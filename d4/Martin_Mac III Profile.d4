<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mac III Profile" ShortName="Mac III Pr" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="19-09-08" Author="David Hunt" Comment="Created" />
  <History Date="07-11-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="06-01-09" Author="David Hunt" Comment="Updated to Version 1.1" />
  <History Date="07-01-09" Author="User" Comment="Checked" />
  <History Date="17-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="24-01-11" Author="Nic Morris" Comment="Inverted ranges for more logical wheel direction." />
  <History Date="24-01-11" Author="Nic Morris" Comment="Shortened names for Expert LCD" />
  <History Date="24-01-11" Author="Nic Morris" Comment="Standardised Colour Function names and reordered" />
  <History Date="24-01-11" Author="Nic Morris" Comment="Removed Gobo1 and Gobo1Rot update from Gobo2Func" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Renamed to distinguish between performance model.  FW v1.5.  Valid for all versions except v1.0" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Removed Gobo Shake Spin function.  Fixed faulty conditions." />
  <History Date="25-01-11" Author="Nic Morris" Comment="Named Gobos" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Increased wheel resolution and raw ranges for 16bit attr" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed animation ranges" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Removed prism func and simplified" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed control ranges (correct for v1.1-v1.5.  Trigger event log has no function in v1.1)" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Revised and added macros" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed Effect Rot wheel direction." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Changed name from Mac 3 Profile to Mac III Profile.  Added Atlabase ID's.  Inverted zoom." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Added physical pan/tilt ranges.  Added function index.  Revised colour scroll function names (were spin)." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Added gobo number to gobo function names.  Renamed effect to animation.  Added missing control functions and macros." />
  <Manual Filename="http://www.martin.com/service/downloadfile.asp?name=UM_MACIIIProfileLoRes_EN_H.pdf&amp;cat=65" Summary="" />

    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f°',0.00~395.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="771~32382" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32639~33153" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33410~65021" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="65278~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="C/CMY/Gobo" Name="C/CMY/G Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="5~10" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Col Shake" Display="'Col Shake %.f%%',0~100" Dmx="19~57" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="3" Name="Rnd CMY Slow" Display="'Rnd CMY Slow'" Dmx="110~135" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="4" Name="Rnd CMY Medium" Display="'Rnd CMY Medium'" Dmx="84~109" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="5" Name="Rnd CMY Fast" Display="'Rnd CMY Fast'" Dmx="58~83" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="6" Name="Reserved" Display="'Reserved %.f',136~255" Dmx="136~255" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Animation" Display="'No Animation'" Dmx="0~0" Update="Effect_Rot" />
      <Function ID="2" Name="Hor Index Pos" Display="'Hor Index Pos'" Dmx="6~10" Update="Effect_Rot" />
      <Function ID="3" Name="Ver Index Pos" Display="'Ver Index Pos'" Dmx="11~15" Update="Effect_Rot" />
      <Function ID="4" Name="Hor Spin Pos" Display="'Hor Spin Pos'" Dmx="16~20" Update="Effect_Rot" />
      <Function ID="5" Name="Ver Spin Pos" Display="'Ver Spin Pos'" Dmx="21~25" Update="Effect_Rot" />
      <Function ID="6" Name="V-H Spin" Display="'V-H Spin %.1f%%',0.0~100.0" Dmx="26~110" Update="Effect_Rot" />
      <Function ID="7" Name="H-V Index" Display="'H-V Index %.1f%%',0.0~100.0" Dmx="111~195" Update="Effect_Rot" />
      <Function ID="8" Name="V-Open Index" Display="'V-Open Index %.1f%%',0.0~100.0" Dmx="196~255" Update="Effect_Rot" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Index" ID="1" If="'Effect'==2||'Effect'==3||'Effect'==7||'Effect'==8" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Effect'==4||'Effect'==5||'Effect'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.f°',0~395" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="254~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism Index" Display="'Prism Index'" Dmx="30~30" Update="Prism_Rot" />
      <Function ID="3" Name="Prism Spin" Display="'Prism Spin'" Dmx="40~59" Update="Prism_Rot" />
      <Function ID="4" Name="Reserved" Display="'Reserved'" Dmx="80~89" Update="Prism_Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Prism'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.f°',0~395" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~90" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="254~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="199~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="200~215" Iris="0~0" Zoom="0~0" />

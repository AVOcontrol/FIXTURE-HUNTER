      <Function ID="18" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="180~209" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="210~232" GoboSpin="0~0" GoboOrientation="0~0" />

      <Function ID="9" Name="2 (5 Circles)" Display="'2 (5 Circles)'" Dmx="40~44" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="3 (Snow Storm)" Display="'3 (Snow Storm)'" Dmx="45~49" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

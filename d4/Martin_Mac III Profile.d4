  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~50" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse    %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" Intensity="0~0" />
      <Function ID="9" Name="Burst Pulse" Display="'Burst Pulse   %.f%%',0~100" Dmx="184~170" Intensity="0~0" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Random Range" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal" Display="'Normal'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Random Range" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal" Display="'Normal'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Condition Name="Random Range" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal" Display="'Normal'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">

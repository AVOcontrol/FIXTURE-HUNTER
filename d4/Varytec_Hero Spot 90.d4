<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hero Spot 90" ShortName="Hero Sp 90" Company="Varytec">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>b12cd9f8-89fa-4097-8afb-ae6fadbacd85</Thumbnail>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7acdb847-95a4-48fc-a6e7-075f84e3dfa4" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~22" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="32~40" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="50~58" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="68~76" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="86~94" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="104~112" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="122~130" WheelPosition="7" Colour="128,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="23~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="41~49" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="59~67" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="77~85" WheelPosition="4" Colour="0,0,255" />
      <Function ID="14" Name="Yel/ L Blu" Display="'Yel/ L Blu'" Dmx="95~103" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="L Blu/ Ppl" Display="'L Blu/ Ppl'" Dmx="113~121" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~195" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Gobo1Func'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>159c1b3b-71e6-4569-907e-4bd3a08fd399</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~21" WheelPosition="1">
        <Swatch>9e18e3fe-8e6b-4a8a-8441-e34e8f015694</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="22~37" WheelPosition="2">
        <Swatch>e7cb38e7-92c4-4fd1-9220-ee68dcaac8ba</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="38~53" WheelPosition="3">
        <Swatch>616eb08c-c590-4814-8b98-eeb0a5da8464</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="54~69" WheelPosition="4">
        <Swatch>45cf29b1-f1ed-4260-8a0b-29fe3c773057</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="70~85" WheelPosition="5">
        <Swatch>dea33275-a8c9-4f08-ba59-83161533dfa5</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="86~101" WheelPosition="6">
        <Swatch>2da735cc-d068-4e16-b483-263890971d41</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="102~117" WheelPosition="7">
        <Swatch>ec1104e8-9fa2-4789-a821-428705a86924</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="118~133" WheelPosition="8">
        <Swatch>25ef554f-1f5f-444a-ac4d-5727c01fae40</Swatch>
      </Function>
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="134~194" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~255" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Gobo2Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>159c1b3b-71e6-4569-907e-4bd3a08fd399</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~28" WheelPosition="1">
        <Swatch>87470a02-fdda-44dc-a0ff-1e5870575967</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="29~49" WheelPosition="2">
        <Swatch>952a7029-4578-499d-ab62-39ca2b9cab53</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="50~70" WheelPosition="3">
        <Swatch>d97752c9-0eea-4165-b29d-af6eae1b7e87</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="71~91" WheelPosition="4">
        <Swatch>cd0b6547-5cc9-4d75-a223-6c64f0ef00fd</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="92~112" WheelPosition="5">
        <Swatch>5ce15c93-403d-413b-8945-371953f409bd</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="113~133" WheelPosition="6">
        <Swatch>67a57bc1-b9c9-4d96-9407-958dd3e68a78</Swatch>
      </Function>
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="134~194" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="130~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~134" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~47" />

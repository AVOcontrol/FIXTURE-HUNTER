    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Mixing" Display="'Col Mixing'" Dmx="10~50" />
      <Function ID="3" Name="Col Jump Change" Display="'Col Jump Change'" Dmx="51~100" />
      <Function ID="4" Name="Col Gradual Change" Display="'Col Gradual Change'" Dmx="101~150" />
      <Function ID="5" Name="Col Sudden Change" Display="'Col Sudden Change'" Dmx="151~200" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="201~220" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="221~240" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

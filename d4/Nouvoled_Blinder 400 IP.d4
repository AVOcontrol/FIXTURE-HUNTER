      <Function ID="8" Name="Jump 7" Display="'Jump 7'" Dmx="96~105" />
      <Function ID="9" Name="Jump 8" Display="'Jump 8'" Dmx="106~110" />
      <Function ID="10" Name="Jump 9" Display="'Jump 9'" Dmx="111~125" />
      <Function ID="11" Name="Jump 10" Display="'Jump 10'" Dmx="126~140" />
      <Function ID="12" Name="Jump 11" Display="'Jump 11'" Dmx="141~155" />
      <Function ID="13" Name="Jump 12" Display="'Jump 12'" Dmx="156~169" />
      <Function ID="14" Name="Jump 13" Display="'Jump 13'" Dmx="170~185" />
      <Function ID="15" Name="Jump 14" Display="'Jump 14'" Dmx="186~200" />
      <Function ID="16" Name="Jump 15" Display="'Jump 15'" Dmx="201~215" />
      <Function ID="17" Name="Strobe" Display="'Strobe'" Dmx="216~230" />
      <Function ID="18" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

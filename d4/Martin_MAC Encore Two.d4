      <Function ID="11" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Animation, Animation_Rot" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4" If="'Animation_Func'==1||'Animation_Func'==2" />
      <Condition Name="Index" ID="5,6,7,8,9" If="'Animation_Func'==3||'Animation_Func'==4" />
      <Condition Name="Shake" ID="10,11,12,13" If="'Animation_Func'==5||'Animation_Func'==6" />
      <Condition Name="Bounce" ID="14,15" If="'Animation_Func'==7||'Animation_Func'==8" />
      <Condition Name="Random" ID="16,17" If="'Animation_Func'==9||'Animation_Func'==10" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Horizontal" Display="'Horizontal'" Dmx="1~1" WheelPosition="1" />
      <Function ID="3" Name="Diagonal" Display="'Diagonal'" Dmx="2~2" WheelPosition="2" />
      <Function ID="4" Name="Vertical" Display="'Vertical'" Dmx="3~3" WheelPosition="3" />

      <Function ID="85" Name="Pan and Tilt Circle Medium" Display="'Pan and Tilt Circle Medium'" Dmx="225~225" />
      <Function ID="86" Name="Pan and Tilt Circle Large" Display="'Pan and Tilt Circle Large'" Dmx="226~226" />

    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Animation_Func'==1||'Animation_Func'==3||'Animation_Func'==5||'Animation_Func'==7||'Animation_Func'==9" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Animation_Func'==2||'Animation_Func'==4||'Animation_Func'==6||'Animation_Func'==8||'Animation_Func'==10" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~32767" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49151~49152" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32768~49150" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49151~49152" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49153~65535" />

    <Attribute ID="FX_2_Adjust" Name="FX 2 Adjust" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="255~129" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="126~0" />
    </Attribute>
    <Attribute ID="FX_Sync" Name="FX Sync" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sync" Display="'No Sync'" Dmx="0~0" />
      <Function ID="2" Name="Fixture Offset " Display="'Fixture Offset  %.f°',10~350" Dmx="1~35" />
      <Function ID="3" Name="Synchronized" Display="'Synchronized'" Dmx="36~36" />
      <Function ID="4" Name="Random Start" Display="'Random Start'" Dmx="101~120" />
      <Function ID="5" Name="Random Duration" Display="'Random Duration'" Dmx="121~140" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

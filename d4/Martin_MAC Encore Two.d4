    <Attribute ID="Animation_Func" Name="Animation Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Animation, Animation_Rot" />

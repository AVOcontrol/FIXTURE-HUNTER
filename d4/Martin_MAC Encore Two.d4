      <Function ID="11" Name="Horiz Shake" Display="'Horiz Shake %.f%%',0~100" Dmx="128~148" WheelPosition="1" />
      <Function ID="12" Name="Diag Shake" Display="'Diag Shake %.f%%',0~100" Dmx="149~169" WheelPosition="2" />
      <Function ID="13" Name="Vert Shake" Display="'Vert Shake %.f%%',0~100" Dmx="170~190" WheelPosition="3" />
      <Function ID="14" Name="Stop" Display="'Stop'" Dmx="192~192" />
      <Function ID="15" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="193~239" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="240~240" />
      <Function ID="17" Name="Random" Display="'Random %.f%%',0~100" Dmx="241~255" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

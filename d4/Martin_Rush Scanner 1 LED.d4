    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Prism'==3" />

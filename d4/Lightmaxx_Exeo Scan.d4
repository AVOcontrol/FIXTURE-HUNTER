<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Exeo Scan" ShortName="Exeo Scan" Company="Lightmaxx">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="18-10-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="14~27" Colour="255,255,0" />
      <Function ID="3" Name="Rose Pink" Display="'Rose Pink'" Dmx="28~41" Colour="255,0,127" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="42~55" Colour="0,255,0" />
      <Function ID="5" Name="Pink Carnation" Display="'Pink Carnation'" Dmx="56~69" Colour="255,150,150" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="70~83" Colour="0,0,255" />
      <Function ID="7" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="84~97" Colour="255,255,128" />
      <Function ID="8" Name="Deep Straw" Display="'Deep Straw'" Dmx="98~111" Colour="255,250,230" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="112~127" Colour="255,150,150" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="191~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="16" If="'Gobo1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="80~99" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="100~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="120~139" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="140~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~179" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="180~199" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="200~219" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~19" Intensity="0~0" />
      <Function ID="3" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="20~127" Intensity="0~0" />
      <Function ID="4" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="138~201" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="4~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~59" />
      <Function ID="2" Name="Reset Col/ Gobo" Display="'Reset Col/ Gobo'" Dmx="60~79" />
      <Function ID="3" Name="Reset All" Display="'Reset All'" Dmx="80~99" />
      <Function ID="4" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="5" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="6" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="7" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="8" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="9" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="10" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="11" Name="Program 8" Display="'Program 8'" Dmx="240~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="UKLMEXSC" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="6" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Col/ Gobo">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Rose Pink" Number="2" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="12" Name="Rose Pink" Number="10" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="13" Name="Rose Pink" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="14" Name="Pink Carnation" Number="8" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
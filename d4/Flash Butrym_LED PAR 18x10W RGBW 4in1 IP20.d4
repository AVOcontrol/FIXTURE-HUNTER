      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="80~255" />
      <Function ID="3" Name="Macro" Display="'Macro %.f%%',0~100" Dmx="1~79" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

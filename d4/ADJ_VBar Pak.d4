    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;5" />
      <Condition Name="Sensitivity" ID="4,5" If="'Mode'==5" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.f%%',0~100" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="0~31" Intensity="0~0" />
      <Function ID="5" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="32~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">

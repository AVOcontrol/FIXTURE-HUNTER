<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Raspa (SS806CW5)" ShortName="Raspa" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>252a9b24-505a-41dd-82e7-f400cafc3de5</Thumbnail>
  <History Date="03-01-13" Author="Peter Budd" Comment="Created" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Changed name from SS 806 CW5 to Raspa (SS806CW5).  Added product thumbnail." />
  <History Date="16-10-18" Author="Nic Morris" Comment="Increased 16bit wheel resolution.  Fixed wheel mapping conflict.  Revised with reserved WarmWhite and ColdWhite Attribute ID's." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3000K" Display="'3000K'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,200,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="110~179" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3000K" Display="'3000K'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Uno, 1 DMX" Channels="1">
    <Import PearlRef="SS_806CW5_1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="STD.W, 5 DMX" Channels="5">
    <Import PearlRef="SS_806CW5_5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Zoom" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="STD.P, 10 DMX" Channels="10">
    <Import PearlRef="SS_806CW510" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="3,4" Wheel="8" />
      <Attribute ID="ColdWhite" ChannelOffset="5,6" Wheel="9" />
      <Attribute ID="Colour_Macro1" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Dos, 2 DMX" Channels="2">
    <Import PearlRef="SS_806CW5_2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>

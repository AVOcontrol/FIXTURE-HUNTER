  </Mode>
  <Mode Name="Mode 3, 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="03fe4b88-0edd-4a65-9f65-7a2f0120608e" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0a621cfb-1469-44e7-a80d-685a66d9e72c" />
  <Control>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="3800K" Display="'3800K'" Dmx="5~6" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="7~8" Colour="255,255,255" />
      <Function ID="6" Name="4600K" Display="'4600K'" Dmx="9~10" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="11~12" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="13~14" Colour="255,255,255" />
      <Function ID="9" Name="6300K" Display="'6300K'" Dmx="15~16" Colour="255,255,255" />
      <Function ID="10" Name="WW-&gt;CW" Display="'WW-&gt;CW %.1f%%',0.0~100.0" Dmx="17~247" Colour="255,255,255" />
      <Function ID="11" Name="Rainbow w/fade" Display="'Rainbow w/fade'" Dmx="248~248" Colour="255,255,255" />
      <Function ID="12" Name="Rainbow no fade" Display="'Rainbow no fade'" Dmx="249~249" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0cda9621-c346-4581-b303-73ed68ba8bb4" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="865d7de8-bd55-42f0-a431-e02e0bacc510" />
    <Include>
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />

    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="102~118" Colour="0,255,128" />
      <Function ID="8" Name="Static Rainbow" Display="'Static Rainbow'" Dmx="119~169" Colour="255,255,255" />
      <Function ID="9" Name="Moving Rainbow" Display="'Moving Rainbow'" Dmx="170~220" Colour="255,255,255" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="11" Name="Static Rainbow" Display="'Static Rainbow'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

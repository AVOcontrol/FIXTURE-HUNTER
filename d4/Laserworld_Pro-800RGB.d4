  <History Date="07-12-16" Author="Nic Morris" Comment="Created (note manual has both Y-Wave and X-Wave on channel 15 with 15 channel total count)" />
  <History Date="05-04-17" Author="Nic Morris" Comment="Added undocumented 'Line Mode' and 'Shutter' channels in response to customer information." />
  <History Date="10-01-18" Author="Nic Morris" Comment="Revised colour functions in response to customer information (documentation is incorrect)." />
  <History Date="10-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="22-03-19" Author="Nic Morris" Comment="Created from Laserworld Pro-1600RGB (note charts have 2x channel 15.  assumed second is 16.  going with this but retained extra in case is wrong)" />
  <History Date="02-04-19" Author="Nic Morris" Comment="Minor revisions to colour functions in attempt to fix customer bug report." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="10~49" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="50~149" />
      <Function ID="4" Name="DMX Static" Display="'DMX Static'" Dmx="150~199" />
      <Function ID="5" Name="DMX Anim" Display="'DMX Anim'" Dmx="200~255" />

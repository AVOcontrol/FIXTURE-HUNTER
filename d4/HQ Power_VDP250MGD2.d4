      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="130~135" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="136~141" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

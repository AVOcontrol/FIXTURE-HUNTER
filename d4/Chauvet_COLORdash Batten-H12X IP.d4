  <History Date="27-05-26" Author="Nic Morris" Comment="Removed virtual dimmer from cells in multi-celled modes and changed master dimmer to dimmer in attempt to solve customer bug report." Version="7" />
  <History Date="27-05-26" Author="Nic Morris" Comment="(the fixture is very unusual in that the RGB components in the multi-celled modes are controlled per pixel but the AWUV seem to be only across the whole fixture)" Version="7" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="87898184-9736-4ec6-ba20-6a8f755b48d8" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White 1" Display="'Warm White 1'" Dmx="6~25" Colour="255,240,200" />
      <Function ID="3" Name="Warm White 2" Display="'Warm White 2'" Dmx="26~50" Colour="255,240,200" />
      <Function ID="4" Name="Warm White 3" Display="'Warm White 3'" Dmx="51~75" Colour="255,240,200" />
      <Function ID="5" Name="Neutral White 1" Display="'Neutral White 1'" Dmx="76~100" Colour="255,255,255" />
      <Function ID="6" Name="Neutral White 2" Display="'Neutral White 2'" Dmx="101~125" Colour="255,255,255" />
      <Function ID="7" Name="Neutral White 3" Display="'Neutral White 3'" Dmx="126~150" Colour="255,255,255" />
      <Function ID="8" Name="Daylight 1" Display="'Daylight 1'" Dmx="151~175" Colour="230,230,255" />
      <Function ID="9" Name="Daylight 2" Display="'Daylight 2'" Dmx="176~200" Colour="230,230,255" />
      <Function ID="10" Name="Daylight 3" Display="'Daylight 3'" Dmx="201~225" Colour="230,230,255" />
      <Function ID="11" Name="Daylight 4" Display="'Daylight 4'" Dmx="226~250" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5 (1-4)" Display="'Auto 5 (1-4)'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Shutter" Name="Master Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

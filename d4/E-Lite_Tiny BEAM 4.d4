  <Thumbnail>9dcc6a23-9f4f-4d30-8ca7-6cd9c91f521b</Thumbnail>
  <History Date="17-04-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="19-04-24" Author="Nic Morris" Comment="Added Atlabase IDs for new version modes." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9a53b4c8-46d8-415c-a0ca-2489806ead4d" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="5,6,7,8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="35~52" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="70~87" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="105~122" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="18~34" WheelPosition="0" Colour="255,255,255" />
      <Function ID="6" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="53~69" WheelPosition="1" Colour="255,0,0" />
      <Function ID="7" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="88~104" WheelPosition="2" Colour="255,255,0" />
      <Function ID="8" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="123~139" WheelPosition="3" Colour="0,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~195" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_Pattern" Name="Beam Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Static Beam" Display="'Static Beam %.1f%%',0.0~100.0" Dmx="0~133" WheelPosition="0" />
      <Function ID="2" Name="Beam FWD" Display="'Beam FWD %.f%%',100~0" Dmx="134~194" />
      <Function ID="3" Name="Beam REV" Display="'Beam REV %.f%%',0~100" Dmx="195~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static Auto 1" Display="'Static Auto 1'" Dmx="8~97" />
      <Function ID="3" Name="Static Auto 2" Display="'Static Auto 2'" Dmx="98~127" />
      <Function ID="4" Name="Static Auto 3" Display="'Static Auto 3'" Dmx="128~167" />
      <Function ID="5" Name="Static Auto 4" Display="'Static Auto 4'" Dmx="168~207" />
      <Function ID="6" Name="Static Auto 5" Display="'Static Auto 5'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~32" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="33~58" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="59~84" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="85~110" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="111~162" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="163~214" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="215~240" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~37" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="38~67" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="68~98" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="99~128" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="129~159" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="160~189" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="190~220" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="221~250" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="af735a7c-d1fe-46e1-8ef8-8c8d30dc12e7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

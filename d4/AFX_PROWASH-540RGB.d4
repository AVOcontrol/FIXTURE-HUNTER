      <Function ID="9" Name="Green Yellow" Display="'Green Yellow'" Dmx="80~89" Colour="180,180,0" />
      <Function ID="10" Name="Salmon" Display="'Salmon'" Dmx="90~99" Colour="255,150,150" />

  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:6" Delay="4000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:4" Delay="4000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Reset:5" Delay="4000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (1)">
      <Set Channel="Reset:3" Delay="4000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off (1)">
      <Set Channel="Reset:2" Delay="4000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (2)">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off (2)">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>

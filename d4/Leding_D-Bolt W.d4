  <AtlaBase TypeID="63c7fe57-2f31-42b2-aab9-74307cea8c72" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Burst Pulse" Display="'Burst Pulse %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" />
      <Function ID="11" Name="Sine Wave" Display="'Sine Wave %.f%%',0~100" Dmx="224~210" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~510" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="102~152" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="153~203" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Dim_Response" Name="Dim Response" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="43~84" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="85~126" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="127~168" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="169~210" />
      <Function ID="6" Name="Halogen" Display="'Halogen'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="RedShift" Name="RedShift" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="85~170" />
      <Function ID="3" Name="On" Display="'On'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~45" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="46~71" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="72~97" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="98~123" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="124~149" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="150~175" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="176~201" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="202~227" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="228~253" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="21~27" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="28~55" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="56~83" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="84~111" />
      <Function ID="6" Name="Speed 5" Display="'Speed 5'" Dmx="112~139" />
      <Function ID="7" Name="Speed 6" Display="'Speed 6'" Dmx="140~167" />
      <Function ID="8" Name="Speed 7" Display="'Speed 7'" Dmx="168~195" />
      <Function ID="9" Name="Speed 8" Display="'Speed 8'" Dmx="196~223" />
      <Function ID="10" Name="Speed 9" Display="'Speed 9'" Dmx="224~251" />
      <Function ID="11" Name="Speed 10" Display="'Speed 10'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>

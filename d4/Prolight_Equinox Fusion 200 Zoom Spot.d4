  <History Date="10-07-19" Author="Nic Morris" Comment="Created from Unknown 230W Spot Beam Zoom LED Moving Head (identical)" />
  <History Date="11-07-19" Author="Nic Morris" Comment="Created from Imrelax IM-LED230" />

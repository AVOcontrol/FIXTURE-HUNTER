<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED BLINDER 400 2in1 IP20" ShortName="Blinder400" Company="Unknown" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="11-06-23" Author="Nic Morris" Comment="Created (very poor documentation.  channel counts in specs are completely different to charts.  effect functions are not documented properly and don't make sense.  left as raw for now.  no pixel layout.  guessed)" Version="0" />
  <History Date="13-06-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="07e92974-9fe5-466a-91a2-b7c36fd69bd7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade_Speed" Name="Fade Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="1s" Display="'1s'" Dmx="11~20" />
      <Function ID="3" Name="2s" Display="'2s'" Dmx="21~30" />
      <Function ID="4" Name="3s" Display="'3s'" Dmx="31~40" />
      <Function ID="5" Name="4s" Display="'4s'" Dmx="41~50" />
      <Function ID="6" Name="5s" Display="'5s'" Dmx="51~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="025ad264-d7f5-43bf-96a7-55fd8ee5eece">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

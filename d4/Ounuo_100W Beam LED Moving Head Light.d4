      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="231~232" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="208~230" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="231~232" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="233~255" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />

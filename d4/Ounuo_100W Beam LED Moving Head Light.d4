      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~128" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="129~255" />
    </Attribute>
  </Control>
  <Mode Name="19 DMX" Channels="19">

      <Function ID="15" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="45~49" WheelPosition="4" Colour="255,255,0" />
      <Function ID="16" Name="Mag/ Amb" Display="'Mag/ Amb'" Dmx="55~59" WheelPosition="5" Colour="255,0,255" />
      <Function ID="17" Name="Amb/ Cy" Display="'Amb/ Cy'" Dmx="65~69" WheelPosition="6" Colour="255,100,0" />
      <Function ID="18" Name="Cy/ 8" Display="'Cy/ 8'" Dmx="75~79" WheelPosition="7" Colour="0,255,255" />

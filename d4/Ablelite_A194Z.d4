      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="CW" Display="'CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="191~192" />
      <Function ID="4" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Pattern_Fade" Name="Pattern Fade" Description="" Group="E">

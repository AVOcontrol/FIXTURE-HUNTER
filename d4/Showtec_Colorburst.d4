  <History Date="20-09-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Col_Macro" Name="LED Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="All Red" Display="'All Red'" Dmx="6~15" Colour="255,255,255" />
      <Function ID="3" Name="All Green" Display="'All Green'" Dmx="16~26" Colour="255,255,255" />
      <Function ID="4" Name="All Blue" Display="'All Blue'" Dmx="27~37" Colour="255,255,255" />
      <Function ID="5" Name="All White" Display="'All White'" Dmx="38~48" Colour="255,255,255" />
      <Function ID="6" Name="R, G, B" Display="'R, G, B'" Dmx="49~59" Colour="255,255,255" />
      <Function ID="7" Name="R, G, W" Display="'R, G, W'" Dmx="60~70" Colour="255,255,255" />
      <Function ID="8" Name="R, B, W" Display="'R, B, W'" Dmx="71~81" Colour="255,255,255" />
      <Function ID="9" Name="G, B, W" Display="'G, B, W'" Dmx="82~92" Colour="255,255,255" />
      <Function ID="10" Name="R/G, R/B, R/W" Display="'R/G, R/B, R/W'" Dmx="93~103" Colour="255,255,255" />
      <Function ID="11" Name="G/R, G/B, G/W" Display="'G/R, G/B, G/W'" Dmx="104~114" Colour="255,255,255" />
      <Function ID="12" Name="B/R, B/G, B/W" Display="'B/R, B/G, B/W'" Dmx="115~125" Colour="255,255,255" />
      <Function ID="13" Name="W/R, W/G, W/B" Display="'W/R, W/G, W/B'" Dmx="126~136" Colour="255,255,255" />
      <Function ID="14" Name="All R/G" Display="'All R/G'" Dmx="137~147" Colour="255,255,255" />
      <Function ID="15" Name="All R/B" Display="'All R/B'" Dmx="148~158" Colour="255,255,255" />
      <Function ID="16" Name="All R/W" Display="'All R/W'" Dmx="159~169" Colour="255,255,255" />
      <Function ID="17" Name="All G/B" Display="'All G/B'" Dmx="170~180" Colour="255,255,255" />
      <Function ID="18" Name="All G/W" Display="'All G/W'" Dmx="181~191" Colour="255,255,255" />
      <Function ID="19" Name="All B/W" Display="'All B/W'" Dmx="192~202" Colour="255,255,255" />
      <Function ID="20" Name="All R/G/B" Display="'All R/G/B'" Dmx="203~213" Colour="255,255,255" />
      <Function ID="21" Name="All R/G/W" Display="'All R/G/W'" Dmx="214~224" Colour="255,255,255" />
      <Function ID="22" Name="All G/B/W" Display="'All G/B/W'" Dmx="225~235" Colour="255,255,255" />
      <Function ID="23" Name="R/G/B, G/B/W, R/G/W" Display="'R/G/B, G/B/W, R/G/W'" Dmx="236~246" Colour="255,255,255" />
      <Function ID="24" Name="All R/G/B/W" Display="'All R/G/B/W'" Dmx="247~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="R On" Display="'R On'" Dmx="6~46" />
      <Function ID="3" Name="G On" Display="'G On'" Dmx="47~87" />
      <Function ID="4" Name="R+G On" Display="'R+G On'" Dmx="88~128" />
      <Function ID="5" Name="R Flash, G On" Display="'R Flash, G On'" Dmx="129~169" />
      <Function ID="6" Name="R On, G Flash" Display="'R On, G Flash'" Dmx="170~210" />
      <Function ID="7" Name="R+G Flash" Display="'R+G Flash'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="1~127" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="6~40" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="41~76" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="77~112" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="113~148" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="149~184" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="185~220" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Rotate1" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="5~127" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Rotate1" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" />
      <Attribute ID="LED_Col_Macro" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="LED_Strobe" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Laser" ChannelOffset="8" Wheel="13" />
      <Attribute ID="Laser_Strobe" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Rotate" ChannelOffset="10" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="22 DMX" Channels="22">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="LED_Strobe" Wheel="5" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="LED_Col_Macro" ChannelOffset="16" Wheel="7" />
        <Attribute ID="Master_Dimmer" ChannelOffset="17" Wheel="4" />
        <Attribute ID="Laser" ChannelOffset="18" Wheel="13" />
        <Attribute ID="Laser_Strobe" ChannelOffset="19" Wheel="14" />
        <Attribute ID="Auto" ChannelOffset="20" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="21" Wheel="23" />
        <Attribute ID="Rotate" ChannelOffset="22" Wheel="19" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="LED_Strobe" TargetId="LED_Strobe" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="LED_Strobe" TargetId="LED_Strobe" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="11" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="LED_Strobe" TargetId="LED_Strobe" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="5" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="LED_Strobe" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Static RGB Effect" ShortName="RGB Effect" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Close" Display="'Close'" Dmx="0~0" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="5~54" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse'" Dmx="55~104" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse'" Dmx="105~154" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="155~204" />
      <Function ID="6" Name="Strobe" Display="'Strobe'" Dmx="205~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Col_Mode" Name="Col Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~14" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~24" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="25~34" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="35~44" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="45~54" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="55~64" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="65~74" Colour="255,255,255" />
      <Function ID="9" Name="Col Jump" Display="'Col Jump %.1f%%',0.0~100.0" Dmx="75~199" Colour="255,255,255" />
      <Function ID="10" Name="Random" Display="'Random %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Gradient" Name="Col Gradient" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~199" Colour="255,255,255" />
      <Function ID="3" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="FX_Speed" Name="FX Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Gradient" Name="FX Gradient" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gradient" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Red" Name="FX Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="FX_Green" Name="FX Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="FX_Blue" Name="FX Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="FX_Dimmer" Name="FX Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="UKSRGBFX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter_Func" ChannelOffset="2" Wheel="34" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="35" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter_Func" ChannelOffset="2" Wheel="34" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="35" />
        <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
        <Attribute ID="Col_Mode" ChannelOffset="7" Wheel="37" />
        <Attribute ID="Col_Gradient" ChannelOffset="8" Wheel="38" />
        <Attribute ID="FX" Wheel="22" />
        <Attribute ID="FX_Speed" Wheel="23" />
        <Attribute ID="FX_Gradient" Wheel="24" />
        <Attribute ID="FX_Red" Wheel="7" />
        <Attribute ID="FX_Green" Wheel="8" />
        <Attribute ID="FX_Blue" Wheel="9" />
        <Attribute ID="FX_Dimmer" Wheel="4" />
        <Attribute ID="BG_Dimmer" Wheel="5" />
      </Master>
      <Cell ID="Cell1" Name="FX" ChannelOffset="9" ModeLink="FX cell" X="0" Y="0">
        <AttributeLink SourceId="FX" TargetId="FX" />
        <AttributeLink SourceId="FX_Speed" TargetId="FX_Speed" />
        <AttributeLink SourceId="FX_Gradient" TargetId="FX_Gradient" />
        <AttributeLink SourceId="FX_Red" TargetId="Red" />
        <AttributeLink SourceId="FX_Green" TargetId="Green" />
        <AttributeLink SourceId="FX_Blue" TargetId="Blue" />
        <AttributeLink SourceId="FX_Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="BG" ChannelOffset="16" ModeLink="BG cell" X="0" Y="1">
        <AttributeLink SourceId="BG_Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="FX cell" Channels="7" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="FX" ChannelOffset="1" Wheel="22" />
      <Attribute ID="FX_Speed" ChannelOffset="2" Wheel="23" />
      <Attribute ID="FX_Gradient" ChannelOffset="3" Wheel="24" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="BG cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100,FX_Red:1:100,FX_Green:1:100,FX_Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0,FX_Red:1:100,FX_Green:1:0,FX_Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0,FX_Red:1:100,FX_Green:1:50,FX_Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0,FX_Red:1:100,FX_Green:1:100,FX_Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0,FX_Red:1:50,FX_Green:1:100,FX_Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0,FX_Red:1:0,FX_Green:1:100,FX_Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50,FX_Red:1:0,FX_Green:1:100,FX_Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100,FX_Red:1:0,FX_Green:1:100,FX_Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100,FX_Red:1:0,FX_Green:1:50,FX_Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100,FX_Red:1:0,FX_Green:1:0,FX_Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100,FX_Red:1:50,FX_Green:1:0,FX_Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100,FX_Red:1:100,FX_Green:1:0,FX_Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50,FX_Red:1:100,FX_Green:1:0,FX_Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94,FX_Red:1:71,FX_Green:1:43,FX_Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100,FX_Red:1:20,FX_Green:1:0,FX_Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
      <Function ID="2" Name="White 3200K" Display="'White 3200K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="White 3800K" Display="'White 3800K'" Dmx="3~4" Colour="255,255,255" />

      <Function ID="29" Name="CTO/ CTB" Display="'CTO/ CTB'" Dmx="108~111" WheelPosition="13" Colour="255,240,200" />
      <Function ID="30" Name="CTB/ Op" Display="'CTB/ Op'" Dmx="116~127" WheelPosition="14" Colour="230,230,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />

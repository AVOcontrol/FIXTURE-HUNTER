      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="80~83" WheelPosition="10" Colour="128,255,0" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="88~91" WheelPosition="11" Colour="255,128,0" />
      <Function ID="13" Name="UV" Display="'UV'" Dmx="96~99" WheelPosition="12" Colour="180,0,255" />
      <Function ID="14" Name="CTO" Display="'CTO'" Dmx="104~107" WheelPosition="13" Colour="255,240,200" />
      <Function ID="15" Name="CTB" Display="'CTB'" Dmx="112~115" WheelPosition="14" Colour="230,230,255" />

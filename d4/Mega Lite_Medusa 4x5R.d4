      <Function ID="22" Name="Pk/ L Blu" Display="'Pk/ L Blu'" Dmx="52~55" WheelPosition="6" Colour="255,150,150" />
      <Function ID="23" Name="L Blu/ Sun" Display="'L Blu/ Sun'" Dmx="60~63" WheelPosition="7" Colour="0,128,255" />
      <Function ID="24" Name="Sun/ D Blu" Display="'Sun/ D Blu'" Dmx="68~71" WheelPosition="8" Colour="255,128,0" />
      <Function ID="25" Name="D Blu/ L Grn" Display="'D Blu/ L Grn'" Dmx="76~79" WheelPosition="9" Colour="0,0,180" />

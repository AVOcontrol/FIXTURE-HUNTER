      <Function ID="14" Name="RGBWA Full" Display="'RGBWA Full'" Dmx="151~170" />
      <Function ID="15" Name="Effect 1" Display="'Effect 1'" Dmx="171~190" />
      <Function ID="16" Name="Effect 2" Display="'Effect 2'" Dmx="191~210" />
      <Function ID="17" Name="Effect 3" Display="'Effect 3'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

    <Attribute ID="Dim_Spd2" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="51~100" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="101~150" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="151~200" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="201~255" />

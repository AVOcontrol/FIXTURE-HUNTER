      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="100~149" Intensity="0~0" />
      <Function ID="5" Name="Async Fast" Display="'Async Fast %.f%%',0~100" Dmx="150~199" Intensity="0~0" />
      <Function ID="6" Name="Sync Fast" Display="'Sync Fast %.f%%',0~100" Dmx="200~255" Intensity="0~0" />

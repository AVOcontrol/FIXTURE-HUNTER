      <Function ID="12" Name="Cyan" Display="'Cyan'" Dmx="28270~29298" WheelPosition="11" Colour="0,255,255" />
      <Function ID="13" Name="Dark Blue" Display="'Dark Blue'" Dmx="30840~31868" WheelPosition="12" Colour="0,0,180" />

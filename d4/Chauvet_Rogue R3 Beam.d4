      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="33~36" Colour="255,255,0" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="37~40" Colour="255,0,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="41~44" Colour="50,128,255" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="45~48" Colour="255,150,0" />
      <Function ID="13" Name="CT0 5600K" Display="'CT0 5600K'" Dmx="49~52" Colour="255,240,200" />
      <Function ID="14" Name="CTO 6500K" Display="'CTO 6500K'" Dmx="53~56" Colour="230,230,255" />
      <Function ID="15" Name="UV" Display="'UV'" Dmx="57~60" Colour="180,0,255" />
      <Function ID="16" Name="Index" Display="'%.f%%',0~100" Dmx="61~127" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />

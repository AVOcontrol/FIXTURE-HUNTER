<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Boxer" ShortName="Boxer" Company="Livegear">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-01-11" Author="Nic Morris" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="23-12-15" Author="Nic Morris" Comment="Changed manufacturer from Unknown to Livegear" />
  <History Date="06-07-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Standardised.  Made colour macro range indexable." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="10-12-17" Author="Nic Morris" Comment="Added channel counts to mode names." />
  <Manual Filename="http://www.livegear.co.jp/product/dmx/powe_mix/boxer_eng.pdf" Summary="" />
  <AtlaBase TypeID="6f65b1b2-5e7a-4403-b5e2-26017fd8aaaf" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~20" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="31~190" Colour="0,0,0" />
      <Function ID="4" Name="RGBW Full" Display="'RGBW Full'" Dmx="191~200" Colour="255,255,255" />
      <Function ID="5" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="6" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="7" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="8" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="9" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="10" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="11" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="12" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="13" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="14" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="15" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',1.0~20.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">

    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="5" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="6" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
    <Attribute ID="Pattern1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Patt_Spd1" />
      <Function ID="2" Name="Control" Display="'Control'" Dmx="16~31" Update="Patt_Spd1" />
      <Function ID="3" Name="Effect" Display="'Effect %.f',1~14" Dmx="32~255" Update="Patt_Spd1" />
    </Attribute>
    <Attribute ID="Patt_Spd1" Name="Patt Spd" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

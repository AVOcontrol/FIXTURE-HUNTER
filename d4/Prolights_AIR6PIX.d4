<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AIR6PIX" ShortName="AIR6PIX" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="08-03-15" Author="Nic Morris" Comment="Created" />
  <History Date="19-03-15" Author="Nic Morris" Comment="Updated to latest spec in response to manufacturer request." />
  <History Date="26-03-15" Author="Nic Morris" Comment="Changed all first text only functions to default to zero in attempt to fix manufacturer bug report." />
  <History Date="19-11-15" Author="Ermanno Valvason" Comment="Patterns, FG and BG colors updated" />
  <History Date="02-12-15" Author="Nic Morris" Comment="Revised Foreground and Background functions.  Tidied up Patt Spd." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added v1.0 firmware modes in response to manufacturer request (minor differences Col 1 &amp; 2, Pattern and FG/BG functions)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f3796d70-e7a2-4202-8dd0-dde058a15425" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Normal BO" Display="'Normal BO'" Dmx="16~31" />
      <Function ID="3" Name="Pan FW" Display="'Pan FW'" Dmx="32~47" />
      <Function ID="4" Name="Pan REV" Display="'Pan REV'" Dmx="48~63" />
      <Function ID="5" Name="Tilt FW" Display="'Tilt FW'" Dmx="64~79" />
      <Function ID="6" Name="Tilt REV" Display="'Tilt REV'" Dmx="80~95" />
      <Function ID="7" Name="P/T FW" Display="'P/T FW'" Dmx="96~111" />
      <Function ID="8" Name="P/T REV" Display="'P/T REV'" Dmx="112~127" />
      <Function ID="9" Name="Pan FW/ Tilt REV" Display="'Pan FW/ Tilt REV'" Dmx="128~143" />
      <Function ID="10" Name="Pan REV/ Tilt FW" Display="'Pan REV/ Tilt FW'" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FW" Display="'Pulse FW'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
      <Function ID="5" Name="Effect" Display="'Effect'" Dmx="64~95" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pivot" Name="Pivot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pivot" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="3" Name="Spin FW" Display="'Spin FW'" Dmx="32~47" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="4" Name="Spin REV" Display="'Spin REV'" Dmx="48~63" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1, Colour11" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1, Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Spin" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CTO" Display="'CTO %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,240,200" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,240,200" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,240,200" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="230,230,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="230,230,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="8" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~243" Colour="255,255,255" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,0,0" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="246~247" Colour="0,255,0" />
      <Function ID="12" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="0,0,255" />
      <Function ID="13" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="14" Name="All" Display="'All'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~243" Colour="255,255,255" />

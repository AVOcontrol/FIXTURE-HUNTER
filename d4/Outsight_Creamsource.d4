<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Creamsource" ShortName="Creamsrce" Company="Outsight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-03-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Smoothing" Name="Smoothing" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="ON" Display="'ON'" Dmx="0~0" />
      <Function ID="2" Name="OFF" Display="'OFF'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Mode" Name="FX Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="20~29" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="30~39" />
      <Function ID="4" Name="Flash Frames" Display="'Flash Frames'" Dmx="40~49" />
    </Attribute>
    <Attribute ID="FX_Variation" Name="FX Variation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Variation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Trigger" Name="FX Trigger" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="OFF" Display="'OFF'" Dmx="0~0" />
      <Function ID="2" Name="ON" Display="'ON'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="2">
    <Import PearlRef="UKOSCSC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="Mode 2" Channels="8">
    <Import PearlRef="UKOSCSC2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Smoothing" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Duration" ChannelOffset="5" Wheel="5" />
      <Attribute ID="FX_Mode" ChannelOffset="6" Wheel="22" />
      <Attribute ID="FX_Variation" ChannelOffset="7" Wheel="23" />
      <Attribute ID="FX_Trigger" ChannelOffset="8" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="Mode 3" Channels="4">
    <Import PearlRef="UKOSCSC3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="3,4" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="Mode 4" Channels="10">
    <Import PearlRef="UKOSCSC4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="3,4" Wheel="7" />
      <Attribute ID="Smoothing" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Duration" ChannelOffset="7" Wheel="5" />
      <Attribute ID="FX_Mode" ChannelOffset="8" Wheel="22" />
      <Attribute ID="FX_Variation" ChannelOffset="9" Wheel="23" />
      <Attribute ID="FX_Trigger" ChannelOffset="10" Wheel="24" />
    </Include>
  </Mode>
</Fixture>
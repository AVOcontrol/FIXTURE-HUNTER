  <History Date="04-04-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Colour="255,255,255" />
      <Function ID="2" Name="Light Green" Display="'Light Green'" Dmx="15~29" Colour="128,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="30~44" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="45~59" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~74" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="75~89" Colour="255,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="90~104" Colour="255,128,0" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="105~119" Colour="0,128,255" />
      <Function ID="9" Name="Rose" Display="'Rose'" Dmx="120~127" Colour="255,0,127" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="15" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~14" Colour="255,255,255" />
      <Function ID="16" Name="Light Green" Display="'Light Green %.f%%',0~100" Dmx="15~29" Colour="128,255,0" />
      <Function ID="17" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~44" Colour="0,0,255" />
      <Function ID="18" Name="Green" Display="'Green %.f%%',0~100" Dmx="45~59" Colour="0,255,0" />
      <Function ID="19" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="60~74" Colour="255,255,0" />
      <Function ID="20" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="75~89" Colour="255,0,255" />
      <Function ID="21" Name="Orange" Display="'Orange %.f%%',0~100" Dmx="90~104" Colour="255,128,0" />
      <Function ID="22" Name="Light Blue" Display="'Light Blue %.f%%',0~100" Dmx="105~119" Colour="0,128,255" />
      <Function ID="23" Name="Rose" Display="'Rose %.f%%',0~100" Dmx="120~127" Colour="255,0,127" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Gobo1Func'==3" />
      <Condition Name="Index" ID="19,20,21,22,23,24,25,26" If="'Gobo1Func'==4" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="80~95" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="96~111" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="112~127" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="128~143" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="144~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="160~175" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="176~191" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~9" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~9" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~225" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="226~235" />
      <Function ID="3" Name="Disable BO on P/T" Display="'Disable BO on P/T'" Dmx="236~245" />
      <Function ID="4" Name="No Func" Display="'No Func'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="32~63" />
      <Function ID="3" Name="Prism 3D" Display="'Prism 3D'" Dmx="64~95" />
      <Function ID="4" Name="Frost" Display="'Frost'" Dmx="96~127" />

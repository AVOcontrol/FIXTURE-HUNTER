      <Function ID="6" Name="Frame Offset" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_5" Name="Effect Param 5" Description="" Group="E">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Condition Name="Emergency Lights" ID="1" If="'Effect'==9" />
      <Condition Name="Flash Frames" ID="2,3" If="'Effect'==4" />

  <History Date="09-09-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="13-09-20" Author="Nic Morris" Comment="Corrected xFade CCT-Col DMX end value in response to customer feedback (was set to 255 in 16bit)" Version="3" />
  <History Date="15-01-21" Author="Nic Morris" Comment="Created from Creamsource SpaceX (note mode 31 is not currently supported.  modes 23 and 29 charts missing channels - assume mistake and bunched up)" Version="4" />
  <History Date="30-10-21" Author="Nic Morris" Comment="Updated in line with v1.2 (adds v1.2 multi zone modes, calibrate sync effect and revises flash frames effect params." Version="11" />
  <History Date="02-07-23" Author="Nic Morris" Comment="Updated in line with latest firmware (DMX table 2.5, document revision A).  Changes reserved to control channel and adds modes 38-67." Version="13" />
  <History Date="20-09-24" Author="Nic Morris" Comment="Created from Creamsource Vortex8" Version="20" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8d3711c6-b297-43dd-9280-0d922343ea67" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2200" PowerOn="1:2200" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2200.0~15000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta1" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.1f%%',100.0~0.0" Dmx="11~133" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="134~134" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~100.0" Dmx="135~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.2f%%',100.00~0.00" Dmx="5001~35267" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="35268~35268" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.2f%%',0.00~100.00" Dmx="35269~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xFade_CCT-Col" Name="xFade CCT-Col" Description="" Group="C" Size="2">

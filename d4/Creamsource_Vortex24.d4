      <Function ID="30" Name="(Col Combination) Magenta" Display="'(Col Combination) Magenta'" Dmx="135~149" />
      <Function ID="31" Name="(Col Combination) Green" Display="'(Col Combination) Green'" Dmx="150~164" />
      <Function ID="32" Name="(Col Combination) White" Display="'(Col Combination) White'" Dmx="165~179" />
      <Function ID="33" Name="(Col Combination) Use Col Mode Slots" Display="'(Col Combination) Use Col Mode Slots'" Dmx="255~255" />

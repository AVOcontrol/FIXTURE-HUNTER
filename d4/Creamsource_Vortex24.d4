    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Timed Flash" ID="1,2" If="'Effect'==6" />
      <Condition Name="Candle+Fire" ID="3,4" If="'Effect'==8" />
      <Condition Name="Emergency Lights/Party" ID="5" If="'Effect'==9||'Effect'==12" />
      <Condition Name="Flash Frames" ID="6" If="'Effect'==4" />
      <Else ID="7" />
      <Function ID="1" Name="Trigger Off" Display="'Trigger Off'" Dmx="0~0" />
      <Function ID="2" Name="Trigger On" Display="'Trigger On'" Dmx="255~255" />
      <Function ID="3" Name="Col Temp" Display="'Col Temp %.fK',1400~5600" Dmx="0~244" />

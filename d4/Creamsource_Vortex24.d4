      <Function ID="2" Name="Effect Off" Display="'Effect Off'" Dmx="0~0" />
      <Function ID="3" Name="Effect On" Display="'Effect On'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

  <History Date="14-04-17" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="08-06-17" Author="Nic Morris" Comment="Changed master fixture RGB to RGB Masters and locate at zero in attempt to fix bug report." Version="2" />
  <History Date="04-09-18" Author="Nic Morris" Comment="Created from Chauvet Maverick MK3 Wash (note auto program ranges don't divide)" Version="3" />
  <History Date="31-08-23" Author="Nic Morris" Comment="Revised Single Basic mode to use cells in response to Gregory's feedback." Version="4" />
  <History Date="01-10-25" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail." Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bc37c87f-07a2-4ee9-81fb-13767aed42f5" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'%.fK',2800~10000" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">

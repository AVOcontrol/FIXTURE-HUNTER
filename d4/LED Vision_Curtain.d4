    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="2" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~34" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="35~65" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="66~98" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="99~131" Colour="0,255,0" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="132~164" Colour="128,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="165~197" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="198~230" Colour="0,255,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin iBar 15" ShortName="iBar 15" Company="Robe" Version="3">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>a4ea8ab7-8fd2-4c1f-9daf-5fdcff91da92</Thumbnail>
  <History Date="17-10-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="20-10-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="2" />
  <History Date="17-10-25" Author="Nic Morris" Comment="Changed RGB masters to normal RGB controls and linked the cell RGB controls to virtual 'All Pix' controls in the master in modes 3 and 4 and also changed the master dimmer to a normal (HTP) dimmer in mode 3 in an attempt to solve customer bug report." Version="3" />
  <History Date="17-10-25" Author="Nic Morris" Comment="This comes with the compromise that there are no virtual dimmers in the cells in mode 3.  In mode 4 the cell dimmers are currently unlinked.  This is not ideal but the alternatives are either to change the main dimmer to LTP or move it to a cell, both of which are also problematic." Version="3" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="21075" ModelID="293" />
  </RDM>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="D-Color" ShortName="D-Color" Company="Studio Due">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="03-03-08" Author="Ion Balan" Comment="Created" />
  <History Date="03-03-08" Author="Ion Balan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated fixture type from nothing to fixed" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated fixture type from nothing to fixed" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="16-08-15" Author="Nic Morris" Comment="Revised shortname.  Fixed amber attribute ID.  Updated to use cells for tilt." />
  <History Date="16-08-15" Author="Nic Morris" Comment="Revised colour speed functions.  Standardised P/T Speed.  Added palettes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b3c53c0d-4895-4366-8892-22c4674e962d" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Spd" Name="Colour Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Cut" Display="'Cut'" Dmx="0~31" />
      <Function ID="2" Name="Time" Display="'Time %.1f Sec',0.0~25.0" Dmx="32~223" />
      <Function ID="3" Name="25.5 sec" Display="'25.5 sec'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~127" Intensity="0~0" />
      <Function ID="3" Name="Rainbow" Display="'Rainbow %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~127" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~191" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="SDDCol1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="170" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9eec05d9-9ff1-4a9a-8345-98ccc8c558a5" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
        <Attribute ID="Amber" ChannelOffset="4" Wheel="9" />
        <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
        <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
        <Attribute ID="Colour_Spd" ChannelOffset="9" Wheel="26" />
        <Attribute ID="P/T_Speed" ChannelOffset="10" Wheel="25" />
        <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
        <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="6" ModeLink="8-bit cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="8-bit cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="SDDCol2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="170" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="19c03a37-7aa7-4a0b-9e42-6c2ac77490cf" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
        <Attribute ID="Amber" ChannelOffset="4" Wheel="9" />
        <Attribute ID="Pan" ChannelOffset="5,6" Wheel="2" />
        <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
        <Attribute ID="Colour_Spd" ChannelOffset="12" Wheel="26" />
        <Attribute ID="P/T_Speed" ChannelOffset="13" Wheel="25" />
        <Attribute ID="Shutter" ChannelOffset="14" Wheel="4" />
        <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="16-bit cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="9" ModeLink="16-bit cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="8-bit cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="170" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
    </Include>
  </Mode>
  <Mode Name="16-bit cell" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="170" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1,2" Wheel="3" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
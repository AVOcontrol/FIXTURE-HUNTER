      <Function ID="17" Name="Pink" Display="'Pink'" Dmx="160~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Sound Fade" Display="'Sound Fade %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Sound Jump" Display="'Sound Jump %.f%%',0~100" Dmx="190~255" />

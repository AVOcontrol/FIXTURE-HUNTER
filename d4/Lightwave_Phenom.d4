  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="File" Name="Cue" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cue" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Folder" Name="Page" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Page" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Size" Name="X-Size" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Y-Size" Name="Y-Size" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="X-Pos" Name="X-Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Y-Pos" Name="Y-Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotate" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Clip_Speed" Name="Clip Speed" Description="" Group="E">
      <Locate Locate="1:151" PowerOn="1:151" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~300.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Clip_Direction" Name="Clip Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Scan_Rate" Name="Scan Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Rate" Display="'Rate %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Visible_Points" Name="Visible Points" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Points" Display="'%.1f%%',-100.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Additive" Display="'Additive'" Dmx="2~2" />
      <Function ID="3" Name="Subtractive" Display="'Subtractive'" Dmx="3~3" />
      <Function ID="4" Name="Additive/Subtractive" Display="'Additive/Subtractive'" Dmx="4~4" />
      <Function ID="5" Name="HSV Entire Clip (Global)" Display="'HSV Entire Clip (Global)'" Dmx="5~5" />
      <Function ID="6" Name="True HSV Point by Point" Display="'True HSV Point by Point'" Dmx="6~6" />
      <Function ID="7" Name="Normal" Display="'Normal'" Dmx="7~255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.f°',0~360" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Range" Name="Tilt Range" Description="" Group="S">
      <Locate Locate="1:255" PowerOn="1:255" />
      <Function ID="1" Name="Limit" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="32 DMX" Channels="32">
    <Import PearlRef="UKLWPHEN" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="File" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Folder" ChannelOffset="3" Wheel="14" />
      <Attribute ID="X-Size" ChannelOffset="4,5" Wheel="19" />
      <Attribute ID="Y-Size" ChannelOffset="6,7" Wheel="20" />
      <Attribute ID="X-Pos" ChannelOffset="8,9" Wheel="21" />
      <Attribute ID="Y-Pos" ChannelOffset="10,11" Wheel="49" />
      <Attribute ID="Z-Rot" ChannelOffset="12,13" Wheel="50" />
      <Attribute ID="Red" ChannelOffset="14" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="15" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="16" Wheel="12" />
      <Attribute ID="Amber" ChannelOffset="17" Wheel="40" />
      <Attribute ID="Clip_Speed" ChannelOffset="18" Wheel="22" />
      <Attribute ID="Clip_Direction" ChannelOffset="19" Wheel="23" />
      <Attribute ID="Scan_Rate" ChannelOffset="20" Wheel="4" />
      <Attribute ID="Visible_Points" ChannelOffset="21" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="22" Wheel="6" />
      <Attribute ID="Colour_Mode" ChannelOffset="23" Wheel="25" />
      <Attribute ID="xHue" ChannelOffset="24" Wheel="7" />
      <Attribute ID="Pan" ChannelOffset="25,26" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="27,28" Wheel="3" />
      <Attribute ID="Tilt_Range" ChannelOffset="29" Wheel="26" />
      <Attribute ID="Control" ChannelOffset="30" Wheel="28" />
      <Attribute ID="Reserved" ChannelOffset="31" Wheel="29" />
      <Attribute ID="Reserved1" ChannelOffset="32" Wheel="30" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

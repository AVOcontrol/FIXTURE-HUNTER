  <History Date="03-05-15" Author="Nic Morris" Comment="Created" />
  <History Date="11-08-16" Author="Nic Morris" Comment="Added 56 DMX mode.  Added Atlabase ID's." />
  <History Date="27-01-17" Author="Nic Morris" Comment="Revised classic pearl refs." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Fixed auto show function names (were missing numbers)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e58d98ef-800b-4a33-8d80-91fac2366f8a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~37" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="38~52" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="53~67" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="68~82" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="83~97" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="98~112" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~142" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="143~157" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="158~172" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="218~232" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="31~45" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="46~60" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="61~75" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="9" Name="GB" Display="'GB'" Dmx="136~150" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="151~165" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="166~180" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="181~195" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="196~210" Colour="255,255,255" />
      <Function ID="14" Name="RBW" Display="'RBW'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="15" Name="GBW" Display="'GBW'" Dmx="226~240" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Sensitivity" Name="Sensitivity" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~30" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="31~53" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="54~76" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="77~99" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="100~122" />
      <Function ID="7" Name="Safe" Display="'Safe'" Dmx="123~199" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="200~224" />
    </Attribute>
  </Control>

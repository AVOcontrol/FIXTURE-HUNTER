      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>7a3b4db1-6e07-4170-b10d-4b4c8a1a9c1a</Swatch>

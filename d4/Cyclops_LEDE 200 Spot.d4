    <Attribute ID="Gobo_Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo_Rot_Func'==1" />
      <Condition Name="Speed" ID="2" If="'Gobo_Rot_Func'&gt;1&amp;&amp;'Gobo_Rot_Func'&lt;8" />
      <Else ID="3" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />

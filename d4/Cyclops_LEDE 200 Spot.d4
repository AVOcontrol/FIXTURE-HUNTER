<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LEDE 200 Spot" ShortName="LEDE 200Sp" Company="Cyclops">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>5adc9c1b-cf1c-4267-8539-a0463a78dc85</Thumbnail>
  <History Date="08-09-14" Author="Nic Morris" Comment="Created" />
  <History Date="16-09-14" Author="Nic Morris" Comment="Updated colour and gobo in response to manufacturer request." />
  <History Date="04-05-15" Author="Nic Morris" Comment="Updated basic modes to use simplified shutter channel in attempt to fix bug report from distributor." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Reinstated basic shutter attribute with correct functions checked against physical fixture." />
  <History Date="11-10-15" Author="Nic Morris" Comment="Fixed duplicate else ID's" />
  <History Date="02-12-15" Author="Nic Morris" Comment="Fixed basic mode shutter wheel mapping error." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="05-06-16" Author="Nic Morris" Comment="Fixed palettes" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Revised prism function names.  Changed basic mode shutter closed to zero to work with Capture." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Fixed Colour11 duplicate else ID.  Added missing Open and No Scroll functions to conditionals." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added no spin functions to prism rot and revised ranges (note error in documentation)" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Changed basic mode iris pulse functions from percentage to text only after testing against fixture." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Revised physical pan tilt limits after testing against actual fixture." />
  <History Date="23-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="23-01-18" Author="Nic Morris" Comment="Added gobo swatches.  Added channel counts to mode names." />
  <History Date="05-10-18" Author="Nic Morris" Comment="Created from Prolights MOONSTONE (effectively identical.  gobo image slots and basic mode colour ranges missing/erroneous - assumed the same for now)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ebdb5812-78be-42bb-b260-ff1bcd7af996" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Function" Name="P/T Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ColorNeptune" ShortName="ColNeptune" Company="VentureLite" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="08-12-22" Author="Nic Morris" Comment="Created (limited information)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~11" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="26~26" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="42~42" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="58~58" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="74~74" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="90~90" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="106~106" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="120~120" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="138~138" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="154~154" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="170~170" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="186~186" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="202~202" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="228~228" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="250~250" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="251~251" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
      <Attribute ID="Tilt_Speed" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Macro" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Macro_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="40" />
    </Include>
  </Mode>

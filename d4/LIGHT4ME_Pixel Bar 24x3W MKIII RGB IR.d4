  <AtlaBase TypeID="dd3849e0-de93-4a3b-8766-4d1e4218b4be" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="12~23" Update="Auto_Spd" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~35" Update="Auto_Spd" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~47" Update="Auto_Spd" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="48~59" Update="Auto_Spd" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="60~71" Update="Auto_Spd" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="72~83" Update="Auto_Spd" />
      <Function ID="8" Name="White" Display="'White'" Dmx="84~95" Update="Auto_Spd" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="96~107" Update="Auto_Spd" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="108~119" Update="Auto_Spd" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="120~131" Update="Auto_Spd" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="132~143" Update="Auto_Spd" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="144~155" Update="Auto_Spd" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="156~167" Update="Auto_Spd" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="168~179" Update="Auto_Spd" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="180~191" Update="Auto_Spd" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="192~203" Update="Auto_Spd" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="204~215" Update="Auto_Spd" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="216~227" Update="Auto_Spd" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="228~239" Update="Auto_Spd" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="240~251" Update="Auto_Spd" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Auto'==22" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

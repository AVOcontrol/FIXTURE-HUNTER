<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RUSH DC 1 Aqua" ShortName="Rsh DC1 Aq" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="26-10-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="905bc45b-c4e2-408f-9dfd-84d5de269c34" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="150~160" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="161~165" Colour="255,128,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="166~170" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="171~175" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="176~180" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="181~185" Colour="255,150,150" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="186~192" Colour="255,255,255" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~149" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="12" Name="Random" Display="'Random %.f%%',0~100" Dmx="255~244" Colour="255,255,255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Wave_Effect_1" Name="Wave Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="10~120" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Wave_Effect_2" Name="Wave Effect 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="10~120" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="246~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="MTRDC1AQ" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8025c5be-cbdc-471d-ba5c-d58d1b36fe55" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Wave_Effect_1" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Wave_Effect_2" ChannelOffset="4" Wheel="23" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Orange" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="13" Name="Pink" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Galactic Bluestar MKII" ShortName="Gl BluStr2" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="18-11-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto Fast" Display="'Auto Fast'" Dmx="52~102" />
      <Function ID="3" Name="Auto Slow" Display="'Auto Slow'" Dmx="103~154" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="155~206" />
      <Function ID="5" Name="DMX" Display="'DMX'" Dmx="207~255" />
    </Attribute>
    <Attribute ID="Red_Laser_Strobe" Name="Red Laser Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Green_Laser_Strobe" Name="Green Laser Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="1:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Laser_Rotate" Name="Laser Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="LED_Rotate" Name="Blue LED Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Blue LED" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blue_LED_Strobe" Name="Blue LED Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="SHGALBS2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Red_Laser_Strobe" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Green_Laser_Strobe" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Laser_Rotate" ChannelOffset="4" Wheel="13" />
      <Attribute ID="LED_Rotate" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Blue_LED_Strobe" ChannelOffset="7" Wheel="6" />
    </Include>
  </Mode>
</Fixture>
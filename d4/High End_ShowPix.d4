    <Attribute ID="Media_Folder1" Name="Img1 Media Fld" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lenses" Display="'Lenses'" Dmx="1~1" />
      <Function ID="3" Name="Backgrounds" Display="'Backgrounds'" Dmx="2~2" />
      <Function ID="4" Name="Chasing" Display="'Chasing'" Dmx="3~3" />
      <Function ID="5" Name="Marquee" Display="'Marquee'" Dmx="4~4" />

    <Attribute ID="Play_Mode1" Name="Img 1 Play Md" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Loop Forward" Display="'Loop Forward'" Dmx="0~0" Update="Play_Speed" />
      <Function ID="2" Name="Loop Reverse" Display="'Loop Reverse'" Dmx="1~1" Update="Play_Speed" />
      <Function ID="3" Name="Once Forward" Display="'Once Forward'" Dmx="2~2" Update="Play_Speed" />
      <Function ID="4" Name="Once Reverse" Display="'Once Reverse'" Dmx="3~3" Update="Play_Speed" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="4~4" Update="Play_Speed" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="5~5" Update="Play_Speed" />
      <Function ID="7" Name="Static Frame" Display="'Static Frame'" Dmx="6~6" Update="Play_Speed" />
      <Function ID="8" Name="Loop Forward w Int" Display="'Loop Forward  w Int'" Dmx="7~7" Update="Play_Speed" />
      <Function ID="9" Name="Loop Reverse w Int" Display="'Loop Reverse  w Int'" Dmx="8~8" Update="Play_Speed" />
      <Function ID="10" Name="Once Forward w Int" Display="'Once Forward  w Int'" Dmx="9~9" Update="Play_Speed" />
      <Function ID="11" Name="Once Reverse w Int" Display="'Once Reverse  w Int'" Dmx="10~10" Update="Play_Speed" />
      <Function ID="12" Name="Random w Int" Display="'Random w Int'" Dmx="11~11" Update="Play_Speed" />
      <Function ID="13" Name="Bounce w Int" Display="'Bounce w Int'" Dmx="12~12" Update="Play_Speed" />
      <Function ID="14" Name="Reserved" Display="'Reserved'" Dmx="13~255" Update="Play_Speed" />
    </Attribute>
    <Attribute ID="Play_Speed1" Name="Img 1 Play Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Static Frame" ID="1,2,3,4,7" If="'Play_Mode'==7" />
      <Condition Name="Random" ID="6" If="'Play_Mode'==5||'Play_Mode'==12" />
      <Else ID="5" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Slow Speed" Display="'Slow Speed %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="1~1" />
      <Function ID="4" Name="Normal" Display="'Normal'" Dmx="128~128" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
      <Function ID="7" Name="Fast Speed" Display="'Fast Speed %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>

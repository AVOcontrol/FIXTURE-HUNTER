      <Function ID="13" Name="Flashing" Display="'Flashing'" Dmx="12~12" />
      <Function ID="14" Name="Reserved" Display="'Reserved'" Dmx="13~40" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="41~250" />

  <Macro>
    <Macro Name="Display Off">
      <Set Channel="Shutter:1" Delay="0" />
      <Set Channel="Control:2" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Bright">
      <Set Channel="Shutter:1" Delay="0" />
      <Set Channel="Control:3" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Home">
      <Set Channel="Shutter:1" Delay="0" />
      <Set Channel="Control:4" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Shutdown">
      <Set Channel="Shutter:1" Delay="0" />
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Outrig Mode">
      <Set Channel="Control:6" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

  <AtlaBase TypeID="14cc4a7c-b544-4bef-836b-574675e89709" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~12" Update="Auto_Spd" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="13~25" Update="Auto_Spd" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="26~38" Update="Auto_Spd" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="39~51" Update="Auto_Spd" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="52~64" Update="Auto_Spd" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="65~77" Update="Auto_Spd" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="78~90" Update="Auto_Spd" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="91~103" Update="Auto_Spd" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="104~116" Update="Auto_Spd" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="117~129" Update="Auto_Spd" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="130~142" Update="Auto_Spd" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="143~155" Update="Auto_Spd" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="156~168" Update="Auto_Spd" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="169~181" Update="Auto_Spd" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="182~194" Update="Auto_Spd" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="195~207" Update="Auto_Spd" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="208~220" Update="Auto_Spd" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="221~233" Update="Auto_Spd" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==20" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

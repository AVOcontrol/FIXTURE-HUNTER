      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="143~157" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="158~172" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="173~187" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="188~202" />

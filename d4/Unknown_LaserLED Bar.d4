    <Attribute ID="Laser_FX_Spd" Name="Laser FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~22" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="23~37" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="38~52" />

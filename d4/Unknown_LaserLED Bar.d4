    </Attribute>
    <Attribute ID="Laser_FX" Name="Laser FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="15~255" />

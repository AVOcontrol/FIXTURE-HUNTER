      <Function ID="2" Name="Small" Display="'Small'" Dmx="11~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Light Dot" Display="'Light Dot'" Dmx="64~127" />
      <Function ID="3" Name="Segment" Display="'Segment'" Dmx="128~191" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

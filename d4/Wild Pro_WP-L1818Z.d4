    <Attribute ID="Motor_Speed" Name="Motor Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="8~127" />
      <Function ID="3" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" />

      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="216~227" Update="Auto_Spd" />
      <Function ID="21" Name="Sound" Display="'Sound'" Dmx="228~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

  <AtlaBase TypeID="c86ff2bf-f955-4540-8641-ccca023349b9" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~7" Update="Speed" Colour="255,0,0" />
      <Function ID="3" Name="Red + Green" Display="'Red + Green'" Dmx="8~15" Update="Speed" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="16~23" Update="Speed" Colour="0,255,0" />
      <Function ID="5" Name="Green + Blue" Display="'Green + Blue'" Dmx="24~31" Update="Speed" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Speed" Colour="0,0,255" />
      <Function ID="7" Name="Red + Blue" Display="'Red + Blue'" Dmx="40~47" Update="Speed" Colour="255,0,255" />
      <Function ID="8" Name="Red + Green + Blue" Display="'Red + Green + Blue'" Dmx="48~55" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Macro 1" Display="'Macro 1'" Dmx="56~63" Update="Speed" Colour="0,0,0" />
      <Function ID="10" Name="Macro 2" Display="'Macro 2'" Dmx="64~71" Update="Speed" Colour="0,0,0" />
      <Function ID="11" Name="Macro 3" Display="'Macro 3'" Dmx="72~79" Update="Speed" Colour="0,0,0" />
      <Function ID="12" Name="Macro 4" Display="'Macro 4'" Dmx="80~87" Update="Speed" Colour="0,0,0" />
      <Function ID="13" Name="Macro 5" Display="'Macro 5'" Dmx="88~95" Update="Speed" Colour="0,0,0" />
      <Function ID="14" Name="Macro 6" Display="'Macro 6'" Dmx="96~103" Update="Speed" Colour="0,0,0" />
      <Function ID="15" Name="Macro 7" Display="'Macro 7'" Dmx="104~111" Update="Speed" Colour="0,0,0" />
      <Function ID="16" Name="Macro 8" Display="'Macro 8'" Dmx="112~119" Update="Speed" Colour="0,0,0" />
      <Function ID="17" Name="Macro 9" Display="'Macro 9'" Dmx="120~127" Update="Speed" Colour="0,0,0" />
      <Function ID="18" Name="Macro 10" Display="'Macro 10'" Dmx="128~135" Update="Speed" Colour="0,0,0" />
      <Function ID="19" Name="Macro 11" Display="'Macro 11'" Dmx="136~143" Update="Speed" Colour="0,0,0" />
      <Function ID="20" Name="Macro 12" Display="'Macro 12'" Dmx="144~151" Update="Speed" Colour="0,0,0" />
      <Function ID="21" Name="Macro 13" Display="'Macro 13'" Dmx="152~159" Update="Speed" Colour="0,0,0" />
      <Function ID="22" Name="Macro 14" Display="'Macro 14'" Dmx="160~167" Update="Speed" Colour="0,0,0" />
      <Function ID="23" Name="Macro 15" Display="'Macro 15'" Dmx="168~175" Update="Speed" Colour="0,0,0" />
      <Function ID="24" Name="Macro 16" Display="'Macro 16'" Dmx="176~183" Update="Speed" Colour="0,0,0" />
      <Function ID="25" Name="Macro 17" Display="'Macro 17'" Dmx="184~191" Update="Speed" Colour="0,0,0" />
      <Function ID="26" Name="Macro 18" Display="'Macro 18'" Dmx="192~199" Update="Speed" Colour="0,0,0" />
      <Function ID="27" Name="Macro 19" Display="'Macro 19'" Dmx="200~207" Update="Speed" Colour="0,0,0" />
      <Function ID="28" Name="Macro 20" Display="'Macro 20'" Dmx="208~215" Update="Speed" Colour="0,0,0" />
      <Function ID="29" Name="Macro 21" Display="'Macro 21'" Dmx="216~223" Update="Speed" Colour="0,0,0" />
      <Function ID="30" Name="Macro 22" Display="'Macro 22'" Dmx="224~231" Update="Speed" Colour="0,0,0" />
      <Function ID="31" Name="Macro 23" Display="'Macro 23'" Dmx="232~239" Update="Speed" Colour="0,0,0" />
      <Function ID="32" Name="Macro 24" Display="'Macro 24'" Dmx="240~247" Update="Speed" Colour="0,0,0" />
      <Function ID="33" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Speed" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;33" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==33" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

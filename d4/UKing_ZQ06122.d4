  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="10~19" Update="Effect_Spd" />
      <Function ID="3" Name="Breathing" Display="'Breathing'" Dmx="20~29" Update="Effect_Spd" />
      <Function ID="4" Name="Jump" Display="'Jump'" Dmx="30~39" Update="Effect_Spd" />
      <Function ID="5" Name="Gradient" Display="'Gradient'" Dmx="40~49" Update="Effect_Spd" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="50~59" Update="Effect_Spd" />

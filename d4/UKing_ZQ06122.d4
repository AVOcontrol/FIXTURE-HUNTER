      <Function ID="25" Name="Auto 19" Display="'Auto 19'" Dmx="168~173" Update="Effect_Spd" />
      <Function ID="26" Name="Auto 20" Display="'Auto 20'" Dmx="174~179" Update="Effect_Spd" />
      <Function ID="27" Name="Auto 21" Display="'Auto 21'" Dmx="180~185" Update="Effect_Spd" />

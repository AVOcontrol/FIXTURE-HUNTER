      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="72~77" Update="Effect_Spd" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="78~83" Update="Effect_Spd" />

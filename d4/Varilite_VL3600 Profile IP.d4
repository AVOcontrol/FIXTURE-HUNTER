      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade_LT" Name="Frame 4B" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade_All_Rot" Name="Frame Rot" Description="" Group="B">
      <Locate Locate="1:60" PowerOn="1:60" />
      <Function ID="1" Name="Angle" Display="'%.1f°',-60.0~60.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_1_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="6~10" Update="Prism_1_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="11~15" Update="Prism_1_Rot" />
      <Function ID="4" Name="Mega Step" Display="'Mega Step'" Dmx="16~20" Update="Prism_1_Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_1_Rot" />
    </Attribute>
    <Attribute ID="Prism_1_Rot" Name="Prism 1 Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="No Prism" ID="1" If="'Prism_1'==1" />
      <Condition Name="Index" ID="2" If="'Prism_1'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism_1'==3||'Prism_1'==4" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_2_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="6~10" Update="Prism_2_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="11~15" Update="Prism_2_Rot" />
      <Function ID="4" Name="Mega Step" Display="'Mega Step'" Dmx="16~20" Update="Prism_2_Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_2_Rot" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="No Prism" ID="1" If="'Prism_2'==1" />
      <Condition Name="Index" ID="2" If="'Prism_2'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism_2'==3||'Prism_2'==4" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Frost" Display="'No Frost'" Dmx="0~0" />
      <Function ID="2" Name="Frost 1" Display="'Frost 1'" Dmx="11~20" />
      <Function ID="3" Name="Frost 2" Display="'Frost 2'" Dmx="21~25" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="26~36" />
      <Function ID="5" Name="Frost 1+2" Display="'Frost 1+2'" Dmx="37~47" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~125" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="131~245" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Programmers_Ch" Name="Programmers Ch" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="41~45" />

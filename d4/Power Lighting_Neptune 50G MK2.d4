  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DMX" Display="'DMX'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="100~199" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">

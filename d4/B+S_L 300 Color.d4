<Fixture Name="L 300 Color" ShortName="L300 Color" Company="B+S">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>e81dab2a-b08f-4e53-9fe0-03ac56dca21d</Thumbnail>
  <History Date="07-05-19" Author="Nic Morris" Comment="Created" />
  <History Date="08-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="16-10-19" Author="Nic Morris" Comment="Corrected Xfade RGBW function DMX range and changed CTC power and locate value to 50% in response to bug report." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6f665518-de9c-43c8-8b98-47d12e27a40a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Xfade" Name="Xfade" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="CTC" Display="'CTC'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC-&gt;RGBW" Display="'CTC-&gt;RGBW %.1f%%',0.0~100.0" Dmx="6~249" Colour="255,255,255" />
      <Function ID="3" Name="RGBW" Display="'RGBW'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 0 (8bit, CCT On), 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

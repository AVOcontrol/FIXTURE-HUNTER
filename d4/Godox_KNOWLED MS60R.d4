    <Attribute ID="Col_Param_5" Name="Col Param 5" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Flash" ID="2,3" If="'Col_Param_1'==7" />
      <Condition Name="Explosion" ID="4" If="'Col_Param_1'==15" />
      <Condition Name="GEL" ID="5,6" If="'Mode_Selection'==6" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Mode: Camera Flash" Display="'Mode: Camera Flash'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Mode: Flash Bulb" Display="'Mode: Flash Bulb'" Dmx="255~255" Colour="0,0,0" />
      <Function ID="4" Name="Embers" Display="'%.1f%%',1.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="0" Display="'0'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="6" Name="Hue" Display="'Hue %.1f',-10.0~10.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_6" Name="Col Param 6" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="GEL" ID="2,3" If="'Mode_Selection'==6" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="0" Display="'0'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Saturation" Display="'Saturation %.1f',-20.0~20.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
  </Control>

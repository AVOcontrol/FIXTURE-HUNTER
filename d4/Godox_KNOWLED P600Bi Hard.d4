  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b04eb62f-730a-4875-9b0e-191152ea99fd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',2800.00~6500.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="2" Name="Flash" Display="'Flash'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="3" Name="Lightning" Display="'Lightning'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="4" Name="Cloudy" Display="'Cloudy'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="5" Name="Broken Blub" Display="'Broken Blub'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="6" Name="TV" Display="'TV'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="7" Name="Candle" Display="'Candle'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="8" Name="Fire" Display="'Fire'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="9" Name="Firework" Display="'Firework'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="10" Name="Explosion" Display="'Explosion'" Dmx="90~99" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="11" Name="Welding" Display="'Welding'" Dmx="100~109" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="12" Name="SOS" Display="'SOS'" Dmx="110~119" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="13" Name="Preset" Display="'Preset'" Dmx="120~255" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
    </Attribute>
    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1" />
      <Condition Name="No Effect" ID="2" If="'FX'==1" />
      <Condition Name="Flash" ID="3" If="'FX'==2" />

      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="6~126" Colour="0,0,0" />
      <Function ID="3" Name="Colour Stop" Display="'Colour Stop'" Dmx="127~128" Colour="0,0,0" />
      <Function ID="4" Name="Colour Jump" Display="'Colour Jump %.f%%',0~100" Dmx="129~192" Colour="0,0,0" />
      <Function ID="5" Name="Colour Fade" Display="'Colour Fade %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
  </Control>

    <AtlaBase ModeID="c8f995f9-659f-4e29-962f-612e33aaf63d" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Warm_White" ChannelOffset="2" Wheel="7" />

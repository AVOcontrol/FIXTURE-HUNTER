  <History Date="13-05-26" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="19-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="20-05-26" Author="Nic Morris" Comment="Added missing Atlabase model ID." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cc9fa542-17f4-482a-8096-41bb30419c68" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Speed/Sens" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro'" Dmx="5~80" Update="Speed/Sens" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="81~150" Update="Speed/Sens" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="151~220" Update="Speed/Sens" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="221~255" Update="Speed/Sens" />
    </Attribute>
    <Attribute ID="Speed/Sens" Name="Speed/Sens" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Macro" ID="2" If="'Auto'==2" />
      <Function ID="1" Name="Speed/Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3" Id="b14b030f-aa15-43d1-ab6d-cc6794f9ebea">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f35fb334-e67b-49a1-aab0-b745b1a40d82" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="10" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="11" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6" Id="13ba56c6-f10f-496a-b7e9-98b52cc273f3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f864fe65-c7ca-4833-b382-6e8e118205d8" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Winamp" ShortName="Winamp" Company="Nullsoft" Version="7">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="06-01-04" Author="Oliver Waits" Comment="Created" Version="1" />
  <History Date="13-04-06" Author="Ed Spencer" Comment="Moved visualisation into effect group" Version="2" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" Version="3" />
  <History Date="17-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="4" />
  <History Date="12-09-17" Author="Gregory Haynes" Comment="Brought in line with version 2 of the plugin removing Visualisation channel and load functions from Play." Version="5" />
  <History Date="30-07-20" Author="Nic Morris" Comment="Changed playlist from a single variable range to 256 discreet functions in response to feedback." Version="6" />
  <History Date="12-09-23" Author="Gregory Haynes" Comment="Added 'Manual Advance' and 'Track' options to the Loop attribute. 'Manual Advance' is now the default for Locate and Power On. Both 'Manual Advance' and 'Off' will result in loop off in the old plugin and 'Track' and 'Playlist' as loop on. Change EQ On to be 0~0 so that comparison to zero works." Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Play" Name="Play" Description="" Group="S">
      <Locate Locate="3" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~9" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="10~19" />
      <Function ID="3" Name="Play" Display="'Play'" Dmx="20~29" />
      <Function ID="4" Name="Refresh" Display="'Refresh'" Dmx="30~39" />
    </Attribute>
    <Attribute ID="TrackPos" Name="Track Position" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f Sec',0.00~6000.00" Dmx="0~60000" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Volume" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Balance" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Left" Display="'Left %.f%%',100~0" Dmx="0~127" />
      <Function ID="2" Name="Center" Display="'Center'" Dmx="128~128" />
      <Function ID="3" Name="Right" Display="'Right %.f%%',0~100" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Play_Mode" Name="Loop" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual Advance" Display="'Manual Advance'" Dmx="0~4" />
      <Function ID="2" Name="Track" Display="'Track'" Dmx="10~14" />
      <Function ID="3" Name="Playlist" Display="'Playlist'" Dmx="15~19" />
      <Function ID="4" Name="Off" Display="'Auto   Advance'" Dmx="5~9" />
    </Attribute>
    <Attribute ID="Playlist" Name="Playlist" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="1~1" />

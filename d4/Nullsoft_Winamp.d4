    <Attribute ID="EQOn" Name="EQ On/Off" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~19" />
    </Attribute>
    <Attribute ID="EQ_16K" Name="EQ 16K" Description="" Group="S">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="16K Hz" Display="'16K Hz - %.f dB',12~0" Dmx="64~33" />
      <Function ID="2" Name="16K Hz" Display="'16K Hz %.f dB',0~12" Dmx="33~0" />

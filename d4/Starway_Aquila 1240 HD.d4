  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2,Control1:2" Delay="4000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Slow">
      <Set Channel="Control:3,Control1:3" Delay="4000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Med">
      <Set Channel="Control:4,Control1:4" Delay="4000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Fast">
      <Set Channel="Control:5,Control1:5" Delay="4000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Zoom Individual">
      <Set Channel="Control:6" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Zoom Combined (Zoom 1 = 1+2)">
      <Set Channel="Control:7" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Order Normal">
      <Set Channel="Control:8" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Order Inverted">
      <Set Channel="Control:9" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

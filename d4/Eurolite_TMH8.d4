      <Function ID="14" Name="Macro 5" Display="'Macro 5'" Dmx="253~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="RGBW Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Motion Macros" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~23" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="24~39" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="40~55" />

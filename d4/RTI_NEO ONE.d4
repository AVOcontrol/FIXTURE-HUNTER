<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="NEO ONE" ShortName="NEO ONE" Company="RTI">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Dot" Display="'Dot'" Dmx="1~10" WheelPosition="0" />
      <Function ID="3" Name="Rectangle" Display="'Rectangle'" Dmx="11~20" WheelPosition="0" />
      <Function ID="4" Name="Triangle" Display="'Triangle'" Dmx="21~30" WheelPosition="0" />
      <Function ID="5" Name="Line Horizontal" Display="'Line Horizontal'" Dmx="31~40" WheelPosition="0" />
      <Function ID="6" Name="Line Vertical" Display="'Line Vertical'" Dmx="41~50" WheelPosition="0" />
      <Function ID="7" Name="2 Dots Horizontal" Display="'2 Dots Horizontal'" Dmx="51~60" WheelPosition="0" />
      <Function ID="8" Name="2 Dots Vertical" Display="'2 Dots Vertical'" Dmx="61~70" WheelPosition="0" />
      <Function ID="9" Name="3 Dots Horizontal" Display="'3 Dots Horizontal'" Dmx="71~80" WheelPosition="0" />
      <Function ID="10" Name="3 Dots Vertical" Display="'3 Dots Vertical'" Dmx="81~90" WheelPosition="0" />
      <Function ID="11" Name="Circle" Display="'Circle'" Dmx="91~100" WheelPosition="0" />
      <Function ID="12" Name="4 Quarter Circle" Display="'4 Quarter Circle'" Dmx="101~110" WheelPosition="0" />
      <Function ID="13" Name="Test Picture" Display="'Test Picture'" Dmx="111~120" WheelPosition="0" />
      <Function ID="14" Name="Blackout" Display="'Blackout'" Dmx="121~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Grow" Display="'Grow %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Grating_Sel" Name="Grating Sel" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Grating" Display="'No Grating'" Dmx="0~0" />
      <Function ID="2" Name="Grating 1" Display="'Grating 1'" Dmx="1~127" />
      <Function ID="3" Name="Grating 2" Display="'Grating 2'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="UKRTIN1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Gobo1Rot" ChannelOffset="11,12" Wheel="15" />
      <Attribute ID="Grating_Sel" ChannelOffset="13" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Blackout" Number="11" Page="1" SetControl="Gobo1:1" />
      <Palette ID="2" Name="Dot" Number="12" Page="1" SetControl="Gobo1:2" />
      <Palette ID="3" Name="Rectangle" Number="13" Page="1" SetControl="Gobo1:3" />
      <Palette ID="4" Name="Triangle" Number="14" Page="1" SetControl="Gobo1:4" />
      <Palette ID="5" Name="Line Horizontal" Number="15" Page="1" SetControl="Gobo1:5" />
      <Palette ID="6" Name="Line Vertical" Number="16" Page="1" SetControl="Gobo1:6" />
      <Palette ID="7" Name="2 Dots Horizontal" Number="17" Page="1" SetControl="Gobo1:7" />
      <Palette ID="8" Name="2 Dots Vertical" Number="18" Page="1" SetControl="Gobo1:8" />
      <Palette ID="9" Name="3 Dots Horizontal" Number="19" Page="1" SetControl="Gobo1:9" />
      <Palette ID="10" Name="3 Dots Vertical" Number="20" Page="1" SetControl="Gobo1:10" />
      <Palette ID="11" Name="Circle" Number="0" Page="1" SetControl="Gobo1:11" />
      <Palette ID="12" Name="4 Quarter Circle" Number="0" Page="1" SetControl="Gobo1:12" />
      <Palette ID="13" Name="Test Picture" Number="0" Page="1" SetControl="Gobo1:13" />
      <Palette ID="14" Name="Blackout" Number="0" Page="1" SetControl="Gobo1:14" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
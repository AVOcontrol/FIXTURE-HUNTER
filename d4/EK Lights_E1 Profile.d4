      <Function ID="8" Name="White 8000K" Display="'White 8000K'" Dmx="249~255" Colour="255,255,255" />
      <Function ID="9" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="10" Name="Black" Display="'Black'" Dmx="0~0" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="12" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="13" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="14" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />

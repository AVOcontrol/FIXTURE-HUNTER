      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="90~90" WheelPosition="9" Colour="255,0,255" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="100~100" WheelPosition="10" Colour="0,255,255" />
      <Function ID="12" Name="CTO 260" Display="'CTO 260'" Dmx="110~110" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~5" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="15" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="25~25" WheelPosition="2" Colour="255,128,0" />
      <Function ID="16" Name="Aq/ Grn" Display="'Aq/ Grn'" Dmx="35~35" WheelPosition="3" Colour="0,255,200" />
      <Function ID="17" Name="Grn/ L Grn" Display="'Grn/ L Grn'" Dmx="45~45" WheelPosition="4" Colour="0,255,0" />
      <Function ID="18" Name="L Grn/ Lav" Display="'L Grn/ Lav'" Dmx="55~55" WheelPosition="5" Colour="128,255,0" />
      <Function ID="19" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="65~65" WheelPosition="6" Colour="255,128,255" />
      <Function ID="20" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="75~75" WheelPosition="7" Colour="255,150,150" />
      <Function ID="21" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="85~85" WheelPosition="8" Colour="255,255,0" />
      <Function ID="22" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="95~95" WheelPosition="9" Colour="255,0,255" />
      <Function ID="23" Name="Cy/ CTO" Display="'Cy/ CTO'" Dmx="105~105" WheelPosition="10" Colour="0,255,255" />
      <Function ID="24" Name="CTO/ Op" Display="'CTO/ Op'" Dmx="115~115" WheelPosition="11" Colour="255,240,200" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="120~187" Colour="0,0,0" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="188~255" Colour="0,0,0" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~250" />

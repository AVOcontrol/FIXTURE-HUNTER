      <Function ID="14" Name="Lavender" Display="'Lavender'" Dmx="96~103" Colour="180,0,255" />
      <Function ID="15" Name="Indigo" Display="'Indigo'" Dmx="104~111" Colour="180,0,180" />
      <Function ID="16" Name="Hemsley Blue" Display="'Hemsley Blue'" Dmx="112~119" Colour="0,0,255" />
      <Function ID="17" Name="Tipton Blue" Display="'Tipton Blue'" Dmx="120~127" Colour="0,128,255" />
      <Function ID="18" Name="Light Steel Blue" Display="'Light Steel Blue'" Dmx="128~135" Colour="220,240,255" />
      <Function ID="19" Name="Light Sky Blue" Display="'Light Sky Blue'" Dmx="136~143" Colour="128,255,255" />
      <Function ID="20" Name="Sky Blue" Display="'Sky Blue'" Dmx="144~151" Colour="0,255,255" />
      <Function ID="21" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="152~159" Colour="0,0,255" />
      <Function ID="22" Name="Light Green Blue" Display="'Light Green Blue'" Dmx="160~167" Colour="0,0,255" />
      <Function ID="23" Name="Bright Blue" Display="'Bright Blue'" Dmx="168~175" Colour="0,0,255" />
      <Function ID="24" Name="Primary Blue" Display="'Primary Blue'" Dmx="176~183" Colour="0,0,255" />
      <Function ID="25" Name="Congo Blue" Display="'Congo Blue'" Dmx="184~191" Colour="0,0,180" />
      <Function ID="26" Name="Pale Yellow Green" Display="'Pale Yellow Green'" Dmx="192~199" Colour="128,255,0" />
      <Function ID="27" Name="Moss Green" Display="'Moss Green'" Dmx="200~207" Colour="0,180,0" />
      <Function ID="28" Name="Primary Green" Display="'Primary Green'" Dmx="208~215" Colour="0,255,0" />
      <Function ID="29" Name="Double CTB" Display="'Double CTB'" Dmx="216~223" Colour="230,230,255" />
      <Function ID="30" Name="Full CTB" Display="'Full CTB'" Dmx="224~231" Colour="230,230,255" />
      <Function ID="31" Name="Half CTB" Display="'Half CTB'" Dmx="232~239" Colour="230,230,255" />
      <Function ID="32" Name="Dark Blue" Display="'Dark Blue'" Dmx="240~247" Colour="0,0,180" />
      <Function ID="33" Name="White" Display="'White'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Curve 0" Display="'Curve 0'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="21~40" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="41~60" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="61~80" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="81~100" />
      <Function ID="6" Name="Active" Display="'Active'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;1" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~159" Update="Shutter" />
      <Function ID="3" Name="3 Col" Display="'3 Col'" Dmx="160~191" Update="Shutter" />
      <Function ID="4" Name="7 Col" Display="'7 Col'" Dmx="192~223" Update="Shutter" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="224~255" Update="Shutter" />
    </Attribute>
  </Control>

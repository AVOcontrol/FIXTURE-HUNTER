  <AtlaBase TypeID="b280be93-19d1-408d-a802-2d1a964ce3f0" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Bastard Amber" Display="'Bastard Amber'" Dmx="1~7" Colour="255,100,0" />
      <Function ID="3" Name="Medium Amber" Display="'Medium Amber'" Dmx="8~15" Colour="255,128,0" />

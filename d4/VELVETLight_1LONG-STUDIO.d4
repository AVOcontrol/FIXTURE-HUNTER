<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="1LONG-STUDIO" ShortName="1LONG" Company="VELVETLight">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="18-01-19" Author="Nic Morris" Comment="Created (note dimmer locate at 50% and CTO at DMX 46 at manufacturer request)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:3222" PowerOn="1:3222" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Green/_Magenta" Name="Green/ Magenta" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="-1/4" Display="'-1/4'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="-1/8" Display="'-1/8'" Dmx="54~106" Colour="255,255,255" />
      <Function ID="3" Name="0" Display="'0'" Dmx="107~155" Colour="255,255,255" />
      <Function ID="4" Name="+1/8" Display="'+1/8'" Dmx="156~207" Colour="255,255,255" />
      <Function ID="5" Name="+1/4" Display="'+1/4'" Dmx="208~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="CTO" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Green/_Magenta" ChannelOffset="3" Wheel="8" />
    </Include>
  </Mode>
  <swatchLibrary />
</Fixture>
    <Include>
      <Attribute ID="ColdWhite1" ChannelOffset="1" Wheel="37" />
      <Attribute ID="WarmWhite1" ChannelOffset="2" Wheel="38" />
      <Attribute ID="ColdWhite2" ChannelOffset="3" Wheel="39" />
      <Attribute ID="WarmWhite2" ChannelOffset="4" Wheel="67" />
      <Attribute ID="ColdWhite3" ChannelOffset="5" Wheel="68" />
      <Attribute ID="WarmWhite3" ChannelOffset="6" Wheel="69" />

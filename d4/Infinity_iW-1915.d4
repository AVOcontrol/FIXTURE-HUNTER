  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Created from Showtec Infinity IW-715" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Created from Showtec Infinity IW-720" />
  <History Date="08-08-15" Author="Nic Morris" Comment="Changed manufacturer from Showtec to Infinity in response to manufacturer request" />
  <History Date="20-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="24-09-17" Author="Nic Morris" Comment="Changed name from IW-1915 to iW-1915.  Added 16 DMX mode.  Revised 14 DMX mode mapping." />
  <History Date="24-09-17" Author="Nic Morris" Comment="Inverted zoom.  Renamed col macro pix and moved wheel slot next to associated col macro control." />
  <History Date="24-09-17" Author="Nic Morris" Comment="Inverted col macro CCW scroll and col jump.  Revised col macro pix function names." />
  <History Date="24-09-17" Author="Nic Morris" Comment="Revised shutter function names.  Inverted effect speed." />

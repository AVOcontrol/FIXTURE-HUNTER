  <Mode Name="23 DMX, 16bit" Channels="23">
    <Import PearlRef="SM_GioSp400" DiamondRef="SGMGiotSp400" WysiwygRef="" />
    <Physical>
      <Bulb Type="250W" Lumens="3600" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="21" />

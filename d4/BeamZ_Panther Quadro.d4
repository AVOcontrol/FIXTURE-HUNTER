  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="60b52601-782d-43ff-ad12-0761882230c6" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="31~45" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~60" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="61~75" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="9" Name="GB" Display="'GB'" Dmx="136~150" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="151~165" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="166~180" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="181~195" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="196~210" Colour="255,255,255" />
      <Function ID="14" Name="RGW" Display="'RGW'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="15" Name="GBW" Display="'GBW'" Dmx="226~240" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Speed/Sens" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~30" Update="Speed/Sens" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="31~53" Update="Speed/Sens" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="54~76" Update="Speed/Sens" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="77~99" Update="Speed/Sens" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="100~122" Update="Speed/Sens" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="200~224" Update="Speed/Sens" />
    </Attribute>
    <Attribute ID="Speed/Sens" Name="Speed/Sens" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Control'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Sensitivity" Name="Sensitivity" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" Update="Show_Spd" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~22" Update="Show_Spd" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="23~37" Update="Show_Spd" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="38~52" Update="Show_Spd" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="53~67" Update="Show_Spd" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="68~82" Update="Show_Spd" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="83~97" Update="Show_Spd" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="98~112" Update="Show_Spd" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="113~127" Update="Show_Spd" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="128~142" Update="Show_Spd" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="143~157" Update="Show_Spd" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="158~172" Update="Show_Spd" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="173~187" Update="Show_Spd" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="188~202" Update="Show_Spd" />
      <Function ID="15" Name="Show 14" Display="'Show 14'" Dmx="203~217" Update="Show_Spd" />
      <Function ID="16" Name="Show 15" Display="'Show 15'" Dmx="218~232" Update="Show_Spd" />
      <Function ID="17" Name="Show 16" Display="'Show 16'" Dmx="233~247" Update="Show_Spd" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Show_Spd" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Show'==18" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="09-12-19" Author="Nic Morris" Comment="Created (documentation is vague)" Version="1" />
  <History Date="11-12-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="08-03-24" Author="Nic Morris" Comment="Created from LIGHT4ME Thunder Bar (similarly vague documentation.  no pixel layout - assumed the same)" Version="3" />
  <History Date="13-03-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="19-02-26" Author="Nic Morris" Comment="Created from LIGHT4ME Venom Strobe Bar (poor documentation.  71 channel mode not documented properly and doesn't make sense.  assumed is 70 channels.  no pixel layout)" Version="5" />
  <History Date="27-02-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="602f44af-bdaa-4af3-a725-dfa32d1729d9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Effects Group 1" Display="'Effects Group 1 %.f%%',0~100" Dmx="0~19" />
      <Function ID="2" Name="Effects Group 2" Display="'Effects Group 2 %.f%%',0~100" Dmx="40~79" />
      <Function ID="3" Name="Effects Group 3" Display="'Effects Group 3 %.f%%',0~100" Dmx="80~119" />
      <Function ID="4" Name="Effects Group 4" Display="'Effects Group 4 %.f%%',0~100" Dmx="120~159" />
      <Function ID="5" Name="Effects Group 5" Display="'Effects Group 5 %.f%%',0~100" Dmx="160~199" />
      <Function ID="6" Name="Effects Group 6" Display="'Effects Group 6 %.f%%',0~100" Dmx="200~239" />
      <Function ID="7" Name="Effects Group 7" Display="'Effects Group 7 %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="FX_Spd" Name="FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~45" Colour="0,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~83" Colour="0,0,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="84~121" Colour="0,0,0" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green'" Dmx="122~159" Colour="0,0,0" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue'" Dmx="160~197" Colour="0,0,0" />
      <Function ID="7" Name="Green+Blue" Display="'Green+Blue'" Dmx="198~235" Colour="0,0,0" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="236~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="WW+CW" Display="'WW+CW'" Dmx="40~79" />
      <Function ID="3" Name="RGB" Display="'RGB'" Dmx="80~119" />
      <Function ID="4" Name="CW+RGB" Display="'CW+RGB'" Dmx="120~159" />
      <Function ID="5" Name="CW" Display="'CW'" Dmx="160~199" />
      <Function ID="6" Name="WW+RGB" Display="'WW+RGB'" Dmx="200~239" />
      <Function ID="7" Name="WW" Display="'WW'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WW_FX" Name="WW FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CW_FX" Name="CW FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

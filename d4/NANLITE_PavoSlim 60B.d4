    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Param_1" />
      <Function ID="2" Name="Effect" Display="'Effect'" Dmx="64~127" Update="Param_1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Param_1" />
    </Attribute>
    <Attribute ID="Param_1" Name="Param 1" Description="" Group="E">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Condition Name="CCT" ID="1" If="'Mode'==1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SD30000+RGB" ShortName="SD30000+RG" Company="Big Dipper">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-06-17" Author="Nic Morris" Comment="Created (translated from Chinese)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="PRG" Display="'PRG'" Dmx="10~49" Update="Shutter" />
      <Function ID="3" Name="ILD" Display="'ILD'" Dmx="50~99" Update="Shutter" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="100~149" Update="Shutter" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="150~199" Update="Shutter" />
      <Function ID="6" Name="Manual" Display="'Manual'" Dmx="200~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Pattern/Folder" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="PRG/ILD" ID="4" If="'Mode'==2||'Mode'==3" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" />
      <Function ID="4" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="126~185" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="126~185" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Zoom" Display="'No Zoom'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~100" />
      <Function ID="3" Name="Auto +" Display="'Auto + %.f%%',0~100" Dmx="101~150" />
      <Function ID="4" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="1~180" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="181~217" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="218~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Constant" Display="'Constant'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Auto +" Display="'Auto + %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Auto Loop" Display="'Auto Loop %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Bounce +" Display="'Bounce + %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Bounce -" Display="'Bounce - %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Wave" Display="'Wave %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Wave" Display="'Wave %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Highlight" Display="'Highlight'" Dmx="64~127" />
      <Function ID="3" Name="Segment" Display="'Segment'" Dmx="128~191" />
      <Function ID="4" Name="Point" Display="'Point'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="BD30000" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern/Folder" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="X-Move" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Y-Move" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="49" />
      <Attribute ID="X-Rot" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Y-Rot" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Z-Rot" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Drawing" ChannelOffset="10" Wheel="5" />
      <Attribute ID="X-Wave" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Y-Wave" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Display_Mode" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="7" />
      <Attribute ID="Reserved" ChannelOffset="15" Wheel="29" />
      <Attribute ID="Red" ChannelOffset="16" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="17" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="18" Wheel="12" />
    </Include>
  </Mode>
</Fixture>
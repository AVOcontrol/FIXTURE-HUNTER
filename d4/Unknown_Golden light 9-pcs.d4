  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="23-01-25" Author="Nic Morris" Comment="Created (poor documentation.  charts only.  auto functions not documented properly and don't make sense.  no pixel layout or drawings)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="16~214" Update="Auto_Spd" />
      <Function ID="3" Name="Sound 1" Display="'Sound 1'" Dmx="215~218" Update="Auto_Spd" />
      <Function ID="4" Name="Sound 2" Display="'Sound 2'" Dmx="219~237" Update="Auto_Spd" />
      <Function ID="5" Name="Sound 3" Display="'Sound 3'" Dmx="238~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'&gt;2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

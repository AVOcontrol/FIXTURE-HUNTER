      <Function ID="14" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="65~74" WheelPosition="2" />
      <Function ID="15" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="75~84" WheelPosition="3" />

      <Function ID="15" Name="Colour 13" Display="'Colour 13'" Dmx="208~223" WheelPosition="13" />
      <Function ID="16" Name="Colour 14" Display="'Colour 14'" Dmx="224~239" WheelPosition="14" />
      <Function ID="17" Name="Full On" Display="'Full On'" Dmx="240~255" WheelPosition="15" />
      <Function ID="18" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />

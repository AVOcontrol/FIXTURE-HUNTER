<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Freedom Stick" ShortName="Free Stick" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="27-07-16" Author="Nic Morris" Comment="Created" />
  <History Date="15-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e8fef1f3-edc3-4361-bb69-c0fad31a01b7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="Colour 1" Display="'Colour 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="Colour 2" Display="'Colour 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="Colour 3" Display="'Colour 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="Colour 4" Display="'Colour 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="Colour 5" Display="'Colour 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="Colour 6" Display="'Colour 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="Colour 7" Display="'Colour 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="Colour 8" Display="'Colour 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="Colour 9" Display="'Colour 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="Colour 10" Display="'Colour 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="Colour 11" Display="'Colour 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~18" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="19~26" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="27~34" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="35~42" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="43~50" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="51~58" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="59~66" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="67~74" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="75~82" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="83~90" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="91~98" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="99~106" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="107~114" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="115~122" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="123~130" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="131~138" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 17" Display="'Auto 17'" Dmx="139~146" Update="Auto_Spd" />
      <Function ID="19" Name="Auto 18" Display="'Auto 18'" Dmx="147~154" Update="Auto_Spd" />
      <Function ID="20" Name="Auto 19" Display="'Auto 19'" Dmx="155~162" Update="Auto_Spd" />
      <Function ID="21" Name="Auto 20" Display="'Auto 20'" Dmx="163~170" Update="Auto_Spd" />
      <Function ID="22" Name="Auto 21" Display="'Auto 21'" Dmx="171~178" Update="Auto_Spd" />
      <Function ID="23" Name="Auto 22" Display="'Auto 22'" Dmx="179~186" Update="Auto_Spd" />
      <Function ID="24" Name="Auto 23" Display="'Auto 23'" Dmx="187~194" Update="Auto_Spd" />
      <Function ID="25" Name="Auto 24" Display="'Auto 24'" Dmx="195~202" Update="Auto_Spd" />
      <Function ID="26" Name="Auto 25" Display="'Auto 25'" Dmx="203~210" Update="Auto_Spd" />
      <Function ID="27" Name="Auto 26" Display="'Auto 26'" Dmx="211~218" Update="Auto_Spd" />
      <Function ID="28" Name="Auto 27" Display="'Auto 27'" Dmx="219~226" Update="Auto_Spd" />
      <Function ID="29" Name="Auto 28" Display="'Auto 28'" Dmx="227~234" Update="Auto_Spd" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="235~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2,3" If="'Auto'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

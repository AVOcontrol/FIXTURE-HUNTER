      <Condition Name="Index" ID="22" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="23,24,25,26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="131~133" WheelPosition="1" Colour="0,0,0" />

    </Attribute>
    <Attribute ID="Plate_Shutter" Name="Plate Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="28-08-07" Author="D.Milligan" Comment="Created" />
  <History Date="28-08-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-09-11" Author="Nic Morris" Comment="Added v-dim to 3 DMX mode.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Fixed power on and locate." />
  <History Date="14-02-12" Author="Peter Budd" Comment="Edited added Cell used for 11ch mode, changed second dimmer to colour macro." />
  <History Date="14-01-13" Author="Peter Budd" Comment="Created from American DJ Mega Bar LED" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="18-12-16" Author="Nic Morris" Comment="Added Atlabase ID to 3 DMX mode.  Added master dimmer to 11 DMX mode and changed cells to use vdim." />
  <History Date="20-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to 2, 6 and 7 DMX modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a0ba02a1-953b-4df0-b662-6a5903bb33ed" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="31~45" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="46~60" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="61~75" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="76~90" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="91~105" />
      <Function ID="8" Name="White" Display="'White'" Dmx="106~120" />
      <Function ID="9" Name="Col Change" Display="'Col Change'" Dmx="121~135" />
      <Function ID="10" Name="Col Flow" Display="'Col Flow'" Dmx="136~150" />
      <Function ID="11" Name="Col Dream" Display="'Col Dream'" Dmx="151~165" />
      <Function ID="12" Name="Multi Col" Display="'Multi Col'" Dmx="166~180" />
      <Function ID="13" Name="Dream Flow" Display="'Dream Flow'" Dmx="181~195" />
      <Function ID="14" Name="2 Col Flow" Display="'2 Col Flow'" Dmx="196~210" />

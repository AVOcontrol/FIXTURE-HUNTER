    </Attribute>
    <Attribute ID="ColourMacro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Dim-Bright" Display="'Dim-Bright'" Dmx="37~72" Colour="0,0,0" />
      <Function ID="3" Name="Bright-Dim" Display="'Bright-Dim'" Dmx="73~108" Colour="0,0,0" />
      <Function ID="4" Name="D-B-D" Display="'D-B-D'" Dmx="109~144" Colour="0,0,0" />
      <Function ID="5" Name="Col Mixing" Display="'Col Mixing'" Dmx="145~180" Colour="0,0,0" />
      <Function ID="6" Name="3 Col Change" Display="'3 Col Change'" Dmx="181~216" Colour="0,0,0" />
      <Function ID="7" Name="7 Col Change" Display="'7 Col Change'" Dmx="217~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COB-4BAR" ShortName="COB-4BAR" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="01-11-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Effect" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Col Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Effect" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Col Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==30" />
      <Condition Name="18 DMX" ID="3,4,5,6,7" If="'Dummy'==1" />
      <Condition Name="Speed" ID="8" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="8~190" />
      <Function ID="4" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="6" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="191~200" />
      <Function ID="8" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~47" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="48~55" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="56~63" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="64~71" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Colour Fade" Display="'Colour Fade'" Dmx="136~143" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Chase 1" Display="'Chase 1'" Dmx="144~151" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Chase 2" Display="'Chase 2'" Dmx="152~159" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Chase 3" Display="'Chase 3'" Dmx="160~167" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Chase 4" Display="'Chase 4'" Dmx="168~175" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Chase 5" Display="'Chase 5'" Dmx="176~183" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Chase 6" Display="'Chase 6'" Dmx="184~191" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Chase 7" Display="'Chase 7'" Dmx="192~199" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Chase 8" Display="'Chase 8'" Dmx="200~207" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Chase 9" Display="'Chase 9'" Dmx="208~215" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Chase 10" Display="'Chase 10'" Dmx="216~223" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Chase 11" Display="'Chase 11'" Dmx="224~231" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Chase 12" Display="'Chase 12'" Dmx="232~239" Update="Red, Green, Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Red, Green, Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Power_Out_1" Name="Power Out 1" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Power_Out_2" Name="Power Out 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dummy" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="68~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="8~37" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="38~67" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fade Spd" Display="'Fade Spd %.1f%%',0.0~100.0" Dmx="8~247" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="JBC4BAR3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

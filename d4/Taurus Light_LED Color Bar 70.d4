<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Color Bar 70" ShortName="Col Bar 70" Company="Taurus Light" Version="9">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>601621b6-d7fe-4b8e-ad7e-cf53e402a518</Thumbnail>
  <History Date="19-01-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="31-01-18" Author="Nic Morris" Comment="Added 9, 15, 180 and 190 channel modes." Version="2" />
  <History Date="31-01-18" Author="Nic Morris" Comment="Note documentation is poor and littered with errors (particularly channel offsets and counts) and has no pixel layout information.  Made best guess" Version="3" />
  <History Date="01-02-18" Author="Nic Morris" Comment="Added Atlabase ID's to 9, 15 and 190 channel modes.  Removed the 180 channel mode." Version="4" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Revised in attempt to improve pixel mapper compatibility in response to customer bug report." Version="5" />
  <History Date="05-09-18" Author="Nic Morris" Comment="Created from Taurus LED Color Bar 70.  Presumably the same fixture but charts are different (original was definitely working for customer)" Version="6" />
  <History Date="06-09-18" Author="Nic Morris" Comment="Corrected manufacturer name." Version="7" />
  <History Date="29-09-20" Author="Nic Morris" Comment="Merged in Taurus LED Color Bar 70 and added Atlabase ID's." Version="8" />
  <History Date="30-09-20" Author="Nic Morris" Comment="Swapped 190 DMX mode Atlabase ID's (was a 50-50 chance!)" Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ae49869d-e56b-4dd9-b20f-b529fb2df7eb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

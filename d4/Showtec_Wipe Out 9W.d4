    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="20~29" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="30~39" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="40~49" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="50~59" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="60~69" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="70~79" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="80~89" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="90~99" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="100~109" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="110~119" />
      <Function ID="12" Name="Off" Display="'Off'" Dmx="120~139" />
      <Function ID="13" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" />
    </Attribute>
  </Control>

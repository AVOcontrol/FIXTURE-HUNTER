<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="APD-1-300-ENC-DMX" ShortName="APD1300ENC" Company="Abstract" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="10-06-25" Author="Nic Morris" Comment="Created (effects are only partially documented which means it is not possible to implement the speed controls as they have depenencies on functions that are not defined)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Solid" Display="'Solid'" Dmx="0~0" />
      <Function ID="2" Name="Sparkle" Display="'Sparkle'" Dmx="16~31" />
      <Function ID="3" Name="Blocks" Display="'Blocks'" Dmx="32~47" />
      <Function ID="4" Name="Comet" Display="'Comet'" Dmx="48~63" />
      <Function ID="5" Name="Rain" Display="'Rain'" Dmx="64~79" />
      <Function ID="6" Name="Flame" Display="'Flame'" Dmx="80~95" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="224~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Length" Name="Length" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Multiple" Name="Multiple" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blur/Fade" Name="Blur/Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Modify" Name="Colour Modify" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spread" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Undefined" Display="'Undefined'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="8~127" Colour="0,0,0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Mix_Mode" Name="Mix Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Layer Overlay" Display="'Layer Overlay'" Dmx="0~0" />
      <Function ID="2" Name="Mix" Display="'Mix'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

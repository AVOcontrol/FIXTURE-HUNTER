<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HighBeam" ShortName="HighBeam" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5be7a15d-4352-412c-9137-d33434ef81e3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="151~160" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="161~170" Colour="255,255,255" />
      <Function ID="17" Name="Macro 1" Display="'Macro 1'" Dmx="171~180" Colour="255,255,255" />
      <Function ID="18" Name="Macro 2" Display="'Macro 2'" Dmx="181~190" Colour="255,255,255" />
      <Function ID="19" Name="Macro 3" Display="'Macro 3'" Dmx="191~200" Colour="255,255,255" />
      <Function ID="20" Name="Macro 4" Display="'Macro 4'" Dmx="201~210" Colour="255,255,255" />
      <Function ID="21" Name="Macro 5" Display="'Macro 5'" Dmx="211~220" Colour="255,255,255" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="32-Bit_Dimmer" Name="32-Bit Dimmer" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Mode 0" Display="'Mode 0'" Dmx="6~55" />
      <Function ID="3" Name="Mode 1" Display="'Mode 1'" Dmx="56~105" />
      <Function ID="4" Name="Mode 2" Display="'Mode 2'" Dmx="106~155" />
      <Function ID="5" Name="Mode 3" Display="'Mode 3'" Dmx="156~205" />
      <Function ID="6" Name="Mode 4" Display="'Mode 4'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Enhanced Pixel, 20 DMX" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2ed0f7c2-8086-40bf-ac77-b7ddc8629d64" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="7" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="18" Wheel="4" />
        <Attribute ID="Colour_Macro" ChannelOffset="19" Wheel="9" />
        <Attribute ID="32-Bit_Dimmer" ChannelOffset="20" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="14" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

      <Function ID="5" Name="4000Hz" Display="'4000Hz'" Dmx="145~180" />
      <Function ID="6" Name="16KHz" Display="'16KHz'" Dmx="181~216" />
      <Function ID="7" Name="18KHz" Display="'18KHz'" Dmx="217~255" />

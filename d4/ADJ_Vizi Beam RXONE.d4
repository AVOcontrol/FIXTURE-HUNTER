      <Else ID="35" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~6" WheelPosition="1" Colour="255,0,0" />

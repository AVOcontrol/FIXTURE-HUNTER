      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="80~89" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="90~99" />
      <Function ID="6" Name="Reset Colour" Display="'Reset Colour'" Dmx="100~109" />
      <Function ID="7" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="110~119" />
      <Function ID="8" Name="Reset Int" Display="'Reset Int'" Dmx="120~129" />
      <Function ID="9" Name="Reset Other" Display="'Reset Other'" Dmx="130~139" />
      <Function ID="10" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="140~149" />
      <Function ID="11" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="150~159" />
      <Function ID="12" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="160~169" />
      <Function ID="13" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="170~179" />
      <Function ID="14" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="180~189" />
      <Function ID="15" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="190~199" />
      <Function ID="16" Name="Reset System" Display="'Reset System'" Dmx="200~219" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Pan, Tilt" />
    </Attribute>
  </Control>

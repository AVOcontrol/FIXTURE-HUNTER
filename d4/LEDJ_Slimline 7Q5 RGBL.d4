    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
    </Attribute>
  </Control>

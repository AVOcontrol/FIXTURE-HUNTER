      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="31~35" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="36~40" Colour="255,0,255" />
      <Function ID="9" Name="Amber" Display="'Amber'" Dmx="41~45" Colour="255,100,0" />
      <Function ID="10" Name="Bright Green" Display="'Bright Green'" Dmx="46~50" Colour="0,255,0" />
      <Function ID="11" Name="Lilac" Display="'Lilac'" Dmx="51~55" Colour="180,0,180" />
      <Function ID="12" Name="Lavender" Display="'Lavender'" Dmx="56~60" Colour="255,128,255" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="61~65" Colour="255,255,0" />

  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="CH_6Spot" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Colour3" ChannelOffset="3" Wheel="37" />
      <Attribute ID="Colour4" ChannelOffset="4" Wheel="38" />

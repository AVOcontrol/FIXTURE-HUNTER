<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Beamer 6 FX" ShortName="Beamer6 FX" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>d666732c-6229-4549-8b87-17e954c79352</Thumbnail>
  <History Date="26-03-18" Author="Nic Morris" Comment="Created (note there is no open or closed strobe range)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Beam_Colour" Name="Beam Colour" Description="" Group="C">
      <Locate Locate="5:100" PowerOn="5:100" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red %.f%%',0~100" Dmx="4~66" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="67~129" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="130~192" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White %.f%%',0~100" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Beam Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Strobe" Name="Beam Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="0~80" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="81~160" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~240" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="SMD_Strobe" Name="SMD Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="SMD_Strobe_Spd" Name="SMD Strobe Spd" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser_Pattern" Name="Laser Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" />
      <Function ID="4" Name="R+G" Display="'R+G'" Dmx="90~129" />
      <Function ID="5" Name="Red On+Green Strobe" Display="'Red On+Green Strobe'" Dmx="130~169" />
      <Function ID="6" Name="Green On+Red Strobe" Display="'Green On+Red Strobe'" Dmx="170~209" />
      <Function ID="7" Name="Red+Green (Alternate Strobe)" Display="'Red+Green (Alternate Strobe)'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~254" WheelPosition="0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Beams Only" Display="'Beams Only'" Dmx="6~41" />
      <Function ID="3" Name="Laser Only" Display="'Laser Only'" Dmx="42~77" />
      <Function ID="4" Name="Strobe Only" Display="'Strobe Only'" Dmx="78~113" />
      <Function ID="5" Name="Beams/ Laser" Display="'Beams/ Laser'" Dmx="114~149" />
      <Function ID="6" Name="Beams/ Strobe" Display="'Beams/ Strobe'" Dmx="150~185" />
      <Function ID="7" Name="Laser/ Strobe" Display="'Laser/ Strobe'" Dmx="186~221" />
      <Function ID="8" Name="Beams/ Laser/ Strobe" Display="'Beams/ Laser/ Strobe'" Dmx="222~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.f%%',0~100" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Beam_Colour" Wheel="7" />
        <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
        <Attribute ID="Beam_Strobe" ChannelOffset="8" Wheel="4" />
        <Attribute ID="SMD_Strobe" ChannelOffset="9" Wheel="5" />
        <Attribute ID="SMD_Strobe_Spd" ChannelOffset="10" Wheel="6" />
        <Attribute ID="Laser_Pattern" ChannelOffset="11" Wheel="13" />
        <Attribute ID="Laser_Strobe" ChannelOffset="12" Wheel="14" />
        <Attribute ID="Laser_Rot" ChannelOffset="13" Wheel="15" />
        <Attribute ID="Program" ChannelOffset="14" Wheel="22" />
        <Attribute ID="Program_Spd" ChannelOffset="15" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="3" Y="0">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="4" Y="2">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="1" Y="4">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="3" Y="4">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="CHBM6FX2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Beam_Colour" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>

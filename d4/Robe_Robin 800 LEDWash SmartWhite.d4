  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="21075" ModelID="137" />
  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="5" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="6" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="7" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="8" Name="Theatre ON" Display="'Theatre ON'" Dmx="90~99" />
      <Function ID="9" Name="Theatre OFF" Display="'Theatre OFF'" Dmx="100~109" />
      <Function ID="10" Name="Zoom Wash" Display="'Zoom Wash'" Dmx="110~114" />
      <Function ID="11" Name="Zoom Beam" Display="'Zoom Beam'" Dmx="115~119" />
      <Function ID="12" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="13" Name="Reset Beam" Display="'Reset Beam'" Dmx="180~179" />
      <Function ID="14" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="15" Name="Silent Fan OFF" Display="'Silent Fan OFF'" Dmx="240~240" />
      <Function ID="16" Name="Silent Fan" Display="'Silent Fan %.f%%',0~100" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="1~2" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="3~4" />
      <Function ID="4" Name="3800K" Display="'3800K'" Dmx="5~6" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="7~8" />
      <Function ID="6" Name="4600K" Display="'4600K'" Dmx="9~10" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="11~12" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="13~14" />
      <Function ID="9" Name="6300K" Display="'6300K'" Dmx="15~16" />
      <Function ID="10" Name="CTO" Display="'CTO %.1f%%',0.0~100.0" Dmx="17~247" />
      <Function ID="11" Name="Rainbow Effect w/time" Display="'Rainbow Effect w/time'" Dmx="248~248" />
      <Function ID="12" Name="Rainbow Effect" Display="'Rainbow Effect'" Dmx="249~249" />
      <Function ID="13" Name="Zone Effect 1" Display="'Zone Effect 1'" Dmx="250~250" />
      <Function ID="14" Name="Zone Effect 2" Display="'Zone Effect 2'" Dmx="251~251" />
      <Function ID="15" Name="Zone Effect 3" Display="'Zone Effect 3'" Dmx="252~252" />
      <Function ID="16" Name="Zone Effect 4" Display="'Zone Effect 4'" Dmx="253~253" />
      <Function ID="17" Name="Zone Effect 5" Display="'Zone Effect 5'" Dmx="254~254" />
      <Function ID="18" Name="Zone Effect 6" Display="'Zone Effect 6'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Beam_Shaper" Name="Beam Shaper" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strb All Zone" Display="'Strb All Zone %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Strb Zone 3" Display="'Strb Zone 3 %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="5" Name="Rnd Zone" Display="'Rnd Zone %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strb+Zone" Display="'Rnd Strb+Zone %.f%%',0~100" Dmx="176~191" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strb" Display="'Rnd Strb %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="8" Name="FX Spd Fwd" Display="'FX Spd Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="9" Name="FX Spd Rev" Display="'FX Spd Rev %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
      <Function ID="10" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="11" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cool_White" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

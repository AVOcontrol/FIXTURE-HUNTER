      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="89~128" />
      <Function ID="8" Name="Spikers" Display="'Spikers %.f%%',0~100" Dmx="215~254" />
    </Attribute>
    <Attribute ID="Strip_FX" Name="Strip FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Horizontal Chase" Display="'Horizontal Chase'" Dmx="5~9" />
      <Function ID="3" Name="Bipolar Alternate" Display="'Bipolar Alternate'" Dmx="10~14" />
      <Function ID="4" Name="Ping Pong" Display="'Ping Pong'" Dmx="15~19" />
      <Function ID="5" Name="Inside OUT" Display="'Inside OUT'" Dmx="20~24" />
      <Function ID="6" Name="Outside IN" Display="'Outside IN'" Dmx="25~29" />
      <Function ID="7" Name="Sparkle" Display="'Sparkle'" Dmx="30~34" />
      <Function ID="8" Name="Snake" Display="'Snake'" Dmx="35~39" />
      <Function ID="9" Name="Wave" Display="'Wave'" Dmx="40~44" />
      <Function ID="10" Name="Block Flash" Display="'Block Flash'" Dmx="45~49" />
      <Function ID="11" Name="Volume Meter" Display="'Volume Meter'" Dmx="50~54" />
      <Function ID="12" Name="Scroll Loop" Display="'Scroll Loop'" Dmx="55~59" />
      <Function ID="13" Name="Explosion" Display="'Explosion'" Dmx="60~64" />
      <Function ID="14" Name="Double Wave" Display="'Double Wave'" Dmx="65~69" />
      <Function ID="15" Name="Horizontal Chase Inverted" Display="'Horizontal Chase Inverted'" Dmx="75~79" />
      <Function ID="16" Name="Bipolar Alternate Inverted" Display="'Bipolar Alternate Inverted'" Dmx="80~84" />
      <Function ID="17" Name="Ping Pong Inverted" Display="'Ping Pong Inverted'" Dmx="85~89" />
      <Function ID="18" Name="Inside OUT Inverted" Display="'Inside OUT Inverted'" Dmx="90~94" />
      <Function ID="19" Name="Outside IN Inverted" Display="'Outside IN Inverted'" Dmx="95~99" />
      <Function ID="20" Name="Sparkle Inverted" Display="'Sparkle Inverted'" Dmx="100~104" />
      <Function ID="21" Name="Snake Inverted" Display="'Snake Inverted'" Dmx="105~109" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DLED7N-C" ShortName="DLED7N-C" Company="Dedolight" Version="52">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>e6297cbc-d460-4817-98bf-7b93327a8338</Thumbnail>
  <History Date="21-05-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="05-10-16" Author="Peter Budd" Comment="Changed the name to the fixture name, corrected Mode 6." Version="2" />
  <History Date="16-12-16" Author="Nic Morris" Comment="Updated to firmware v2.5 specs." Version="3" />
  <History Date="04-02-17" Author="Nic Morris" Comment="Changed name from SkyPanel S60-C to SkyPanel S60-C (v4.x)" Version="4" />
  <History Date="04-02-17" Author="Nic Morris" Comment="Harmonised Xfade to Col across range.  Added highlight/lowlight." Version="5" />
  <History Date="17-02-17" Author="Nic Morris" Comment="Exported R20 modes 17,18 and 19." Version="6" />
  <History Date="03-05-17" Author="Nic Morris" Comment="Updated to v4.3 specs (revised Grn/Mag Point ranges, added 'Preset' control and modes 20-23)" Version="7" />
  <History Date="19-10-17" Author="Nic Morris" Comment="Revised mode names.  Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." Version="8" />
  <History Date="19-10-17" Author="Nic Morris" Comment="Split into two colour temp versions for Capture.  Added Atlabase ID's to modes 1-15." Version="9" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated existing (not sure why they changed) and added remaining Atlabase ID's." Version="10" />
  <History Date="19-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Added raw range and discreet functions to GN Saturation based on customer feedback." Version="11" />
  <History Date="19-02-18" Author="Nic Morris" Comment="Added discreet functions to Xfade to Col and Xfade to go straight to full CCT or RGBW and 1/2 respectively." Version="12" />
  <History Date="19-02-18" Author="Nic Morris" Comment="Changed CTC to a custom range and added discreet functions for popular colour temperatures based on customer feedback." Version="13" />
  <History Date="19-02-18" Author="Nic Morris" Comment="Revised wheel mapping." Version="14" />
  <History Date="15-04-18" Author="Nic Morris" Comment="Updated to protocol spec V4.4 (04/2018):" Version="15" />
  <History Date="15-04-18" Author="Nic Morris" Comment="(added extended modes and modes 24-31. added new FX.  Changed reserved channel to shutter except in FX modes)" Version="16" />
  <History Date="15-04-18" Author="Nic Morris" Comment="(Minor revision to gel col match ranges.  Revisions to fan speed ranges)" Version="17" />
  <History Date="15-04-18" Author="Nic Morris" Comment="Revised with relevant xfade options for X/Y and cat/source.  Fixed typo in source function." Version="18" />
  <History Date="15-04-18" Author="Nic Morris" Comment="Note that the 'Ultimate' modes are not currently compatible with the colour picker." Version="19" />
  <History Date="17-04-18" Author="Nic Morris" Comment="Created from Arri Lighting SkyPanel S60-C 3200K (v4.x)" Version="20" />
  <History Date="28-04-18" Author="Nic Morris" Comment="Added remaining Atlabase ID's." Version="21" />
  <History Date="01-11-18" Author="Nic Morris" Comment="Changed x and y coordinate display range to 0-65535 for maximum precision." Version="22" />
  <History Date="01-11-18" Author="Nic Morris" Comment="Changed xfade x/y function names from x/y to 1/2" Version="23" />
  <History Date="26-11-20" Author="Nic Morris" Comment="Added xfade value to highlight and lowlight." Version="24" />
  <History Date="15-05-21" Author="Nic Morris" Comment="Changed XY display range to 0-&gt;80000 in response to customer feedback (in lieu of floating point range values which are not currently compatible)" Version="25" />
  <History Date="02-10-21" Author="Nic Morris" Comment="Changed hue display from percentage to degrees." Version="26" />
  <History Date="25-04-22" Author="Nic Morris" Comment="Created from Arri Lighting SkyPanel S30-C (v4.x)" Version="27" />
  <History Date="28-04-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="44" />
  <History Date="01-05-24" Author="Nic Morris" Comment="Created from Prolycht Orion 300 FS (much of the documentation appears to have been copied straight from ARRI)" Version="45" />
  <History Date="02-05-24" Author="Nic Morris" Comment="Added missing Atlabase ID's for modes 24-27." Version="52" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fdc2c1ca-3734-4de4-94ac-dca95058e8e0" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:1800" PowerOn="1:1800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',1800~20000" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>

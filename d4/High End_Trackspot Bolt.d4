      <Function ID="8" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="224~255" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />

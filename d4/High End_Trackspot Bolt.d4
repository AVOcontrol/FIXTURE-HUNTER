      <Function ID="2" Name="MSpeed" Display="'MSpeed %.1f%%',100.0~0.0" Dmx="4~255" Update="Colour1Func, Colour1, Gobo1Func, Gobo1, Gobo2Func, Gobo2, Gobo2RotFunc, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~5" />

      <Function ID="8" Name="Blink" Display="'Blink'" Dmx="112~127" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Fixed" Display="'Fixed'" Dmx="128~143" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW'" Dmx="144~159" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

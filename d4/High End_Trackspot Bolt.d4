    <Attribute ID="Gobo2RotFunc" Name="Gobo2Rot Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Full Speed" ID="1,2,3,4,5,6,7" If="'PT_Speed'==1" />
      <Else ID="8,9,10,11,12,13,14" />

      <Function ID="8" Name="Fixed" Display="'Fixed'" Dmx="128~143" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Spin CW" Display="'Spin CW'" Dmx="144~159" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Spin CCW" Display="'Spin CCW'" Dmx="160~175" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Blink" Display="'Blink'" Dmx="176~191" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Animate Spin CW" Display="'Animate Spin  CW'" Dmx="192~207" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Animate Spin CCW" Display="'Animate Spin  CCW'" Dmx="208~223" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Gobo2RotFunc'==1||'Gobo2RotFunc'==4||'Gobo2RotFunc'==8||'Gobo2RotFunc'==11" />
      <Condition Name="Spin" ID="2,3" If="'Gobo2RotFunc'==2||'Gobo2RotFunc'==3||'Gobo2RotFunc'==5||'Gobo2RotFunc'==6||'Gobo2RotFunc'==9||'Gobo2RotFunc'==10||'Gobo2RotFunc'==12||'Gobo2RotFunc'==13" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />

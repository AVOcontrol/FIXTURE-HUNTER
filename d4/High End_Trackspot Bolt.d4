      <Function ID="14" Name="Slow Shake" Display="'Slow Shake'" Dmx="192~207" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Fast Shake" Display="'Fast Shake'" Dmx="208~223" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Random" Display="'Random'" Dmx="224~239" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

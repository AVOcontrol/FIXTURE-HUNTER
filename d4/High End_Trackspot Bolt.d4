      <Function ID="5" Name="Animate Spin CW" Display="'Animate Spin  CW'" Dmx="64~95" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Animate Spin CCW" Display="'Animate Spin  CCW'" Dmx="80~127" Update="Gobo2Rot1" GoboSpin="0~0" GoboOrientation="0~0" />

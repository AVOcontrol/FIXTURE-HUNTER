    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Gobo" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==4||'Gobo1Func'==5||'Gobo1Func'==6||'Gobo1Func'==8||'Gobo1Func'==10||'Gobo1Func'==13||'Gobo1Func'==14||'Gobo1Func'==15||'Gobo1Func'==17" />
      <Condition Name="Scroll CW" ID="9,10" If="'Gobo1Func'==2||'Gobo1Func'==3||'Gobo1Func'==7||'Gobo1Func'==11||'Gobo1Func'==12||'Gobo1Func'==16" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~31" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="32~63" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CS-1000RGB MKII" ShortName="CS-1KRGBv2" Company="Laserworld" Version="3">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>fde30780-3aa6-489d-a588-942a3699a13f</Thumbnail>
  <History Date="06-06-19" Author="Nic Morris" Comment="Created (could not find anything that said MKII explicitly but German section of manual has 'Manual:Club Serier MKII' in the page headers)" Version="1" />
  <History Date="06-06-19" Author="Nic Morris" Comment="(very poor documentation - channels only, no ranges)" Version="2" />
  <History Date="17-10-21" Author="Nic Morris" Comment="Added function ranges in line with 08/2015 manual (a later version of the manual does not contain these)." Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="62~129" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="130~189" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Circular_Move" Name="Circular Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~161" />
      <Function ID="2" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="162~243" />
      <Function ID="3" Name="CW Slow" Display="'CW Slow'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Y_Rot" Name="Y Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="161~243" />
      <Function ID="3" Name="CW Slow" Display="'CW Slow'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="X_Rot" Name="X Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="161~243" />
      <Function ID="3" Name="CW Slow" Display="'CW Slow'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Horiz Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="L-&gt;R" Display="'L-&gt;R %.f%%',0~100" Dmx="161~243" />
      <Function ID="3" Name="L-R Slow" Display="'L-R Slow'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Vert Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="Top Down" Display="'Top Down %.f%%',0~100" Dmx="129~193" />
      <Function ID="3" Name="Top Down Left Slow" Display="'Top Down Left Slow'" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="0~80" />
      <Function ID="2" Name="Auto Out" Display="'Auto Out %.f%%',0~100" Dmx="81~161" />
      <Function ID="3" Name="In" Display="'In %.f%%',0~100" Dmx="162~243" />
      <Function ID="4" Name="In Slow" Display="'In Slow'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Patt_Buildup" Name="Patt Buildup" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dot_FX+Strobe" Name="Dot FX+Strobe" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Movement" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Multicolour Effect" Display="'Multicolour Effect'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="31~62" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="63~94" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="95~126" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="127~156" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="157~190" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="191~219" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="220~254" Colour="128,0,255" />
      <Function ID="9" Name="Auto Col Change" Display="'Auto Col Change'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Circular_Move" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Y_Rot" ChannelOffset="4" Wheel="21" />
      <Attribute ID="X_Rot" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Pan" ChannelOffset="6" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="7" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="49" />
      <Attribute ID="Patt_Buildup" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Dot_FX+Strobe" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Multicolour Effect" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:3" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:3" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:6" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:8" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:8" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:8" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="fde30780-3aa6-489d-a588-942a3699a13f"></Swatch>

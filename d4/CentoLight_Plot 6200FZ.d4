    <AtlaBase ModeID="95e954e8-6620-41f4-a053-156e13250f3e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="7" />
      <Attribute ID="CCT/Colour" ChannelOffset="3" Wheel="8" />

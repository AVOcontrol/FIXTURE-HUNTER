<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot HPE 700" ShortName="AlpHPE700" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>522bf202-72a2-49b0-886f-a068cb8f448f</Thumbnail>
  <History Date="07-04-09" Author="David Hunt" Comment="Created" />
  <History Date="14-05-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="09-06-09" Author="David Hunt" Comment="Updated Shutter and Colour channels" />
  <History Date="08-06-10" Author="John Rogers" Comment="Edited 16bit Gobo Rotation functions to the appropriate number of decimal places." />
  <History Date="02-02-11" Author="John Rogers" Comment="Edited Reset in response to Clay Paky tech update." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="01-05-12" Author="Peter Budd" Comment="Edited colour index to percentage 1dp" />
  <History Date="22-10-12" Author="Peter Budd" Comment="Edited timing channels to conform better with the manual. Timed for attributes. Added macros. Some general naming updates and tested with fixture." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-06-16" Author="Nic Morris" Comment="Changed Atlabase modes from RGB to CMY." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Changed name from Alpha Spot 700 HPE to Alpha Spot HPE 700.  Added function index." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Increased wheel resolution.  Revised colour index DMX ranges for full field control." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Standardised shutter.  Standardised conditionals.  Revised function control." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Renamed gobo 2 reset functions.  Inverted zoom.  Recreated palettes." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added RDM ID's.  Added product thumbnail." />
  <Manual Filename="" Summary="" />

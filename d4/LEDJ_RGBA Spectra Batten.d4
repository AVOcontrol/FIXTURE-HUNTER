<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RGBA Spectra Batten" ShortName="RGBA Sp Bt" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-12-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-01-17" Author="Nic Morris" Comment="Added Atlabase ID to 4 DMX mode.  Changed 19 DMX mode colour macro channel to locate in multi cell mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="39a305cd-9eee-4973-a16b-305cbf3eab2a" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="Single" Display="'Single'" Dmx="6~10" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="Multi" Display="'Multi'" Dmx="11~15" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="4" Name="R" Display="'R'" Dmx="16~20" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="5" Name="G" Display="'G'" Dmx="21~25" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="6" Name="B" Display="'B'" Dmx="26~30" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="7" Name="A" Display="'A'" Dmx="31~35" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="8" Name="RA" Display="'RA'" Dmx="36~40" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="9" Name="RG" Display="'RG'" Dmx="41~45" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="RB" Display="'RB'" Dmx="46~50" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="11" Name="GB" Display="'GB'" Dmx="51~55" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="12" Name="AB" Display="'AB'" Dmx="56~60" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="13" Name="AG" Display="'AG'" Dmx="61~65" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="14" Name="RGB" Display="'RGB'" Dmx="66~70" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="15" Name="RGA" Display="'RGA'" Dmx="71~75" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="16" Name="RBA" Display="'RBA'" Dmx="76~80" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="17" Name="GBA" Display="'GBA'" Dmx="81~85" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="18" Name="RGBA" Display="'RGBA'" Dmx="86~90" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="19" Name="Jump" Display="'Jump'" Dmx="91~100" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="20" Name="Fade" Display="'Fade'" Dmx="101~110" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="21" Name="Dreaming" Display="'Dreaming'" Dmx="111~120" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="22" Name="Col Flow" Display="'Col Flow'" Dmx="121~130" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="23" Name="Overlap Flow" Display="'Overlap Flow'" Dmx="131~140" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="24" Name="Chase" Display="'Chase'" Dmx="141~150" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="25" Name="Multi" Display="'Multi'" Dmx="151~160" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="26" Name="Fade Flow" Display="'Fade Flow'" Dmx="161~170" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="27" Name="Two Flow" Display="'Two Flow'" Dmx="171~180" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="28" Name="One Way" Display="'One Way'" Dmx="181~190" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="29" Name="Two Way" Display="'Two Way'" Dmx="191~200" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="30" Name="Two Col" Display="'Two Col'" Dmx="201~210" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="31" Name="Sound" Display="'Sound'" Dmx="211~255" Update="Dimmer, Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;3&amp;&amp;'Colour_Macro'&lt;31" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==31" />
      <Condition Name="2 DMX" ID="4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~240" Intensity="0~0" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="241~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;26&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.f%%',0~100" Dmx="5~80" Colour="255,255,255" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="81~150" Colour="255,255,255" />
      <Function ID="4" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="151~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="LJRGBAB2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

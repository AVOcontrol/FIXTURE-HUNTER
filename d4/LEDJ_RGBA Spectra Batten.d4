    <AtlaBase ModeID="75b05989-92b6-49f9-8638-152e3355720c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro1" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Dummy" Wheel="28" />
    </Include>
  </Mode>

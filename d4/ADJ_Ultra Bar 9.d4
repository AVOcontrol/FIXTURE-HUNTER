      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="206~215" Update="Speed" />
      <Function ID="22" Name="Program 21" Display="'Program 21'" Dmx="216~225" Update="Speed" />
      <Function ID="23" Name="Program 22" Display="'Program 22'" Dmx="226~235" Update="Speed" />
      <Function ID="24" Name="Auto" Display="'Auto'" Dmx="236~245" Update="Speed" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="246~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Program'==25" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

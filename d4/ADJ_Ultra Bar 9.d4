      <Function ID="23" Name="Program 22" Display="'Program 22'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" Update="Speed" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~25" Update="Speed" />

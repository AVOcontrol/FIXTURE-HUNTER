<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Outdoor Washer 60 (LOW60)" ShortName="OD Wash 60" Company="Taurus Light">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ecaad91b-49ef-4c9a-bb2b-d89022dd0699</Thumbnail>
  <History Date="29-05-19" Author="Nic Morris" Comment="Created (poor documentation.  charts contain range conflicts and errors.  note channel counts in charts don't agree with specs on product webpage)" />
  <History Date="31-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c42780cf-3998-4a92-9615-95aaf0968999" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="Red+Green" Display="'Red+Green'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="Green+Blue" Display="'Green+Blue'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="101~150" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="151~200" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="17e6660e-e505-4059-ac46-3c9558f45f24" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a1add94f-5ac7-4f38-ae07-ed8027a452f3" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="40" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="63d4fb6f-2ca7-47c2-abc8-da366a249f22" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="9" Wheel="23" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

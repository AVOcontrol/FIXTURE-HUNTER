  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="4" />
  <History Date="17-07-16" Author="Nic Morris" Comment="Fixed Mode 1 colour and gobo updates.  Added function index to colour.  Fixed gobo function index." Version="5" />
  <History Date="17-07-16" Author="Nic Morris" Comment="Revised Atlabase Fixture ID and added missing Atlabase mode ID's." Version="6" />
  <History Date="17-07-16" Author="Nic Morris" Comment="Changed shutter to locate at 255 so that it works with Capture." Version="7" />
  <History Date="16-10-25" Author="Nic Morris" Comment="Created from ACME XP-5R Beam (poor documentation.  colour and gobo wheel are missing slot numbers and too low resolution to be used)" Version="8" />
  <History Date="18-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="12" />

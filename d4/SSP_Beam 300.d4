    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Colour1Func1'==1" />
      <Condition Name="Scroll" ID="2,3,4,5" If="'Colour1Func1'==2" />

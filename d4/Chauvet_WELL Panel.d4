  <AtlaBase TypeID="83a40205-a4ec-45d5-9936-ba55665a9519" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Colour Temp 1" Display="'Colour Temp 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="Colour Temp 2" Display="'Colour Temp 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="Colour Temp 3" Display="'Colour Temp 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="Colour Temp 4" Display="'Colour Temp 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="Colour Temp 5" Display="'Colour Temp 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="Colour Temp 6" Display="'Colour Temp 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="Colour Temp 7" Display="'Colour Temp 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="Colour Temp 8" Display="'Colour Temp 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="Colour Temp 9" Display="'Colour Temp 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="Colour Temp 10" Display="'Colour Temp 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="Colour Temp 11" Display="'Colour Temp 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~25" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="26~50" Colour="0,0,0" />
      <Function ID="4" Name="3500K" Display="'3500K'" Dmx="51~75" Colour="0,0,0" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="76~100" Colour="0,0,0" />
      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="101~125" Colour="0,0,0" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="126~150" Colour="0,0,0" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="151~175" Colour="0,0,0" />
      <Function ID="9" Name="6000K" Display="'6000K'" Dmx="176~200" Colour="0,0,0" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="201~225" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~37" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="38~64" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="65~91" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="92~118" />
      <Function ID="6" Name="Auto 5 (1-4)" Display="'Auto 5 (1-4)'" Dmx="119~145" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="146~172" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="173~199" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="200~226" />
      <Function ID="10" Name="Auto 9 (6-8)" Display="'Auto 9 (6-8)'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="11~127" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MediaMaster Small 1.0" ShortName="MMSmall1.0" Company="Arkaos" Version="0">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="01-10-21" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Brightness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Contrast" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Mask" Name="Mask" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Mask" Display="'No Mask'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Mask" Display="'Mask %.f',1~255" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Brightness" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Contrast" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Mask" ChannelOffset="3" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
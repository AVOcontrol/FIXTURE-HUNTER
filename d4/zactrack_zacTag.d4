<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="zacTag" ShortName="zacTag" Company="zactrack" Version="2">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="20-12-21" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Height" Name="Height" Description="" Group="S">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Target Height" Display="'%.2fm',-2.00~2.00" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Speed_Preset" Name="Speed Preset" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Slow" Display="'Slow'" Dmx="0~0" />
      <Function ID="2" Name="Medium" Display="'Medium'" Dmx="128~128" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Smart_Beam" Name="Smart Beam" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Diameter" Display="'Diameter %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Freeze_Filter" Name="Freeze Filter" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Freeze Intensity (Default)" Display="'Freeze Intensity (Default)'" Dmx="8~8" />
      <Function ID="2" Name="Freeze Intensity (Level)" Display="'Freeze Intensity (Level) %.1f%%',0.0~100.0" Dmx="0~254" />
      <Function ID="3" Name="Freeze Position" Display="'Freeze Position'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Tracker_Mode" Name="Tracker Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="0~0" />
      <Function ID="2" Name="Force 2D (Active 2D Tracker)" Display="'Force 2D (Active 2D Tracker)'" Dmx="20~20" />
      <Function ID="3" Name="Dimmer 0%" Display="'Dimmer 0%'" Dmx="175~175" />
      <Function ID="4" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="176~253" />
      <Function ID="5" Name="Inactive Tracker" Display="'Inactive Tracker'" Dmx="254~254" />
      <Function ID="6" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Height" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed_Preset" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Smart_Beam" ChannelOffset="3" Wheel="30" />
      <Attribute ID="Freeze_Filter" ChannelOffset="4" Wheel="58" />
      <Attribute ID="Tracker_Mode" ChannelOffset="5" Wheel="59" />
    </Include>
  </Mode>
</Fixture>
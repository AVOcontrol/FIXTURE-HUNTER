      <Else ID="1" />
      <Function ID="1" Name="No Pattern" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="A" Display="'A'" Dmx="0~4" />
      <Function ID="3" Name="B" Display="'B'" Dmx="5~9" />

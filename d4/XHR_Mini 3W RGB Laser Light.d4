    </Attribute>
    <Attribute ID="Patt_Rot" Name="Patt Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="30 deg" Display="'30 deg %.f%%',0~100" Dmx="128~159" />
      <Function ID="3" Name="180 deg" Display="'180 deg %.f%%',0~100" Dmx="160~191" />
      <Function ID="4" Name="Invert" Display="'Invert %.f%%',0~100" Dmx="192~223" />

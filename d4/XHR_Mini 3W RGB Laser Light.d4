  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto Manual" Display="'Auto Manual'" Dmx="42~83" />
      <Function ID="3" Name="Auto Beam" Display="'Auto Beam'" Dmx="84~125" />
      <Function ID="4" Name="Auto Anim" Display="'Auto Anim'" Dmx="126~167" />
      <Function ID="5" Name="Sound Beam" Display="'Sound Beam'" Dmx="168~209" />
      <Function ID="6" Name="Sound Anim" Display="'Sound Anim'" Dmx="210~251" />
      <Function ID="7" Name="Sound Manual" Display="'Sound Manual'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

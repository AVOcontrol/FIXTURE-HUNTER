  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d367f27f-9f47-471d-b27b-1bf715127686" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~95" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Col Wheel Effect" Display="'Col Wheel Effect'" Dmx="96~111" Update="Colour2, Colour1" Colour="255,255,255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour2, Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index/Bounce" ID="8,9,10,11,12,13" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Condition Name="Col Wheel Effect" ID="14,15,16,17,18,19,20,21" If="'Colour1Func'==7" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="2000-2700K" Display="'%.fK',2000~2700" Dmx="0~223" Colour="255,240,200" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="8" Name="Black" Display="'Black'" Dmx="0~0" WheelPosition="1" Colour="0,0,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="13" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="14" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="32~63" Colour="0,0,255" />
      <Function ID="16" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="17" Name="Yellow" Display="'Yellow'" Dmx="96~127" Colour="255,255,0" />
      <Function ID="18" Name="Pink" Display="'Pink'" Dmx="128~159" Colour="255,150,150" />
      <Function ID="19" Name="Light Blue" Display="'Light Blue'" Dmx="160~191" Colour="0,128,255" />
      <Function ID="20" Name="Magenta" Display="'Magenta'" Dmx="192~223" Colour="255,0,255" />
      <Function ID="21" Name="Dark Blue" Display="'Dark Blue'" Dmx="224~255" Colour="0,0,180" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Bounce" ID="2,3,4,5,6,7" If="'Colour1Func'==6" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Black" Display="'Black'" Dmx="0~0" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="FG_Colour" Name="FG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="4~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="4~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Pattern_Speed" />
      <Function ID="2" Name="Pattern Control" Display="'Pattern Control'" Dmx="16~31" Update="Pattern_Speed" />
      <Function ID="3" Name="Pattern 1" Display="'Pattern 1'" Dmx="32~47" Update="Pattern_Speed" />
      <Function ID="4" Name="Pattern 2" Display="'Pattern 2'" Dmx="48~63" Update="Pattern_Speed" />
      <Function ID="5" Name="Pattern 3" Display="'Pattern 3'" Dmx="64~79" Update="Pattern_Speed" />
      <Function ID="6" Name="Pattern 4" Display="'Pattern 4'" Dmx="80~95" Update="Pattern_Speed" />
      <Function ID="7" Name="Pattern 5" Display="'Pattern 5'" Dmx="96~111" Update="Pattern_Speed" />
      <Function ID="8" Name="Pattern 6" Display="'Pattern 6'" Dmx="112~127" Update="Pattern_Speed" />
      <Function ID="9" Name="Pattern 7" Display="'Pattern 7'" Dmx="128~143" Update="Pattern_Speed" />
      <Function ID="10" Name="Pattern 8" Display="'Pattern 8'" Dmx="144~159" Update="Pattern_Speed" />
      <Function ID="11" Name="Pattern 9" Display="'Pattern 9'" Dmx="160~175" Update="Pattern_Speed" />
      <Function ID="12" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~191" Update="Pattern_Speed" />
      <Function ID="13" Name="Pattern 11" Display="'Pattern 11'" Dmx="192~207" Update="Pattern_Speed" />
      <Function ID="14" Name="Pattern 12" Display="'Pattern 12'" Dmx="208~223" Update="Pattern_Speed" />
      <Function ID="15" Name="Pattern 13" Display="'Pattern 13'" Dmx="224~239" Update="Pattern_Speed" />
      <Function ID="16" Name="Pattern 14" Display="'Pattern 14'" Dmx="240~255" Update="Pattern_Speed" />
    </Attribute>
    <Attribute ID="Pattern_Speed" Name="Pattern Speed" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Control" ID="2,3" If="'Pattern'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="3" Name="Picture Effects" Display="'Picture Effects %.1f%%',0.0~100.0" Dmx="3~252" />
    </Attribute>
    <Attribute ID="Pattern_Fade" Name="Pattern Fade" Description="" Group="G">

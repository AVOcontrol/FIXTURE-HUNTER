      <Function ID="5" Name="Strobe CCW" Display="'Strobe CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="16~31" Update="Prism_Rot" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW'" Dmx="32~47" Update="Prism_Rot" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW'" Dmx="48~63" Update="Prism_Rot" />
      <Function ID="5" Name="Strobe CW" Display="'Strobe CW'" Dmx="64~79" Update="Prism_Rot" />
      <Function ID="6" Name="Strobe CCW" Display="'Strobe CCW'" Dmx="80~95" Update="Prism_Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2" />
      <Condition Name="Spin" ID="2,3" If="'Prism'&gt;2&amp;&amp;'Prism'&lt;7" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">

      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>0788c185-8cf4-4c22-951b-aac0b65bcddb</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Dot Line 4)" Display="'Gobo 1 (Dot Line 4)'" Dmx="10~19" WheelPosition="1">
        <Swatch>95454d44-010f-41b8-91a3-a42ae037cb1f</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Dot Triangle 3)" Display="'Gobo 2 (Dot Triangle 3)'" Dmx="20~29" WheelPosition="2">
        <Swatch>56e2debf-2a9d-4bc9-9ed4-892535652f4e</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Square Beam 4)" Display="'Gobo 3 (Square Beam 4)'" Dmx="30~39" WheelPosition="3">
        <Swatch>6e9df17a-aacb-4c4d-81df-fd17a8996da1</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Five Spokes)" Display="'Gobo 4 (Five Spokes)'" Dmx="40~49" WheelPosition="4">
        <Swatch>4e8e80dd-9bad-4e73-bb08-bb624cb5f524</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Breaking Glass)" Display="'Gobo 5 (Breaking Glass)'" Dmx="50~59" WheelPosition="5">
        <Swatch>9d4bf2cb-9776-4cf5-9e25-0ca1745158d1</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Waves)" Display="'Gobo 6 (Waves)'" Dmx="60~69" WheelPosition="6">
        <Swatch>c9461a13-5ef8-4d1f-96f7-03ead0af4303</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Scrim Filter)" Display="'Gobo 7 (Scrim Filter)'" Dmx="70~77" WheelPosition="7">
        <Swatch>371112a9-7b31-4164-a1a9-7222d3614fcf</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>0788c185-8cf4-4c22-951b-aac0b65bcddb</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="78~93" WheelPosition="1">
        <Swatch>95454d44-010f-41b8-91a3-a42ae037cb1f</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="94~109" WheelPosition="2">
        <Swatch>56e2debf-2a9d-4bc9-9ed4-892535652f4e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="110~125" WheelPosition="3">
        <Swatch>6e9df17a-aacb-4c4d-81df-fd17a8996da1</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="126~141" WheelPosition="4">

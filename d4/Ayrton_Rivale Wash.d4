      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTB 1/4" Display="'CTB 1/4'" Dmx="1028~1799" Colour="150,200,255" />

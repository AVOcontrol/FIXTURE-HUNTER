      <Function ID="2" Name="Low Haze Mode (Water Vapour Only)" Display="'Low Haze Mode (Water Vapour Only)'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">

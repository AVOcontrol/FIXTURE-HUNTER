<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-CYC500" ShortName="EK-CYC500" Company="EK Lights" Version="4">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="19-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="19-05-19" Author="Nic Morris" Comment="Added product thumbnail.  Added 17 channel mode." Version="2" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Changed CTO to a single range and CTO Layer 2 to CTO on Colours in response to manufacturer request (this is contrary to documentation)" Version="3" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added Atlabase ID's (currently missing 17 channel mode)" Version="3" />
  <History Date="21-11-20" Author="Nic Morris" Comment="Created from Prolights ECLIPSEPARFC (identical)" Version="4" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~30" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="31~55" Colour="255,255,255" />
      <Function ID="4" Name="3500K" Display="'3500K'" Dmx="56~80" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="81~105" Colour="255,255,255" />
      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="106~130" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="131~155" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="156~180" Colour="255,255,255" />
      <Function ID="9" Name="6000K" Display="'6000K'" Dmx="181~205" Colour="255,255,255" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="206~230" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5 (1-4)" Display="'Auto 5 (1-4)'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f',-25.0~25.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Amber Shift On" Display="'Amber Shift On'" Dmx="3~5" Colour="255,255,255" />
      <Function ID="3" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="131~200" />
    </Attribute>
    <Attribute ID="xHue1" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f°',-25.0~0.0" Dmx="0~126" Colour="255,255,255" />
      <Function ID="2" Name="0" Display="'0'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f°',0.0~25.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Layer 1-&gt;2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO_on_Colours" Name="CTO on Colours" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~6500" Dmx="0~240" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Curve-Bar" ShortName="Curve Bar" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="16-08-11" Author="Nic Morris" Comment="Created" />
  <History Date="30-08-11" Author="Nic Morris" Comment="Removed dimmer attribute link from P3 and P4 mode cells." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Macro_Control" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Update="Macro_Control" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Update="Macro_Control" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="40~49" Update="Macro_Control" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Update="Macro_Control" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Update="Macro_Control" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="80~89" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="90~99" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="100~109" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="110~119" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="120~129" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="130~139" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="140~149" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="150~159" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="160~169" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="170~179" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="180~189" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="190~199" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="200~209" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="210~219" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="220~229" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="230~239" Update="Macro_Control" Colour="0,0,0" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Macro_Control" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

    <Attribute ID="Macro_Control" Name="Macro Control" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="1" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;25" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==25" />
      <Else ID="3" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="''" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber_Macro" Name="Amber Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="37~110" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="111~147" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="148~184" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="185~255" />
    </Attribute>
    <Attribute ID="Wash_Macro" Name="Wash Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="5~33" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="34~93" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="94~109" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="110~252" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Beam_Macro" Name="Beam Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="5~85" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="86~170" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Amber_Master" Name="Amber Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Wash_Master" Name="Wash Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Wash_Shutter" Name="Wash Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Wash_Colour" Name="Wash Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="36~72" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="73~107" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="108~143" Colour="0,0,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="144~178" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="179~216" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="217~254" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber_Sel" Name="Amber Sel" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="5~41" />
      <Function ID="3" Name="2" Display="'2'" Dmx="42~76" />
      <Function ID="4" Name="3" Display="'3'" Dmx="77~112" />
      <Function ID="5" Name="1+2" Display="'1+2'" Dmx="113~148" />
      <Function ID="6" Name="1+3" Display="'1+3'" Dmx="149~184" />
      <Function ID="7" Name="2+3" Display="'2+3'" Dmx="185~220" />
      <Function ID="8" Name="1+2+3" Display="'1+2+3'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Beam_Colour" Name="Beam Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~36" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~48" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="49~79" Colour="0,0,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="80~111" Colour="255,255,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="112~144" Colour="0,0,0" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="145~176" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="177~208" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B" Display="'R+G+B'" Dmx="209~240" Colour="255,255,255" />
      <Function ID="10" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="241~255" Colour="0,0,0" />
    </Attribute>
  </Control>

      <Function ID="2" Name="Auto L" Display="'Auto L %.f%%',0~100" Dmx="128~160" />
      <Function ID="3" Name="Auto R" Display="'Auto R %.f%%',0~100" Dmx="161~192" />
      <Function ID="4" Name="Auto L/R" Display="'Auto L/R %.f%%',0~100" Dmx="193~224" />
      <Function ID="5" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="225~239" />
      <Function ID="6" Name="Rhombus" Display="'Rhombus %.f%%',0~100" Dmx="240~247" />

      <Function ID="2" Name="Auto Dn" Display="'Auto Dn %.f%%',0~100" Dmx="128~160" />
      <Function ID="3" Name="Auto Up" Display="'Auto Up %.f%%',0~100" Dmx="161~192" />
      <Function ID="4" Name="Auto Up/Dn" Display="'Auto Up/Dn %.f%%',0~100" Dmx="193~224" />
      <Function ID="5" Name="Circle" Display="'Circle %.f%%',0~100" Dmx="225~231" />

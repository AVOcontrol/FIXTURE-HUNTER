      <Function ID="4" Name="Pendulum" Display="'Pendulum %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Ellipse" Display="'Ellipse %.f%%',0~100" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Zoom" Display="'No Zoom'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~159" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="160~191" />

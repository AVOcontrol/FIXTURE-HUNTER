  </Control>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="UKLXAL4W" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Patt_Func" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Patt_Group_1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Col_Group_1" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Patt_Group_2" ChannelOffset="8" Wheel="15" />
      <Attribute ID="Col_Group_2" ChannelOffset="9" Wheel="8" />

      <Function ID="30" Name="T" Display="'T'" Dmx="190~199" />
      <Function ID="31" Name="U" Display="'U'" Dmx="200~209" />
      <Function ID="32" Name="V" Display="'V'" Dmx="210~219" />
      <Function ID="33" Name="W" Display="'W'" Dmx="220~229" />
      <Function ID="34" Name="X" Display="'X'" Dmx="230~239" />
      <Function ID="35" Name="Y" Display="'Y'" Dmx="240~249" />
      <Function ID="36" Name="Z" Display="'Z'" Dmx="250~255" />
      <Function ID="37" Name="Sound 1" Display="'Sound 1'" Dmx="0~16" />
      <Function ID="38" Name="Sound 2" Display="'Sound 2'" Dmx="17~33" />
      <Function ID="39" Name="Sound 3" Display="'Sound 3'" Dmx="34~50" />
      <Function ID="40" Name="Sound 4" Display="'Sound 4'" Dmx="51~67" />
      <Function ID="41" Name="Sound 5" Display="'Sound 5'" Dmx="68~84" />
      <Function ID="42" Name="Sound 6" Display="'Sound 6'" Dmx="85~101" />
      <Function ID="43" Name="Sound 7" Display="'Sound 7'" Dmx="102~118" />
      <Function ID="44" Name="Sound 8" Display="'Sound 8'" Dmx="119~135" />
      <Function ID="45" Name="Sound 9" Display="'Sound 9'" Dmx="136~152" />
      <Function ID="46" Name="Sound 10" Display="'Sound 10'" Dmx="153~169" />
      <Function ID="47" Name="Sound 11" Display="'Sound 11'" Dmx="170~186" />
      <Function ID="48" Name="Sound 12" Display="'Sound 12'" Dmx="187~203" />
      <Function ID="49" Name="Sound 13" Display="'Sound 13'" Dmx="204~220" />
      <Function ID="50" Name="Sound 14" Display="'Sound 14'" Dmx="221~237" />
      <Function ID="51" Name="Sound 15" Display="'Sound 15'" Dmx="238~255" />
      <Function ID="52" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

      <Function ID="19" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="156~161" WheelPosition="3" />
      <Function ID="20" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="150~155" WheelPosition="4" />
      <Function ID="21" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="144~149" WheelPosition="5" />
      <Function ID="22" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="138~143" WheelPosition="6" />
      <Function ID="23" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="132~137" WheelPosition="7" />
      <Function ID="24" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="126~131" WheelPosition="8" />
      <Function ID="25" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="120~125" WheelPosition="9" />
      <Function ID="26" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="114~119" WheelPosition="10" />
      <Function ID="27" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="108~113" WheelPosition="11" />
      <Function ID="28" Name="Gobo 12 Shake" Display="'Gobo 12 Shake %.f%%',0~100" Dmx="102~107" WheelPosition="12" />
      <Function ID="29" Name="Gobo 13 Shake" Display="'Gobo 13 Shake %.f%%',0~100" Dmx="96~101" WheelPosition="13" />
      <Function ID="30" Name="Gobo 14 Shake" Display="'Gobo 14 Shake %.f%%',0~100" Dmx="90~95" WheelPosition="14" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="180~217" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="218~255" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="100~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto Fast" Display="'Auto Fast'" Dmx="50~100" />
      <Function ID="3" Name="Auto Slow" Display="'Auto Slow'" Dmx="101~200" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <AtlaBase TypeID="e12b211f-de91-4fd7-900b-b3b05069cbd3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="36~71" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="72~107" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="108~143" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="144~179" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="180~215" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="216~251" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="A" Display="'A'" Dmx="36~71" Colour="255,255,255" />
      <Function ID="3" Name="A+WW" Display="'A+WW'" Dmx="72~107" Colour="255,255,255" />
      <Function ID="4" Name="WW" Display="'WW'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="5" Name="A+CW" Display="'A+CW'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="6" Name="WW+CW" Display="'WW+CW'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="7" Name="CW" Display="'CW'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="8" Name="A+WW+CW" Display="'A+WW+CW'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">

  <Thumbnail>c0f75934-e509-4cc1-8c64-b8cc425b6a8a</Thumbnail>
  <History Date="08-09-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="16-09-14" Author="Nic Morris" Comment="Updated colour and gobo in response to manufacturer request." Version="2" />
  <History Date="04-05-15" Author="Nic Morris" Comment="Updated basic modes to use simplified shutter channel in attempt to fix bug report from distributor." Version="3" />
  <History Date="19-09-15" Author="Nic Morris" Comment="Created from Prolights MOONSTONE" Version="4" />
  <History Date="26-10-15" Author="Ermanno Valvason" Comment="Fixed Blades position in Attribute Editor and added linear frost" Version="5" />
  <History Date="26-10-15" Author="Nic Morris" Comment="Renamed from Prolights MODULA in response to manufacturer request." Version="6" />
  <History Date="26-10-15" Author="Nic Morris" Comment="Brought blade attribute names in line with revised ID's.  Fixed blade RT and RB ID's." Version="7" />
  <History Date="14-12-15" Author="Nic Morris" Comment="Created from Prolights LUMA1500 (another rename + updated colour and gobo functions)" Version="8" />
  <History Date="14-12-15" Author="Nic Morris" Comment="Created from Prolights LUMA 1500SH" Version="9" />
  <History Date="29-01-16" Author="Nic Morris" Comment="Added separate gobo shake ranges for standard and extended modes in response to manufacturer request." Version="10" />
  <History Date="30-01-16" Author="Nic Morris" Comment="Created from Prolights LUMA 1500SP" Version="11" />
  <History Date="17-03-16" Author="Nic Morris" Comment="Created from Prolights LUMA 700" Version="12" />
  <History Date="08-10-18" Author="Nic Morris" Comment="Added product thumbnail.  Revised colour and gobo functions." Version="13" />
  <History Date="08-10-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />
  <History Date="04-12-21" Author="Nic Morris" Comment="Created from BSL Helios" Version="15" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e441de1f-d736-48c2-97e7-d152fdc5ec46" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Function" Name="P/T Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="4112~7967" Colour="255,150,150" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="8224~12079" Colour="255,128,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="12336~16191" Colour="128,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="16448~20303" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="20560~24415" Colour="0,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="24672~28527" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="28784~32639" Colour="255,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="49858~65535" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="15~23" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="24~32" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="33~41" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="42~50" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="51~59" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~68" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="69~77" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="78~93" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="94~109" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="110~125" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="126~141" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="142~157" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="158~173" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="174~189" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~221" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48573" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49858~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="8~127" />

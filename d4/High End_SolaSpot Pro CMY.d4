      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="187~128" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Condition Name="Speed" ID="2" If="'C-Mix_Func'&gt;10" />
      <Condition Name="Continuous" ID="7,8,9,10" If="'C-Mix_Func'&gt;4&amp;&amp;'C-Mix_Func'&lt;9" />

    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'&lt;9" />
      <Condition Name="Speed" ID="9,10" If="'Gobo1Func'&gt;8&amp;&amp;'Gobo1Func'&lt;15" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Dense Foliage" Display="'Dense Foliage'" Dmx="32~63" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gatlin" Display="'Gatlin'" Dmx="64~95" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="PsySpin" Display="'PsySpin'" Dmx="96~127" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Bubbles" Display="'Bubbles'" Dmx="128~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Lumiol" Display="'Lumiol'" Dmx="160~191" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Paper Stack" Display="'Paper Stack'" Dmx="192~223" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="224~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />

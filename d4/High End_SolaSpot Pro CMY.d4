  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:5" Delay="1000" />
      <Set Channel="Shutter:1" Delay="5000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="MSpeed Off">
      <Set Channel="Control:2" Delay="1000" />
      <Set Channel="Shutter:1" Delay="5000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />

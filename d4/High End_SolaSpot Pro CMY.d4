      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="255~196" Colour="0,0,0" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="188~195" Colour="255,255,255" />
      <Function ID="6" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="187~128" Colour="0,0,0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Split" Display="'Split'" Dmx="5~40" Colour="255,255,255" />
      <Function ID="9" Name="Variable" Display="'Variable %.1f%%',0.0~100.0" Dmx="41~248" Colour="255,255,255" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="249~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed Index" Display="'Full Speed Index'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />

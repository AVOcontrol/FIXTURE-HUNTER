      <Function ID="9" Name="Full Speed Scroll CW" Display="'Full Speed Scroll CW'" Dmx="16~31" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Full Speed Scroll CCW" Display="'Full Speed Scroll CCW'" Dmx="32~47" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Full Speed Random" Display="'Full Speed Random'" Dmx="64~79" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="MSpeed Scroll CW" Display="'MSpeed Scroll CW'" Dmx="144~159" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="MSpeed Scroll CCW" Display="'MSpeed Scroll CCW'" Dmx="160~175" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="MSpeed Random" Display="'MSpeed Random'" Dmx="192~207" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func'&lt;9" />
      <Condition Name="Speed" ID="10,11" If="'Gobo2Func'&gt;8&amp;&amp;'Gobo2Func'&lt;15" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Tunnel" Display="'Tunnel'" Dmx="16~47" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Bars" Display="'Bars'" Dmx="48~79" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Strokes" Display="'Strokes'" Dmx="80~111" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Foliage" Display="'Foliage'" Dmx="112~143" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Burst" Display="'Burst'" Dmx="144~175" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Fracture" Display="'Fracture'" Dmx="176~207" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Crosshatch" Display="'Crosshatch'" Dmx="208~239" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="240~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed Open" Display="'Full Speed Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Full Speed Continuous" Display="'Full Speed Continuous'" Dmx="15~31" Update="Prism_Rot" />
      <Function ID="3" Name="Full Speed Reserved" Display="'Full Speed Reserved'" Dmx="96~127" Update="Prism_Rot" />
      <Function ID="4" Name="MSpeed Open" Display="'MSpeed Open'" Dmx="128~143" Update="Prism_Rot" />
      <Function ID="5" Name="MSpeed Continuous" Display="'MSpeed Continuous'" Dmx="144~159" Update="Prism_Rot" />
      <Function ID="6" Name="MSpeed Reserved" Display="'MSpeed Reserved'" Dmx="224~255" Update="Prism_Rot" />
      <Function ID="7" Name="Full Speed Spin CW" Display="'Full Speed Spin CW'" Dmx="32~47" Update="Prism_Rot" />
      <Function ID="8" Name="Full Speed Spin CCW" Display="'Full Speed Spin CCW'" Dmx="48~63" Update="Prism_Rot" />
      <Function ID="9" Name="Full Speed Anim CW" Display="'Full Speed Anim CW'" Dmx="64~79" Update="Prism_Rot" />
      <Function ID="10" Name="Full Speed Anim CCW" Display="'Full Speed Anim CCW'" Dmx="80~95" Update="Prism_Rot" />
      <Function ID="11" Name="MSpeed Spin CW" Display="'MSpeed Spin CW'" Dmx="160~175" Update="Prism_Rot" />
      <Function ID="12" Name="MSpeed Spin CCW" Display="'MSpeed Spin CCW'" Dmx="176~191" Update="Prism_Rot" />
      <Function ID="13" Name="MSpeed Anim CW" Display="'MSpeed Anim CW'" Dmx="192~207" Update="Prism_Rot" />
      <Function ID="14" Name="MSpeed Anim CCW" Display="'MSpeed Anim CCW'" Dmx="208~223" Update="Prism_Rot" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Prism_Func'&lt;7" />
      <Condition Name="Spin" ID="2,3" If="'Prism_Func'&gt;6&amp;&amp;'Prism_Func'&lt;15" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" />
      <Function ID="4" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Variable" Display="'Variable %.1f%%',0.0~100.0" Dmx="1~127" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Soft Edge" Display="'Soft Edge'" Dmx="128~135" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Strobe" Display="'Strobe'" Dmx="136~151" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="152~167" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="168~225" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

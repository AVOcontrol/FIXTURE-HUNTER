  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Spin CW" ID="2,3" If="'Pan_Mode'==3||'Pan_Mode'==4" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.2f%%',0.00~100.00" Dmx="1028~65535" />
    </Attribute>
    <Attribute ID="Pan_Mode" Name="Pan Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Path" Display="'Full Path'" Dmx="0~0" Update="Pan" />
      <Function ID="2" Name="Quick Path" Display="'Quick Path'" Dmx="32~63" Update="Pan" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW'" Dmx="64~95" Update="Pan" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW'" Dmx="96~255" Update="Pan" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

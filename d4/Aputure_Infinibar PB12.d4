<Fixture Name="Infinibar PB12" ShortName="InfbarPB12" Company="Aputure" Version="104">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>6385444a-b23c-47dd-a328-d63861009ffb</Thumbnail>
  <History Date="26-07-22" Author="Nic Morris" Comment="Created (confusing documentation.  littered with errors.  nested conditionals are ridiculous.  note Modes 23 (FX 16bit) and 28 (Ultimate 16bit) cannot be supported at the moment as they involve dynamic resolution changes)" Version="0" />
  <History Date="16-09-22" Author="Nic Morris" Comment="Created from Aputure Nova P600c (nested conditionals are silly)" Version="50" />
  <History Date="17-09-22" Author="Nic Morris" Comment="Revised some custom ranges that were not displaying as hoped." Version="94" />
  <History Date="02-07-23" Author="Nic Morris" Comment="Created from Aputure MT Pro" Version="95" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fa65637d-e58a-43e3-92c2-c18b1fb3e20f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2000~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M(8bit)" Name="G/M" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="- Green" Display="'- Green %.2f%%',99.00~1.00" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.2f%%',1.00~99.00" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Xfade_CCT-&gt;Col" Name="Xfade CCT-&gt;Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;Col" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Hue" Display="'%.f°',1~360" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Base_CCT" Name="Base CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="6500K" Display="'6500K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2000~10000" Dmx="11~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="FX_Sel" Name="FX Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi II" Display="'Paparazzi II'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="2" Name="Lightning II" Display="'Lightning II'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="3" Name="TV III" Display="'TV III'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="4" Name="Fire III" Display="'Fire III'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="5" Name="Faulty Bulb III" Display="'Faulty Bulb III'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="6" Name="Pulsing III" Display="'Pulsing III'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="7" Name="Cop Car III" Display="'Cop Car III'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="8" Name="Party Lights II" Display="'Party Lights II'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="9" Name="Fireworks II" Display="'Fireworks II'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5" />
    </Attribute>
    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="2:2000" PowerOn="2:2000" />
      <Else ID="1" />
      <Condition Name="Paparazzi II" ID="2" If="'FX_Sel'==1" />
      <Condition Name="Lightning II" ID="3,4" If="'FX_Sel'==2" />
      <Condition Name="TV III" ID="5,6" If="'FX_Sel'==3" />
      <Condition Name="Fire III" ID="7,8" If="'FX_Sel'==4" />
      <Condition Name="Faulty Bulb III" ID="9,10" If="'FX_Sel'==5" />
      <Condition Name="Pulsing III" ID="11,12" If="'FX_Sel'==6" />
      <Condition Name="Cop Car III" ID="13,14,15,16,17" If="'FX_Sel'==7" />
      <Condition Name="Party Lights II" ID="18" If="'FX_Sel'==8" />
      <Condition Name="Fireworks II" ID="19,20,21" If="'FX_Sel'==9" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2000~10000" Dmx="0~255" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="3" Name="CCT" Display="'CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="4" Name="HSI" Display="'HSI'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="5" Name="CCT" Display="'CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="6" Name="HSI" Display="'HSI'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="7" Name="CCT" Display="'CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="8" Name="HSI" Display="'HSI'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="9" Name="CCT" Display="'CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="10" Name="HSI" Display="'HSI'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="11" Name="CCT" Display="'CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="12" Name="HSI" Display="'HSI'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="13" Name="Col Combination Red" Display="'Col Combination Red'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="14" Name="Col Combination Blue" Display="'Col Combination Blue'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="15" Name="Col Combination Red+Blue" Display="'Col Combination Red+Blue'" Dmx="20~29" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="16" Name="Col Combination Blue+White" Display="'Col Combination Blue+White'" Dmx="30~39" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="17" Name="Col Combination Red+Blue+White" Display="'Col Combination Red+Blue+White'" Dmx="40~49" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="18" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="19" Name="Col Combination CCT" Display="'Col Combination CCT'" Dmx="0~0" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="20" Name="Col Combination HUE" Display="'Col Combination HUE'" Dmx="10~19" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="21" Name="Col Combination CCT+HUE" Display="'Col Combination CCT+HUE'" Dmx="20~29" Update="FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
    </Attribute>

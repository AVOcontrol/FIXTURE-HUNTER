      <Function ID="5" Name="Neutral" Display="'Neutral'" Dmx="120~145" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
      <Function ID="6" Name="+ Green" Display="'+ Green %.2f%%',1.00~99.00" Dmx="146~244" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
      <Function ID="7" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
      <Function ID="8" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_28" Name="FX Param 28" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Pix 6 Mode HSI" ID="2,3" If="'Pix_FX_Param_25'==5" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
      <Function ID="2" Name="Base CCT 6500K" Display="'Base CCT 6500K'" Dmx="0~0" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
      <Function ID="3" Name="Base CCT C-Mix" Display="'Base CCT C-Mix %.fK',2000~10000" Dmx="11~255" Update="Pix_FX_Param_23, Pix_FX_Param_24, Pix_FX_Param_25, Pix_FX_Param_26, Pix_FX_Param_27, Pix_FX_Param_28" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_29" Name="FX Param 29" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Departure 2 Way" ID="2" If="'Pix_FX_Param_3'==10" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="BG Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_30" Name="FX Param 30" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Departure 2 Way" ID="2,3,4" If="'Pix_FX_Param_3'==10" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="2" Name="BG Col Mode CCT" Display="'BG Col Mode CCT'" Dmx="0~0" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="3" Name="BG Col Mode HSI" Display="'BG Col Mode HSI'" Dmx="10~19" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="4" Name="BG Col Mode Black" Display="'BG Col Mode Black'" Dmx="20~29" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_31" Name="FX Param 31" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="BG Col Mode CCT" ID="2" If="'Pix_FX_Param_30'==2" />
      <Condition Name="BG Col Mode HSI" ID="3" If="'Pix_FX_Param_30'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2000~10000" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="3" Name="Hue" Display="'%.f°',1~360" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_32" Name="FX Param 32" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="BG Col Mode CCT" ID="2,3,4,5,6,7" If="'Pix_FX_Param_30'==2" />

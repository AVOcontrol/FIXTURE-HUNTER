      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="0~0" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="3" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="4" Name="- Green" Display="'- Green %.2f%%',99.00~1.00" Dmx="21~119" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="5" Name="Neutral" Display="'Neutral'" Dmx="120~145" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="6" Name="+ Green" Display="'+ Green %.2f%%',1.00~99.00" Dmx="146~244" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="7" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
      <Function ID="8" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Update="Pix_FX_Param_31, Pix_FX_Param_32, Pix_FX_Param_33" />
    </Attribute>
    <Attribute ID="Pix_FX_Param_33" Name="FX Param 33" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="BG Col Mode HSI" ID="2,3" If="'Pix_FX_Param_30'==3" />

      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Pan" Display="'Pan %.f%%',0~100" Dmx="6~40" />
      <Function ID="3" Name="Tilt" Display="'Tilt %.f%%',0~100" Dmx="41~75" />
      <Function ID="4" Name="P/T" Display="'P/T %.f%%',0~100" Dmx="76~110" />
      <Function ID="5" Name="P/T Inv" Display="'P/T Inv %.f%%',0~100" Dmx="111~145" />
      <Function ID="6" Name="Circle" Display="'Circle %.f%%',0~100" Dmx="146~180" />
      <Function ID="7" Name="Circle Inv" Display="'Circle Inv %.f%%',0~100" Dmx="181~215" />
      <Function ID="8" Name="Random" Display="'Random %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="6~20" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="21~35" />
      <Function ID="4" Name="Pan Invert" Display="'Pan Invert'" Dmx="36~50" />
      <Function ID="5" Name="Pan Normal" Display="'Pan Normal'" Dmx="51~65" />
      <Function ID="6" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="66~80" />
      <Function ID="7" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="81~95" />
      <Function ID="8" Name="Fan Auto" Display="'Fan Auto'" Dmx="96~110" />
      <Function ID="9" Name="Fan Silent" Display="'Fan Silent'" Dmx="111~125" />
      <Function ID="10" Name="650Hz" Display="'650Hz'" Dmx="126~140" />
      <Function ID="11" Name="1530Hz" Display="'1530Hz'" Dmx="141~155" />
      <Function ID="12" Name="3600Hz" Display="'3600Hz'" Dmx="156~170" />
      <Function ID="13" Name="12000Hz" Display="'12000Hz'" Dmx="171~185" />
      <Function ID="14" Name="25000Hz" Display="'25000Hz'" Dmx="186~200" />
      <Function ID="15" Name="Reset P/T" Display="'Reset P/T'" Dmx="201~215" />
      <Function ID="16" Name="Reset Head" Display="'Reset Head'" Dmx="216~230" />
      <Function ID="17" Name="Reset All" Display="'Reset All'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="+ Magenta" Display="'+ Magenta %.1f%%',100.0~0.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_xFade" Name="Col Mac xFade" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0s" Display="'0s'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="100-10000ms" Display="'%.fms',100~10000" Dmx="6~105" Colour="255,255,255" />
      <Function ID="3" Name="11-119s" Display="'11-119s %.f Sec',11~119" Dmx="106~214" Colour="255,255,255" />
      <Function ID="4" Name="120-290s" Display="'120-290s %.f Sec',120~290" Dmx="215~244" Colour="255,255,255" />
      <Function ID="5" Name="5-15min" Display="'%.fmin',5~15" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="192~192" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="255~193" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Auto +" Display="'Auto + %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Auto Cycle" Display="'Auto Cycle %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Bounce +" Display="'Bounce + %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Bounce -" Display="'Bounce - %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="70~129" />
      <Function ID="4" Name="Large" Display="'Large'" Dmx="130~189" />
      <Function ID="5" Name="Max" Display="'Max'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />

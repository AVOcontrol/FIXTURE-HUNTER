  <Thumbnail>bacac25d-fa7f-44ef-a5bd-fcce5b94b6a0</Thumbnail>
  <History Date="16-05-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="19-05-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5be914f4-58cd-4dda-990d-7169290d0f69" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Kelvin" Name="Kelvin" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Kelvin C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Sel_1" Name="Colour Sel 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~74" Colour="255,0,0" />
      <Function ID="3" Name="UV" Display="'UV'" Dmx="75~140" Colour="180,0,255" />
      <Function ID="4" Name="Dark Blue" Display="'Dark Blue'" Dmx="141~200" Colour="0,0,180" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="201~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Colour_Sel_2" Name="Colour Sel 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Lime Green" Display="'Lime Green'" Dmx="11~74" Colour="0,200,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="75~140" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="141~200" Colour="0,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="201~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Colour_Sel_3" Name="Colour Sel 3" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Light Pink" Display="'Light Pink'" Dmx="11~74" Colour="255,200,200" />
      <Function ID="3" Name="Teal" Display="'Teal'" Dmx="75~140" Colour="0,255,200" />
      <Function ID="4" Name="RGB" Display="'RGB'" Dmx="141~200" Colour="255,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="201~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour_Sel_4" Name="Colour Sel 4" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="4789K" Display="'4789K'" Dmx="11~74" Colour="255,255,255" />
      <Function ID="3" Name="3513K" Display="'3513K'" Dmx="75~140" Colour="255,255,255" />
      <Function ID="4" Name="3301K" Display="'3301K'" Dmx="141~200" Colour="255,255,255" />
      <Function ID="5" Name="5262K" Display="'5262K'" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red Orange" Display="'Red Orange'" Dmx="17~17" Colour="255,0,0" />
      <Function ID="3" Name="Purple" Display="'Purple'" Dmx="32~32" Colour="128,0,255" />
      <Function ID="4" Name="Aqua" Display="'Aqua'" Dmx="46~46" Colour="0,255,200" />
      <Function ID="5" Name="Hot Pink" Display="'Hot Pink'" Dmx="64~64" Colour="255,150,150" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="79~79" Colour="255,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="97~97" Colour="0,0,255" />
      <Function ID="8" Name="1/4 CTB" Display="'1/4 CTB'" Dmx="111~111" Colour="230,230,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="126~190" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="191~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_Shape" Name="Beam Shape" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Beam_Shape_Rot" Name="Beam Shape Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="255~192" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="120~160" />
      <Function ID="3" Name="Reset Motor" Display="'Reset Motor'" Dmx="161~200" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

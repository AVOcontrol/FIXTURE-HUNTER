      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="187~129" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

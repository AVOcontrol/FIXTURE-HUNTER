<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BeamBar 10RGB" ShortName="BBar10RGB" Company="Laserworld" Version="7">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>c31d9e83-6d10-4536-b51c-aabae1e4b5b4</Thumbnail>
  <History Date="25-08-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="20-09-21" Author="Nic Morris" Comment="Split from Laserworld BeamBar for Capture.  Added Atlabase ID's.  Added product thumbnail" Version="2" />
  <History Date="11-01-25" Author="Nic Morris" Comment="Created from Laserworld BeamBar 10G-532 (shares with the same charts)" Version="5" />
  <History Date="06-02-25" Author="Nic Morris" Comment="Added 31 channel mode based on 04/2024 charts (note effect dependencies can't be supported properly in multi-cell as they would straddle cells.  implemented as modes with and without cells)" Version="6" />
  <History Date="07-02-25" Author="Nic Morris" Comment="Added Atlabase ID for 31 channel mode (celled version)" Version="7" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e3f6d185-a15c-4278-a7e8-9c0e4c36eb42" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="50~99" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="100~149" />
      <Function ID="4" Name="DMX (Effect)" Display="'DMX (Effect)'" Dmx="150~199" />
      <Function ID="5" Name="DMX (Individual)" Display="'DMX (Individual)'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode1" Name="Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="30~59" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="60~89" />
      <Function ID="4" Name="Flow Col Changing Effect 1" Display="'Flow Col Changing Effect 1'" Dmx="90~119" />
      <Function ID="5" Name="Flow Col Changing Effect 2" Display="'Flow Col Changing Effect 2'" Dmx="120~149" />
      <Function ID="6" Name="Tracing Effects" Display="'Tracing Effects'" Dmx="150~179" />
      <Function ID="7" Name="Sync All" Display="'Sync All'" Dmx="180~209" />
      <Function ID="8" Name="Independent Control" Display="'Independent Control'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Mode11" Name="Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="30~59" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="60~89" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="4" Name="Flow Col Changing Effect 1" Display="'Flow Col Changing Effect 1'" Dmx="90~119" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="5" Name="Flow Col Changing Effect 2" Display="'Flow Col Changing Effect 2'" Dmx="120~149" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="6" Name="Tracing Effects" Display="'Tracing Effects'" Dmx="150~179" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="7" Name="Sync All" Display="'Sync All'" Dmx="180~209" Update="Red1, Green1, Blue1, Red2" />
      <Function ID="8" Name="Independent Control" Display="'Independent Control'" Dmx="210~255" Update="Red1, Green1, Blue1, Red2" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Program" ID="2" If="'Mode11'&gt;3&amp;&amp;'Mode11'&lt;7" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Program Sel" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Mode11'==5||'Mode11'==6" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Red Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Mode11'==5" />
      <Condition Name="Direction" ID="3,4" If="'Mode11'==6" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Green Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Right-&gt;Left" Display="'Right-&gt;Left'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="Left-&gt;Right" Display="'Left-&gt;Right'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Mode11'==5" />
      <Condition Name="Interval" ID="3,4,5" If="'Mode11'==6" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Blue Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="1 Diode" Display="'1 Diode'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="2 Diodes" Display="'2 Diodes'" Dmx="200~249" Colour="0,0,0" />
      <Function ID="5" Name="3 Diodes" Display="'3 Diodes'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>

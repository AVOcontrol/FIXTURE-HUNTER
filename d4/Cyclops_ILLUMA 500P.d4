      <Function ID="36" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.1f%%',0.0~100.0" Dmx="41634~43433" WheelPosition="5" />
      <Function ID="37" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.1f%%',0.0~100.0" Dmx="43690~45489" WheelPosition="6" />
      <Function ID="38" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.1f%%',0.0~100.0" Dmx="45746~47545" WheelPosition="7" />
      <Function ID="39" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.1f%%',0.0~100.0" Dmx="47802~49344" WheelPosition="8" />
      <Function ID="40" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.1f%%',0.0~100.0" Dmx="49601~51143" WheelPosition="9" />
      <Function ID="41" Name="No Scroll" Display="'No Scroll'" Dmx="51400~51657" />
      <Function ID="42" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="51914~57054" />
      <Function ID="43" Name="No Scroll" Display="'No Scroll'" Dmx="51400~51657" />
      <Function ID="44" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="57311~62451" />
      <Function ID="45" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="46" Name="Rand Audio" Display="'Rand Audio'" Dmx="62708~63993" />
      <Function ID="47" Name="Rand Auto" Display="'Rand Auto %.1f%%',0.0~100.0" Dmx="65535~64250" />
      <Function ID="48" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func1'==1||'Gobo2Func1'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==5||'Gobo2Func'==6||'Gobo2Func1'==2||'Gobo2Func1'==4||'Gobo2Func1'==5||'Gobo2Func1'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="257~32639" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~32896" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33153~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism Index" Display="'Prism Index'" Dmx="20~73" Update="Prism_Rot" />
      <Function ID="3" Name="Prism Rot" Display="'Prism Rot'" Dmx="74~127" Update="Prism_Rot" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Prism_Rot" />
      <Function ID="5" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Prism_Rot" />
      <Function ID="6" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Prism_Rot" />
      <Function ID="7" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Prism_Rot" />
      <Function ID="8" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Prism_Rot" />
      <Function ID="9" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Prism_Rot" />
      <Function ID="10" Name="Macro 7" Display="'Macro 7'" Dmx="176~183" Update="Prism_Rot" />
      <Function ID="11" Name="Macro 8" Display="'Macro 8'" Dmx="184~191" Update="Prism_Rot" />
      <Function ID="12" Name="Macro 9" Display="'Macro 9'" Dmx="192~199" Update="Prism_Rot" />
      <Function ID="13" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Prism_Rot" />
      <Function ID="14" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Prism_Rot" />
      <Function ID="15" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" Update="Prism_Rot" />
      <Function ID="16" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" Update="Prism_Rot" />
      <Function ID="17" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" Update="Prism_Rot" />
      <Function ID="18" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Prism_Rot" />
      <Function ID="19" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Prism" ID="1" If="'Prism'==1" />
      <Condition Name="Index" ID="2" If="'Prism'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" WheelPosition="0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~1" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

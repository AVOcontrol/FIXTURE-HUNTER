<Fixture Name="ILLUMA 500P" ShortName="ILLUMA500P" Company="Cyclops" Version="22">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>8d2ce2c0-a48d-4367-b0de-7fa1ca3a2a9b</Thumbnail>
  <History Date="27-03-19" Author="Nic Morris" Comment="Created (v0.9)" Version="1" />
  <History Date="30-08-19" Author="Nic Morris" Comment="Changed name from Espritt to Esprite and updated in line with v1.1 charts in response to manufacturer request (adds max intensity control and boost mode control functions and macros)" Version="2" />
  <History Date="13-11-19" Author="Nic Morris" Comment="Fixed colour CCW scroll DMX range.  Added product thumbnail.  Added gobo swatches." Version="3" />
  <History Date="12-12-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <History Date="20-11-20" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (minor change to gobo scroll ranges)." Version="5" />
  <History Date="14-01-21" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds modes 3+4)" Version="6" />
  <History Date="14-01-21" Author="Nic Morris" Comment="Revised fixed colour names and swatches.  Revised CTO range.  Added prism index/prism spin." Version="6" />
  <History Date="20-05-21" Author="Nic Morris" Comment="Updated in line with v2.0 charts in response to manufacturer request (adds control functions and macros)" Version="7" />
  <History Date="07-10-21" Author="Nic Morris" Comment="Created from Robe Esprite (v1.0)" Version="8" />
  <History Date="21-10-21" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (adds prism index/spin options)" Version="10" />
  <History Date="13-01-22" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (adds wired and wireless control function and macros)" Version="11" />
  <History Date="03-02-22" Author="Nic Morris" Comment="Updated in line with v1.5 charts in repsonse to manufacturer request (colour function names and swatches)" Version="12" />
  <History Date="04-04-22" Author="Nic Morris" Comment="Updated in line with v1.6 charts in reponse to manufacturer requets (adds CTO control)" Version="13" />
  <History Date="05-05-22" Author="Nic Morris" Comment="Updated in line with v1.7 charts (initial release version.  significant changes to control functions/macros.  corrects gobo 2 shake spin function ranges)." Version="15" />
  <History Date="05-05-22" Author="Nic Morris" Comment="Added gobo swatches.  Added product thumbnail." Version="15" />
  <History Date="09-05-22" Author="Nic Morris" Comment="Correction to wired/wireless control function DMX ranges (missed in previous update)" Version="16" />
  <History Date="12-05-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="17" />
  <History Date="09-12-22" Author="Nic Morris" Comment="Added 45 channel mode 2 in line with v1.9 charts in response to manufacturer request." Version="18" />
  <History Date="23-10-23" Author="Nic Morris" Comment="Added Atlabase ID for 45 channel mode." Version="19" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="20" />
  <History Date="07-01-25" Author="Nic Morris" Comment="Created from Robe Robin Painte (hopeless documentation.  gobo 2 image has 7 slots+open but charts have 8+open)" Version="21" />
  <History Date="10-01-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="22" />

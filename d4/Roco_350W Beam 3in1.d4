      <Function ID="28" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="29" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="195~135" />
      <Function ID="30" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="31" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="129~75" />
      <Function ID="32" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour11" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colour12" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Colour2" ChannelOffset="13" Wheel="37" />
      <Attribute ID="Colour13" ChannelOffset="14" Wheel="38" />
      <Attribute ID="PT_Speed3" ChannelOffset="5" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="6" Wheel="25" />
      <Attribute ID="PT_Speed1" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="PL_MWLD1216" DiamondRef="" WysiwygRef="" />
    <Physical>

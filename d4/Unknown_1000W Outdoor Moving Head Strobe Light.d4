  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter_Effect" Name="Shutter Effect" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="3~5" />
      <Function ID="3" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~50" />
      <Function ID="4" Name="Ramp Down" Display="'Ramp Down'" Dmx="51~100" />
      <Function ID="5" Name="Ramp Up-Down" Display="'Ramp Up-Down'" Dmx="101~150" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="151~200" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">

      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="50~99" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="100~149" />
      <Function ID="4" Name="Col Fade In/Out" Display="'Col Fade In/Out'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />

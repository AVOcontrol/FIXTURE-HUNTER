  <Thumbnail>fdd09e34-161b-43f6-aa5d-e4a6be903d96</Thumbnail>
  <History Date="18-01-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="07-05-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (revises macro delay, adds head invert and removes wireless control functions/macros)" Version="3" />
  <History Date="04-09-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds modes 3 and 4)" Version="4" />
  <History Date="05-09-24" Author="Nic Morris" Comment="Added Atlabase IDs for modes 3 and 4." Version="5" />
  <History Date="09-09-24" Author="Nic Morris" Comment="Added vdim to mode 3 beam cells." Version="6" />
  <History Date="02-12-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds mode 5 and CCI Calibration + dimming start mode control functions/macros)" Version="7" />
  <History Date="03-12-24" Author="Nic Morris" Comment="Added Atlabase ID for 170 channel mode." Version="8" />
  <History Date="24-03-25" Author="Nic Morris" Comment="Created from ACME Tornado (TB 5 IP INT) (poor documentation.  vague.  no function ranges except control which contains two reset functions.  effectively identical except addition of 21 channel mode)" Version="9" />
  <History Date="28-03-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3eab902c-9797-4a31-b431-c99a8cf574d0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Lemon" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lemon C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Macro" Name="Ring Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Shutter" Name="Beam Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Shutter" Name="Ring Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="30~39" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="40~49" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="50~59" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="60~69" />
      <Function ID="6" Name="Reset (1)" Display="'Reset (1)'" Dmx="0~0" />
      <Function ID="7" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="160~169" />
      <Function ID="8" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="170~179" />
      <Function ID="9" Name="Reset (2)" Display="'Reset (2)'" Dmx="200~209" />
      <Function ID="10" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="210~219" />
      <Function ID="11" Name="Dim Spd Smooth" Display="'Dim Spd Smooth'" Dmx="220~229" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Master" Name="Beam Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Master" Name="Ring Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

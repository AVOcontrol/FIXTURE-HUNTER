    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Effect 1 Col" ID="2" If="'Effect_2'==1&amp;&amp;'Effect_1'==2" />
      <Condition Name="Effect 1 Spd" ID="3" If="'Effect_2'==1&amp;&amp;'Effect_1'&gt;3" />
      <Condition Name="Effect 2" ID="4,5,6,7,8,9,10,11" If="'Effect_2'&gt;1" />
      <Condition Name="Effect 1 Col + PT" ID="12" If="'Effect_2'==1&amp;&amp;'Effect_1'==3" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="5" Name="Step 1" Display="'Step 1'" Dmx="28~47" />

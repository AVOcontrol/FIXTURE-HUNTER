  <History Date="10-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Generic" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~19" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="20~29" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="30~39" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="40~49" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="50~59" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="60~69" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="70~79" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="80~89" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="90~99" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="100~109" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="110~119" />
      <Function ID="13" Name="No Function" Display="'No Function'" Dmx="120~139" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 3 DMX" Channels="3">
    <Import PearlRef="SGPXBM5W" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Generic" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 5 DMX" Channels="5">

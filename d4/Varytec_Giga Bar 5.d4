      <Function ID="20" Name="Sound 2" Display="'Sound 2'" Dmx="131~140" Update="Auto_Spd" />
      <Function ID="21" Name="Sound 3" Display="'Sound 3'" Dmx="141~150" Update="Auto_Spd" />

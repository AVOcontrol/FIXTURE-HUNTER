<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TecShow cuatroTEC II" ShortName="cuatroTEC2" Company="American Pro">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="20-06-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~9" Update="Effect_Spd" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="10~19" Update="Effect_Spd" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="20~29" Update="Effect_Spd" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="30~39" Update="Effect_Spd" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="40~49" Update="Effect_Spd" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="50~59" Update="Effect_Spd" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="60~69" Update="Effect_Spd" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="70~79" Update="Effect_Spd" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="80~89" Update="Effect_Spd" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="90~99" Update="Effect_Spd" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="100~109" Update="Effect_Spd" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="110~119" Update="Effect_Spd" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="120~129" Update="Effect_Spd" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="130~139" Update="Effect_Spd" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="140~149" Update="Effect_Spd" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="150~159" Update="Effect_Spd" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="160~169" Update="Effect_Spd" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="170~179" Update="Effect_Spd" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="180~189" Update="Effect_Spd" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="190~199" Update="Effect_Spd" />
      <Function ID="22" Name="Program 21" Display="'Program 21'" Dmx="200~209" Update="Effect_Spd" />
      <Function ID="23" Name="Program 22" Display="'Program 22'" Dmx="210~219" Update="Effect_Spd" />
      <Function ID="24" Name="Program 23" Display="'Program 23'" Dmx="220~229" Update="Effect_Spd" />
      <Function ID="25" Name="Program 24" Display="'Program 24'" Dmx="230~239" Update="Effect_Spd" />
      <Function ID="26" Name="Program 25" Display="'Program 25'" Dmx="240~249" Update="Effect_Spd" />
      <Function ID="27" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Effect'==27" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==13" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="1~22" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="23~45" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="46~68" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="Y" Display="'Y'" Dmx="69~91" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="W" Display="'W'" Dmx="92~114" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="YW" Display="'YW'" Dmx="115~137" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="RG" Display="'RG'" Dmx="138~160" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="RB" Display="'RB'" Dmx="161~183" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="GB" Display="'GB'" Dmx="184~206" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="207~229" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="RGBYW" Display="'RGBYW'" Dmx="230~252" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="253~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="P1" Channels="3">
    <Import PearlRef="ARTSCT21" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Effect" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Effect_Spd" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="P2" Channels="2">
    <Import PearlRef="ARTSCT22" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
    </Attribute>
    <Attribute ID="Draw" Name="Draw" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Speed" Name="Display Dot" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Length" Display="'Length %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="8~63" Colour="255,255,255" />
      <Function ID="3" Name="Change" Display="'Change %.f%%',0~100" Dmx="64~127" Colour="255,255,255" />
      <Function ID="4" Name="Flow" Display="'Flow %.f%%',0~100" Dmx="128~223" Colour="255,255,255" />
      <Function ID="5" Name="Drawing" Display="'Drawing %.f%%',0~100" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Analogue_Col" Name="Analogue Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

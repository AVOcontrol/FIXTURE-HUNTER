      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6,Colour_Func:1" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:3,Colour_Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour_Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:3,Colour_Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour_Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour_Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour_Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:2,Colour_Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:2,Colour_Func:1" />
      <Palette ID="11" Name="UV" Number="9" Page="1" SetControl="Colour1:8,Colour_Func:1" />
      <Palette ID="12" Name="UV" Number="10" Page="1" SetControl="Colour1:8,Colour_Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:6,Colour_Func:1" />
      <Palette ID="14" Name="UV" Number="8" Page="1" SetControl="Colour1:8,Colour_Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:2,Colour_Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />

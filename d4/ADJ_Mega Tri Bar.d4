<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mega Tri Bar" ShortName="Mega TriBr" Company="ADJ" Version="7">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="02-08-10" Author="Jonathan Moreton" Comment="Created" Version="1" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Added v-dim to 3 DMX mode.  Replaced Red,Green,Blue with Red1,Green1,Blue1 in 12 DMX mode." Version="2" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed 54 DMX wheel mapping to avoid builder errors." Version="3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="4" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="5" />
  <History Date="21-11-17" Author="Nic Morris" Comment="Replaced 12 DMX mode dimmer with master dimmer and fixed cell dimmer link in attempt to fix customer bug report." Version="6" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Mega Tri Bar.d4 to ADJ_Mega Tri Bar.d4." Version="7" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e58ff11c-1266-41fd-9323-f573c7900469" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~21" Update="Auto_Spd" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="22~32" Update="Auto_Spd" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="33~43" Update="Auto_Spd" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="44~54" Update="Auto_Spd" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="55~65" Update="Auto_Spd" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="66~76" Update="Auto_Spd" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="77~87" Update="Auto_Spd" />
      <Function ID="9" Name="Slow Dream" Display="'Slow Dream'" Dmx="88~98" Update="Auto_Spd" />
      <Function ID="10" Name="Fast Dream" Display="'Fast Dream'" Dmx="99~109" Update="Auto_Spd" />
      <Function ID="11" Name="Colour Fade" Display="'Colour Fade'" Dmx="110~120" Update="Auto_Spd" />
      <Function ID="12" Name="Colour Change" Display="'Colour Change'" Dmx="121~131" Update="Auto_Spd" />
      <Function ID="13" Name="Flow 1" Display="'Flow 1'" Dmx="132~142" Update="Auto_Spd" />
      <Function ID="14" Name="Flow 2" Display="'Flow 2'" Dmx="143~153" Update="Auto_Spd" />
      <Function ID="15" Name="Flow 3" Display="'Flow 3'" Dmx="154~164" Update="Auto_Spd" />
      <Function ID="16" Name="Flow 4" Display="'Flow 4'" Dmx="165~175" Update="Auto_Spd" />
      <Function ID="17" Name="Double Flow 1" Display="'Double Flow 1'" Dmx="176~186" Update="Auto_Spd" />
      <Function ID="18" Name="Double Flow 2" Display="'Double Flow 2'" Dmx="187~197" Update="Auto_Spd" />
      <Function ID="19" Name="Multi Colour" Display="'Multi Colour'" Dmx="198~208" Update="Auto_Spd" />
      <Function ID="20" Name="2 Colour Flow 1" Display="'2 Colour Flow 1'" Dmx="209~219" Update="Auto_Spd" />
      <Function ID="21" Name="2 Colour Flow 2" Display="'2 Colour Flow 2'" Dmx="220~230" Update="Auto_Spd" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="231~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==22" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

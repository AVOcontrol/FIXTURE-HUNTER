    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2||'Gobo1Func'==7||'Gobo1Func'==6" />
      <Condition Name="Speed" ID="9,10" If="'Gobo1Func'==3||'Gobo1Func'==4||'Gobo1Func'==5||'Gobo1Func'==8||'Gobo1Func'==9||'Gobo1Func'==10" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>24be5ace-9b82-4b17-9167-8bc2474840f6</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Wiggle Lines)" Display="'Gobo 1 (Wiggle Lines)'" Dmx="16~31" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>df13223c-5d3c-4eb7-b7a3-8a65f3411bfe</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Mycelium)" Display="'Gobo 2 (Mycelium)'" Dmx="32~47" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>e92d6326-7462-4992-b9f0-ee6894f44b4b</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Bobs Brush)" Display="'Gobo 3 (Bobs Brush)'" Dmx="48~63" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>5625bcd3-69ce-431b-afb9-75be72850a58</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (The Claw)" Display="'Gobo 4 (The Claw)'" Dmx="64~79" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>19e71efb-696d-45d4-afe1-14c0540f268d</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Cut Cone)" Display="'Gobo 5 (Cut Cone)'" Dmx="80~95" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>65014a4c-ee26-4e74-934f-e189c036cc29</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Split-S)" Display="'Gobo 6 (Split-S)'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>360b157b-5fe7-4238-ae92-7d2cb2a92cd7</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Ice)" Display="'Gobo 7 (Ice)'" Dmx="112~127">
        <Swatch>0c38bcbe-de50-4dc6-b502-d6218e1e1fc2</Swatch>
      </Function>
      <Function ID="9" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_1_Rot_Fnc" Name="Gobo 1 Rot Fnc" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="16~31" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="32~47" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="48~63" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CCW" Display="'Anim CCW'" Dmx="64~79" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo_1_Rot_Fnc'==1" />
      <Condition Name="Spin" ID="2,3" If="'Gobo_1_Rot_Fnc'&gt;1&amp;&amp;'Gobo_1_Rot_Fnc'&lt;6" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1024~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

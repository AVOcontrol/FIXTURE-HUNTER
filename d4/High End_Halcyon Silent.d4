      <Function ID="7" Name="mSpeed Scan" Display="'mSpeed Scan'" Dmx="176~191" Update="Gobo1" />
      <Function ID="8" Name="mSpeed Scroll CW" Display="'mSpeed Scroll CW'" Dmx="144~159" Update="Gobo1" />
      <Function ID="9" Name="mSpeed Scroll CCW" Display="'mSpeed Scroll CCW'" Dmx="160~175" Update="Gobo1" />

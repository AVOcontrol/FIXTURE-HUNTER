      <Function ID="21" Name="Grn/ Org" Display="'Grn/ Org %.f%%',0~100" Dmx="90~119" Colour="255,255,255" />
      <Function ID="22" Name="Org/ D Blu" Display="'Org/ D Blu %.f%%',0~100" Dmx="120~149" Colour="255,150,0" />
      <Function ID="23" Name="D Blu/ CTB" Display="'D Blu/ CTB %.f%%',0~100" Dmx="150~179" Colour="0,0,200" />
      <Function ID="24" Name="CTB/ Op" Display="'CTB/ Op %.f%%',0~100" Dmx="180~255" Colour="255,255,255" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed Fixed" Display="'Full Speed Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Full Speed Scan" Display="'Full Speed Scan'" Dmx="48~63" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Full Speed Scroll CW" Display="'Full Speed Scroll CW'" Dmx="16~31" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Full Speed Scroll CCW" Display="'Full Speed Scroll CCW'" Dmx="32~47" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Full Speed Random" Display="'Full Speed Random'" Dmx="64~79" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

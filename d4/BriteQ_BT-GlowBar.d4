<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-GlowBar" ShortName="BT-GlowBar" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-10-17" Author="Nic Morris" Comment="Created" />
  <History Date="14-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="44de93ad-65b9-48c9-85a3-995824293a53" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe (dimmed)" Display="'Strobe (dimmed)'" Dmx="8~27" />
      <Function ID="3" Name="Strobe (full)" Display="'Strobe (full)'" Dmx="28~47" />
      <Function ID="4" Name="Scan R-&gt;L-&gt;R" Display="'Scan R-&gt;L-&gt;R'" Dmx="48~67" />
      <Function ID="5" Name="Fast Scan R-&gt;L" Display="'Fast Scan R-&gt;L'" Dmx="68~87" />
      <Function ID="6" Name="Fast Scan L-&gt;R" Display="'Fast Scan L-&gt;R'" Dmx="88~107" />
      <Function ID="7" Name="Full On" Display="'Full On'" Dmx="108~127" />
      <Function ID="8" Name="Pixel Scan Center Out" Display="'Pixel Scan Center Out'" Dmx="128~147" />
      <Function ID="9" Name="3 Pix Scan L-&gt;R" Display="'3 Pix Scan L-&gt;R'" Dmx="148~167" />
      <Function ID="10" Name="Fast Strobe All Pix" Display="'Fast Strobe All Pix'" Dmx="168~255" />
    </Attribute>
    <Attribute ID="White_Pix_Dim" Name="White Pix Dim" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program1" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Program 1" Display="'Program 1'" Dmx="0~0" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="8~31" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="32~55" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="56~79" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="80~103" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="104~127" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="128~151" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="152~175" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="176~199" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="200~223" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="224~247" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White_Master" Name="White Master" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

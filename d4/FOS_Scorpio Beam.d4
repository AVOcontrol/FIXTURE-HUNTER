      <Function ID="25" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="154~161" WheelPosition="9" />
      <Function ID="26" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="162~169" WheelPosition="10" />
      <Function ID="27" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="170~177" WheelPosition="11" />

      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="70~74" WheelPosition="14" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="90~97" WheelPosition="1" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="98~105" WheelPosition="2" />

      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~14" />
      <Function ID="3" Name="PTSP Normal" Display="'PTSP Normal'" Dmx="40~44" />
      <Function ID="4" Name="PTSP Fast" Display="'PTSP Fast'" Dmx="45~49" />
      <Function ID="5" Name="PTSP Slow" Display="'PTSP Slow'" Dmx="50~54" />

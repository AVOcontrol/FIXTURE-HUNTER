  <History Date="19-09-08" Author="David Hunt" Comment="Created" Version="1" />
  <History Date="06-10-08" Author="Jonathan Moreton" Comment="Checked" Version="2" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="3" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Removed value.  Replaced with Dimmer for HTP.  Fixed power on and locate." Version="4" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Increased wheel resolution.  Added v-dim.  Added palettes." Version="5" />
  <History Date="13-05-13" Author="Peter Budd" Comment="Created from Chauvet COLORado Panel." Version="6" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="7" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="8" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's.  Removed unused ID attribute." Version="9" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Changed name from Colorado Deco Quad-1 Tour to COLORado Deco Quad-1 Tour.  Revised mode names." Version="10" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Revised colour macro functions and names.  Removed conditions from red and green (not documented and would never be met)" Version="11" />
  <History Date="28-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" Version="12" />
  <History Date="22-02-23" Author="Nic Morris" Comment="Fixed white DMX end value in response to customer bug report (was set to zero instead of 255).  Added product thumbnail." Version="13" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5b5adb0b-8cd1-4ff9-9807-ca865091b8b7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBW 100%" Display="'RGBW 100%'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="41~50" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~60" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~70" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="71~80" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="81~90" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="91~100" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="101~110" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~120" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~130" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />

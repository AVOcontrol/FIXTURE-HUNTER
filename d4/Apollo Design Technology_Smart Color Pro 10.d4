      <Function ID="2" Name="Frame 2" Display="'Frame 2'" Dmx="16~16" Colour="255,255,255" />
      <Function ID="3" Name="Frame 3" Display="'Frame 3'" Dmx="32~32" Colour="255,255,255" />
      <Function ID="4" Name="Frame 4" Display="'Frame 4'" Dmx="47~47" Colour="255,255,255" />

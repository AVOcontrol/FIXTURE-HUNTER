      <Function ID="7" Name="Frame 7" Display="'Frame 7'" Dmx="91~91" Colour="255,255,255" />
      <Function ID="8" Name="Frame 8" Display="'Frame 8'" Dmx="106~106" Colour="255,255,255" />
      <Function ID="9" Name="Frame 9" Display="'Frame 9'" Dmx="120~120" Colour="255,255,255" />
      <Function ID="10" Name="Frame 10" Display="'Frame 10'" Dmx="134~134" Colour="255,255,255" />

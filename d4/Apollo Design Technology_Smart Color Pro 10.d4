      <Function ID="18" Name="Frame 18" Display="'Frame 18'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />

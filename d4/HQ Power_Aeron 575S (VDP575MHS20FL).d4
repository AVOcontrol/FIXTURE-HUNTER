      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="43~49" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="6500K" Display="'6500K'" Dmx="50~56" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="3200K" Display="'3200K'" Dmx="57~63" WheelPosition="8" Colour="230,230,255" />

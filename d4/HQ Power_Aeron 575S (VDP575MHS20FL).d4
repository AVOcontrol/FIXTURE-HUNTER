      <Function ID="16" Name="D Cy/ Yel" Display="'D Cy/ Yel'" Dmx="106~112" Colour="0,0,0" />
      <Function ID="17" Name="Yel/ 6500K" Display="'Yel/ 6500K'" Dmx="113~119" WheelPosition="6" Colour="0,0,0" />
      <Function ID="18" Name="6500K/ 3200K" Display="'6500K/ 3200K'" Dmx="120~127" WheelPosition="7" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="255~192" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW     %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Spider" ShortName="MiniSpider" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="8~17" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="18~27" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="28~37" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="38~47" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="48~57" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="58~67" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="68~77" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="78~87" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="88~97" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="98~107" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="108~117" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="118~127" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="128~136" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="137~146" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="147~156" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="157~166" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="167~176" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="177~186" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="187~196" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="197~206" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="207~216" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="217~226" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="227~236" />
      <Function ID="25" Name="Effect 24 (Stand-Alone)" Display="'Effect 24 (Stand-Alone)'" Dmx="237~246" />
      <Function ID="26" Name="Effect 25 (Sound)" Display="'Effect 25 (Sound)'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="241~250" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="135" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Effect" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Effect_Spd" ChannelOffset="6" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Tilt 1" ChannelOffset="1" ModeLink="Tilt Cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="2" ModeLink="Tilt Cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PIXIEWASH" ShortName="PIXIEWASH" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="14-12-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2e341292-fc25-4ca9-b9da-6e273c380b39" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~49" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="50~99" />
      <Function ID="3" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="150~199" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~19" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="20~39" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="40~59" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="60~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="80~99" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="8,9,10,11,12,13" If="'Colour1Func'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="8" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="13" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~51" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Medium" Display="'Medium'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="PGPXWS13" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bbf4dfcd-dbce-4815-9cce-22f3273b0d96" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="13" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="PGPXWS16" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9a250e9c-e102-489c-80f2-33eef9212d65" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Colour1Func" ChannelOffset="13" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Dim_Spd" ChannelOffset="16" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

  <History Date="03-11-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d2f70437-57de-4824-a86e-2e0c19f8a47c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~42" Update="Program_Spd" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="43~85" Update="Program_Spd" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="86~128" Update="Program_Spd" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="129~171" Update="Program_Spd" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="172~214" Update="Program_Spd" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="215~255" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Program 1" ID="2,3,4,5" If="'Program'==2" />
      <Condition Name="Sound" ID="6" If="'Program'==7" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="3" Name="Warm White" Display="'Warm White'" Dmx="64~127" />
      <Function ID="4" Name="Cold White" Display="'Cold White'" Dmx="128~191" />
      <Function ID="5" Name="All" Display="'All'" Dmx="192~255" />
      <Function ID="6" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2" Id="0c063960-34af-4e86-9d53-d05d88453375">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a9361c94-07c2-4092-ba61-1b1c85a8cf6f" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6" Id="310a2083-e4f0-480c-86b2-edd0d38626d5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d6a3a5a9-60d8-4680-931e-6d323a6600b3" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Program" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>

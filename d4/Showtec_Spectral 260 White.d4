<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Spectral 260 White" ShortName="Spectl 260" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="19-10-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'White C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Cool_White" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="3400K" Display="'3400K'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="4900K" Display="'4900K'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="S1.DS, 5 DMX" Channels="5">
    <Import PearlRef="SH_Sp260WDS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Warm_White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cool_White" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="STD.W, 2 DMX" Channels="2">
    <Import PearlRef="SH_Sp260WDW" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Warm_White" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Cool_White" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="STD.D, 3 DMX" Channels="3">
    <Import PearlRef="SH_Sp260WDD" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Warm_White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cool_White" ChannelOffset="3" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="STD.1, 2 DMX" Channels="2">
    <Import PearlRef="SH_Sp260WD1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
</Fixture>
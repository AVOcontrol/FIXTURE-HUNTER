      </Function>
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="54~197" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="198~226" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="227~255" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="3,4,5,6,7,8" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="9" />
      <Function ID="1" Name="No function" Display="'No function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~171" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="172~215" />
      <Function ID="7" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="8" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="216~255" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Protron Color" ShortName="Pro Color" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-09-04" Author="Phil Rogers" Comment="Created" />
  <History Date="27-09-04" Author="Tom Peck" Comment="Checked" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="17-11-17" Author="Nic Morris" Comment="Changed name from Proton Color to Protron Color.  Added Atlabase ID's." />
  <History Date="17-11-17" Author="Nic Morris" Comment="Standardised conditionals.  Moved raw function into else condition and fixed duplicate functions." />
  <History Date="17-11-17" Author="Nic Morris" Comment="Added colour function index.  Increased wheel resolution.  Renamed Time to Duration and changed to intensity group." />
  <History Date="17-11-17" Author="Nic Morris" Comment="Revised colour spd display range and moved to colour wheel slot." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ac6ef31b-9a68-4f42-98f7-819b7528cecd" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.f',0~16" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Macro" Display="'Macro'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="5,6,7,8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Condition Name="Macro" ID="13,14" If="'Colour1Func'==4" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~47" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~79" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~111" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~31" WheelPosition="0" Colour="255,255,255" />
      <Function ID="6" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="48~63" WheelPosition="1" Colour="255,0,0" />
      <Function ID="7" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="80~95" WheelPosition="2" Colour="255,255,0" />
      <Function ID="8" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="112~127" WheelPosition="3" Colour="0,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="128~144" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="176~191" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="128~144" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="145~159" Colour="0,0,0" />
      <Function ID="13" Name="No Macro " Display="'No Macro'" Dmx="192~207" Colour="0,0,0" />
      <Function ID="14" Name="Macro " Display="'Macro'" Dmx="208~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Spd" Name="Colour Spd" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="ELPrtnColor" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bdb5a53b-7dd8-4622-a752-867cae76904c" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Duration" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Colour_Spd" ChannelOffset="5" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
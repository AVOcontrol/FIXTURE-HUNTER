      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~64" Intensity="0~0" />
      <Function ID="3" Name="No Strobe" Display="'No Strobe'" Dmx="65~69" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="70~129" Intensity="0~0" />
      <Function ID="5" Name="No Strobe" Display="'No Strobe'" Dmx="130~134" Intensity="0~0" />

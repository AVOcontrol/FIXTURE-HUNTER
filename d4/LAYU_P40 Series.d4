      <Function ID="6" Name="Move 3 Column R&gt;L" Display="'Move 3 Column R&gt;L'" Dmx="50~59" />
      <Function ID="7" Name="Move 3 Column L&lt;R" Display="'Move 3 Column L&lt;R'" Dmx="60~69" />
      <Function ID="8" Name="Move 3 Column Bounce" Display="'Move 3 Column Bounce'" Dmx="70~79" />
      <Function ID="9" Name="Move 2 Rows TR&gt;BL" Display="'Move 2 Rows TR&gt;BL'" Dmx="80~89" />
      <Function ID="10" Name="Move 2 Rows BR-&gt;TL" Display="'Move 2 Rows BR-&gt;TL'" Dmx="90~99" />
      <Function ID="11" Name="Move 2 Rows BL&gt;TR" Display="'Move 2 Rows BL&gt;TR'" Dmx="100~109" />
      <Function ID="12" Name="Move 2 Rows TL&gt;BR" Display="'Move 2 Rows TL&gt;BR'" Dmx="110~119" />
      <Function ID="13" Name="Move 2 Rows TR&gt;BL+BR&gt;TL" Display="'Move 2 Rows TR&gt;BL+BR&gt;TL'" Dmx="120~129" />
      <Function ID="14" Name="Move 2 Rows TL&gt;BR+BR&gt;TL" Display="'Move 2 Rows TL&gt;BR+BR&gt;TL'" Dmx="130~139" />
      <Function ID="15" Name="Move 2 Rows BL&gt;TR+TL&gt;BR+TR&gt;BL+BR&gt;TL" Display="'Move 2 Rows BL&gt;TR+TL&gt;BR+TR&gt;BL+BR&gt;TL'" Dmx="140~149" />
      <Function ID="16" Name="Discrete Points Flash" Display="'Discrete Points Flash'" Dmx="150~159" />
      <Function ID="17" Name="Discrete Points Flash+Update" Display="'Discrete Points Flash+Update'" Dmx="160~169" />
      <Function ID="18" Name="Odd/Even Discrete Points Flash" Display="'Odd/Even Discrete Points Flash'" Dmx="170~179" />
      <Function ID="19" Name="Rectangle Zoom Out" Display="'Rectangle Zoom Out'" Dmx="180~189" />
      <Function ID="20" Name="Rectangle Zoom In" Display="'Rectangle Zoom In'" Dmx="190~199" />
      <Function ID="21" Name="Rectangle Bounce" Display="'Rectangle Bounce'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode1" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="30~59" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="60~89" />
      <Function ID="4" Name="DMX (Manual)" Display="'DMX (Manual)'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

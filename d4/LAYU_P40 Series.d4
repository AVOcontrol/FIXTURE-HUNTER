  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="30~59" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="60~89" />
      <Function ID="4" Name="Auto+Speed" Display="'Auto+Speed'" Dmx="90~119" />
      <Function ID="5" Name="Sound+Speed" Display="'Sound+Speed'" Dmx="120~149" />
      <Function ID="6" Name="DMX (Effect)" Display="'DMX (Effect)'" Dmx="150~179" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All On" Display="'All On'" Dmx="0~0" />
      <Function ID="2" Name="All Flash" Display="'All Flash'" Dmx="10~19" />
      <Function ID="3" Name="Move 2 Rows Dn&gt;Up" Display="'Move 2 Rows Dn&gt;Up'" Dmx="20~29" />

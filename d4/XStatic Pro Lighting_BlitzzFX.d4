      <Function ID="2" Name="Enable (Preheat On)" Display="'Enable (Preheat On)'" Dmx="50~100" />
      <Function ID="3" Name="Clean" Display="'Clean'" Dmx="150~200" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">

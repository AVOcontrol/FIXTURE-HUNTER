<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Move Strobe 1500 IPX" ShortName="MSt1500IPX" Company="Lyte" Version="22">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="20-11-21" Author="Nic Morris" Comment="Created (pixel layout not documented - guessed)" Version="0" />
  <History Date="25-03-22" Author="Nic Morris" Comment="Updated in line with rev 4 charts (revises all existing control function ranges and adds new control functions/macros).  Note these are currently different to the latest manual available (rev 2)." Version="11" />
  <History Date="25-03-22" Author="Nic Morris" Comment="Thoroughly checked all other elements and found everything is exact match and agree with current Capture simulation.  Pixel layout now documented and guess was correct." Version="11" />
  <History Date="26-08-22" Author="Nic Morris" Comment="Added multi-part patch options for the 97 and 74 channel modes." Version="12" />
  <History Date="20-09-22" Author="Nic Morris" Comment="Corrected 3rd part name of 74 channel mode multi-part option (previously the 2nd and 3rd part both said 'plate'.  the 3rd part now says 'beam')" Version="13" />
  <History Date="27-10-22" Author="Nic Morris" Comment="Updated in line with latest documentation (Rev 6) (adds 47 channel mode)" Version="14" />
  <History Date="02-11-22" Author="Nic Morris" Comment="Added 47 channel mode Atlabase ID." Version="15" />
  <History Date="06-03-24" Author="Nic Morris" Comment="Updated in line with latest documentation (Rev 7) (adds 68 channel mode)" Version="16" />
  <History Date="08-03-24" Author="Nic Morris" Comment="Added Atlabase IDs for 68 channel mode." Version="17" />
  <History Date="20-05-24" Author="Nic Morris" Comment="Added multi-part patch options for the 68 channel mode." Version="18" />
  <History Date="18-06-25" Author="Nic Morris" Comment="Added multi-part patch options for remaining modes." Version="19" />
  <History Date="07-04-26" Author="Nic Morris" Comment="Revised 68 channel mode control function dmx ranges in line with latest documentation." Version="20" />
  <History Date="03-06-26" Author="Nic Morris" Comment="Created from Chauvet Color STRIKE M (identical.  DMX charts are clearly taken straight from the Chauvet documentation.  function ranges for channels 15-19 in 68 channel mode don't make sense.  used Chauvet Color STRIKE M ranges for now)" Version="21" />
  <History Date="16-06-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="22" />

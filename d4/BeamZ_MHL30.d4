  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0144dcc0-dacd-4500-aa27-978d66c13a64" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="16~23" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="32~39" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="48~55" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="64~71" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="80~87" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="96~103" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="112~119" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Op/ 1" Display="'Op/ 1'" Dmx="8~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="1/ 2" Display="'1/ 2'" Dmx="24~31" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="2/ 3" Display="'2/ 3'" Dmx="40~47" WheelPosition="2" Colour="0,0,0" />
      <Function ID="12" Name="3/ 4" Display="'3/ 4'" Dmx="56~63" WheelPosition="3" Colour="0,0,0" />
      <Function ID="13" Name="4/ 5" Display="'4/ 5'" Dmx="72~79" WheelPosition="4" Colour="0,0,0" />
      <Function ID="14" Name="5/ 6" Display="'5/ 6'" Dmx="88~95" WheelPosition="5" Colour="0,0,0" />
      <Function ID="15" Name="6/ 7" Display="'6/ 7'" Dmx="104~111" WheelPosition="6" Colour="0,0,0" />
      <Function ID="16" Name="7/ Op" Display="'7/ Op'" Dmx="120~127" WheelPosition="7" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~192" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Gobo1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="21~41" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="42~62" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="63~83" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="84~104" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="105~125" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="126~127" WheelPosition="6" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~192" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~115" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="244~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="116~243" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="150~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="585" TiltMax="225" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d396d54d-cba4-46fb-8b47-726fe20bdb0f" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="3" Wheel="15" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5,8" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,9" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>

  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="FU_PHW575P" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

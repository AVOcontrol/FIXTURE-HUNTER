    </Physical>
    <AtlaBase ModeID="df29c531-bf8f-4145-aa18-1822fe59ce77" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="13" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,15" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,16" Wheel="3" />

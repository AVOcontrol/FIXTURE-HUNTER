  <AtlaBase TypeID="459b8334-d534-44d7-9abe-956826ef0266" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~225" />
      <Function ID="2" Name="BO P/T" Display="'BO P/T'" Dmx="226~235" />
      <Function ID="3" Name="BO Colour Change" Display="'BO Colour     Change'" Dmx="236~245" />
      <Function ID="4" Name="Safe" Display="'Safe'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split_Func" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll_Func" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func" ID="1,3,5,7,9,11,13,15,17" If="'Colour1Func'==1" />
      <Condition Name="Split_Func" ID="2,4,6,8,10,12,14,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll_Func" ID="18,19,20,21" If="'Colour1Func'==3" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Open/Red" Display="'Open/Red %.f%%',0~100" Dmx="1~13" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="14~14" Colour="255,0,0" />
      <Function ID="4" Name="Red/Blue" Display="'Red/Blue %.f%%',0~100" Dmx="15~27" Colour="255,0,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="28~28" Colour="0,0,255" />
      <Function ID="6" Name="Blue/Green" Display="'Blue / Green  %.f%%',0~100" Dmx="29~41" Colour="0,0,255" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="42~42" Colour="0,255,0" />
      <Function ID="8" Name="Green/Light Yellow" Display="'Green / Light Yellow %.f%%',0~100" Dmx="43~55" Colour="0,255,0" />
      <Function ID="9" Name="Light Yellow" Display="'Light Yellow'" Dmx="56~56" Colour="255,255,128" />
      <Function ID="10" Name="Light Yellow/Rose" Display="'Light Yellow / Rose %.f%%',0~100" Dmx="57~69" Colour="255,255,128" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="70~70" Colour="255,0,127" />
      <Function ID="12" Name="Magenta/CTO" Display="'Magenta/CTO %.f%%',0~100" Dmx="71~83" Colour="255,0,127" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="84~84" Colour="255,240,200" />
      <Function ID="14" Name="CTO/CTB" Display="'CTO/CTB %.f%%',0~100" Dmx="85~97" Colour="255,240,200" />
      <Function ID="15" Name="CTB" Display="'CTB'" Dmx="98~98" Colour="230,230,255" />
      <Function ID="16" Name="CTB/UV" Display="'CTB/UV %.f%%',0~100" Dmx="99~111" Colour="230,230,255" />
      <Function ID="17" Name="UV" Display="'UV'" Dmx="112~187" Colour="180,0,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="188~127" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="255,255,255" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />

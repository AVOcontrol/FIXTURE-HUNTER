      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="40" />
      <Attribute ID="Static_Effect" ChannelOffset="14" Wheel="22" />
      <Attribute ID="Dynamic_Effect" ChannelOffset="15" Wheel="23" />
      <Attribute ID="Effect_Spd" ChannelOffset="16" Wheel="24" />
      <Attribute ID="Macro" ChannelOffset="17" Wheel="52" />
      <Attribute ID="Control" ChannelOffset="18" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

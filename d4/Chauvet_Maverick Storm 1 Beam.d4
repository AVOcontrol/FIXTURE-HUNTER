      <Attribute ID="Prism_2" ChannelOffset="16" Wheel="53" />
      <Attribute ID="Prism_2_Rot" ChannelOffset="17" Wheel="54" />
      <Attribute ID="Frost" ChannelOffset="18" Wheel="20" />
      <Attribute ID="Focus" ChannelOffset="19,20" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="21" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:10" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:19" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:16" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:11" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:12" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~22" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="34~45" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="57~68" />
      <Function ID="8" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="23~33" />
      <Function ID="9" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="46~56" />
      <Function ID="10" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="69~79" />
      <Function ID="11" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Warm White" Display="'Warm White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="WW-&gt;3200K" Display="'WW-&gt;3200K %.f%%',0~100" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="3200K (Halogen White)" Display="'3200K (Halogen White)'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="4" Name="3200-4000K" Display="'3200-4000K %.fK',3200~4000" Dmx="0~0" Colour="255,255,255" />
      <Function ID="5" Name="4000K (Neutral White)" Display="'4000K (Neutral White)'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="4000-5600K" Display="'4000-5600K %.fK',4000~5600" Dmx="0~0" Colour="255,255,255" />
      <Function ID="7" Name="5600K (Studio White)" Display="'5600K (Studio White)'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="5600-6500K" Display="'5600-6500K %.fK',5600~6500" Dmx="0~0" Colour="255,255,255" />
      <Function ID="9" Name="6500K (Daylight White)" Display="'6500K (Daylight White)'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="6500K-CW" Display="'6500K-CW %.f%%',0~100" Dmx="0~0" Colour="255,255,255" />
      <Function ID="11" Name="Cold White" Display="'Cold White'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="DMX_Delay" Name="DMX Delay" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Delay" Display="'No Delay'" Dmx="0~0" />
      <Function ID="2" Name="Delay" Display="'Delay %.fms',100~2000" Dmx="6~255" />
    </Attribute>
  </Control>

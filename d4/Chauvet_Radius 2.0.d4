  <AtlaBase TypeID="675eb35f-23ba-4148-b671-ba4131ffec97" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~39" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~69" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="70~99" />
      <Function ID="5" Name="White" Display="'White'" Dmx="100~129" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="130~159" />
      <Function ID="7" Name="All Colours" Display="'All Colours'" Dmx="160~189" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Cluster S2" ShortName="Cluster S2" Company="ROXX" Version="30">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>8e50c848-52f7-4f53-ad80-55ec3dee0f5b</Thumbnail>
  <History Date="19-04-23" Author="Nic Morris" Comment="Created (note 'Easy' mode charts say 32 channels but contain channel conflicts.  Assumed is 35 for now)" Version="0" />
  <History Date="14-06-23" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds 'V4' modes and adds '16bit' to existing 'Pure' mode to differentiate from the new 8bit option)" Version="13" />
  <History Date="14-06-23" Author="Nic Morris" Comment="(note there are discrepencies between the channel counts in various headers compared to the actual number of controls listed)" Version="14" />
  <History Date="14-06-23" Author="Nic Morris" Comment="(the overview for Full Access V4 and Full Access Extended V4 both have one fewer channels than in the detailed charts (RGB 1+2 CTC on offsets 177 and 274 respectively.  Assumed full charts are correct and ignored overview/headers)" Version="14" />
  <History Date="14-06-23" Author="Nic Morris" Comment="(control functions are not backwards compatible.  these sort of firmware changes are very poorly considered)" Version="14" />
  <History Date="17-06-23" Author="Nic Morris" Comment="Added 'V3' modes." Version="25" />
  <History Date="12-02-26" Author="Nic Morris" Comment="Added multipart patch options for Simple mode." Version="30" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e208495b-35cd-4abe-afb5-46357977ff58" />

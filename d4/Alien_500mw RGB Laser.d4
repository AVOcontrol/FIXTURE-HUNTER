    <Attribute ID="Tilt" Name="Vert Pos" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Center" Display="'Center'" Dmx="0~0" />
      <Function ID="2" Name="Up" Display="'Up %.f%%',0~100" Dmx="1~32" />
      <Function ID="3" Name="Down" Display="'Down %.f%%',0~100" Dmx="33~63" />

    <Attribute ID="Zoom" Name="Size" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'Size %.f%%',0~100" Dmx="63~0" />
      <Function ID="2" Name="Open Puse" Display="'Open Puse %.f%%',0~100" Dmx="64~127" />

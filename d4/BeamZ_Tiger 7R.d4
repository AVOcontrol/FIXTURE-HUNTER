      <Function ID="12" Name="Light Yellow" Display="'Light Yellow'" Dmx="110~114" WheelPosition="11" Colour="255,255,128" />
      <Function ID="13" Name="Light Blue" Display="'Light Blue'" Dmx="120~124" WheelPosition="12" Colour="0,128,255" />
      <Function ID="14" Name="Amaranth" Display="'Amaranth'" Dmx="130~134" WheelPosition="13" Colour="255,255,255" />
      <Function ID="15" Name="Kelly" Display="'Kelly'" Dmx="140~144" WheelPosition="14" Colour="0,255,0" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />

      <Function ID="22" Name="CTO/ L Blu Ppl" Display="'CTO/ L Blu Ppl'" Dmx="65~69" WheelPosition="6" Colour="255,240,200" />
      <Function ID="23" Name="L Blu Ppl/ Brn" Display="'L Blu Ppl/ Brn'" Dmx="75~79" WheelPosition="7" Colour="0,128,255" />
      <Function ID="24" Name="Brn/ Org" Display="'Brn/ Org'" Dmx="85~89" WheelPosition="8" Colour="255,240,200" />
      <Function ID="25" Name="Org/ D Blu" Display="'Org/ D Blu'" Dmx="95~99" WheelPosition="9" Colour="255,128,0" />
      <Function ID="26" Name="D Blu/ L Yel" Display="'D Blu/ L Yel'" Dmx="105~109" WheelPosition="10" Colour="0,0,180" />
      <Function ID="27" Name="L Yel/ L Blu" Display="'L Yel/ L Blu'" Dmx="115~119" WheelPosition="11" Colour="255,255,128" />
      <Function ID="28" Name="L Blu/ Am" Display="'L Blu/ Am'" Dmx="125~129" WheelPosition="12" Colour="0,128,255" />
      <Function ID="29" Name="Am/ Kelly" Display="'Am/ Kelly'" Dmx="135~139" WheelPosition="13" Colour="255,255,255" />
      <Function ID="30" Name="Kelly/ Op" Display="'Kelly/ Op'" Dmx="145~149" WheelPosition="14" Colour="0,255,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="150~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />

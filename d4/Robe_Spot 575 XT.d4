      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~1" />
      <Function ID="2" Name="Max Speed (Tracking)" Display="'Max Speed (Tracking)'" Dmx="0~0" />

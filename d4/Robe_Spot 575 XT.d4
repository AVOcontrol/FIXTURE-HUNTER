      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="191~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="192~223" Iris="0~0" Zoom="0~0" />

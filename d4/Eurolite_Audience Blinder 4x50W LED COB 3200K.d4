<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Audience Blinder 4x50W LED COB 3200K" ShortName="Blind 4x50" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-02-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8e17e72b-5b1f-4e43-b594-50b963ccae99" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Master_Dimmer" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="25~49" Update="Master_Dimmer" />
      <Function ID="3" Name="Meteor" Display="'Meteor'" Dmx="50~74" Update="Master_Dimmer" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="75~99" Update="Master_Dimmer" />
      <Function ID="5" Name="Change" Display="'Change'" Dmx="100~124" Update="Master_Dimmer" />
      <Function ID="6" Name="Flow 1" Display="'Flow 1'" Dmx="125~149" Update="Master_Dimmer" />
      <Function ID="7" Name="Flow 2" Display="'Flow 2'" Dmx="150~174" Update="Master_Dimmer" />
      <Function ID="8" Name="Flow 3" Display="'Flow 3'" Dmx="175~199" Update="Master_Dimmer" />
      <Function ID="9" Name="No Function" Display="'No Function'" Dmx="200~255" Update="Master_Dimmer" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Effect'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Curve" Display="'No Curve'" Dmx="0~0" />
      <Function ID="2" Name="Halogen Linear" Display="'Halogen Linear'" Dmx="16~45" />
      <Function ID="3" Name="Halogen Square" Display="'Halogen Square'" Dmx="46~75" />
      <Function ID="4" Name="Halogen Inv Sq" Display="'Halogen Inv Sq'" Dmx="76~105" />
      <Function ID="5" Name="Halogen S-Curve" Display="'Halogen S-Curve'" Dmx="106~135" />
      <Function ID="6" Name="LED Linear" Display="'LED Linear'" Dmx="136~165" />
      <Function ID="7" Name="LED Square" Display="'LED Square'" Dmx="166~195" />
      <Function ID="8" Name="LED Inv Sq" Display="'LED Inv Sq'" Dmx="196~225" />
      <Function ID="9" Name="LED S-Curve" Display="'LED S-Curve'" Dmx="226~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="62dadb76-2c0c-4711-91c7-3693c6891854" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
        <Attribute ID="Dim_Spd" ChannelOffset="6" Wheel="25" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

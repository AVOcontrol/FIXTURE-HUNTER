    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Scan" Display="'Scan'" Dmx="64~79" Update="Colour2" Colour="0,0,0" />

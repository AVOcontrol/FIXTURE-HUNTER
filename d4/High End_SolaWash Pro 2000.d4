    </Macro>
    <Macro Name="Fan Standard">
      <Set Channel="Control:17" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Disable P/T">
      <Set Channel="Control:18,Shutter:1" Delay="9000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
  </Macro>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MANA PROFILE (XA 600 BSWF IP)" ShortName="MANA Pr" Company="ACME" Version="8">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>198f896e-4f0b-410a-a304-75d584f549c8</Thumbnail>
  <History Date="22-12-23" Author="Nic Morris" Comment="Created (note colour wheel is in Chinese only and gobo wheel images are missing slot numbers and resolution is too low to use)" Version="0" />
  <History Date="23-12-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="23-12-23" Author="Nic Morris" Comment="Corrected CRI name (was Colour Macro)" Version="2" />
  <History Date="08-05-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (changes tilt range to 260°, revises colours with names/swatches and adds gobo swatches)" Version="3" />
  <History Date="10-05-24" Author="Nic Morris" Comment="Corrected gobo wheel 1 slot 1 swatch." Version="4" />
  <History Date="04-06-24" Author="Nic Morris" Comment="Revised colour functions in line with latest charts in response to manufacturer request." Version="5" />
  <History Date="22-01-26" Author="Nic Morris" Comment="Revised channel mapping in line with latest documentation in response to manufacturer request (moves CRI)" Version="6" />
  <History Date="17-07-26" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds 30 channel mode, revises mode names with mode number prefixes and identifiers.  adds RDM model ID.  note RDM mode IDs are not provided)" Version="7" />
  <History Date="17-07-26" Author="Nic Morris" Comment="(inverts zoom.  changes blade control names.  changes numerous wheel spin directions.  removes wireless control functions/macros.  changes Fan Standard to Fan Auto and adds CTB compensate control functions/macros)" Version="7" />
  <History Date="17-07-26" Author="Nic Morris" Comment="(note colour names are not included in the latest charts) " Version="7" />
  <History Date="21-07-26" Author="Nic Morris" Comment="Added Atlabase ID for 30 channel mode." Version="8" />

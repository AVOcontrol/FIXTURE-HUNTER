    </Physical>
    <AtlaBase ModeID="32f5ef83-a84d-4535-9e65-8d0854f2fecd" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />

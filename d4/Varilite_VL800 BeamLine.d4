<Fixture Name="VL800 BeamLine" ShortName="VL800 BmLn" Company="Varilite">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>03e15cf5-b5dd-476b-9a0d-cecd9ca7190d</Thumbnail>
  <History Date="17-04-18" Author="Nic Morris" Comment="Created (note strobe ranges are incomplete in charts)" />
  <History Date="24-04-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="09-01-19" Author="Nic Morris" Comment="Revised control functions and macros in line with v1.7 mapping in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b2a9f924-862f-4fed-84ae-95de2f97517a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Pan_Ctrl'==2||'Pan_Ctrl'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin %.2f%%',0.00~100.00" Dmx="32757~32780" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="4" Name="No Spin" Display="'No Spin %.2f%%',0.00~100.00" Dmx="32757~32780" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Tilt_Ctrl'==2||'Tilt_Ctrl'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin %.2f%%',0.00~100.00" Dmx="32757~32780" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="4" Name="No Spin" Display="'No Spin %.2f%%',0.00~100.00" Dmx="32757~32780" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
    </Attribute>
    <Attribute ID="Pan_Ctrl" Name="Pan Ctrl" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Pan" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="51~70" Update="Pan" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="71~120" Update="Pan" />
      <Function ID="4" Name="Twist" Display="'Twist %.f%%',0~100" Dmx="121~180" Update="Pan" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pan" />
    </Attribute>
    <Attribute ID="Tilt_Ctrl" Name="Tilt Ctrl" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Tilt" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="51~70" Update="Tilt" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="71~120" Update="Tilt" />
      <Function ID="4" Name="Twist" Display="'Twist %.f%%',0~100" Dmx="121~180" Update="Tilt" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Tilt" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour" Display="'Colour'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Chase" Display="'Chase'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />

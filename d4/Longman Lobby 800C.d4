<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Lobby 800C" ShortName="Loby 800C" Company="Longman">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="07-07-08" Author="David Hunt" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="01-12-16" Author="Nic Morris" Comment="Removed effect func and merged effect and effect rot into one channel to fix mapping conflicts (no manual - used r20's as reference)" />
  <History Date="01-12-16" Author="Nic Morris" Comment="Standardised conditionals.  Fixed colour no scroll ranges.  Increased wheel resolution." />
  <History Date="01-12-16" Author="Nic Morris" Comment="Changed P/T Speed fixed 'Safe' range to variable 'Speed'." />
  <History Date="01-12-16" Author="Nic Morris" Comment="Simplified shutter.  Tidied up.  Added palettes." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="215~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="216~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'Colour1Func'==2" />
      <Condition Name="Random" ID="11" If="'Colour1Func'==3" />
      <Else ID="12" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~153" Colour="255,255,255" />
      <Function ID="2" Name="Rose" Display="'Rose'" Dmx="154~166" Colour="255,0,127" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="167~173" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="174~182" Colour="0,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="183~190" Colour="255,0,0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="191~198" Colour="255,255,255" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="199~219" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="220~240" Colour="0,0,0" />
      <Function ID="11" Name="Random" Display="'Random %.f%%',0~100" Dmx="241~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~207" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="208~235" Intensity="0~0" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="236~245" Intensity="0~0" />
      <Function ID="6" Name="Lamp On/Off" Display="'Lamp On/Off'" Dmx="246~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="3~251" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Vector" Display="'No Vector'" Dmx="0~0" />
      <Function ID="2" Name="CMY Vector" Display="'CMY Vector'" Dmx="40~79" />
      <Function ID="3" Name="Colour Wheel Vector" Display="'Colour Wheel  Vector'" Dmx="80~119" />
      <Function ID="4" Name="Special Effect Vector" Display="'Special Effect Vector'" Dmx="120~159" />
      <Function ID="5" Name="CMY Colour Wheel + Vector" Display="'CMY Colour    Wheel + Vector'" Dmx="160~199" />
      <Function ID="6" Name="CMY+Col Whl+Spec Eff Vector" Display="'CMY+ColWhl+   Spec Eff Vec'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="15~29" />
      <Function ID="3" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="30~199" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="200~227" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="228~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'Cyan C-Mix %.1f%%',0.0~100.0" Dmx="0~159" Colour="0,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~160" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'Magenta C-Mix %.1f%%',0.0~100.0" Dmx="0~159" Colour="255,0,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~160" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'Yellow C-Mix %.1f%%',0.0~100.0" Dmx="0~159" Colour="255,255,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~160" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Filt_Cont" Name="Col Filt Ctrl" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Col Filter" Display="'No Col Filter'" Dmx="0~0" />
      <Function ID="2" Name="Col Filt 1" Display="'Col Filt 1'" Dmx="80~159" />
      <Function ID="3" Name="Col Filt 2" Display="'Col Filt 2'" Dmx="160~255" />
    </Attribute>
    <Attribute ID="CMY_Speed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX, 16bit" Channels="17">
    <Import PearlRef="LO_Lb800C" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,6" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="7,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="12" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="13" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="14" Wheel="12" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="17" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="11" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="10" Wheel="27" />
      <Attribute ID="Col_Filt_Cont" ChannelOffset="15" Wheel="28" />
      <Attribute ID="CMY_Speed" ChannelOffset="16" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="LO_Lb800C1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="12" Wheel="12" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="9" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="27" />
      <Attribute ID="Col_Filt_Cont" ChannelOffset="13" Wheel="28" />
      <Attribute ID="CMY_Speed" ChannelOffset="14" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:5" Delay="5000" />
      <Set Channel="Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp On/ Off">
      <Set Channel="Shutter:6" Delay="5000" />
      <Set Channel="Shutter:2" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
</Fixture>
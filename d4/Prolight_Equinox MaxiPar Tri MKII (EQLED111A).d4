      <Function ID="5" Name="Green" Display="'Green'" Dmx="112~139" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="140~167" Colour="0,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="168~195" Colour="255,255,0" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="196~223" Colour="128,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="224~251" Colour="0,255,255" />
      <Function ID="10" Name="White" Display="'White'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red Pulse" Display="'Red Pulse'" Dmx="1~12" />

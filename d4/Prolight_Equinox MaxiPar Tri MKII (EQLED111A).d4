      <Function ID="8" Name="White Pulse" Display="'White Pulse'" Dmx="78~90" />
      <Function ID="9" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="91~116" />
      <Function ID="10" Name="Col Fade" Display="'Col Fade'" Dmx="117~142" />
      <Function ID="11" Name="Col Change" Display="'Col Change'" Dmx="143~168" />
      <Function ID="12" Name="Col Change w/Strobe" Display="'Col Change w/Strobe'" Dmx="169~181" />
      <Function ID="13" Name="All Auto Shows" Display="'All Auto Shows'" Dmx="182~207" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="208~255" />

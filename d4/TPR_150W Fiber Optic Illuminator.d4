<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="150W Fiber Optic Illuminator" ShortName="150W Illum" Company="TPR">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="07-06-16" Author="Nic Morris" Comment="Created (documentation provides only percentage function values which are not accurate enough)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Power" Name="Power" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="28~28" Colour="255,255,255" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="56~56" Colour="255,255,255" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="87~87" Colour="255,255,255" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="115~115" Colour="255,255,255" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="145~145" Colour="255,255,255" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="176~176" Colour="255,255,255" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="207~207" Colour="255,255,255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="237~237" Colour="255,255,255" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Scroll" Name="Col Scroll" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Scroll CW" Display="'Scroll CW     %.1f%%',100.0~0.0" Dmx="3~125" Colour="0,0,0" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="128~133" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW    %.1f%%',0.0~100.0" Dmx="135~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Twinkle" Name="Twinkle" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKTPRFOI" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Power" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Col_Scroll" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Twinkle" ChannelOffset="5" Wheel="22" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Power:1,Colour1:1,Col_Scroll:1,Dimmer:1:0,Twinkle:1:100" Delay="1000" />
      <Set Channel="Twinkle:1:0" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
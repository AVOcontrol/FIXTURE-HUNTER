      <Function ID="8" Name="RGBW" Display="'RGBW'" Dmx="110~127" />
      <Function ID="9" Name="Jump" Display="'Jump'" Dmx="128~169" />
      <Function ID="10" Name="Fade" Display="'Fade'" Dmx="170~210" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

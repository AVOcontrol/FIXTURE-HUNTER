      <Function ID="8" Name="3500K" Display="'3500K'" Dmx="102~117" Colour="0,0,0" />
      <Function ID="9" Name="4000K" Display="'4000K'" Dmx="118~133" Colour="0,0,0" />
      <Function ID="10" Name="4500K" Display="'4500K'" Dmx="134~149" Colour="0,0,0" />

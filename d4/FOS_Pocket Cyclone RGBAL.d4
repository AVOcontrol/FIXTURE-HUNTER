    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="+ Magenta" Display="'+ Magenta %.1f%%',100.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="128~128" Colour="0,0,0" />

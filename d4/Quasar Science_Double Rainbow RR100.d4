  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="10003172-b949-4e11-a46b-7c848d9dce72" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:3200" PowerOn="1:3200" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',1750~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.f%%',0~100" Dmx="21~119" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',0~100" Dmx="146~244" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Spectrum_Ctrl" Name="Spectrum Ctrl" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="RGB-&gt;Max Spectrum" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Space(M63-66)" Name="Colour Space" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rec709 (EOTF Gamma 2.4, Gamut Rec709)" Display="'Rec709 (EOTF Gamma 2.4, Gamut Rec709)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="sRGB (EOTF sRGB Curve, Gamut sRGB)" Display="'sRGB (EOTF sRGB Curve, Gamut sRGB)'" Dmx="27~51" Colour="0,0,0" />
      <Function ID="3" Name="SRGB (EOTF Linear, Gamut RGBX)" Display="'SRGB (EOTF Linear, Gamut RGBX)'" Dmx="52~77" Colour="0,0,0" />
      <Function ID="4" Name="RGBX (EOTF Linear, Gamut RGBX)" Display="'RGBX (EOTF Linear, Gamut RGBX)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Output_Mode" Name="Output Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="High" Display="'High'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="78~153" Colour="0,0,0" />
      <Function ID="3" Name="Low" Display="'Low'" Dmx="154~255" Colour="0,0,0" />

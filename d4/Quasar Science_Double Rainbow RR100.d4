      <Function ID="4" Name="RGBX (EOTF Linear, Gamut RGBX)" Display="'RGBX (EOTF Linear, Gamut RGBX)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Type" Name="Effect Type" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Size, Hue, Red" />
      <Function ID="2" Name="Rainbow" Display="'Rainbow'" Dmx="27~38" Update="Effect_Size, Hue, Red" />
      <Function ID="3" Name="Short Circuit" Display="'Short Circuit'" Dmx="39~51" Update="Effect_Size, Hue, Red" />
      <Function ID="4" Name="Paparazzi" Display="'Paparazzi'" Dmx="52~64" Update="Effect_Size, Hue, Red" />
      <Function ID="5" Name="Strobe" Display="'Strobe'" Dmx="65~77" Update="Effect_Size, Hue, Red" />
      <Function ID="6" Name="Fire" Display="'Fire'" Dmx="78~90" Update="Effect_Size, Hue, Red" />
      <Function ID="7" Name="Emergency Light" Display="'Emergency Light'" Dmx="91~102" Update="Effect_Size, Hue, Red" />
    </Attribute>
    <Attribute ID="Effect_Rate" Name="Effect Rate" Description="" Group="E">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="0%" Display="'0%'" Dmx="11~20" />
      <Function ID="3" Name="- Rate" Display="'- Rate %.f%%',1~99" Dmx="21~119" />
      <Function ID="4" Name="100%" Display="'100%'" Dmx="133~133" />
      <Function ID="5" Name="+ Rate" Display="'+ Rate %.f%%',101~199" Dmx="146~244" />
      <Function ID="6" Name="200%" Display="'200%'" Dmx="245~255" />
      <Function ID="7" Name="Continuous" Display="'Continuous %.1f%%',0.0~200.0" Dmx="20~133" />
    </Attribute>
    <Attribute ID="Effect_Size" Name="Effect Size" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Emergency Light" ID="2,3,4,5,6" If="'Effect_Type'==7" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Flash Single" Display="'Flash Single'" Dmx="0~0" />
      <Function ID="3" Name="Flash Single/Off" Display="'Flash Single/Off'" Dmx="39~77" />
      <Function ID="4" Name="Flash Double" Display="'Flash Double'" Dmx="78~115" />
      <Function ID="5" Name="Flash Triple" Display="'Flash Triple'" Dmx="116~153" />
      <Function ID="6" Name="Flash Quad" Display="'Flash Quad'" Dmx="154~191" />
    </Attribute>
  </Control>

  <Thumbnail>b40fb4a4-5a0e-4327-8cbf-6ef262be77c4</Thumbnail>
  <History Date="30-10-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="14-11-23" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="32ae2b48-ab31-4200-92d9-148f1c49c16a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~127" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="3~119" Colour="255,255,255" />
      <Function ID="3" Name="4 Col Chng" Display="'4 Col Chng %.f%%',0~100" Dmx="120~169" Colour="255,255,255" />
      <Function ID="4" Name="4 Col Fade" Display="'4 Col Fade %.f%%',0~100" Dmx="170~219" Colour="255,255,255" />
      <Function ID="5" Name="Strobe+Col" Display="'Strobe+Col %.f%%',0~100" Dmx="220~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
  </Control>
  <Mode Name="21 DMX" Channels="21" Id="e99fa0c3-fddd-4236-a647-9bb93e99ae3a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

  <History Date="19-02-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="19-02-15" Author="Gab " Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Increased wheel resolution.  Fixed PT Speed DMX range.  Set Zoom power on to match locate" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed hue and saturation to percentage ranges.  Added reset macro" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Set RGB power on to match locate.  Removed Reserved1 attribute as unused." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed name from ServoColor1200 to ServoColor 1200" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added product thumbnail,  Standardised" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added pan/tilt and zoom palettes." />
  <History Date="15-06-19" Author="Nic Morris" Comment="Added Atlabase ID's." />

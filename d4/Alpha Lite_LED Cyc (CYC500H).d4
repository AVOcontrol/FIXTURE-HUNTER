    </Attribute>
    <Attribute ID="UV" Name="Royal Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Royal Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="1~6" Colour="255,255,255" />
      <Function ID="3" Name="4500K" Display="'4500K'" Dmx="7~12" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="13~18" Colour="255,255,255" />
      <Function ID="5" Name="7000K" Display="'7000K'" Dmx="19~24" Colour="255,255,255" />
      <Function ID="6" Name="10000K" Display="'10000K'" Dmx="25~30" Colour="255,255,255" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="31~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

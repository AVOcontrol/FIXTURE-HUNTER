      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="87~96" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="97~106" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Cy" Display="'Blu/ Cy'" Dmx="107~116" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="Cy/ Mag" Display="'Cy/ Mag'" Dmx="117~127" WheelPosition="6" Colour="0,255,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />

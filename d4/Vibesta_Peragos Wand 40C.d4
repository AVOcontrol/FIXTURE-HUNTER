    <Attribute ID="Series_Name" Name="Series Name" Description="" Group="C">
      <Locate Locate="6" PowerOn="6" />
      <Condition Name="2" ID="1,2,3,4,5" If="'Manufacturer'==2" />
      <Else ID="6,7,8,9" />

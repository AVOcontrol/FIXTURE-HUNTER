  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="7" />
  <History Date="13-01-17" Author="Nic Morris" Comment="Updated to 1.4 specs in response to manufacturer request." Version="8" />
  <History Date="02-02-17" Author="Nic Morris" Comment="Added colour swatches." Version="9" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Updated to v1.5 charts in response to manufacturer request.  Corrected iris random pulse function names." Version="10" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Recreated palettes to include colour.  Moved reserved into special group and wheel slot." Version="11" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="12" />

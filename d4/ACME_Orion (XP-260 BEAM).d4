      <Function ID="18" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>5051e742-0989-4859-b4ef-280bcdeb6cf3</Swatch>
      </Function>
      <Function ID="19" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="56~127" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="132~167" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="168~203" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="204~239" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">

      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="26~28">
        <Swatch>e2ca4ffa-e75b-4755-be5c-fd25e6961baf</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="29~31">
        <Swatch>45306bc4-7adf-4f0f-bd85-ef67b5bcfc4c</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="32~34">
        <Swatch>a5697952-5540-44c3-8848-30a76460bc42</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="35~37">
        <Swatch>63ec44fb-01a1-4ebf-b11c-59e53e929f5e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="38~40">
        <Swatch>128841eb-987f-4354-9437-be29b194ed9c</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="41~43">
        <Swatch>eca6d734-961f-4e90-b819-c37354fd88e4</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="44~46">
        <Swatch>048951ca-ab38-4e5c-b678-ba25fb80ebe4</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="47~49">
        <Swatch>821da594-2ecf-4cdd-bace-a9561b5d0359</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="50~52">
        <Swatch>b2a1acb5-db30-46ef-9c42-f77d8e780eeb</Swatch>
      </Function>

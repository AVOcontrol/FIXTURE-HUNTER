      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Trail_Effect" Name="Trail Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Static Macros" Display="'Static Macros %.1f%%',0.0~100.0" Dmx="6~127" Colour="0,0,0" />
      <Function ID="3" Name="Dynamic Macros" Display="'Dynamic Macros %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="BG_Colour_Dim" Name="BG Colour Dim" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />

    </Attribute>
    <Attribute ID="Effect_Dir" Name="Effect Dir" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R-&gt;L" Display="'R-&gt;L'" Dmx="0~0" />
      <Function ID="2" Name="L-&gt;R" Display="'L-&gt;R'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="255~255" />
      <Function ID="2" Name="On" Display="'On'" Dmx="0~0" />
    </Attribute>
  </Control>

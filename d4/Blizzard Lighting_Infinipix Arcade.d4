      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="132~152" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="153~173" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="174~194" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="195~215" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="216~236" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="237~255" />
    </Attribute>
    <Attribute ID="Special_Effect" Name="Special Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />

  <AtlaBase TypeID="09bc171a-4ca6-4b97-b540-533f1cd64667" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~247" />
      <Function ID="3" Name="Blinder" Display="'Blinder'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Spike" Display="'Spike'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Pixel_FX" Name="Pixel FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="6~41" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="42~83" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="84~125" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="126~167" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="168~209" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6 %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

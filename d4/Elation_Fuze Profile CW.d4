      <Function ID="92" Name="Program 7" Display="'Program 7'" Dmx="247~247" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour2Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="16~31" Colour="255,240,200" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="32~47" Colour="255,240,200" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="5500K" Display="'5500K'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="6800K" Display="'6800K'" Dmx="80~95" Colour="230,230,255" />
      <Function ID="7" Name="8000K" Display="'8000K'" Dmx="96~111" Colour="230,230,255" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="112~127" Colour="180,0,255" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

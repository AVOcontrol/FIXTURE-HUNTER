      <Function ID="6" Name="Sync Fast" Display="'Sync Fast %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan Off" Display="'Fan Off'" Dmx="11~20" />
      <Function ID="3" Name="Fan Low" Display="'Fan Low'" Dmx="21~25" />
      <Function ID="4" Name="Fan High" Display="'Fan High'" Dmx="26~30" />
      <Function ID="5" Name="Fan Auto" Display="'Fan Auto'" Dmx="31~40" />

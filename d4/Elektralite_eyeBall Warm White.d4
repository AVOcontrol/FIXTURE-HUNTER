    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Sync Slow" Display="'Sync Slow %.f%%',0~100" Dmx="10~49" />
      <Function ID="3" Name="Async Slow" Display="'Async Slow %.f%%',0~100" Dmx="50~99" />
      <Function ID="4" Name="Rnd Slow" Display="'Rnd Slow %.f%%',0~100" Dmx="100~149" />

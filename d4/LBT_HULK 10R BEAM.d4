      <Function ID="25" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="183~190" WheelPosition="11" />
      <Function ID="26" Name="Gobo 12 Shake" Display="'Gobo 12 Shake %.f%%',0~100" Dmx="191~199" WheelPosition="12" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="228~229" />
      <Function ID="28" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="202~227" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll %.f%%',0~100" Dmx="228~229" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="230~255" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ScanBar" ShortName="ScanBar" Company="Laserworld" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="24-07-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Pattern_Sel" Name="Pattern Sel" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Pos" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Pos" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="16~23" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="24~31" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="40~47" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~55" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="56~63" Colour="128,0,255" />
      <Function ID="9" Name="7 Col Change Spd (1)" Display="'7 Col Change Spd (1) %.f%%',0~100" Dmx="64~95" Colour="0,0,0" />
      <Function ID="10" Name="RGB Col Change Spd" Display="'RGB Col Change Spd %.f%%',0~100" Dmx="96~127" Colour="0,0,0" />
      <Function ID="11" Name="7 Col Change Spd (2)" Display="'7 Col Change Spd (2) %.f%%',0~100" Dmx="128~159" Colour="0,0,0" />
      <Function ID="12" Name="Multi-Col Flow Spd" Display="'Multi-Col Flow Spd %.f%%',0~100" Dmx="160~191" Colour="0,0,0" />
      <Function ID="13" Name="Full Col Flow Spd" Display="'Full Col Flow Spd %.f%%',0~100" Dmx="192~223" Colour="0,0,0" />
      <Function ID="14" Name="Col Drawing Spd" Display="'Col Drawing Spd %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Pattern_Group" Name="Pattern Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static Group 1" Display="'Static Group 1'" Dmx="0~0" />
      <Function ID="2" Name="Static Group 2" Display="'Static Group 2'" Dmx="64~127" />
      <Function ID="3" Name="Dynamic Group 1" Display="'Dynamic Group 1'" Dmx="128~191" />
      <Function ID="4" Name="Dynamic Group 2" Display="'Dynamic Group 2'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="27~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',0.00~100.00" Dmx="32896~49087" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49344~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Movement" Display="'No Movement'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="1~127" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="128~159" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="160~191" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="192~223" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="224~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Movement" Display="'No Movement'" Dmx="0~0" />
      <Function ID="2" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="128~159" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="160~191" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="192~223" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto Spd" Display="'Auto Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Drawing" Display="'No Drawing'" Dmx="0~0" />
      <Function ID="2" Name="Drawing 1" Display="'Drawing 1 %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Drawing 2" Display="'Drawing 2 %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Scan_Spd" Name="Scan Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line Scan Spd" Display="'Line Scan Spd %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Dot Scan Spd" Display="'Dot Scan Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small X-Wave" Display="'Small X-Wave %.f%%',0~100" Dmx="1~63" />
      <Function ID="3" Name="Big X-Wave" Display="'Big X-Wave %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Small Y-Wave" Display="'Small Y-Wave %.f%%',0~100" Dmx="128~191" />
      <Function ID="5" Name="Big Y-Wave" Display="'Big Y-Wave %.f%%',0~100" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX" Channels="20" Id="fcfaa558-dcb7-48dd-8769-654babefa7e8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Pattern_Sel" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Pattern_Size" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Pan" ChannelOffset="7,8" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="9,10" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Pattern_Group" ChannelOffset="12" Wheel="13" />
      <Attribute ID="Z-Rot" ChannelOffset="13,14" Wheel="49" />
      <Attribute ID="Y-Rot" ChannelOffset="15" Wheel="50" />
      <Attribute ID="X-Rot" ChannelOffset="16" Wheel="51" />
      <Attribute ID="X-Move" ChannelOffset="17" Wheel="79" />
      <Attribute ID="Y-Move" ChannelOffset="18" Wheel="80" />
      <Attribute ID="Scan_Spd" ChannelOffset="19" Wheel="25" />
      <Attribute ID="Wave" ChannelOffset="20" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="24 DMX" Channels="24" Id="b829a457-886d-4729-bf5e-9fd5eb11850a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Pattern_Sel" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Pattern_Size" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Pan" ChannelOffset="7,8" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="9,10" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="5" />
      <Attribute ID="Pattern_Group" ChannelOffset="13" Wheel="13" />
      <Attribute ID="Auto_Spd" ChannelOffset="14" Wheel="22" />
      <Attribute ID="Z-Rot" ChannelOffset="15,16" Wheel="49" />
      <Attribute ID="Y-Rot" ChannelOffset="17" Wheel="50" />
      <Attribute ID="X-Rot" ChannelOffset="18" Wheel="51" />
      <Attribute ID="X-Move" ChannelOffset="19" Wheel="79" />
      <Attribute ID="Y-Move" ChannelOffset="20" Wheel="80" />
      <Attribute ID="Zoom" ChannelOffset="21" Wheel="81" />
      <Attribute ID="Drawing" ChannelOffset="22" Wheel="6" />
      <Attribute ID="Scan_Spd" ChannelOffset="23" Wheel="25" />
      <Attribute ID="Wave" ChannelOffset="24" Wheel="23" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Legend="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Legend="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Legend="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Legend="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Legend="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Legend="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Legend="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Legend="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Legend="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Legend="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Legend="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Legend="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Legend="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Legend="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Legend="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Legend="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Legend="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Legend="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Legend="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
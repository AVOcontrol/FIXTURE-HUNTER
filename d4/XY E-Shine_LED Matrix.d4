<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Matrix" ShortName="LED Matrix" Company="XY E-Shine">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="03-05-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~4" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="130~5" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~131" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~4" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="130~5" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~131" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~24" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="25~30" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="31~36" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="37~42" />
      <Function ID="5" Name="Pattern" Display="'Pattern %.f',1~23" Dmx="43~123" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="133~138" />
      <Function ID="7" Name="Auto Col" Display="'Auto Col'" Dmx="139~144" />
      <Function ID="8" Name="Auto Jump" Display="'Auto Jump'" Dmx="145~150" />
      <Function ID="9" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="151~156" />
      <Function ID="10" Name="Auto Pattern" Display="'Auto Pattern %.f',1~23" Dmx="157~248" />
      <Function ID="11" Name="Auto Sound" Display="'Auto Sound'" Dmx="249~255" />
    </Attribute>
    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.f',6~255" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed 1" Display="'Fixed 1'" Dmx="0~31" />
      <Function ID="2" Name="Fixed 2" Display="'Fixed 2'" Dmx="32~63" />
      <Function ID="3" Name="Fixed 3" Display="'Fixed 3'" Dmx="64~95" />
      <Function ID="4" Name="Fixed 4" Display="'Fixed 4'" Dmx="96~126" />
      <Function ID="5" Name="CW" Display="'CW %.f%%',0~100" Dmx="195~127" />
      <Function ID="6" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

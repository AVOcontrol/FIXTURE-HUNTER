    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="51~100" />
      <Function ID="3" Name="Col Gradient" Display="'Col Gradient'" Dmx="101~150" />
      <Function ID="4" Name="Col Pulse" Display="'Col Pulse'" Dmx="151~200" />
      <Function ID="5" Name="Col Transition" Display="'Col Transition'" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mac 401 Dual RGB Zoom" ShortName="Mac 401" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="29-09-09" Author="Steve Cohu" Comment="Created" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Shortened names for Expert LCD" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Reversed shutter ranges" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed all broken update functions" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Adjusted Effect ranges to exclude reserved." />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed Spin wheel direction" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Increased wheel resolutions for correct control range" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Changed zoom hypermode to fixed value" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed control ranges" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Added colour palettes" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Fixed power on and locate" />
  <History Date="25-01-11" Author="Nic Morris" Comment="Revised macros" />
  <History Date="26-09-11" Author="Nic Morris" Comment="Aligned RGBC1 attribute ID number with attribute name." />
  <History Date="26-09-11" Author="Nic Morris" Comment="Added RGBC/HSV and replaced in single cell modes." />
  <History Date="26-09-11" Author="Nic Morris" Comment="Standardised func names.  Added v-dim to RGBC cell.  Added pixel mapper compatibility." />
  <History Date="22-02-12" Author="Peter Budd" Comment="Edited removed virtual dimmer from RGBC 1 Cell" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="08-01-17" Author="Nic Morris" Comment="Replaced dimmer with master dimmer in multi-cell modes, fixed HSI cell dimmer link and reinstated RGB cell virtual dimmer." />
  <History Date="08-01-17" Author="Nic Morris" Comment="Added Atlabase mode ID's.  Changed cells to hidden." />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed name from Mac 401 Dual to Mac 401 Dual RGB Zoom.  Added physical pan/tilt ranges." />
  <History Date="15-12-17" Author="Nic Morris" Comment="Inverted zoom.  Added Master Dimmer to reset macros.  Added missing macros." />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed value attribute ID to ColourIntensity for compatibility." />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed dimmer to value in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="http://www.martin.com/service/downloadfile.asp?name=UM_MAC401_EN_E.pdf&amp;cat=65" Summary="" />
  <RDM>
    <Device ManufacturerID="19792" ModelID="0" />
  </RDM>

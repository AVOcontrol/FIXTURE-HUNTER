  <History Date="09-04-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added gobo swatches." />
  <History Date="09-04-19" Author="Nic Morris" Comment="Corrected 13 DMX mode 16bit pan/tilt mapping" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e8dd286c-1606-44ec-9bb9-821cbed6a141" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="9" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="7~13" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="14~20" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~27" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="28~34" WheelPosition="4" Colour="255,0,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="35~41" WheelPosition="5" Colour="0,128,255" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="42~48" WheelPosition="6" Colour="128,255,0" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="49~55" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Dark Blue" Display="'Deep Blue'" Dmx="56~64" WheelPosition="8" Colour="0,0,180" />
      <Function ID="10" Name="Op/ Yell" Display="'Op/ Yell'" Dmx="65~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Yell/ Pink" Display="'Yell/ Pink'" Dmx="72~78" WheelPosition="1" Colour="255,255,0" />
      <Function ID="12" Name="Pink/ Grn" Display="'Pink/ Grn'" Dmx="79~85" WheelPosition="2" Colour="255,150,150" />
      <Function ID="13" Name="Grn/ Red" Display="'Grn/ Red'" Dmx="86~92" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Red/ Lt Blue" Display="'Red/ Lt Blue'" Dmx="93~99" WheelPosition="4" Colour="255,0,0" />
      <Function ID="15" Name="Lt Blue/ L Grn" Display="'Lt Blue/ L Grn'" Dmx="100~106" WheelPosition="5" Colour="0,128,255" />
      <Function ID="16" Name="L Grn/ Org" Display="'L Grn/ Org'" Dmx="107~113" WheelPosition="6" Colour="128,255,0" />
      <Function ID="17" Name="Org/ Dk Blue" Display="'Org/ Dk Blue'" Dmx="114~120" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="D Blu/ Op" Display="'D Blu/ Op'" Dmx="121~127" WheelPosition="8" Colour="0,0,180" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~215" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>2b844512-f1a9-4bb0-8364-346d3e403a96</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>00085523-0452-4866-bab5-0d63448a2c53</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>12e56fcc-ebce-4e34-9a25-92d0704a8480</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>581ba30a-91ff-4647-bb30-db77be6635a1</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>9395d0b9-6707-4665-9ea4-2eab48107e52</Swatch>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0b0ec8a7-8bd0-4f74-9a31-44616064768e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~128" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="129~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~71" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="72~132" />
      <Function ID="4" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="133~193" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 10000K" Display="'White 10000K'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="White 8000K" Display="'White 8000K'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="White 6500K" Display="'White 6500K'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="White 5000K" Display="'White 5000K'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="White 4500K" Display="'White 4500K'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="8" Name="White 4000K" Display="'White 4000K'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="White 3200K" Display="'White 3200K'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="10" Name="White 3000K" Display="'White 3000K'" Dmx="9~9" Colour="255,255,255" />
      <Function ID="11" Name="White 2700K" Display="'White 2700K'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~251" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CW" Display="'Scroll CW'" Dmx="252~253" Colour="255,255,255" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="254~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="10~19" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="20~29" />
      <Function ID="4" Name="Fan Slow" Display="'Fan Slow'" Dmx="30~39" />
      <Function ID="5" Name="Fan Normal" Display="'Fan Normal'" Dmx="40~49" />
      <Function ID="6" Name="Fan Fast" Display="'Fan Fast'" Dmx="50~59" />
      <Function ID="7" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~69" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="70~79" />
      <Function ID="9" Name="Auto 2" Display="'Auto 2'" Dmx="80~89" />
      <Function ID="10" Name="Custom" Display="'Custom'" Dmx="90~99" />
      <Function ID="11" Name="Test" Display="'Test'" Dmx="100~109" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="110~119" />
      <Function ID="13" Name="Dim0" Display="'Dim0'" Dmx="130~139" />
      <Function ID="14" Name="Dim1" Display="'Dim1'" Dmx="140~149" />
      <Function ID="15" Name="Dim2" Display="'Dim2'" Dmx="150~159" />
      <Function ID="16" Name="Dim3" Display="'Dim3'" Dmx="160~169" />
      <Function ID="17" Name="Dim4" Display="'Dim4'" Dmx="170~179" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

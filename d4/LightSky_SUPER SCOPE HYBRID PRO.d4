      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="156~166" Colour="0,0,255" />
      <Function ID="8" Name="CRI" Display="'CRI'" Dmx="167~179" Colour="255,200,255" />
      <Function ID="9" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~89" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="214~180" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="249~215" Colour="0,0,0" />

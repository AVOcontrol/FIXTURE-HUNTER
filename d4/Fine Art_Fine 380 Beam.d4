      <Function ID="26" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="205~211" WheelPosition="9" />
      <Function ID="27" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="212~217" WheelPosition="10" />
      <Function ID="28" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="218~223" WheelPosition="11" />

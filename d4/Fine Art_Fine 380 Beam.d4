      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="52~55" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="56~59" WheelPosition="13" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="60~63" WheelPosition="14" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="64~67" WheelPosition="15" />
      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="68~71" WheelPosition="16" />
      <Function ID="18" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="160~166" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="167~172" WheelPosition="3" />

      <Function ID="33" Name="Gobo 16 Shake" Display="'Gobo 16 Shake %.f%%',0~100" Dmx="250~255" WheelPosition="16" />
      <Function ID="34" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="35" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="72~113" />
      <Function ID="36" Name="No Scroll" Display="'No Scroll %.f%%',0~100" Dmx="114~117" />
      <Function ID="37" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="118~159" />
      <Function ID="38" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

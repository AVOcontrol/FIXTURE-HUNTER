    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="2" Name="HSI" Display="'HSI'" Dmx="10~19" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="3" Name="RGBWW" Display="'RGBWW'" Dmx="20~29" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="4" Name="GEL" Display="'GEL'" Dmx="30~39" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Param_1" Name="Colour Param 1" Description="" Group="C">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Colour_Mode'==1" />
      <Condition Name="HSI" ID="3" If="'Colour_Mode'==2" />
      <Condition Name="RGBWW" ID="4" If="'Colour_Mode'==3" />
      <Condition Name="GEL" ID="5" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="3" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Masterpiece" ShortName="Masterpce" Company="SENNA" Version="8">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>f1355d68-d3ad-4d59-96ac-5948ff44acbf</Thumbnail>
  <History Date="28-11-22" Author="Nic Morris" Comment="Created (poor documentation. no pixel layout or ranges except gels.  littered with errors.  made best guess)" Version="0" />
  <History Date="30-11-22" Author="Nic Morris" Comment="Added 16bit modes and added 8bit to existing mode names (charts don't say anything about 16bit.  menu system implies they exist although the implementation is unclear)" Version="4" />
  <History Date="30-11-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="25-11-24" Author="Nic Morris" Comment="Added CCT/CCT+ control to CCT (1 Segment, 8bit) mode in response to customer feedback." Version="5" />
  <History Date="26-11-24" Author="Nic Morris" Comment="Revised channel count in CCT (1 Segment, 8bit) mode name to reflect addition of CCT/CCT+ control." Version="7" />
  <History Date="24-03-25" Author="Nic Morris" Comment="Revised CCT with Kelvin display range (dynamic dependent on CCT/CCT+)" Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dbb3e201-521f-4957-bb39-06db4d02bdd3" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:3000" PowerOn="1:3000" />
      <Else ID="1" />
      <Condition Name="CCT+" ID="2" If="'CCT/CCT+'==2" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',3000.00~6000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.2fK',1500.00~20000.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8fe26d3b-531a-47a7-bec4-234f6e1255a2" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~90" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="181~240" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="106~165" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~45" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~80" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="81~115" Colour="0,0,255" />
      <Function ID="5" Name="R&#xD;&#xA;R+G" Display="'R&#xD;&#xA;R+G'" Dmx="116~150" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="151~185" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="186~220" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="9~19" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="20~30" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="31~41" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="42~52" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="53~63" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="64~74" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="75~85" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="86~96" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="97~107" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="108~118" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="119~129" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="130~140" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="141~151" />
      <Function ID="15" Name="Show 14" Display="'Show 14'" Dmx="152~162" />
      <Function ID="16" Name="Show 15" Display="'Show 15'" Dmx="163~173" />
      <Function ID="17" Name="Show 16" Display="'Show 16'" Dmx="174~184" />
      <Function ID="18" Name="Show 17" Display="'Show 17'" Dmx="185~195" />
      <Function ID="19" Name="Show 18" Display="'Show 18'" Dmx="196~206" />
      <Function ID="20" Name="Show 19" Display="'Show 19'" Dmx="207~217" />
      <Function ID="21" Name="Show 20" Display="'Show 20'" Dmx="218~228" />
      <Function ID="22" Name="Show 21" Display="'Show 21'" Dmx="229~239" />
      <Function ID="23" Name="Auto" Display="'Auto'" Dmx="241~250" />
      <Function ID="24" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

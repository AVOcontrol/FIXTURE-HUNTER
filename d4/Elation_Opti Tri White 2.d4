<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Opti Tri White 2" ShortName="Opti TriW2" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="09-03-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~18" Colour="255,255,255" />
      <Function ID="2" Name="7500K" Display="'7500K'" Dmx="19~37" Colour="255,255,255" />
      <Function ID="3" Name="7000K" Display="'7000K'" Dmx="38~56" Colour="255,255,255" />
      <Function ID="4" Name="6500K" Display="'6500K'" Dmx="57~75" Colour="255,255,255" />
      <Function ID="5" Name="6000K" Display="'6000K'" Dmx="76~94" Colour="255,255,255" />
      <Function ID="6" Name="5500K" Display="'5500K'" Dmx="95~113" Colour="255,255,255" />
      <Function ID="7" Name="5100K" Display="'5100K'" Dmx="114~132" Colour="255,255,255" />
      <Function ID="8" Name="4700K" Display="'4700K'" Dmx="133~151" Colour="255,255,255" />
      <Function ID="9" Name="4300K" Display="'4300K'" Dmx="152~170" Colour="255,255,255" />
      <Function ID="10" Name="3900K" Display="'3900K'" Dmx="171~189" Colour="255,255,255" />
      <Function ID="11" Name="3500K" Display="'3500K'" Dmx="190~208" Colour="255,255,255" />
      <Function ID="12" Name="3100K" Display="'3100K'" Dmx="209~227" Colour="255,255,255" />
      <Function ID="13" Name="2700K" Display="'2700K'" Dmx="228~246" Colour="255,255,255" />
      <Function ID="14" Name="2300K" Display="'2300K'" Dmx="247~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~128" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="129~159" Intensity="0~0" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="160~191" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~19" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="20~39" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="40~59" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="60~79" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="80~99" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="100~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="ELOPTW28" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="9" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="37" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="ELOPTW24" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="60~69" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="70~79" />
      <Function ID="4" Name="Reset Other" Display="'Reset Other'" Dmx="80~89" />

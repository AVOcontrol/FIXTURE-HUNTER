      <Function ID="6" Name="Rainbow Scene 5" Display="'Rainbow Scene 5'" Dmx="136~167" Colour="0,0,0" />
      <Function ID="7" Name="Rainbow Scene 6" Display="'Rainbow Scene 6'" Dmx="168~199" Colour="0,0,0" />
      <Function ID="8" Name="Rainbow Scene 7" Display="'Rainbow Scene 7'" Dmx="200~231" Colour="0,0,0" />
      <Function ID="9" Name="Flow" Display="'Flow %.f%%',0~100" Dmx="232~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />

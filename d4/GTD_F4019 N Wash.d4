      <Function ID="10" Name="Program 6" Display="'Program 6'" Dmx="150~159" />
      <Function ID="11" Name="Program 7" Display="'Program 7'" Dmx="160~169" />
      <Function ID="12" Name="Program 8" Display="'Program 8'" Dmx="170~179" />
      <Function ID="13" Name="Program 9" Display="'Program 9'" Dmx="180~189" />
      <Function ID="14" Name="Program 10" Display="'Program 10'" Dmx="190~199" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

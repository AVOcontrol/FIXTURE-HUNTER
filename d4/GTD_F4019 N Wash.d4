    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rainbow" Name="Rainbow" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Rainbow Scene 1" Display="'Rainbow Scene 1'" Dmx="10~39" Colour="0,0,0" />
      <Function ID="3" Name="Rainbow Scene 2" Display="'Rainbow Scene 2'" Dmx="40~71" Colour="0,0,0" />
      <Function ID="4" Name="Rainbow Scene 3" Display="'Rainbow Scene 3'" Dmx="72~103" Colour="0,0,0" />

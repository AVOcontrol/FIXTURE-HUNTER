  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~12" Update="Speed" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="13~25" Update="Speed" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="26~38" Update="Speed" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="39~51" Update="Speed" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="52~64" Update="Speed" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="65~77" Update="Speed" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="78~90" Update="Speed" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="91~103" Update="Speed" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="104~116" Update="Speed" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="117~129" Update="Speed" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="130~142" Update="Speed" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="143~155" Update="Speed" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="156~168" Update="Speed" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="169~181" Update="Speed" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="182~194" Update="Speed" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="195~207" Update="Speed" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="208~220" Update="Speed" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="221~233" Update="Speed" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Program'==20" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>

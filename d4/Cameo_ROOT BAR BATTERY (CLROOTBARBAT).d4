  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="01-07-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="02-07-21" Author="Nic Morris" Comment="Fixed D6 DMX Atlabase Mode ID" Version="1" />
  <History Date="10-03-22" Author="Nic Morris" Comment="Created from Cameo ROOT PAR 4 (CLROOTPAR4)" Version="2" />
  <History Date="12-03-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="31-01-25" Author="Nic Morris" Comment="Created from Cameo ROOT PAR BATTERY (CLROOTPARBAT) (charts extremely difficult to read and littered with errors.  made best guess)" Version="4" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~22" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="34~45" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="57~68" />
      <Function ID="8" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="23~33" />
      <Function ID="9" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="46~56" />
      <Function ID="10" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="69~79" />
      <Function ID="11" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="14~21" Colour="255,100,0" />
      <Function ID="4" Name="Yellow Warm" Display="'Yellow Warm'" Dmx="22~29" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="30~37" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="38~45" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="46~53" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="54~61" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="62~69" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="70~77" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="78~85" Colour="180,0,180" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="86~93" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="94~101" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="102~109" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Jumping Stop" Display="'Jumping Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="18" Name="Jumping" Display="'Jumping %.f%%',0~100" Dmx="128~164" Colour="255,255,255" />
      <Function ID="19" Name="Fading" Display="'Fading %.f%%',0~100" Dmx="165~201" Colour="255,255,255" />
      <Function ID="20" Name="User Col 1" Display="'User Col 1'" Dmx="202~207" Colour="255,255,255" />
      <Function ID="21" Name="User Col 2" Display="'User Col 2'" Dmx="208~213" Colour="255,255,255" />
      <Function ID="22" Name="User Col 3" Display="'User Col 3'" Dmx="214~219" Colour="255,255,255" />
      <Function ID="23" Name="User Col 4" Display="'User Col 4'" Dmx="220~225" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="DMX_Delay" Name="DMX Delay" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

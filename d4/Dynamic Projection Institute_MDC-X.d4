<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MDC-X" ShortName="MDC-X" Company="Dynamic Projection Institute">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Preset" Name="Preset" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Option" Display="'No Option'" Dmx="0~0" />
      <Function ID="2" Name="Preset # " Display="'Preset #  %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Map" Name="Map" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Option" Display="'No Option'" Dmx="0~0" />
      <Function ID="2" Name="Map # " Display="'Map #  %.f',1~254" Dmx="1~254" />
      <Function ID="3" Name="All Maps" Display="'All Maps'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Media" Name="Media" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Option" Display="'No Option'" Dmx="0~0" />
      <Function ID="2" Name="Media # " Display="'Media #  %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Timeline" Name="Timeline" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Option" Display="'No Option'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="1~10" />
      <Function ID="3" Name="Pause" Display="'Pause'" Dmx="11~20" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="21~30" />
      <Function ID="5" Name="Restart" Display="'Restart'" Dmx="31~40" />
      <Function ID="6" Name="Fullscreen Toggle" Display="'Fullscreen Toggle'" Dmx="41~50" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Fade" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved (ch 6)" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved (ch 7)" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved (ch 8)" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved (ch 9)" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved4" Name="Reserved (ch 10)" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="1~1" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="2~2" />
      <Function ID="4" Name="Motor On" Display="'Motor On'" Dmx="3~3" />
      <Function ID="5" Name="Motor Off" Display="'Motor Off'" Dmx="4~4" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="5~5" />
      <Function ID="7" Name="Simple Start" Display="'Simple Start'" Dmx="6~6" />
      <Function ID="8" Name="Simple Kill" Display="'Simple Kill'" Dmx="7~7" />
      <Function ID="9" Name="DLOAD" Display="'DLOAD'" Dmx="8~8" />
      <Function ID="10" Name="DAULOAD" Display="'DAULOAD'" Dmx="9~9" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="UKDPIMDC" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Preset" ChannelOffset="1" Wheel="13" />
      <Attribute ID="Map" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Media" ChannelOffset="3" Wheel="15" />
      <Attribute ID="Timeline" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Reserved" ChannelOffset="6" Wheel="29" />
      <Attribute ID="Reserved1" ChannelOffset="7" Wheel="30" />
      <Attribute ID="Reserved2" ChannelOffset="8" Wheel="58" />
      <Attribute ID="Reserved3" ChannelOffset="9" Wheel="59" />
      <Attribute ID="Reserved4" ChannelOffset="10" Wheel="60" />
      <Attribute ID="Pan" ChannelOffset="11,12" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="13,14" Wheel="3" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Motor On">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Motor Off">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Simple Start">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Simple Kill">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="DLOAD">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="DAULOAD">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
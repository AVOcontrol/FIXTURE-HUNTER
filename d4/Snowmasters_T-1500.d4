  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="I">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Cycle_Duration" />
      <Function ID="2" Name="Short Timer" Display="'Short Timer'" Dmx="64~127" Update="Cycle_Duration" />
      <Function ID="3" Name="Long Timer" Display="'Long Timer'" Dmx="128~191" Update="Cycle_Duration" />
      <Function ID="4" Name="On" Display="'On'" Dmx="192~255" Update="Cycle_Duration" />
    </Attribute>
    <Attribute ID="Cycle_Duration" Name="Cycle Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Short Timer" ID="2" If="'Control'==2" />
      <Condition Name="Long Timer" ID="3" If="'Control'==3" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.fmin',0~5" Dmx="0~255" />
      <Function ID="3" Name="Duration" Display="'%.fmin',0~15" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cycle_On_Time" Name="Cycle On Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="On Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Output" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Control" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Cycle_Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Cycle_On_Time" ChannelOffset="3" Wheel="6" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>

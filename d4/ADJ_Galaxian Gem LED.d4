<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Galaxian Gem LED" ShortName="Galaxn Gem" Company="ADJ" Version="2">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="27-06-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Galaxian Gem LED.d4 to ADJ_Galaxian Gem LED.d4." Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Laser_Mode" Name="Laser Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="8~15" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~239" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="240~247" />
      <Function ID="5" Name="On" Display="'On'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Laser_Rotation" Name="Laser Rotation" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="LED_Chase" Name="LED Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="8~37" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="38~67" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="68~97" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="98~127" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="128~157" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="158~187" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="188~217" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="218~247" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="LED_Chase_Spd" Name="LED Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_Shutter" Name="LED Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~247" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="ADJGALGM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Laser_Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Laser_Rotation" ChannelOffset="2" Wheel="19" />
      <Attribute ID="LED_Chase" ChannelOffset="3" Wheel="22" />
      <Attribute ID="LED_Chase_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="LED_Shutter" ChannelOffset="5" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
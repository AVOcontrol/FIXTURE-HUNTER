  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c8845958-fbfd-4e62-a0fa-220caa196e4c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="10~19" Update="Effect_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="20~29" Update="Effect_Spd" />
      <Function ID="4" Name="Gradual" Display="'Gradual'" Dmx="30~39" Update="Effect_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="40~49" Update="Effect_Spd" />
      <Function ID="6" Name="Effect 1" Display="'Effect 1'" Dmx="50~59" Update="Effect_Spd" />
      <Function ID="7" Name="Effect 2" Display="'Effect 2'" Dmx="60~69" Update="Effect_Spd" />
      <Function ID="8" Name="Effect 3" Display="'Effect 3'" Dmx="70~79" Update="Effect_Spd" />
      <Function ID="9" Name="Effect 4" Display="'Effect 4'" Dmx="80~89" Update="Effect_Spd" />
      <Function ID="10" Name="Effect 5" Display="'Effect 5'" Dmx="90~99" Update="Effect_Spd" />
      <Function ID="11" Name="Effect 6" Display="'Effect 6'" Dmx="100~109" Update="Effect_Spd" />
      <Function ID="12" Name="Effect 7" Display="'Effect 7'" Dmx="110~119" Update="Effect_Spd" />
      <Function ID="13" Name="Effect 8" Display="'Effect 8'" Dmx="120~129" Update="Effect_Spd" />
      <Function ID="14" Name="Effect 9" Display="'Effect 9'" Dmx="130~139" Update="Effect_Spd" />
      <Function ID="15" Name="Effect 10" Display="'Effect 10'" Dmx="140~149" Update="Effect_Spd" />
      <Function ID="16" Name="Effect 11" Display="'Effect 11'" Dmx="150~159" Update="Effect_Spd" />
      <Function ID="17" Name="Effect 12" Display="'Effect 12'" Dmx="160~169" Update="Effect_Spd" />
      <Function ID="18" Name="Effect 13" Display="'Effect 13'" Dmx="170~179" Update="Effect_Spd" />
      <Function ID="19" Name="Effect 14" Display="'Effect 14'" Dmx="180~189" Update="Effect_Spd" />
      <Function ID="20" Name="Effect 15" Display="'Effect 15'" Dmx="190~199" Update="Effect_Spd" />
      <Function ID="21" Name="Effect 16" Display="'Effect 16'" Dmx="200~209" Update="Effect_Spd" />
      <Function ID="22" Name="Effect 17" Display="'Effect 17'" Dmx="210~219" Update="Effect_Spd" />
      <Function ID="23" Name="Effect 18" Display="'Effect 18'" Dmx="220~229" Update="Effect_Spd" />
      <Function ID="24" Name="Effect 19" Display="'Effect 19'" Dmx="230~239" Update="Effect_Spd" />
      <Function ID="25" Name="Cycle" Display="'Cycle'" Dmx="240~249" Update="Effect_Spd" />
      <Function ID="26" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Effect'==2" />
      <Condition Name="Sound" ID="3,4" If="'Effect'==26" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Full Colour" Display="'Full Colour %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="4" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

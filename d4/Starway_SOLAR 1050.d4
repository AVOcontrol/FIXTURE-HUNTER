  <History Date="30-04-22" Author="Nic Morris" Comment="Created (flow effect ranges not documented properly and don't make sense - left as raw only)" Version="0" />
  <History Date="04-05-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1c85b964-50ec-450a-871d-52d681419979" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~92" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="93~174" />
      <Function ID="5" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="175~250" />
      <Function ID="6" Name="Open (Fast Dim Disabled)" Display="'Open (Fast Dim Disabled)'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Flow_Effect" Name="Flow Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Separate White/Amber Control" Display="'Separate White/Amber Control'" Dmx="1~30" />
      <Function ID="3" Name="Tungsten 1" Display="'Tungsten 1'" Dmx="31~60" />
      <Function ID="4" Name="Tungsten 2" Display="'Tungsten 2'" Dmx="61~90" />
      <Function ID="5" Name="Tungsten 3" Display="'Tungsten 3'" Dmx="91~120" />
      <Function ID="6" Name="Tungsten 4" Display="'Tungsten 4'" Dmx="121~150" />
      <Function ID="7" Name="Tungsten 5" Display="'Tungsten 5'" Dmx="151~180" />
      <Function ID="8" Name="LED Direction 1&lt;10" Display="'LED Direction 1&lt;10'" Dmx="235~244" />
      <Function ID="9" Name="LED Direction 10&gt;1" Display="'LED Direction 10&gt;1'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Dim 0" Display="'Dim 0'" Dmx="10~19" />
      <Function ID="3" Name="Dim 1" Display="'Dim 1'" Dmx="20~29" />
      <Function ID="4" Name="Dim 2" Display="'Dim 2'" Dmx="30~39" />
      <Function ID="5" Name="Dim 3" Display="'Dim 3'" Dmx="40~49" />
      <Function ID="6" Name="Dim 4" Display="'Dim 4'" Dmx="50~59" />
      <Function ID="7" Name="Fade" Display="'Fade %.1f Sec',0.0~10.0" Dmx="60~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

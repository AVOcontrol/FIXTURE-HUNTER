    </Attribute>
    <Attribute ID="Shutter_Mode" Name="Shutter Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="PAR + Strobe" Display="'PAR + Strobe'" Dmx="0~0" />
      <Function ID="2" Name="PAR Only" Display="'PAR Only'" Dmx="100~199" />
      <Function ID="3" Name="Strobe Only" Display="'Strobe Only'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Shutter_Speed" Name="Shutter Speed" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="51~100" />
      <Function ID="3" Name="Gradual" Display="'Gradual'" Dmx="101~150" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="151~200" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="V1200TW-ER" ShortName="V1200TW-ER" Company="Terbly">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <Thumbnail>be1f030c-31be-4472-a1ab-b1c177419835</Thumbnail>
  <History Date="15-06-09" Author="David Hunt" Comment="Created" />
  <History Date="22-06-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="11-02-10" Author="Gregory Haynes" Comment="Updated macro timings to 20 seconds" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function.  Increased wheel resolution and tidied colour func function names." />
  <History Date="20-12-17" Author="Nic Morris" Comment="Added Atlabase ID's (note there are currently two sets of the same modes/channels)." />
  <History Date="20-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." />
  <History Date="20-12-17" Author="Nic Morris" Comment="Fixed 16bit raw display ranges." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8693f276-2dfb-410c-ba6e-80703d3f5666" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
      <Function ID="3" Name="All in Dark" Display="'All in Dark'" Dmx="236~245" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="4112~7967" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="8224~12079" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="12336~16191" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="16448~20303" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="20560~24415" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="24672~28527" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="28784~32639" Colour="0,0,0" />
      <Function ID="9" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.2f%%',0.00~100.00" Dmx="49858~65535" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CMYSpeed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Macro" Display="'Macro %.f',1~30" Dmx="8~247" Colour="0,0,0" />
      <Function ID="3" Name="Random CMY" Display="'Random CMY'" Dmx="248~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="C/G Fixed" Display="'C/G Fixed'" Dmx="0~0" />
      <Function ID="2" Name="Col Index" Display="'Col Index'" Dmx="20~29" />
      <Function ID="3" Name="C/G Index" Display="'C/G Index'" Dmx="30~39" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="8" Name="Reset Colour" Display="'Reset Colour'" Dmx="88~90" />
      <Function ID="9" Name="Reset Intensity" Display="'Reset Intensity'" Dmx="94~96" />
      <Function ID="10" Name="Reset Other" Display="'Reset Other'" Dmx="97~99" />
      <Function ID="11" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="12" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="13" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="14" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="15" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="16" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="17" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
  </Control>

      <Function ID="29" Name="Pattern 27" Display="'Pattern 27'" Dmx="168~173" />
      <Function ID="30" Name="Gradient Effect" Display="'Gradient Effect'" Dmx="174~179" />
      <Function ID="31" Name="Pulse Effect" Display="'Pulse Effect'" Dmx="180~185" />
      <Function ID="32" Name="Jump Effect" Display="'Jump Effect'" Dmx="186~191" />
      <Function ID="33" Name="Colourful Pattern 1" Display="'Colourful Pattern 1'" Dmx="192~197" />
      <Function ID="34" Name="Colourful Pattern 2" Display="'Colourful Pattern 2'" Dmx="198~203" />
      <Function ID="35" Name="Sound 1" Display="'Sound 1'" Dmx="204~213" />
      <Function ID="36" Name="Sound 2" Display="'Sound 2'" Dmx="214~223" />
      <Function ID="37" Name="Sound 3" Display="'Sound 3'" Dmx="224~233" />
      <Function ID="38" Name="Sound 4" Display="'Sound 4'" Dmx="234~243" />
      <Function ID="39" Name="Sound Summary" Display="'Sound Summary'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="WW" Display="'WW %.f%%',0~100" Dmx="1~85" Colour="0,0,0" />
      <Function ID="3" Name="CW" Display="'CW %.f%%',0~100" Dmx="86~170" Colour="0,0,0" />
      <Function ID="4" Name="WW+CW" Display="'WW+CW %.f%%',0~100" Dmx="171~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="WW_Dim_Macro" Name="WW Dim Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CW_Dim_Macro" Name="CW Dim Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Direction" Name="FX Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="FWD" Display="'FWD'" Dmx="0~0" />
      <Function ID="2" Name="REV/Refresh" Display="'REV/Refresh'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Pixel Control, 10 DMX" Channels="10" Id="1cc3146e-c738-4b39-b101-cea54c9613f8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="805f5fcc-61c7-4a01-a579-6698d692a1d2" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="WarmWhite" Wheel="10" />
        <Attribute ID="ColdWhite" Wheel="11" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORstrip Mini FX" ShortName="ClStMiniFX" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="22-04-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c066c7d4-f463-4162-b699-61385df84fc6" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="238~244" Update="Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~6" Update="Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="7~13" Update="Red, Green" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="14~20" Update="Red, Green" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="21~27" Update="Red, Green" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="28~34" Update="Red, Green" Colour="255,255,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="35~41" Update="Red, Green" Colour="128,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="42~48" Update="Red, Green" Colour="0,255,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="49~55" Update="Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="Red Laser" Display="'Red Laser'" Dmx="56~62" Update="Red, Green" Colour="255,255,255" />
      <Function ID="11" Name="Green Laser" Display="'Green Laser'" Dmx="63~69" Update="Red, Green" Colour="255,255,255" />
      <Function ID="12" Name="R+G Laser" Display="'R+G Laser'" Dmx="70~76" Update="Red, Green" Colour="255,255,255" />
      <Function ID="13" Name="Col Change 1" Display="'Col Change 1'" Dmx="77~83" Update="Red, Green" Colour="255,255,255" />
      <Function ID="14" Name="Col Change 2" Display="'Col Change 2'" Dmx="84~90" Update="Red, Green" Colour="255,255,255" />
      <Function ID="15" Name="Col Change 3" Display="'Col Change 3'" Dmx="91~97" Update="Red, Green" Colour="255,255,255" />
      <Function ID="16" Name="Col Change 4" Display="'Col Change 4'" Dmx="98~104" Update="Red, Green" Colour="255,255,255" />
      <Function ID="17" Name="Col Change 5" Display="'Col Change 5'" Dmx="105~111" Update="Red, Green" Colour="255,255,255" />
      <Function ID="18" Name="Col Change 6" Display="'Col Change 6'" Dmx="112~118" Update="Red, Green" Colour="255,255,255" />
      <Function ID="19" Name="Col Change 1 (Laser)" Display="'Col Change 1 (Laser)'" Dmx="119~125" Update="Red, Green" Colour="255,255,255" />
      <Function ID="20" Name="Col Change 2 (Laser)" Display="'Col Change 2 (Laser)'" Dmx="126~132" Update="Red, Green" Colour="255,255,255" />
      <Function ID="21" Name="Col Change 3 (Laser)" Display="'Col Change 3 (Laser)'" Dmx="133~139" Update="Red, Green" Colour="255,255,255" />
      <Function ID="22" Name="Col Change 4 (Laser)" Display="'Col Change 4 (Laser)'" Dmx="140~146" Update="Red, Green" Colour="255,255,255" />
      <Function ID="23" Name="Col Change 5 (Laser)" Display="'Col Change 5 (Laser)'" Dmx="147~153" Update="Red, Green" Colour="255,255,255" />
      <Function ID="24" Name="Col Chase 1" Display="'Col Chase 1'" Dmx="154~160" Update="Red, Green" Colour="255,255,255" />
      <Function ID="25" Name="Col Chase 2" Display="'Col Chase 2'" Dmx="161~167" Update="Red, Green" Colour="255,255,255" />
      <Function ID="26" Name="Col Chase 3" Display="'Col Chase 3'" Dmx="168~174" Update="Red, Green" Colour="255,255,255" />
      <Function ID="27" Name="Col Chase 4" Display="'Col Chase 4'" Dmx="175~181" Update="Red, Green" Colour="255,255,255" />
      <Function ID="28" Name="Col Chase 5" Display="'Col Chase 5'" Dmx="182~188" Update="Red, Green" Colour="255,255,255" />
      <Function ID="29" Name="Col Chase 6" Display="'Col Chase 6'" Dmx="189~195" Update="Red, Green" Colour="255,255,255" />
      <Function ID="30" Name="Col Chase 7" Display="'Col Chase 7'" Dmx="196~202" Update="Red, Green" Colour="255,255,255" />
      <Function ID="31" Name="Col Chase 1 (Laser)" Display="'Col Chase 1 (Laser)'" Dmx="203~209" Update="Red, Green" Colour="255,255,255" />
      <Function ID="32" Name="Col Chase 2 (Laser)" Display="'Col Chase 2 (Laser)'" Dmx="210~216" Update="Red, Green" Colour="255,255,255" />
      <Function ID="33" Name="Col Chase 3 (Laser)" Display="'Col Chase 3 (Laser)'" Dmx="217~223" Update="Red, Green" Colour="255,255,255" />
      <Function ID="34" Name="Col Chase 4 (Laser)" Display="'Col Chase 4 (Laser)'" Dmx="224~230" Update="Red, Green" Colour="255,255,255" />
      <Function ID="35" Name="Col Chase 5 C(Laser)" Display="'Col Chase 5 C(Laser)'" Dmx="231~237" Update="Red, Green" Colour="255,255,255" />
      <Function ID="36" Name="Col Fade" Display="'Col Fade'" Dmx="245~251" Update="Red, Green" Colour="255,255,255" />
      <Function ID="37" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Auto" ID="2,3" If="'Colour_Macro'&gt;12&amp;&amp;'Colour_Macro'&lt;36" />
      <Condition Name="Speed" ID="4" If="'Colour_Macro'==36" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Auto Speed" Display="'Auto Speed %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="128~255" Colour="255,255,255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;17" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~249" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="40~79" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="80~119" Colour="255,255,255" />
      <Function ID="4" Name="Red + Green" Display="'Red + Green'" Dmx="120~159" Colour="255,255,255" />
      <Function ID="5" Name="Red On, Green Strobe" Display="'Red On, Green Strobe'" Dmx="160~199" Colour="255,255,255" />
      <Function ID="6" Name="Green On, Red Strobe" Display="'Green On, Red Strobe'" Dmx="200~239" Colour="255,255,255" />
      <Function ID="7" Name="Alternate Strobe" Display="'Alternate Strobe'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Shutter" Name="Laser Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Laser_Effect" Name="Laser Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern 1" Display="'Pattern 1'" Dmx="0~0" />
      <Function ID="2" Name="Pattern 2" Display="'Pattern 2'" Dmx="20~39" />
      <Function ID="3" Name="Pattern 3" Display="'Pattern 3'" Dmx="40~59" />
      <Function ID="4" Name="Pattern 4" Display="'Pattern 4'" Dmx="60~79" />
      <Function ID="5" Name="Pattern 5" Display="'Pattern 5'" Dmx="80~99" />
      <Function ID="6" Name="Pattern 6" Display="'Pattern 6'" Dmx="100~119" />
      <Function ID="7" Name="Rotate" Display="'Rotate %.1f%%',0.0~100.0" Dmx="120~255" />
    </Attribute>
    <Attribute ID="Laser_Colour1" Name="Laser Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Auto with Strobe" Display="'Auto with Strobe'" Dmx="11~63" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="5" Name="Red + Green" Display="'Red + Green'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="CHCSMFX7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bf7f6e52-db8c-4ad3-b867-3f6f50ae44c2" />
    <Include>
      <Attribute ID="Laser_Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Laser_Colour" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Laser_Effect" ChannelOffset="7" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CHCSMFX4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9838d056-2cd5-426d-87ba-9adfecd3ff3b" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Laser_Colour1" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
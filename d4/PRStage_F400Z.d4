    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:5800" PowerOn="1:5800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3200~5800" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Quadratic" Display="'Quadratic'" Dmx="50~99" />
      <Function ID="3" Name="Inv Quadratic" Display="'Inv Quadratic'" Dmx="100~149" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Slow" Display="'Dim Slow'" Dmx="150~159" />
      <Function ID="3" Name="Dim Fast" Display="'Dim Fast'" Dmx="160~169" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>

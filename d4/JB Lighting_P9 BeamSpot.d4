    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~49087" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="49344~57054" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="57311~57568" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="57825~65535" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="FX_Speed" Name="FX Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Move_in_Dark" Name="Move in Dark" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="96~127" />
      <Function ID="3" Name="G/C/P in Dark" Display="'G/C/P in Dark'" Dmx="128~159" />
      <Function ID="4" Name="G/C/P/F in Dark" Display="'G/C/P/F in Dark'" Dmx="160~191" />
      <Function ID="5" Name="G/C/P/PT in Dark" Display="'G/C/P/PT in Dark'" Dmx="192~223" />
      <Function ID="6" Name="All in Dark" Display="'All in Dark'" Dmx="224~255" />
    </Attribute>
  </Control>

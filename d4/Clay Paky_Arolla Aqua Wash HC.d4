    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19" If="'Colour1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="9~13" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Navy Blue" Display="'Navy Blue'" Dmx="18~21" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Deep Green" Display="'Deep Green'" Dmx="27~30" WheelPosition="3" Colour="0,200,0" />
      <Function ID="5" Name="Golden Amber" Display="'Golden Amber'" Dmx="35~39" WheelPosition="4" Colour="255,100,0" />
      <Function ID="6" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="44~48" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Dark Orange" Display="'Dark Orange'" Dmx="53~56" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="CTB" Display="'CTB'" Dmx="62~65" WheelPosition="7" Colour="230,230,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ N Blu" Display="'D Rd/ N Blu'" Dmx="14~17" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="N Blu/ D Grn" Display="'N Blu/ D Grn'" Dmx="22~26" WheelPosition="2" Colour="0,0,255" />
      <Function ID="12" Name="D Grn/ G Amb" Display="'D Grn/ G Amb'" Dmx="31~34" WheelPosition="3" Colour="0,200,0" />
      <Function ID="13" Name="G Amb/ B Blu" Display="'G Amb/ B Blu'" Dmx="40~43" WheelPosition="4" Colour="255,100,0" />
      <Function ID="14" Name="B Blu/ D Org" Display="'B Blu/ D Org'" Dmx="49~52" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="D Org/ CTB" Display="'D Org/ CTB'" Dmx="57~61" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="CTB/ Op" Display="'CTB/ Op'" Dmx="66~69" WheelPosition="7" Colour="230,230,255" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="70~127" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

      <Function ID="6" Name="Tq - F Pk" Display="'Tq - F Pk %.f%%',0~100" Dmx="64~96" Colour="0,255,150" />
      <Function ID="7" Name="Follies Pink" Display="'Follies Pink'" Dmx="96~96" Colour="255,160,180" />
      <Function ID="8" Name="F Pk - R Mag" Display="'F Pk - R Mag %.f%%',0~100" Dmx="96~128" Colour="255,160,180" />
      <Function ID="9" Name="Rosey Magenta" Display="'Rosey Magenta'" Dmx="128~128" Colour="255,0,170" />
      <Function ID="10" Name="R Mag - Org" Display="'R Mag - Org %.f%%',0~100" Dmx="128~160" Colour="255,0,170" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="160~160" Colour="255,150,0" />
      <Function ID="12" Name="Org - Grn" Display="'Org - Grn %.f%%',0~100" Dmx="160~192" Colour="255,150,0" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="192~192" Colour="0,255,0" />
      <Function ID="14" Name="Grn - UV Blu" Display="'Grn - UV Blu %.f%%',0~100" Dmx="192~224" Colour="0,255,0" />
      <Function ID="15" Name="UV Blue" Display="'UV Blue'" Dmx="224~224" Colour="50,0,200" />
      <Function ID="16" Name="UV Blu - Op" Display="'UV Blu - Op %.f%%',0~100" Dmx="224~255" Colour="50,0,200" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="127~128" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.1f%%',100.0~0.0" Dmx="0~126" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="127~128" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Continuous" Display="'Continuous'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Discreet" Display="'Discreet'" Dmx="10~19" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="20~39" Update="Colour1" Colour="0,0,0" />

    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Effect, Effect_Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Effect, Effect_Rot" />
      <Function ID="3" Name="Frost" Display="'Frost'" Dmx="0~0" Update="Effect, Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Index" ID="1,2,3,4" If="'Effect_Func'==1||'Effect_Func'==2" />
      <Condition Name="Frost" ID="5" If="'Effect_Func'==3" />

      <Function ID="6" Name="Rnd Strobe Fast" Display="'Rnd Strobe Fast'" Dmx="47~49" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~255" Update="Colour1" Colour="0,0,0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>

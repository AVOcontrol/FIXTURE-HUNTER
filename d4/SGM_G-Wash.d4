      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Aperture" Name="Aperture" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="2" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="512~32768" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32769~49151" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49152~49152" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49153~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Shut Cl=RED" Display="'Shut Cl=RED'" Dmx="27~32" />
      <Function ID="3" Name="Shut Cl=GREEN" Display="'Shut Cl=GREEN'" Dmx="33~38" />

  <AtlaBase TypeID="2f18f288-1e49-49fe-9b9a-3e665050929a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open (Preheat ON)" Display="'Open (Preheat ON)'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="116~16" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="152~117" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="153~173" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="174~194" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="195~220" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="221~246" Intensity="0~0" />
      <Function ID="9" Name="Open (Preheat OFF)" Display="'Open (Preheat OFF)'" Dmx="247~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="14:71" PowerOn="14:71" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No CTC (RAW)" Display="'No CTC (RAW)'" Dmx="1~4" Colour="255,255,255" />
      <Function ID="3" Name="2000K" Display="'2000K'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="4" Name="2200K" Display="'2200K'" Dmx="15~15" Colour="255,255,255" />
      <Function ID="5" Name="2700K" Display="'2700K'" Dmx="40~40" Colour="255,255,255" />
      <Function ID="6" Name="3000K" Display="'3000K'" Dmx="54~54" Colour="255,255,255" />
      <Function ID="7" Name="3200K" Display="'3200K'" Dmx="65~65" Colour="255,255,255" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="105~105" Colour="255,255,255" />
      <Function ID="9" Name="4200K" Display="'4200K'" Dmx="115~115" Colour="255,255,255" />
      <Function ID="10" Name="5500K" Display="'5500K'" Dmx="177~177" Colour="255,255,255" />
      <Function ID="11" Name="6300K" Display="'6300K'" Dmx="216~216" Colour="255,255,255" />
      <Function ID="12" Name="8000K" Display="'8000K'" Dmx="238~238" Colour="255,255,255" />
      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="14" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

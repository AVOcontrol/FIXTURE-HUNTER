    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Blend" Display="'Blend %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Change" Display="'Change %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Sound Blend" Display="'Sound Blend %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Sound Change" Display="'Sound Change %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="White 4300K" Display="'White 4300K'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="White 6500K" Display="'White 6500K'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="White 8000K" Display="'White 8000K'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
  </Control>

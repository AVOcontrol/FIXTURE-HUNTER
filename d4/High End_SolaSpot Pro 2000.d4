      <Function ID="14" Name="Program 7" Display="'Program 7'" Dmx="227~237" />
      <Function ID="15" Name="Fan Studio" Display="'Fan Studio'" Dmx="76~82" />
      <Function ID="16" Name="Fan Continuous" Display="'Fan Continuous'" Dmx="83~89" />
      <Function ID="17" Name="Fan Standard" Display="'Fan Standard'" Dmx="90~96" />
    </Attribute>
    <Attribute ID="Indigo_Func" Name="Indigo Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer Tracking" Display="'Dimmer Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Strobe Tracking" Display="'Strobe Tracking'" Dmx="16~41" />
      <Function ID="3" Name="Rnd Strobe Tracking" Display="'Rnd Strobe Tracking'" Dmx="42~67" />
      <Function ID="4" Name="Dimmer Independent" Display="'Dimmer Independent'" Dmx="128~143" />
      <Function ID="5" Name="Strobe Independent" Display="'Strobe Independent'" Dmx="144~169" />
      <Function ID="6" Name="Rnd Strobe Independent" Display="'Rnd Strobe Independent'" Dmx="170~195" />
    </Attribute>
    <Attribute ID="Gobo_2_Rot_Func" Name="Gobo 2 Rot Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="16~31" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="32~47" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="48~63" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CCW" Display="'Anim CCW'" Dmx="64~79" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo_2_Rot_Func'==1" />
      <Condition Name="Spin" ID="2,3" If="'Gobo_2_Rot_Func'&gt;1&amp;&amp;'Gobo_2_Rot_Func'&lt;6" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~771" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Animation_2" Name="Animation 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="4~6" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="7~8" />
      <Function ID="4" Name="Spin FW" Display="'Spin FW %.1f%%',100.0~0.0" Dmx="131~9" />
      <Function ID="5" Name="Spin REV" Display="'Spin REV %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Prism2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="16~31" Update="Prism_Rot" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW'" Dmx="32~47" Update="Prism_Rot" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW'" Dmx="48~63" Update="Prism_Rot" />
      <Function ID="5" Name="Anim CW" Display="'Anim CW'" Dmx="64~79" Update="Prism_Rot" />
      <Function ID="6" Name="Anim CCW" Display="'Anim CCW'" Dmx="80~95" Update="Prism_Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fine" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

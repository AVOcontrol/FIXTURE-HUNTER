    <Attribute ID="Parameter_1" Name="Parameter 1" Description="" Group="E">
      <Locate Locate="2:1800" PowerOn="2:1800" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Mode'==1" />
      <Condition Name="HSI" ID="3" If="'Mode'==2" />

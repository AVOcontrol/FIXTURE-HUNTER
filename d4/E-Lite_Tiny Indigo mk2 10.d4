      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="241~250" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="12~23" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="24~35" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="36~47" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="48~59" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="60~71" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="72~83" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="84~95" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="136~150" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="151~165" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="166~180" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="181~195" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="196~210" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="211~225" />

  <Thumbnail>e8a7b801-fcca-46f6-aee4-e568d127dd4c</Thumbnail>
  <History Date="08-12-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e16baa8f-86d7-4cbb-91de-12e9bccbe666" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="5 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~200" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~254" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="24~47" Colour="255,128,0" />
      <Function ID="3" Name="Cyan" Display="'Cyan'" Dmx="48~71" Colour="0,255,255" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="72~95" Colour="128,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="96~119" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="120~143" Colour="0,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="144~167" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="168~191" Colour="255,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Gobo1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>5f2a767f-e19c-4ed0-b452-dfdf1ed5c688</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="12~23" WheelPosition="1">
        <Swatch>d066bd90-a6b8-4e24-912e-323d078dd94c</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="24~35" WheelPosition="2">
        <Swatch>4b3ac5cb-36d4-49b2-9188-9f611d8984ec</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="36~47" WheelPosition="3">
        <Swatch>ebd01ea1-9e9d-4285-ac78-841d7d4ec5d5</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="48~59" WheelPosition="4">
        <Swatch>d4b89f86-39c0-4767-99c0-874a53ab7b68</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="60~71" WheelPosition="5">
        <Swatch>8d55f65c-ea9e-489c-beae-324bb6f6b770</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="72~83" WheelPosition="6">
        <Swatch>f7558bdf-b6cd-4084-8e1c-468964b51ad3</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="84~95" WheelPosition="7">
        <Swatch>a75c7f5c-4d30-4107-bc25-dc97f1e86791</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>5f2a767f-e19c-4ed0-b452-dfdf1ed5c688</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="96~111" WheelPosition="1">
        <Swatch>d066bd90-a6b8-4e24-912e-323d078dd94c</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="112~127" WheelPosition="2">
        <Swatch>4b3ac5cb-36d4-49b2-9188-9f611d8984ec</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="128~143" WheelPosition="3">
        <Swatch>ebd01ea1-9e9d-4285-ac78-841d7d4ec5d5</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="144~159" WheelPosition="4">
        <Swatch>d4b89f86-39c0-4767-99c0-874a53ab7b68</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~175" WheelPosition="5">
        <Swatch>8d55f65c-ea9e-489c-beae-324bb6f6b770</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="176~191" WheelPosition="6">
        <Swatch>f7558bdf-b6cd-4084-8e1c-468964b51ad3</Swatch>
      </Function>
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="8~32" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="33~58" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="59~84" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="85~110" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="111~136" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="137~164" />

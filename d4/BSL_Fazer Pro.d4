      <Attribute ID="Fan" ChannelOffset="2" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKBSLFP4" DiamondRef="" WysiwygRef="" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Haze" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Duration 3s" Display="'Duration 3s'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'Duration %.f Sec',3~250" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Interval" Name="Interval" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Interval 3s" Display="'Interval 3s'" Dmx="0~0" />
      <Function ID="2" Name="Interval" Display="'Interval %.f Sec',5~250" Dmx="10~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKBSLFP1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

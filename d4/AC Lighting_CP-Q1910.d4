    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

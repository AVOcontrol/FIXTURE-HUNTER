<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Astroraggi Power" ShortName="Astroraggi" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-10-04" Author="Phil Rogers" Comment="Created" />
  <History Date="04-10-04" Author="Tom Peck" Comment="Checked" />
  <History Date="06-04-06" Author="Ed" Comment="Moved Dome Rot and Dom Func to Effect group" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-06-17" Author="Nic Morris" Comment="Revised function ranges." />
  <History Date="28-06-17" Author="Nic Morris" Comment="Fixed channel mapping." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b61da577-7187-4633-a87c-b55d89573534" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="128~140" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="141~242" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="243~255" />
    </Attribute>
    <Attribute ID="Dome_Rot" Name="Dome Rot" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Index" Display="'Index %.f°',0~360" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~194" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="189~128" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="CPASTRORAG" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fc8b8d89-be07-48d9-a43b-2c41a22f5829" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Dome_Rot" ChannelOffset="1" Wheel="19" />
    </Include>
  </Mode>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2bd673dc-dd6b-4850-b00b-e3d49e4f294b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3000K" Display="'3000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="51~100" Colour="255,255,255" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="101~150" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="151~200" Colour="255,255,255" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="11~25" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="26~40" Colour="0,0,255" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="41~55" Colour="0,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="56~70" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="71~85" Colour="255,0,255" />
      <Function ID="7" Name="3000K" Display="'3000K'" Dmx="86~100" Colour="255,240,200" />
      <Function ID="8" Name="3200K" Display="'3200K'" Dmx="101~115" Colour="255,240,200" />
      <Function ID="9" Name="4000K" Display="'4000K'" Dmx="116~130" Colour="255,255,255" />
      <Function ID="10" Name="5600K" Display="'5600K'" Dmx="131~145" Colour="230,230,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="146~160" Colour="230,230,255" />
      <Function ID="12" Name="Medium Amber" Display="'Medium Amber'" Dmx="161~170" Colour="255,100,0" />
      <Function ID="13" Name="Lavender" Display="'Lavender'" Dmx="171~180" Colour="255,128,255" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="181~190" Colour="255,128,0" />
      <Function ID="15" Name="Medium Blue Green" Display="'Medium Blue Green'" Dmx="191~200" Colour="0,255,128" />
      <Function ID="16" Name="Dark Blue" Display="'Dark Blue'" Dmx="201~210" Colour="0,0,180" />
      <Function ID="17" Name="Dark Green" Display="'Dark Green'" Dmx="211~220" Colour="0,180,0" />
      <Function ID="18" Name="Mauve" Display="'Mauve'" Dmx="221~230" Colour="180,0,255" />
      <Function ID="19" Name="Bright Pink" Display="'Bright Pink'" Dmx="231~240" Colour="255,0,127" />
      <Function ID="20" Name="Medium Blue" Display="'Medium Blue'" Dmx="241~255" Colour="0,128,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

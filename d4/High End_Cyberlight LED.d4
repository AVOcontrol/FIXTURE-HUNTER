      <Condition Name="Scan" ID="19,20,21,22,23,24,25,26" If="'Colour1Func'==5" />
      <Else ID="27" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~30" WheelPosition="1" Colour="255,255,255" />

  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:7" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

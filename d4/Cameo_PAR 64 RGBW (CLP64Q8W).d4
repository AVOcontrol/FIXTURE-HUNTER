  <AtlaBase TypeID="a7c65902-05ae-42c5-b8b3-5f8b91774971" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="26~30" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="31~35" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="36~40" Colour="255,0,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="41~45" Colour="255,150,150" />
      <Function ID="10" Name="Bright Green" Display="'Bright Green'" Dmx="46~50" Colour="128,255,0" />
      <Function ID="11" Name="Lavender" Display="'Lavender'" Dmx="51~55" Colour="180,0,255" />
      <Function ID="12" Name="Pale Pink" Display="'Pale Pink'" Dmx="56~60" Colour="255,150,230" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="61~65" Colour="255,100,0" />
      <Function ID="14" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="66~70" Colour="255,128,255" />
      <Function ID="15" Name="Pale Cyan" Display="'Pale Cyan'" Dmx="71~75" Colour="128,255,255" />
      <Function ID="16" Name="Warm White" Display="'Warm White'" Dmx="76~80" Colour="255,240,200" />
      <Function ID="17" Name="Colour Jump" Display="'Colour Jump %.f%%',0~100" Dmx="81~150" Colour="255,255,255" />
      <Function ID="18" Name="Colour Fade" Display="'Colour Fade %.f%%',0~100" Dmx="151~220" Colour="255,255,255" />
      <Function ID="19" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="51~67" Colour="255,255,255" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="68~84" Colour="255,128,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="85~101" Colour="0,255,255" />
      <Function ID="7" Name="Lavender" Display="'Lavender'" Dmx="102~118" Colour="200,100,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="119~135" Colour="255,150,150" />
      <Function ID="9" Name="Bright Green" Display="'Bright Green'" Dmx="136~152" Colour="128,255,0" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="153~169" Colour="180,0,255" />
      <Function ID="11" Name="Pale Pink" Display="'Pale Pink'" Dmx="170~186" Colour="255,150,230" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="187~203" Colour="255,100,0" />
      <Function ID="13" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="204~220" Colour="255,128,255" />
      <Function ID="14" Name="Pale Cyan" Display="'Pale Cyan'" Dmx="221~237" Colour="128,255,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="238~255" Colour="255,240,200" />
    </Attribute>
  </Control>

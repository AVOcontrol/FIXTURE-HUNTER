  <History Date="22-08-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="20-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's to 3 DMX modes.  (Note there are currently 6 fixture options in Capture.)" />
  <History Date="01-03-18" Author="Nic Morris" Comment="Created from Cameo Flat Par Can (same thing - split for Capture)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ea4afb72-3b35-403c-b2c8-c383c361cb90" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="37~73" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="74~110" Colour="0,0,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="111~147" Colour="255,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="148~184" Colour="255,0,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="185~221" Colour="0,255,255" />
      <Function ID="7" Name="White" Display="'White'" Dmx="222~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~15" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~26" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="27~37" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="38~48" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="49~59" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~70" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="81~150" Colour="255,255,255" />
      <Function ID="10" Name="Col Blend" Display="'Col Blend %.f%%',0~100" Dmx="151~220" Colour="255,255,255" />
      <Function ID="11" Name="Sound Sens" Display="'Sound Sens %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMFP11" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="395ff26c-a5a5-4f51-af2b-193aada49e17" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX m1" Channels="3">
    <Import PearlRef="UKCMFP12" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="14286597-92bb-4f24-9ff1-c2fffb56b496" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour_Macro1" ChannelOffset="3" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX m2" Channels="3">
    <Import PearlRef="UKCMFP13" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a6459d44-0955-4e7e-b569-dd1eb27e3711" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="UKCMFP14" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bc8fca80-ea27-42ac-8181-2d770f04b312" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />

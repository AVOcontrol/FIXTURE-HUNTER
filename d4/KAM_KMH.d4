    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Pan" Display="'Reset Pan'" Dmx="51~101" />
      <Function ID="3" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="102~152" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="153~203" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="204~255" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="3~223" />
      <Function ID="3" Name="Col Snap" Display="'Col Snap %.f%%',0~100" Dmx="224~234" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="235~243" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />

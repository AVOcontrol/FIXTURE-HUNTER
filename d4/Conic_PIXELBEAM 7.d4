      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="136~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="128~159" />
      <Function ID="5" Name="Rnd Colour" Display="'Rnd Colour %.f%%',0~100" Dmx="192~223" />
    </Attribute>
    <Attribute ID="FX_Macro" Name="FX Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static %.f',1~75" Dmx="1~75" />
      <Function ID="3" Name="Dynamic 1" Display="'Dynamic 1'" Dmx="76~95" />
      <Function ID="4" Name="Dynamic 2" Display="'Dynamic 2'" Dmx="96~115" />
      <Function ID="5" Name="Dynamic 3" Display="'Dynamic 3'" Dmx="116~135" />
      <Function ID="6" Name="Dynamic 4" Display="'Dynamic 4'" Dmx="136~155" />
      <Function ID="7" Name="Dynamic 5" Display="'Dynamic 5'" Dmx="156~175" />
      <Function ID="8" Name="Dynamic 6" Display="'Dynamic 6'" Dmx="176~195" />
      <Function ID="9" Name="Dynamic 7" Display="'Dynamic 7'" Dmx="196~215" />
      <Function ID="10" Name="Dynamic 8" Display="'Dynamic 8'" Dmx="216~235" />
      <Function ID="11" Name="Dynamic 9" Display="'Dynamic 9'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

  <Mode Name="23 DMX, 16bit" Channels="23">
    <Import PearlRef="CM_InfSM23" DiamondRef="CM_InfSM23" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

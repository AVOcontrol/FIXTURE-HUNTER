<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Tri Cloth &amp; Controller" ShortName="Tri Cloth" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="08-02-15" Author="Nic Morris" Comment="Created" />
  <History Date="22-04-16" Author="Gregory Haynes" Comment="Added short name" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~49" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="50~59" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="60~69" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="70~79" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="80~89" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="90~99" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="100~109" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="110~119" />
      <Function ID="9" Name="White" Display="'White'" Dmx="120~129" />
      <Function ID="10" Name="Program 1" Display="'Program 1'" Dmx="130~139" />
      <Function ID="11" Name="Program 2" Display="'Program 2'" Dmx="140~149" />
      <Function ID="12" Name="Program 3" Display="'Program 3'" Dmx="150~159" />
      <Function ID="13" Name="Program 4" Display="'Program 4'" Dmx="160~169" />
      <Function ID="14" Name="Program 5" Display="'Program 5'" Dmx="170~179" />
      <Function ID="15" Name="Program 6" Display="'Program 6'" Dmx="180~189" />
      <Function ID="16" Name="Program 7" Display="'Program 7'" Dmx="190~199" />
      <Function ID="17" Name="Program 8" Display="'Program 8'" Dmx="200~209" />
      <Function ID="18" Name="Program 9" Display="'Program 9'" Dmx="210~219" />
      <Function ID="19" Name="Program 10" Display="'Program 10'" Dmx="220~229" />
      <Function ID="20" Name="Macro" Display="'Macro'" Dmx="230~239" />
      <Function ID="21" Name="Sound" Display="'Sound'" Dmx="240~249" />
      <Function ID="22" Name="No Function" Display="'No Function'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~4" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Architectural City Color 600 (VDPLOW608)" ShortName="CityCol600" Company="HQ Power">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="5 DMX" ID="4,5,6" If="'Dummy'==1" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~196" />
      <Function ID="3" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="197~255" />
      <Function ID="4" Name="Open" Display="'Open %.1f%%',0.0~100.0" Dmx="152~152" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="153~196" />
      <Function ID="6" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="197~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="2~19" />
      <Function ID="3" Name="Col Trans" Display="'Col Trans %.f%%',0~100" Dmx="20~39" />
      <Function ID="4" Name="Col Free" Display="'Col Free %.f%%',0~100" Dmx="40~59" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~79" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~99" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="100~119" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="120~139" />
      <Function ID="9" Name="Red Flash" Display="'Red Flash %.f%%',0~100" Dmx="140~159" />
      <Function ID="10" Name="Green Flash" Display="'Green Flash %.f%%',0~100" Dmx="160~179" />
      <Function ID="11" Name="Blue Flash" Display="'Blue Flash %.f%%',0~100" Dmx="180~199" />
      <Function ID="12" Name="Lt Yel Flash" Display="'Lt Yel Flash %.f%%',0~100" Dmx="200~219" />
      <Function ID="13" Name="Cyan Flash" Display="'Cyan Flash %.f%%',0~100" Dmx="220~229" />
      <Function ID="14" Name="White Flash" Display="'White Flash %.f%%',0~100" Dmx="230~249" />
      <Function ID="15" Name="All On" Display="'All On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Shutter" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="HQCC6004" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="HQCC6005" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Dummy" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="HQCC6007" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Macro" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
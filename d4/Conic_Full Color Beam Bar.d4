  <History Date="05-10-24" Author="Nic Morris" Comment="Added Atlabase ID's (Laser Bar LTB12W)" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="46127ce9-cebc-4f6b-b33f-5b856181def9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~37" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="38~52" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="53~67" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="68~82" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="83~97" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="98~112" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~142" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="143~157" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="158~172" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="218~232" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro " Display="'Macro  %.1f%%',0.0~100.0" Dmx="15~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Master" Name="Pan Master" Description="" Group="P" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Individual Control" Display="'Individual Control'" Dmx="0~0" />
      <Function ID="2" Name="Pan All" Display="'Pan All %.2f%%',0.00~100.00" Dmx="257~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

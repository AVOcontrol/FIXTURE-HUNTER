<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RGY 180" ShortName="RGY  180" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="10-01-08" Author="Gregory Haynes" Comment="Created" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Lanta to Unknown" />
  <History Date="10-02-10" Author="John Rogers" Comment="Renamed and moved from Unknown to Lanta Lighting." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~69" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="70~139" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="140~209" />
      <Function ID="4" Name="Manual" Display="'Manual'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~33" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.1f%%',0.0~100.0" Dmx="34~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Speed 1" Display="'Speed 1'" Dmx="0~30" Intensity="0~0" />
      <Function ID="2" Name="Speed 2" Display="'Speed 2'" Dmx="31~60" Intensity="0~0" />
      <Function ID="3" Name="Speed 3" Display="'Speed 3'" Dmx="61~90" Intensity="0~0" />
      <Function ID="4" Name="Speed 4" Display="'Speed 4'" Dmx="91~120" Intensity="0~0" />
      <Function ID="5" Name="Speed 5" Display="'Speed 5'" Dmx="121~150" Intensity="0~0" />
      <Function ID="6" Name="Speed 6" Display="'Speed 6'" Dmx="151~180" Intensity="0~0" />
      <Function ID="7" Name="Speed 7" Display="'Speed 7'" Dmx="181~210" Intensity="0~0" />
      <Function ID="8" Name="Speed 8" Display="'Speed 8'" Dmx="211~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dot_Line" Name="Dot &amp; Line" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~69" />
      <Function ID="2" Name="Dot &amp; Line" Display="'Dot &amp; Line'" Dmx="70~139" />
      <Function ID="3" Name="Sub Section" Display="'Sub Section'" Dmx="140~209" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'%.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="Left/Right" Display="'Left/Right'" Dmx="161~190" />
      <Function ID="3" Name="Right/Left" Display="'Right/Left'" Dmx="191~220" />
      <Function ID="4" Name="Bounce" Display="'Bounce'" Dmx="121~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'%.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="Up/Down" Display="'Up/Down'" Dmx="161~190" />
      <Function ID="3" Name="Down/Up" Display="'Down/Up'" Dmx="191~220" />
      <Function ID="4" Name="Bounce" Display="'Bounce'" Dmx="121~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~2" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Manual" Display="'%.1f%%',0.0~100.0" Dmx="3~92" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Small/Big" Display="'Small/Big'" Dmx="93~146" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Big/Small" Display="'Big/Small'" Dmx="147~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour_Mix" Name="Colour Mix" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Func" Display="'No Func'" Dmx="0~199" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="2:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Manual %.f%%',0~100" Dmx="1~100" Intensity="0~0" />
      <Function ID="3" Name="Timed Fade" Display="'Timed %.1f%%',0.0~100.0" Dmx="101~251" Intensity="0~0" />
      <Function ID="4" Name="Sound Fade" Display="'Sound Fade'" Dmx="252~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="LAN_RGY180" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Strobe" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour_Mix" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="29" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Dot_Line" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Reset" ChannelOffset="9" Wheel="30" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="5000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
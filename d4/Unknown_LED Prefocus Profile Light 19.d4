    <AtlaBase ModeID="ade520d6-a825-45d8-9685-90240f8f372e" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="37" />
      <Attribute ID="CCT" ChannelOffset="6" Wheel="38" />
      <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Dim_Spd" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="10,11" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="HSIC, 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="feddf1c7-29a4-433e-be84-0fc9e0deb563" />
    <Include>
      <Attribute ID="Hue" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Saturation" ChannelOffset="2" Wheel="8" />
      <Attribute ID="ColourIntensity" ChannelOffset="3,4" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="CCT" ChannelOffset="5" Wheel="38" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>

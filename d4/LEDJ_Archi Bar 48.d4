<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Archi Bar 48" ShortName="Archi Br48" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Created" />
  <History Date="19-09-15" Author="Nic Morris" Comment="Changed shutter open to default at zero in attempt to fix customer bug report." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Single Cell" Display="'Single Cell'" Dmx="6~10" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="Multi Cell" Display="'Multi Cell'" Dmx="11~15" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="16~20" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="21~25" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="26~30" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="White" Display="'White'" Dmx="31~35" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="R/ W" Display="'R/ W'" Dmx="36~40" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="R/ G" Display="'R/ G'" Dmx="41~45" Update="Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="R/ B" Display="'R/ B'" Dmx="46~50" Update="Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="G/ B" Display="'G/ B'" Dmx="51~55" Update="Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="W/ B" Display="'W/ B'" Dmx="56~60" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="W/ G" Display="'W/ G'" Dmx="61~65" Update="Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="R/ G/ B" Display="'R/ G/ B'" Dmx="66~70" Update="Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="R/ G/ W" Display="'R/ G/ W'" Dmx="71~75" Update="Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="R/ B/ W" Display="'R/ B/ W'" Dmx="76~80" Update="Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="G/ B/ W" Display="'G/ B/ W'" Dmx="81~85" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="R/ G/ B/ W" Display="'R/ G/ B/ W'" Dmx="86~90" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="R/ G/ B/ W" Display="'R/ G/ B/ W'" Dmx="91~100" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Jump" Display="'Jump'" Dmx="101~110" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Dream" Display="'Dream'" Dmx="111~120" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Flow" Display="'Flow'" Dmx="121~130" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Overlap" Display="'Overlap'" Dmx="131~140" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Chase" Display="'Chase'" Dmx="141~150" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Multi" Display="'Multi'" Dmx="151~160" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Fade" Display="'Fade'" Dmx="161~170" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="2 Flow" Display="'2 Flow'" Dmx="171~180" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="One Way" Display="'One Way'" Dmx="181~190" Update="Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Two Way" Display="'Two Way'" Dmx="191~200" Update="Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="2 Col" Display="'2 Col'" Dmx="201~210" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;18" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Generic %" Display="'%.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="LJAR484" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="LJAR486" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="White" Wheel="8" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="12" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="16" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
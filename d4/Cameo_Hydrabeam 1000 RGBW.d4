  <Thumbnail>1c65a295-055c-4ab7-a1f9-1439531cbf2a</Thumbnail>
  <History Date="26-07-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e7bc0120-5953-4582-9dc4-16718355cf7f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="31~45" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="46~60" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="61~75" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="9" Name="GB" Display="'GB'" Dmx="136~150" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="151~165" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="166~180" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="181~195" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="196~210" Colour="255,255,255" />
      <Function ID="14" Name="RBW" Display="'RBW'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="15" Name="GBW" Display="'GBW'" Dmx="226~240" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~30" Update="Auto_Spd" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="31~53" Update="Auto_Spd" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="54~76" Update="Auto_Spd" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="77~99" Update="Auto_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="100~122" Update="Auto_Spd" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="200~224" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

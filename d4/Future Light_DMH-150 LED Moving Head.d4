      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="224~255" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~31" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="32~63" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="64~95" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="96~127" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="128~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~191" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="192~223" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="224~255" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

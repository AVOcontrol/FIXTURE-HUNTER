      <Attribute ID="H_V_Stretch" ChannelOffset="16" Wheel="21" />
      <Attribute ID="Slow_Draw_Speed" ChannelOffset="17" Wheel="26" />
      <Attribute ID="Point-Draw" ChannelOffset="18" Wheel="18" />
      <Attribute ID="Scan_Speed" ChannelOffset="19" Wheel="27" />

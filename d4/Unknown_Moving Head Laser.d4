<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Moving Head Laser" ShortName="Mov_HLaser" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="06-08-08" Author="David Hunt" Comment="Created" />
  <History Date="03-09-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="30-04-12" Author="Peter Budd" Comment="Edited Edited changed filename from Unknown(Generic) to Unknown" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~252" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Group" Name="Pattern Group" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern Group 1" Display="'Pattern Group 1'" Dmx="0~51" />
      <Function ID="2" Name="Pattern Group 2" Display="'Pattern Group 2'" Dmx="52~103" />
      <Function ID="3" Name="Pattern Group 3" Display="'Pattern Group 3'" Dmx="104~155" />
      <Function ID="4" Name="Pattern Group 4" Display="'Pattern Group 4'" Dmx="156~207" />
      <Function ID="5" Name="Pattern Group 5" Display="'Pattern Group 5'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hori_Roll" Name="Hori Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Vert_Roll" Name="Vert Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

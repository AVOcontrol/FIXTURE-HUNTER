      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~1" />
      <Function ID="2" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 16bit" Channels="20">
    <Import PearlRef="UK_MovHLs1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="530" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Pattern_Group" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Pattern" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Hori_Roll" ChannelOffset="9" Wheel="13" />
      <Attribute ID="Vert_Roll" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Z_Roll" ChannelOffset="11" Wheel="15" />
      <Attribute ID="Hori_Move" ChannelOffset="12" Wheel="16" />
      <Attribute ID="Vert_Move" ChannelOffset="13" Wheel="17" />
      <Attribute ID="Hori_Stretch" ChannelOffset="14" Wheel="19" />
      <Attribute ID="Vert_Stretch" ChannelOffset="15" Wheel="20" />
      <Attribute ID="H_V_Stretch" ChannelOffset="16" Wheel="21" />
      <Attribute ID="Slow_Draw_Speed" ChannelOffset="17" Wheel="26" />
      <Attribute ID="Point-Draw" ChannelOffset="18" Wheel="18" />
      <Attribute ID="Scan_Speed" ChannelOffset="19" Wheel="27" />
      <Attribute ID="Pattern_Size" ChannelOffset="20" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 16bit" Channels="20">

      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="H_V_Stretch" Name="H &amp; V Stretch" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Slow_Draw_Speed" Name="Slow Draw Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Point-Draw" Name="Point-Draw" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

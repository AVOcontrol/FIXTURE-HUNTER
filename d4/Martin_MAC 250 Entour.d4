    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==4" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f°',0.00~395.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />

      <Function ID="7" Name="Rnd Op Pls Slow" Display="'Rnd Op Pls Slow'" Dmx="194~196" Intensity="0~0" />
      <Function ID="8" Name="Rnd Op Pls Fast" Display="'Rnd Op Pls Fast'" Dmx="191~193" Intensity="0~0" />
      <Function ID="9" Name="Rnd Cl Pls Slow" Display="'Rnd Cl Pls Slow'" Dmx="200~202" Intensity="0~0" />

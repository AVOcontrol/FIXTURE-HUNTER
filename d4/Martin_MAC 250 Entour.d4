<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MAC 250 Entour" ShortName="250 Entour" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-08-03" Author="D.Shelton" Comment="Created" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 2. Dim F - (16 bit only)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 3. Colour LSB - (16 bit only)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 4. Fows LSB - (16 bit only)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 5. Eff Speed - No legends for set positions" />
  <History Date="10-08-04" Author="Phil Rogers" Comment="All above fixed" />
  <History Date="16-02-05" Author="Dave Trounce" Comment="Tested against manual" />
  <History Date="16-02-05" Author="Dave Trounce" Comment="Error 1: Gobo Rot: CCW and CW are wrong way round.  Error 2: Prism CW and CCW are wrong way round." />
  <History Date="17-02-05" Author="Phil" Comment="Fixed above problems" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="01-08-06" Author="Ed" Comment="Fixed Gobo1Func Wheel" />
  <History Date="14-04-09" Author="David Hunt" Comment="Fixed highlight and lowlight values" />
  <History Date="04-02-10" Author="John Rogers" Comment="Edited - added Prism_Func to both modes." />
  <History Date="17-03-10" Author="John Rogers" Comment="Added Shutter Function to prevent accidental Reset." />
  <History Date="21-01-11" Author="Nic Morris" Comment="Removed duplicate ID's.  Fixed Colour1 Raw.  Increased wheel resolution for 16bit attr." />
  <History Date="21-01-11" Author="Nic Morris" Comment="Inverted and increased shutter pulse ranges.  Removed Gobo1Rot update from Gobo1." />
  <History Date="23-01-11" Author="Nic Morris" Comment="Revised macros.  Fixed power on and locate." />
  <History Date="25-01-11" Author="Nic Morris" Comment="Added Gobo1Rot to macros since Gobo1Func might modify its condition" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="24-05-17" Author="Nic Morris" Comment="Fixed typo in close pulse name and standardised shutter functions.  Recreated palettes." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Added colour function index.  Standardised conditionals.  Added numbers to all colour functions." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Revised fixed colour ranges.  Added gobo function index.  Added numbers to gobo function names." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Increased gobo rot index wheel resolution.  Corrected Gobo 1 number 6 name for Entour." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Changed gobo 2 open shake to variable range.  Revised P/T Speed function ranges." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Added full range colour index function." />
  <Manual Filename="/manual/Martin_MAC 250.pdf" Summary="Created:Martin, 30/03/2000" />

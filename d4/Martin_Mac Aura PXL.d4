  <History Date="02-07-20" Author="Nic Morris" Comment="Created (based on chart revision 1.5)" Version="0" />
  <History Date="16-08-20" Author="Nic Morris" Comment="Added product thumbnail.  Updated to release spec (revises FX)" Version="11" />
  <History Date="03-09-20" Author="Nic Morris" Comment="Minor change to colour macro function ranges in line with latest documentation." Version="12" />
  <History Date="26-03-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="03-12-21" Author="Nic Morris" Comment="Updated in line with Rev B (firmware version 1.2.0) (adds low-noise LED control function and macro and 12 new virtual colours)" Version="14" />
  <History Date="01-02-23" Author="Nic Morris" Comment="Updated in line with Rev C (firmware version 1.3.0) (adds Compact Mode Aura control functions and macros)" Version="15" />
  <History Date="08-09-24" Author="Nic Morris" Comment="Moved Extended mode aura dimmer and rgb parts into a cell and linked to respective reserved controls and added multi-part patch option in attempt to solve customer bug report." Version="16" />
  <History Date="01-04-25" Author="Nic Morris" Comment="Updated in line with Rev E (firmware version 1.5.xx) (adds Compact Direct mode)" Version="17" />
  <History Date="21-11-25" Author="Nic Morris" Comment="Updated Atlabase mode IDs.  These appear to have changed - this should not happen." Version="18" />

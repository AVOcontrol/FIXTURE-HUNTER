<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Equinox Gemini Laser" ShortName="Gemini" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="22-03-17" Author="Nic Morris" Comment="Fixed name (previously was 'Equniox')" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="50~99" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="100~149" />
      <Function ID="4" Name="Green Gobo" Display="'Green Gobo'" Dmx="150~209" />
      <Function ID="5" Name="Red Gobo" Display="'Red Gobo'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="0~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="100~199" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="200~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="70~139" Colour="0,255,0" />
      <Function ID="3" Name="Red + Green" Display="'Red + Green'" Dmx="140~209" Colour="255,0,0" />
      <Function ID="4" Name="Red + Green Strobe" Display="'Red + Green Strobe'" Dmx="210~255" Colour="255,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="4">
    <Import PearlRef="PT_EQGmLsr" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Rot" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
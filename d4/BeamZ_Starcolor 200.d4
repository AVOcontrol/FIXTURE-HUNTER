  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="66ae6b60-2d36-4401-a8a1-e103af7b769d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Col Temp 1" Display="'Col Temp 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="Col Temp 2" Display="'Col Temp 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="Col Temp 3" Display="'Col Temp 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="Col Temp 4" Display="'Col Temp 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="Col Temp 5" Display="'Col Temp 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="Col Temp 6" Display="'Col Temp 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="Col Temp 7" Display="'Col Temp 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="Col Temp 8" Display="'Col Temp 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="Col Temp 9" Display="'Col Temp 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="Col Temp 10" Display="'Col Temp 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="Col Temp 11" Display="'Col Temp 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="14~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="21~30" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~40" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="41~50" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="51~60" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="61~70" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="71~80" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="81~90" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="91~100" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="101~110" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="111~120" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Colour" ID="2,3,4,5,6,7,8,9" If="'Macro1'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="0~0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~63" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="64~95" />
      <Function ID="5" Name="White" Display="'White'" Dmx="96~127" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="128~159" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="160~191" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="192~223" />
      <Function ID="9" Name="Full On" Display="'Full On'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~55" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="56~104" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="105~155" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="156~205" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Macro1" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Macro_Spd" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="51~100" Update="Macro_Spd" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="101~109" Update="Macro_Spd" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="110~119" Update="Macro_Spd" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="120~129" Update="Macro_Spd" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="130~139" Update="Macro_Spd" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="140~149" Update="Macro_Spd" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="150~159" Update="Macro_Spd" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="160~169" Update="Macro_Spd" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="170~179" Update="Macro_Spd" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="180~189" Update="Macro_Spd" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="190~199" Update="Macro_Spd" />
    </Attribute>
  </Control>

    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="3~5" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="13~127" Intensity="0~0" />
      <Function ID="4" Name="Rnd Slow" Display="'Rnd Slow'" Dmx="6~7" Intensity="0~0" />
      <Function ID="5" Name="Rnd Med" Display="'Rnd Med'" Dmx="8~10" Intensity="0~0" />
      <Function ID="6" Name="Rnd Fast" Display="'Rnd Fast'" Dmx="11~12" Intensity="0~0" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="134~191" Intensity="0~0" />
      <Function ID="8" Name="Op Pls Rnd Slow" Display="'Op Pls Rnd Slow'" Dmx="128~129" Intensity="0~0" />
      <Function ID="9" Name="Op Pls Rnd Med" Display="'Op Pls Rnd Med'" Dmx="130~131" Intensity="0~0" />
      <Function ID="10" Name="Op Pls Rnd Fast" Display="'Op Pls Rnd Fast'" Dmx="132~133" Intensity="0~0" />
      <Function ID="11" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="198~255" Intensity="0~0" />
      <Function ID="12" Name="Cls Pls Rnd Slow" Display="'Cls Pls Rnd Slow'" Dmx="192~193" Intensity="0~0" />
      <Function ID="13" Name="Cls Pls Rnd Med" Display="'Cls Pls Rnd Med'" Dmx="194~195" Intensity="0~0" />
      <Function ID="14" Name="Cls Pls Rnd Fast" Display="'Cls Pls Rnd Fast'" Dmx="196~197" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.f',0~85" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Intensity_Time" Name="Intensity Time" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Time" Name="Colour Time" Description="" Group="S">

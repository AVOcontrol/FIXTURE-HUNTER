    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="37" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="38" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="40" />
      <Attribute ID="Duration" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Timing" ChannelOffset="5" Wheel="27" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="HSIC, 10 DMX" Channels="10">
    <Import PearlRef="PH_SL400_HS" DiamondRef="" WysiwygRef="" />
    <Physical>

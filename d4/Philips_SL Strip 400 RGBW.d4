    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Normal" Display="'Dim Normal'" Dmx="5~9" />
      <Function ID="3" Name="Dim Incandescent" Display="'Dim Incandescent'" Dmx="10~29" />
      <Function ID="4" Name="Curve Linear" Display="'Curve Linear'" Dmx="30~34" />
      <Function ID="5" Name="Curve Square" Display="'Curve Square'" Dmx="35~39" />
      <Function ID="6" Name="S-Curve" Display="'S-Curve'" Dmx="40~44" />
      <Function ID="7" Name="PL-Curve" Display="'PL-Curve'" Dmx="45~49" />
      <Function ID="8" Name="Calibration Off" Display="'Calibration Off'" Dmx="70~74" />
      <Function ID="9" Name="Calibration On" Display="'Calibration On'" Dmx="75~79" />
      <Function ID="10" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~84" />
      <Function ID="11" Name="Fan Off" Display="'Fan Off'" Dmx="85~89" />
      <Function ID="12" Name="Reserved" Display="'Reserved'" Dmx="90~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">

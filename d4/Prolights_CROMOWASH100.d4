<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CROMOWASH100" ShortName="CromoW 100" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="19-08-11" Author="John Rogers" Comment="Created" />
  <History Date="01-09-11" Author="John Rogers" Comment="Corrected channel assignment errors in both modes." />
  <History Date="26-01-12" Author="Nic Morris" Comment="Inverted P/T Speed.  Minor correction to Col Macro function names.  Added macros." />
  <History Date="26-01-12" Author="Nic Morris" Comment="Removed Dimmer Speed and corrected advanced mode channel count in response to manufacturer." />
  <History Date="02-01-13" Author="Peter Budd" Comment="Created from Chauvet Q-Wash 260 LED" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="01c3a9c4-4205-4d9b-91cb-7b61fc959036" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="Red/Grn" Display="'Red/Grn %.f%%',0~100" Dmx="11~30" Colour="255,0,0" />
      <Function ID="4" Name="Grn/Red" Display="'Grn/Red %.f%%',0~100" Dmx="31~50" Colour="255,255,0" />
      <Function ID="5" Name="Grn/Bl" Display="'Grn/Bl %.f%%',0~100" Dmx="51~70" Colour="0,255,0" />
      <Function ID="6" Name="Bl/Grn" Display="'Bl/Grn %.f%%',0~100" Dmx="71~90" Colour="0,255,255" />
      <Function ID="7" Name="Bl/Red" Display="'Bl/Red %.f%%',0~100" Dmx="91~110" Colour="0,0,255" />
      <Function ID="8" Name="Red/Bl" Display="'Red/Bl %.f%%',0~100" Dmx="111~130" Colour="255,0,255" />
      <Function ID="9" Name="Red/Grn/Bl" Display="'Red/Grn/Bl %.f%%',0~100" Dmx="131~150" Colour="255,0,0" />
      <Function ID="10" Name="Bl/Red/Grn" Display="'Bl/Red/Grn %.f%%',0~100" Dmx="151~170" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="12" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="13" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="14" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="15" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="16" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="17" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="18" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="19" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="20" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="21" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="22" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="BO on P/T ON" Display="'BO on P/T ON'" Dmx="20~39" />
      <Function ID="3" Name="BO on P/T OFF" Display="'BO on P/T OFF'" Dmx="40~59" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~79" />
      <Function ID="5" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="6" Name="Fan Medium" Display="'Fan Medium'" Dmx="100~119" />
      <Function ID="7" Name="Fan Fast" Display="'Fan Fast'" Dmx="120~139" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="140~149" />
      <Function ID="9" Name="Auto 2" Display="'Auto 2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="180~189" />
      <Function ID="13" Name="Sound 2" Display="'Sound 2'" Dmx="190~199" />
      <Function ID="14" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="15" Name="No Func" Display="'No Func'" Dmx="220~235" />
      <Function ID="16" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="17" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="18" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="19" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="20" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 16bit" Channels="12">
    <Import PearlRef="PG_CrW100_X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a787d756-cabb-468f-84f7-043756ec8865" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="9" Wheel="8" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="9 DMX, 8bit" Channels="9">
    <Import PearlRef="PG_CrW100_B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="73a5b88a-a5d6-418d-8b0e-bdda18f5cf73" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:14" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:5" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:5" />
      <Palette ID="12" Name="White" Number="10" Page="1" SetControl="Colour1:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="White" Number="8" Page="1" SetControl="Colour1:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e0ee8120-8e5e-4c3e-8adc-edc455d34795" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour Temp 1" Display="'Colour Temp 1'" Dmx="66~128" Colour="0,0,0" />
      <Function ID="3" Name="Colour Temp 2" Display="'Colour Temp 2'" Dmx="129~191" Colour="0,0,0" />
      <Function ID="4" Name="Colour Temp 3" Display="'Colour Temp 3'" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="5" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="47~87" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="88~129" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="130~171" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="172~213" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="214~255" Colour="255,128,0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5" Id="d1761b4a-d7f1-48a0-8220-edc18db1388d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="60a7db12-7c87-44a5-936f-33d5c0f4a3ae" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Zoom" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="White" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4" />

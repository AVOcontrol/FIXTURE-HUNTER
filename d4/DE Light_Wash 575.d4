<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Wash 575" ShortName="Wash 575" Company="DE Light">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="01-11-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16" If="'Colour1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~35" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="36~47" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="48~59" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="60~71" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="72~83" WheelPosition="4" Colour="128,0,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="84~95" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="96~107" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="108~119" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Op/ Blue" Display="'Op/ Blue'" Dmx="120~131" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Blue/ Red" Display="'Blue/ Red'" Dmx="132~143" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Red/ Yel" Display="'Red/ Yel'" Dmx="144~155" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Ppl" Display="'Yel/ Ppl'" Dmx="156~167" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Ppl/ Grn" Display="'Ppl/ Grn'" Dmx="168~179" WheelPosition="4" Colour="128,0,255" />
      <Function ID="14" Name="Grn/ Pk" Display="'Grn/ Pk'" Dmx="180~191" WheelPosition="5" Colour="0,255,0" />
      <Function ID="15" Name="Pk/ Lt Blue" Display="'Pk/ Lt Blue'" Dmx="192~203" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="204~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="32~63" Colour="255,128,0" />
      <Function ID="3" Name="UV" Display="'UV'" Dmx="64~95" Colour="180,0,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="96~127" Colour="255,240,200" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="128~159" Colour="230,230,255" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="160~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'Focus %.1f%%',0.0~100.0" Dmx="0~227" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Macro Slow" Display="'Macro Slow'" Dmx="228~239" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Macro Fast" Display="'Macro Fast'" Dmx="240~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~159" Intensity="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="160~191" Intensity="0~0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="192~223" Intensity="0~0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKDEW575" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="12" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="8" Wheel="38" />
      <Attribute ID="Frost" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Pan_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Tilt_Speed" ChannelOffset="6" Wheel="26" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour2:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour2:2,Colour1:1,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour2:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1" />
      <Palette ID="12" Name="UV" Number="10" Page="1" SetControl="Colour2:3,Colour1:1,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1" />
      <Palette ID="14" Name="UV" Number="8" Page="1" SetControl="Colour2:3,Colour1:1,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour2:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
      <Palette ID="7" Name="Frost Off" Number="47" Page="1" SetControl="Frost:1:0" />
      <Palette ID="8" Name="Frost Full" Number="48" Page="1" SetControl="Frost:1:100" />
    </Group>
  </Palettes>
</Fixture>
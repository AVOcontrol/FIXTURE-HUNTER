  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d064a1b4-9baf-4127-bfe3-cb9ec9782a7e" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="BASTARD AMBER" Display="'BASTARD AMBER'" Dmx="1~7" Colour="255,255,255" />
      <Function ID="3" Name="MEDIUM AMBER" Display="'MEDIUM AMBER'" Dmx="8~15" Colour="255,100,0" />
      <Function ID="4" Name="PALE AMBER GOLD" Display="'PALE AMBER GOLD'" Dmx="16~23" Colour="255,100,0" />
      <Function ID="5" Name="GALLO GOLD" Display="'GALLO GOLD'" Dmx="24~31" Colour="255,100,0" />
      <Function ID="6" Name="GOLDEN AMBER" Display="'GOLDEN AMBER'" Dmx="32~39" Colour="255,100,0" />
      <Function ID="7" Name="LIGHT RED" Display="'LIGHT RED'" Dmx="40~47" Colour="255,100,100" />
      <Function ID="8" Name="MEDIUM RED" Display="'MEDIUM RED'" Dmx="48~55" Colour="255,0,0" />
      <Function ID="9" Name="MEDIUM PINK" Display="'MEDIUM PINK'" Dmx="56~63" Colour="255,150,150" />
      <Function ID="10" Name="BROADWAY PINK" Display="'BROADWAY PINK'" Dmx="64~71" Colour="255,150,150" />
      <Function ID="11" Name="FOLLIES PINK" Display="'FOLLIES PINK'" Dmx="72~79" Colour="255,150,150" />
      <Function ID="12" Name="LIGHT LAVENDER" Display="'LIGHT LAVENDER'" Dmx="80~87" Colour="255,150,150" />
      <Function ID="13" Name="SPECIAL LAVENDER" Display="'SPECIAL LAVENDER'" Dmx="88~95" Colour="255,128,255" />
      <Function ID="14" Name="LAVENDER" Display="'LAVENDER'" Dmx="96~103" Colour="255,0,255" />
      <Function ID="15" Name="INDIGO" Display="'INDIGO'" Dmx="104~111" Colour="255,0,255" />
      <Function ID="16" Name="HEMSLEY BLUE" Display="'HEMSLEY BLUE'" Dmx="112~119" Colour="255,0,255" />
      <Function ID="17" Name="TIPTON BLUE" Display="'TIPTON BLUE'" Dmx="120~127" Colour="0,0,255" />
      <Function ID="18" Name="LIGHT STEEL BLUE" Display="'LIGHT STEEL BLUE'" Dmx="128~135" Colour="0,0,255" />
      <Function ID="19" Name="LIGHT SKY BLUE" Display="'LIGHT SKY BLUE'" Dmx="136~143" Colour="0,0,255" />
      <Function ID="20" Name="SKY BLUE" Display="'SKY BLUE'" Dmx="144~151" Colour="0,128,255" />
      <Function ID="21" Name="BRILLIANT BLUE" Display="'BRILLIANT BLUE'" Dmx="152~159" Colour="0,0,255" />
      <Function ID="22" Name="LIGHT GREEN BLUE" Display="'LIGHT GREEN BLUE'" Dmx="160~167" Colour="0,0,255" />
      <Function ID="23" Name="BRIGHT BLUE" Display="'BRIGHT BLUE'" Dmx="168~175" Colour="0,128,255" />
      <Function ID="24" Name="PRIMARY BLUE" Display="'PRIMARY BLUE'" Dmx="176~183" Colour="0,0,255" />
      <Function ID="25" Name="CONGO BLUE" Display="'CONGO BLUE'" Dmx="184~191" Colour="0,0,255" />
      <Function ID="26" Name="PALE YELLOW GREEN" Display="'PALE YELLOW GREEN'" Dmx="192~199" Colour="255,255,128" />
      <Function ID="27" Name="MOSS GREEN" Display="'MOSS GREEN'" Dmx="200~207" Colour="0,180,0" />
      <Function ID="28" Name="PRIMARY GREEN" Display="'PRIMARY GREEN'" Dmx="208~215" Colour="0,255,0" />
      <Function ID="29" Name="DOUBLE CTB" Display="'DOUBLE CTB'" Dmx="216~223" Colour="230,230,255" />
      <Function ID="30" Name="FULL CTB" Display="'FULL CTB'" Dmx="224~231" Colour="230,230,255" />
      <Function ID="31" Name="HALF CTB" Display="'HALF CTB'" Dmx="232~239" Colour="200,255,255" />
      <Function ID="32" Name="DARK BLUE" Display="'DARK BLUE'" Dmx="240~247" Colour="0,0,255" />
      <Function ID="33" Name="White" Display="'White'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Mode1" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="COLOR ADJUSTMENT" Display="'COLOR ADJUSTMENT'" Dmx="0~127" Colour="0,0,0" />
      <Function ID="2" Name="AUTO MIX" Display="'AUTO MIX'" Dmx="128~159" Colour="0,0,0" />
      <Function ID="3" Name="3 COLOR STROBE" Display="'3 COLOR STROBE'" Dmx="160~191" Colour="0,0,0" />
      <Function ID="4" Name="7 COLOR STROBE" Display="'7 COLOR STROBE'" Dmx="192~223" Colour="0,0,0" />
      <Function ID="5" Name="SOUND ACTIVE" Display="'SOUND ACTIVE'" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
  </Control>

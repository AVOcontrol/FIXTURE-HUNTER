  <Thumbnail>f903f975-3c09-476e-9733-252b82ec3643</Thumbnail>
  <History Date="11-10-22" Author="Nic Morris" Comment="Created (poor documentation.  11 channel mode has 'Function' on channel 1 and 'Dimmer' on channel 2.  Assuming this is incorrect and is dimmer on 1 and shutter on 2)" Version="0" />
  <History Date="12-10-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="06-11-23" Author="Nic Morris" Comment="Created from Nouvoled Aries Bar 1815IP (identical - same problem with 11 channel mode charts)" Version="2" />
  <History Date="08-11-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0ae2d1d2-3470-4ecf-a0f3-263d19d0c841" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~25" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="26~35" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="36~45" />

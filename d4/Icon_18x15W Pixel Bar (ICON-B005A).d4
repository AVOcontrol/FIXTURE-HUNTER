      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="86~95" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="96~105" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="106~115" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="116~125" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="126~135" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="136~145" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="146~155" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="156~165" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="166~175" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="176~185" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="186~195" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="196~205" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="206~215" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="216~225" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="226~235" />
      <Function ID="24" Name="Macro" Display="'Macro'" Dmx="236~245" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Direction" Name="Auto Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="L-&gt;R" Display="'L-&gt;R'" Dmx="0~0" />
      <Function ID="2" Name="R-&gt;L" Display="'R-&gt;L'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

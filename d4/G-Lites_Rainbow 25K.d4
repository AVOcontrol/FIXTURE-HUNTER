<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Rainbow 2.5K" ShortName="Rainbow2.5" Company="G-Lites">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-10-08" Author="David Hunt" Comment="Created" />
  <History Date="28-10-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-12-16" Author="Nic Morris" Comment="Recreated - original didn't match charts (was 6 instead of 7 channel with different attributes/order)." />
  <History Date="31-12-16" Author="Nic Morris" Comment="Added Atlabase mode ID" />
  <History Date="25-02-17" Author="Nic Morris" Comment="Revised c-mix power on and locate (assumed is subtractive).  Added highlight/lowlight." />
  <History Date="25-02-17" Author="Nic Morris" Comment="Temporarily changed c-mix attribute ID's to 'Subtractive' to solve compatibility issues pending improved colour model support." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c9098db8-1e9f-479a-85e5-1cd944d87886" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="YellowSubtractive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="BlueSubtractive" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="RedSubtractive" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto-Work" Name="Auto-Work" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto-Check" Name="Auto-Check" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="20888f56-2288-4e1c-bbc4-3760f85bffab" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="YellowSubtractive" ChannelOffset="2" Wheel="10" />
      <Attribute ID="BlueSubtractive" ChannelOffset="3" Wheel="11" />
      <Attribute ID="RedSubtractive" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Auto-Work" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Auto-Check" ChannelOffset="7" Wheel="23" />
    </Include>
  </Mode>
</Fixture>
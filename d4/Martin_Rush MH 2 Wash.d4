      <Function ID="8" Name="L181 (Congo Blue)" Display="'L181 (Congo Blue)'" Dmx="40~44" Colour="0,0,128" />
      <Function ID="9" Name="L071 (Tokyo Blue)" Display="'L071 (Tokyo Blue)'" Dmx="45~49" Colour="0,128,192" />
      <Function ID="10" Name="L120 (Deep Blue)" Display="'L120 (Deep Blue)'" Dmx="50~54" Colour="0,0,160" />
      <Function ID="11" Name="L079 (Just Blue)" Display="'L079 (Just Blue)'" Dmx="55~59" Colour="0,0,255" />
      <Function ID="12" Name="L132 (Medium Blue)" Display="'L132 (Medium Blue)'" Dmx="60~64" Colour="13,13,255" />
      <Function ID="13" Name="L200 (Double CT Blue)" Display="'L200 (Double CT Blue)'" Dmx="65~69" Colour="128,255,255" />
      <Function ID="14" Name="L161 (Slate Blue)" Display="'L161 (Slate Blue)'" Dmx="70~74" Colour="0,128,192" />
      <Function ID="15" Name="L201 (Full CT Blue)" Display="'L201 (Full CT Blue)'" Dmx="75~79" Colour="128,255,255" />
      <Function ID="16" Name="L202 (Half CT Blue)" Display="'L202 (Half CT Blue)'" Dmx="80~84" Colour="128,255,255" />
      <Function ID="17" Name="L117 (Steel Blue)" Display="'L117 (Steel Blue)'" Dmx="85~89" Colour="0,255,255" />

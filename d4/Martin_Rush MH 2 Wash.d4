      <Function ID="21" Name="L124 (Dark Green)" Display="'L124 (Dark Green)'" Dmx="105~109" Colour="0,128,0" />
      <Function ID="22" Name="L139 (Primary Green)" Display="'L139 (Primary Green)'" Dmx="110~114" Colour="0,255,0" />
      <Function ID="23" Name="L089 (Moss Green)" Display="'L089 (Moss Green)'" Dmx="115~119" Colour="0,64,0" />
      <Function ID="24" Name="L122 (Fern Green)" Display="'L122 (Fern Green)'" Dmx="120~124" Colour="0,128,0" />
      <Function ID="25" Name="L738 (JAS Green)" Display="'L738 (JAS Green)'" Dmx="125~129" Colour="128,255,0" />
      <Function ID="26" Name="L088 (Lime Green)" Display="'L088 (Lime Green)'" Dmx="130~134" Colour="128,255,0" />
      <Function ID="27" Name="L100 (Spring Yellow)" Display="'L100 (Spring Yellow)'" Dmx="135~139" Colour="255,255,128" />
      <Function ID="28" Name="L104 (Deep Amber)" Display="'L104 (Deep Amber)'" Dmx="140~144" Colour="255,128,0" />
      <Function ID="29" Name="L179 (Chrome Orange)" Display="'L179 (Chrome Orange)'" Dmx="145~149" Colour="255,128,0" />
      <Function ID="30" Name="L105 (Orange)" Display="'L105 (Orange)'" Dmx="150~154" Colour="255,128,64" />
      <Function ID="31" Name="L021 (Gold Amber)" Display="'L021 (Gold Amber)'" Dmx="155~159" Colour="255,128,64" />
      <Function ID="32" Name="L778 (Millennium Gold)" Display="'L778 (Millennium Gold)'" Dmx="160~164" Colour="255,128,64" />
      <Function ID="33" Name="L135 (Deep Golden Amber)" Display="'L135 (Deep Golden Amber)'" Dmx="165~169" Colour="255,128,0" />
      <Function ID="34" Name="L164 (Flame Red)" Display="'L164 (Flame Red)'" Dmx="170~174" Colour="255,0,0" />
      <Function ID="35" Name="Open" Display="'Open'" Dmx="175~179" Colour="255,255,255" />
      <Function ID="36" Name="Open" Display="'Open'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="37" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="180~201" Colour="0,0,0" />
      <Function ID="38" Name="No Scroll" Display="'No Scroll'" Dmx="202~207" Colour="255,255,255" />
      <Function ID="39" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="208~229" Colour="0,0,0" />
      <Function ID="40" Name="Open" Display="'Open'" Dmx="250~255" Colour="255,255,255" />
      <Function ID="41" Name="Slow" Display="'Slow'" Dmx="245~249" Colour="0,0,0" />
      <Function ID="42" Name="Medium" Display="'Medium'" Dmx="240~244" Colour="0,0,0" />
      <Function ID="43" Name="Fast" Display="'Fast'" Dmx="235~239" Colour="0,0,0" />
      <Function ID="44" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED B-40 Beam Effect" ShortName="B-40 Bm FX" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>b22b6e8d-22eb-4466-80a2-69015e5380d6</Thumbnail>
  <History Date="14-11-15" Author="Nic Morris" Comment="Created" />
  <History Date="15-07-19" Author="Nic Morris" Comment="Changed name from LED B-40 to LED B-40 Beam Effect to differentiate from other models." />
  <History Date="15-07-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5df56cce-fb21-477a-a4d5-f7d68477f297" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~138" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~137" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~10" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="Red + Green" Display="'Red + Green'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="Red + Blue" Display="'Red + Blue'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="Green + Blue" Display="'Green + Blue'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Internal" Display="'Internal'" Dmx="11~249" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="EXLEDB40" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b8c9706f-c5f9-44b4-8d8e-0bf6a8dfa74c" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Effect" ChannelOffset="4" Wheel="23" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="b22b6e8d-22eb-4466-80a2-69015e5380d6"></Swatch>
  </swatchLibrary>
</Fixture>
  <History Date="29-08-24" Author="Nic Morris" Comment="Created (hopeless documentation.  conflicting ranges and channel mappings.  impressive how much of a mess was made of such a simple fixture.  made best guess)" Version="0" />
  <History Date="04-09-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="07-09-24" Author="Nic Morris" Comment="Changed first function of effect to a variable range, defaulting at 100% (7 DMX) for Capture compatibility.  It is not clear if this is correct or not." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="64e03de0-c9f2-4c55-b8a7-7078dcbdb416" />
  <Control>

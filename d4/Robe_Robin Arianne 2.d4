  <History Date="27-06-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="23-10-25" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request (significantly different)" Version="1" />
  <History Date="29-10-25" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request (changes name from iBeam 600 to Arianne 6 and revises mode 4 screenpix controls)" Version="2" />
  <History Date="29-10-25" Author="Nic Morris" Comment="Corrected mode 4 name with updated channel count." Version="3" />
  <History Date="03-11-25" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (removes CMix Ctrl Zone from modes 3 and 4)" Version="4" />
  <History Date="19-01-26" Author="Nic Morris" Comment="Updated in line with v1.6 charts in response to manufacturer request (revises mode 1 channel mapping)" Version="5" />
  <History Date="23-01-26" Author="Nic Morris" Comment="Created from Robe Robin Arianne 6" Version="6" />
  <History Date="24-02-26" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (adds control functions/macros)" Version="7" />
  <History Date="24-04-26" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (revises shutter functions)" Version="8" />
  <History Date="12-05-26" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request (revises pattern FX/Spd functions)" Version="9" />
  <History Date="08-06-26" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (removes mode 4 and changes mapping for modes 2 and 3)" Version="10" />
  <History Date="23-06-26" Author="Nic Morris" Comment="Added product thumbnail" Version="11" />
  <History Date="20-07-26" Author="Nic Morris" Comment="Removed reserved Color effect 32 from SPix FX channel and corrected SPix FX Spd L-R wheel direction in response to manufacturer request." Version="12" />

    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="6~10" Colour="200,0,0" />
      <Function ID="3" Name="Deep Green" Display="'Deep Green'" Dmx="11~15" Colour="0,200,0" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="16~20" Colour="128,255,0" />

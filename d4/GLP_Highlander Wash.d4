      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="31~35" Colour="255,128,0" />
      <Function ID="7" Name="Deep Blue" Display="'Deep Blue'" Dmx="36~40" Colour="0,0,200" />
      <Function ID="8" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="44~167" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="212~212" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="168~211" Colour="0,0,0" />

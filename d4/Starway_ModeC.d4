<Fixture Name="ModeC" ShortName="ModeC" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="20-01-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="21-01-15" Author="Gabi de Moitelle" Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Added white to virtual dimmer.  Changed shutter range displays to percentage 0dp.  Fixed shutter sinus range error." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Increased dimmer wheel resolution.  Standardised P/T Speed" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed 'All LED Control' to a fixed function.  Changed RGB power on to match locate values." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed colour macro scrolls to percentage ranges.  Changed colour macro random functions to text only." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Swapped mode 1 Pan1/Tilt1 to Pan/Tilt for shape compatibility.  Removed Pan1/Tilt1 attributes." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Moved colour macro wheel mapping to colour slot to match group." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />

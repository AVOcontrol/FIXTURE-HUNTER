      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="30~30" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="35~35" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="40~40" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="45~45" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="50~50" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="55~55" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="60~60" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="65~65" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="70~70" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="186~190" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="191~195" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="196~200" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="201~205" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />

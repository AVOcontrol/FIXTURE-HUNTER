      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="75~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" GoboSpin="0~0" GoboOrientation="0~0" />

  <AtlaBase TypeID="4927318d-40d6-46fb-8661-860b99cdfdb3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="6~54" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="153~201" />
      <Function ID="5" Name="Rnd Sectional" Display="'Rnd Sectional %.f%%',0~100" Dmx="202~250" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="55~103" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~152" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="6~15" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="16~25" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="26~35" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="36~45" />
      <Function ID="6" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="46~55" />
      <Function ID="7" Name="Dim Spd Smooth" Display="'Dim Spd Smooth'" Dmx="56~65" />
      <Function ID="8" Name="Dim Spd Super Smooth" Display="'Dim Spd Super Smooth'" Dmx="66~75" />
      <Function ID="9" Name="Tungsten Mode High Quality" Display="'Tungsten Mode High Quality'" Dmx="76~85" />
      <Function ID="10" Name="Tungsten Mode High Output" Display="'Tungsten Mode High Output'" Dmx="86~95" />
      <Function ID="11" Name="Pix Direction Normal" Display="'Pix Direction Normal'" Dmx="96~105" />
      <Function ID="12" Name="Pix Direction Inverted" Display="'Pix Direction Inverted'" Dmx="106~115" />
      <Function ID="13" Name="Display Normal" Display="'Display Normal'" Dmx="116~125" />
      <Function ID="14" Name="Display Inverted" Display="'Display Inverted'" Dmx="126~135" />
      <Function ID="15" Name="PWM 1kHz" Display="'PWM 1kHz'" Dmx="136~145" />
      <Function ID="16" Name="PWM 3kHz" Display="'PWM 3kHz'" Dmx="146~155" />

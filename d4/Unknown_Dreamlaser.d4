    </Cells>
  </Mode>
  <Mode Name="21 DMX" Channels="21" Id="bb195652-181e-4b12-b1f7-0f46705bd0f7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

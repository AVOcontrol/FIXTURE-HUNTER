        <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
        <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="7" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
        <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Tilt" Wheel="3" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="10" ModeLink="Col+Tilt cell" X="0" Y="0">

      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour_Master:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour_Master:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour_Master:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour_Master:1" />

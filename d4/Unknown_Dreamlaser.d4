<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dreamlaser" ShortName="Dreamlaser" Company="Unknown" Version="1">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="19-11-24" Author="Nic Morris" Comment="Created (hopeless documentation)" Version="0" />
  <History Date="20-11-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a16ff5d2-d998-4164-9168-0d4d53877c24" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~72" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="73~108" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="109~144" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="145~180" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="181~216" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="217~254" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1 (Motor Controlled)" Display="'Auto 1 (Motor Controlled)'" Dmx="16~30" />
      <Function ID="3" Name="Auto 2 (Motor Controlled)" Display="'Auto 2 (Motor Controlled)'" Dmx="31~45" />
      <Function ID="4" Name="Auto 3 (Motor Controlled)" Display="'Auto 3 (Motor Controlled)'" Dmx="46~60" />
      <Function ID="5" Name="Auto 4 (Motor Controlled)" Display="'Auto 4 (Motor Controlled)'" Dmx="61~75" />
      <Function ID="6" Name="Auto 5 (Motor Controlled)" Display="'Auto 5 (Motor Controlled)'" Dmx="76~90" />
      <Function ID="7" Name="Auto 6 (Motor Controlled)" Display="'Auto 6 (Motor Controlled)'" Dmx="91~105" />
      <Function ID="8" Name="Auto 7 (Motor Controlled)" Display="'Auto 7 (Motor Controlled)'" Dmx="106~120" />
      <Function ID="9" Name="Sound (Motor Controlled)" Display="'Sound (Motor Controlled)'" Dmx="121~135" />
      <Function ID="10" Name="Auto 1 (Motor Running)" Display="'Auto 1 (Motor Running)'" Dmx="136~150" />
      <Function ID="11" Name="Auto 2 (Motor Running)" Display="'Auto 2 (Motor Running)'" Dmx="151~165" />
      <Function ID="12" Name="Auto 3 (Motor Running)" Display="'Auto 3 (Motor Running)'" Dmx="166~180" />
      <Function ID="13" Name="Auto 4 (Motor Running)" Display="'Auto 4 (Motor Running)'" Dmx="181~195" />
      <Function ID="14" Name="Auto 5 (Motor Running)" Display="'Auto 5 (Motor Running)'" Dmx="196~210" />
      <Function ID="15" Name="Auto 6 (Motor Running)" Display="'Auto 6 (Motor Running)'" Dmx="211~225" />
      <Function ID="16" Name="Auto 7 (Motor Running)" Display="'Auto 7 (Motor Running)'" Dmx="226~240" />
      <Function ID="17" Name="Sound (Motor Running)" Display="'Sound (Motor Running)'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Master" Name="Colour Master" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~72" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="73~108" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="109~144" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="145~180" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="181~216" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="217~254" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15" Id="522db165-7a2d-4a6c-9d17-b4d5bc0a3fb3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

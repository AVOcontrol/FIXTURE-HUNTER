  <History Date="11-07-18" Author="Nic Morris" Comment="Created (poor documentation - charts have errors and are missing important function ranges)" />
  <History Date="16-07-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7a201f46-a572-47a6-b3af-c42f9ce78c2a" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="4~127" Colour="255,255,255" />
      <Function ID="3" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~97" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="210~249" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="102~126" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="127~151" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="156~180" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="181~205" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="4~59" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="147~104" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="103~60" />
      <Function ID="5" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="148~245" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="127~64" />
      <Function ID="4" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display Invert" Display="'Display Invert'" Dmx="124~134" />
      <Function ID="3" Name="Display Normal" Display="'Display Normal'" Dmx="135~145" />
      <Function ID="4" Name="Reset Effect" Display="'Reset Effect'" Dmx="185~191" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="192~198" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="199~211" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Low Power" Display="'Low Power'" Dmx="32~63" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="160~191" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="UKTPV130" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="00013a68-a530-41c1-b9a5-5fe3982fb779" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Focus" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Pan" ChannelOffset="8,9" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="10,11" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="12" Wheel="25" />
      <Attribute ID="Function" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Lamp" ChannelOffset="14" Wheel="29" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Function:6" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Function:5" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effect">
      <Set Channel="Function:4" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display Normal">
      <Set Channel="Function:3" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display Invert">
      <Set Channel="Function:2" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:4" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Low Power">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>

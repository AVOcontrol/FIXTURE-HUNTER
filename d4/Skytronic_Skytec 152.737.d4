      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="76~131" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="132~188" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="189~239" />

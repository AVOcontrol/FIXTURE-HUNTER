      <Function ID="3" Name="Red" Display="'Red'" Dmx="57~84" Colour="255,255,255" />
      <Function ID="4" Name="Green Strobe" Display="'Green Strobe'" Dmx="85~112" Colour="255,255,255" />
      <Function ID="5" Name="Red Strobe" Display="'Red Strobe'" Dmx="113~140" Colour="255,255,255" />
      <Function ID="6" Name="R On, G Strobe" Display="'R On, G Strobe'" Dmx="141~168" Colour="255,255,255" />
      <Function ID="7" Name="G On, R Strobe" Display="'G On, R Strobe'" Dmx="169~197" Colour="255,255,255" />
      <Function ID="8" Name="R+G Strobe" Display="'R+G Strobe'" Dmx="198~224" Colour="255,255,255" />

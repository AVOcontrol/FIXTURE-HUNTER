  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="39f14235-b919-45da-abc0-be44bff74d12" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="80~95" Colour="255,100,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="96~111" Colour="255,128,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="112~127" Colour="255,255,0" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="128~143" Colour="128,0,255" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="144~159" Colour="255,150,150" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="160~175" Colour="0,255,255" />
      <Function ID="12" Name="Pastel Red" Display="'Pastel Red'" Dmx="176~191" Colour="255,100,100" />
      <Function ID="13" Name="Pastel Green" Display="'Pastel Green'" Dmx="192~207" Colour="128,255,0" />
      <Function ID="14" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="208~223" Colour="0,128,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="224~239" Colour="255,240,200" />
      <Function ID="16" Name="Cool White" Display="'Cool White'" Dmx="240~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="1~19" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="20~39" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="40~59" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="60~79" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="80~99" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="100~119" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="120~139" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="140~159" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="160~179" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="180~199" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="200~219" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="220~239" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

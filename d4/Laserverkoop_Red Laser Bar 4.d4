<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Red Laser Bar 4" ShortName="Red Bar 4" Company="Laserverkoop" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="03-08-22" Author="Nic Morris" Comment="Created (poor documentation. can't find product online)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Effect" Name="Col Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="16~128" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="16~128" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Speed/Sens" Name="Speed/Sens" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed/Sensitivity" Display="'Speed/Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
        <Attribute ID="Tilt_Speed" ChannelOffset="2" Wheel="25" />
        <Attribute ID="Master_Dimmer" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="11" Wheel="5" />
        <Attribute ID="Col_Effect" ChannelOffset="12" Wheel="22" />
        <Attribute ID="Auto" ChannelOffset="13" Wheel="23" />
        <Attribute ID="Speed/Sens" ChannelOffset="14" Wheel="24" />
        <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Laser 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Laser 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Laser 3" ChannelOffset="6" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Laser 4" ChannelOffset="7" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="LED 1" ChannelOffset="8" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="LED 2" ChannelOffset="9" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="LED 3" ChannelOffset="10" ModeLink="Cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
</Fixture>
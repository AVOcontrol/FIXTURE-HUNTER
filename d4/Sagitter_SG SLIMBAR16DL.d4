  <AtlaBase TypeID="374e0ed0-28db-4b45-a010-19cca8c50b05" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="18~35" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="36~53" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="54~71" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="72~89" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="90~107" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="108~125" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="126~143" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="144~161" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="162~179" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="180~197" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="198~215" />
      <Function ID="13" Name="Sound 2" Display="'Sound 2'" Dmx="216~233" />
      <Function ID="14" Name="Sound 3" Display="'Sound 3'" Dmx="234~251" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

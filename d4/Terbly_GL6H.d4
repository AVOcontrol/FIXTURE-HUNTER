<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GL6H" ShortName="GL6H" Company="Terbly" Version="16">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="27-05-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="23-10-15" Author="Nic Morris" Comment="Created from Terbly GL-6" Version="2" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Swapped zoom and focus wheel slots.  Revised name and display name in response to manufacturer bug report." Version="4" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Changed All Blade Rot to locate and power on at 50% in response to customer bug report." Version="5" />
  <History Date="11-05-17" Author="Nic Morris" Comment="Reverted blade rot to power on and locate at zero." Version="6" />
  <History Date="30-12-17" Author="Nic Morris" Comment="Changed blades to two-point system in repsonse to manufacturer request (documentation is incorrect)." Version="7" />
  <History Date="30-12-17" Author="Nic Morris" Comment="Added channel counts to mode names." Version="8" />
  <History Date="31-12-17" Author="Nic Morris" Comment="Changed name from GL6H-R to GL-6H-R" Version="9" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Revised blade ID's in response to manufacturer calibration data." Version="10" />
  <History Date="23-04-19" Author="Nic Morris" Comment="Changed AutoFocus to 8bit and added separate AutoFocus Adj control." Version="11" />
  <History Date="23-04-19" Author="Nic Morris" Comment="Revised fixed colours with names and swatches in line with latest documentation." Version="12" />
  <History Date="23-04-19" Author="Nic Morris" Comment="Changed name from GL-6H-R to GL6H in response to manufacturer bug report (fairly sure previous change was manuf. request also!)" Version="13" />
  <History Date="23-04-19" Author="Nic Morris" Comment="Added gobo swatches" Version="14" />
  <History Date="24-04-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="15" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="16" />

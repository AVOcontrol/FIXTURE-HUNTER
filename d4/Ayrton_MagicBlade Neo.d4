      <Function ID="1" Name="Normal (Stop Spin by Spinout)" Display="'Normal (Stop Spin by Spinout)'" Dmx="0~0" />
      <Function ID="2" Name="Normal (Stop Spin by Shortcut)" Display="'Normal (Stop Spin by Shortcut)'" Dmx="64~127" />

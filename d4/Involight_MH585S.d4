      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="13~25" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="26~38" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="39~50" WheelPosition="3" />

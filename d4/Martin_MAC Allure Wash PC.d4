      <Function ID="21" Name="Offset Shift 200°" Display="'Offset Shift 200°'" Dmx="20~20" />
      <Function ID="22" Name="Offset Shift 210°" Display="'Offset Shift 210°'" Dmx="21~21" />
      <Function ID="23" Name="Offset Shift 220°" Display="'Offset Shift 220°'" Dmx="22~22" />

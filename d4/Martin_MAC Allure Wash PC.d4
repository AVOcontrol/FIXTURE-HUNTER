      <Function ID="20" Name="Single LED Chase" Display="'Single LED Chase'" Dmx="111~111" />
      <Function ID="21" Name="Double LED Chase" Display="'Double LED Chase'" Dmx="112~112" />
      <Function ID="22" Name="Triple LED Chase" Display="'Triple LED Chase'" Dmx="113~113" />

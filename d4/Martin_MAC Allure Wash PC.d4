    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Shape" Name="Beam Shape" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Beam_Shape_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Beam_Shape_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Beam_Shape_Rot" />
    </Attribute>
    <Attribute ID="Beam_Shape_Rot" Name="Beam Shape Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="2" If="'Beam_Shape'==2" />
      <Condition Name="Spin" ID="3,4,5,6,7" If="'Beam_Shape'==3" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" />
      <Function ID="3" Name="No Spin (0° Index)" Display="'No Spin (0° Index)'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="127~129" WheelPosition="0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="253~130" />
      <Function ID="7" Name="No Spin (45° Index)" Display="'No Spin (45° Index)'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P3_Mode" Name="P3 Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DMX Only" Display="'DMX Only'" Dmx="0~0" />
      <Function ID="2" Name="DMX-&gt;P3" Display="'DMX-&gt;P3 %.1f%%',0.0~100.0" Dmx="27~227" />
      <Function ID="3" Name="P3 Only" Display="'P3 Only'" Dmx="228~228" />
      <Function ID="4" Name="P3+DMX" Display="'P3+DMX'" Dmx="229~255" />
    </Attribute>
  </Control>

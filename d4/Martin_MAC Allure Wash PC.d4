<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MAC Allure Wash PC" ShortName="AllureWsPC" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>c32f47c4-0996-479a-bed5-7c196274a23a</Thumbnail>
  <History Date="31-03-14" Author="Nic Morris" Comment="Created" />
  <History Date="11-06-14" Author="Nic Morris" Comment="Added compatibility attributes to extended mode for r20 export." />
  <History Date="19-06-14" Author="Nic Morris" Comment="Fixed beam twister ranges." />
  <History Date="24-06-14" Author="Peter Budd" Comment="Called the Aura Cell. Aura 4 so it would exchange." />
  <History Date="10-03-15" Author="Nic Morris" Comment="Updated to firmware version 2.0.0 (FX - manual rev B) in response to customer bug report." />
  <History Date="30-05-15" Author="Nic Morris" Comment="Updated RGB in basic mode to 16-bit in line with latest documentation in response to customer request." />
  <History Date="21-07-15" Author="Nic Morris" Comment="Resynced beam twister range fixes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="30-09-17" Author="Nic Morris" Comment="Revised mode names with channel counts.  Revised cell names." />
  <History Date="30-09-17" Author="Nic Morris" Comment="Fixed colour conditions.  Added LEE filter names.  Added vdim to cells.  Fixed aura cell links." />
  <History Date="07-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Created from Martin Mac Quantum Wash (assuming control DMX 69/70 are store tilt limit rather than pan as in charts)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="15003e1b-8e8f-4533-9871-8e11a08435f4" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

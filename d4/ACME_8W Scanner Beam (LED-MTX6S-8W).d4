  <History Date="16-02-15" Author="Nic Morris" Comment="Created" />
  <History Date="23-04-17" Author="Nic Morris" Comment="Changed name from 8W Scanner Beam to 8W Scanner Beam (LED-MTX6S-8W)" />
  <History Date="27-04-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ce06cdd4-8aba-4fea-9f06-3c9c6d6944dd" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~27" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="28~47" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="48~67" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="68~87" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="88~107" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="108~127" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="128~147" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="148~167" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="168~187" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="188~207" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="208~227" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="228~247" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Macro" Name="Tilt Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~43" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="44~79" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="80~115" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="116~151" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="152~187" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="188~223" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Tilt_Mac_Spd" Name="Tilt Mac Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="1">
    <Import PearlRef="AME8WSB1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="240" PanMaxSpeed="0" TiltMaxSpeed="0" />

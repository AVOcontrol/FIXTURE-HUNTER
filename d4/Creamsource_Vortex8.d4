      <Function ID="6" Name="Flash Level" Display="'Flash Level'" Dmx="255~255" />
      <Function ID="7" Name="Effect Disabled" Display="'Effect Disabled'" Dmx="0~0" />
      <Function ID="8" Name="Effect Enabled" Display="'Effect Enabled'" Dmx="255~255" />
      <Function ID="9" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="10" Name="1 Flash" Display="'1 Flash'" Dmx="0~0" />
      <Function ID="11" Name="2 Flashes" Display="'2 Flashes'" Dmx="10~19" />
      <Function ID="12" Name="3 Flashes" Display="'3 Flashes'" Dmx="20~29" />
      <Function ID="13" Name="4 Flashes" Display="'4 Flashes'" Dmx="30~39" />
      <Function ID="14" Name="5 Flashes" Display="'5 Flashes'" Dmx="40~49" />
      <Function ID="15" Name="6 Flashes" Display="'6 Flashes'" Dmx="50~59" />
      <Function ID="16" Name="7 Flashes" Display="'7 Flashes'" Dmx="60~69" />
      <Function ID="17" Name="8 Flashes" Display="'8 Flashes'" Dmx="70~79" />
      <Function ID="18" Name="9 Flashes" Display="'9 Flashes'" Dmx="80~89" />
      <Function ID="19" Name="10 Flashes" Display="'10 Flashes'" Dmx="90~99" />
      <Function ID="20" Name="11 Flashes" Display="'11 Flashes'" Dmx="100~109" />
      <Function ID="21" Name="12 Flashes" Display="'12 Flashes'" Dmx="110~119" />
      <Function ID="22" Name="13 Flashes" Display="'13 Flashes'" Dmx="120~129" />
      <Function ID="23" Name="14 Flashes" Display="'14 Flashes'" Dmx="130~139" />
      <Function ID="24" Name="15 Flashes" Display="'15 Flashes'" Dmx="140~149" />

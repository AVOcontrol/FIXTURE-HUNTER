      <Function ID="17" Name="Flash Time 1/15th sec" Display="'Flash Time 1/15th sec'" Dmx="100~109" />
      <Function ID="18" Name="Flash Time 1/10th sec" Display="'Flash Time 1/10th sec'" Dmx="110~119" />
      <Function ID="19" Name="Flash Time 1/5th sec" Display="'Flash Time 1/5th sec'" Dmx="120~129" />
      <Function ID="20" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="21" Name="(Col Combination) Blue" Display="'(Col Combination) Blue'" Dmx="0~0" />
      <Function ID="22" Name="(Col Combination) Blue, Red" Display="'(Col Combination) Blue, Red'" Dmx="15~29" />
      <Function ID="23" Name="(Col Combination) Blue, White" Display="'(Col Combination) Blue, White'" Dmx="30~44" />
      <Function ID="24" Name="(Col Combination) Blue, Amber" Display="'(Col Combination) Blue, Amber'" Dmx="45~59" />
      <Function ID="25" Name="(Col Combination) Blue, White, Red" Display="'(Col Combination) Blue, White, Red'" Dmx="60~74" />
      <Function ID="26" Name="(Col Combination) Blue, Amber, Red" Display="'(Col Combination) Blue, Amber, Red'" Dmx="75~89" />

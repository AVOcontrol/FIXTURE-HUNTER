      <Function ID="10" Name="Bonfire" Display="'Bonfire'" Dmx="100~119" />
      <Function ID="11" Name="Inferno" Display="'Inferno'" Dmx="120~139" />
      <Function ID="12" Name="Gas Fire" Display="'Gas Fire'" Dmx="140~159" />
      <Function ID="13" Name="(Preset) Custom" Display="'(Preset) Custom'" Dmx="0~0" />
      <Function ID="14" Name="(Preset) Blue Slow" Display="'(Preset) Blue Slow'" Dmx="10~19" />
      <Function ID="15" Name="(Preset) Blue Fast" Display="'(Preset) Blue Fast'" Dmx="20~29" />
      <Function ID="16" Name="(Preset) Blue Double" Display="'(Preset) Blue Double'" Dmx="30~39" />
      <Function ID="17" Name="(Preset) Blue Burst" Display="'(Preset) Blue Burst'" Dmx="40~49" />
      <Function ID="18" Name="(Preset) Blue/Red Slow" Display="'(Preset) Blue/Red Slow'" Dmx="50~59" />
      <Function ID="19" Name="(Preset) Blue/Red Fast" Display="'(Preset) Blue/Red Fast'" Dmx="60~69" />
      <Function ID="20" Name="(Preset) Blue/Red Double" Display="'(Preset) Blue/Red Double'" Dmx="70~79" />
      <Function ID="21" Name="(Preset) Blue/Red Burst" Display="'(Preset) Blue/Red Burst'" Dmx="80~89" />
      <Function ID="22" Name="(Preset) BlueRed Rapid" Display="'(Preset) BlueRed Rapid'" Dmx="90~99" />
      <Function ID="23" Name="(Preset) Blue/Red/White Rapid" Display="'(Preset) Blue/Red/White Rapid'" Dmx="100~109" />
      <Function ID="24" Name="(Preset) Red Warning" Display="'(Preset) Red Warning'" Dmx="110~119" />
      <Function ID="25" Name="(Preset) Amber Ping" Display="'(Preset) Amber Ping'" Dmx="120~129" />
      <Function ID="26" Name="(Preset) Magenta Burst" Display="'(Preset) Magenta Burst'" Dmx="130~139" />
      <Function ID="27" Name="(Palette) Primary 6" Display="'(Palette) Primary 6'" Dmx="0~0" />
      <Function ID="28" Name="(Palette) Primary 12" Display="'(Palette) Primary 12'" Dmx="20~39" />
      <Function ID="29" Name="(Palette) Primary 24" Display="'(Palette) Primary 24'" Dmx="40~59" />
      <Function ID="30" Name="(Palette) Warm" Display="'(Palette) Warm'" Dmx="60~79" />
      <Function ID="31" Name="(Palette) Cool" Display="'(Palette) Cool'" Dmx="80~99" />
      <Function ID="32" Name="(Palette) Warm+Cool" Display="'(Palette) Warm+Cool'" Dmx="100~119" />
      <Function ID="33" Name="(Palette) Pastel" Display="'(Palette) Pastel'" Dmx="120~139" />
      <Function ID="34" Name="(Palette) Purple Rain" Display="'(Palette) Purple Rain'" Dmx="140~159" />

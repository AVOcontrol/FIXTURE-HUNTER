      <Function ID="6" Name="Effect Enabled" Display="'Effect Enabled'" Dmx="255~255" />
      <Function ID="7" Name="Flash Time 1/5000th sec" Display="'Flash Time 1/5000th sec'" Dmx="0~0" />

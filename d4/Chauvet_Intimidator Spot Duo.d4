<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intimidator Spot Duo" ShortName="ISpot Duo" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-06-13" Author="Peter Budd" Comment="Created" />
  <History Date="03-10-16" Author="Nic Morris" Comment="Changed non-standard modes to hidden and added Atlabase ID's." />
  <History Date="03-10-16" Author="Nic Morris" Comment="Fixed duplicate ID's in colour 2 else condition.  Fixed various updates." />
  <History Date="03-10-16" Author="Nic Morris" Comment="Added Colour and all Colour Funcs to hilight/lolight.  Changed 10 DMX mode to use cells (dimmer)" />
  <History Date="10-11-17" Author="Nic Morris" Comment="Fixed control functions and macros.  Inverted CW scrolls." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d9360f93-f7cc-4530-bba5-3e506896b9ce" />
  <Control>
    <Attribute ID="Pan1" Name="Pan 1" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt1" Name="Tilt 1" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan2" Name="Pan 2" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt2" Name="Tilt 2" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="16~31" Colour="255,128,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="32~47" Colour="0,128,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="48~63" Colour="255,0,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~79" Colour="0,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="80~95" Colour="255,150,150" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="96~111" Colour="255,255,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="112~127" Colour="0,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

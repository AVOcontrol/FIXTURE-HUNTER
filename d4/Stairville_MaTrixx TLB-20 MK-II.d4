<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MaTrixx TLB-20 MK-II" ShortName="TLB-20 Mk2" Company="Stairville">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="15-10-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Colour" Description="" Group="C">
      <Locate Locate="5" PowerOn="1" />
      <Function ID="1" Name="Close" Display="'Close'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~9" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="10~19" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="20~29" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="40~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed 1" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed1" Name="Speed 2" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PreProgram" Name="PreProgram" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~9" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="10~19" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="20~29" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="30~39" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="40~49" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="50~59" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="60~69" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="70~79" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="80~89" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="90~99" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="100~109" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="110~119" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="120~129" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="130~139" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="140~149" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="150~159" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="160~169" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="170~179" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="180~189" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="190~199" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="200~209" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="210~219" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="220~229" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="230~239" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="240~249" />
      <Function ID="27" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="SV_MtxTLB22" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="SV_MtxTLB23" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="PreProgram" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="26" />
      <Attribute ID="Speed1" ChannelOffset="3" Wheel="27" />
    </Include>
  </Mode>
</Fixture>
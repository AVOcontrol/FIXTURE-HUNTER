<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SG RAYSERL (Laser Ray Emulator)" ShortName="SG RAYSERL" Company="Sagitter">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>2f91fd40-fb5a-4931-af94-441db5716ae0</Thumbnail>
  <History Date="06-11-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Motor_1" Name="Motor 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Motor_2" Name="Motor 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~11" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~19" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="23~26" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="31~34" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="39~42" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="46~49" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="54~57" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="62~64" WheelPosition="8" Colour="255,150,150" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="12~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="20~22" WheelPosition="2" Colour="0,255,0" />
      <Function ID="13" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="27~30" WheelPosition="3" Colour="0,0,255" />
      <Function ID="14" Name="Yel/ Org" Display="'Yel/ Org'" Dmx="35~38" WheelPosition="4" Colour="255,255,0" />
      <Function ID="15" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="43~45" WheelPosition="5" Colour="255,128,0" />
      <Function ID="16" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="50~53" WheelPosition="6" Colour="255,0,255" />
      <Function ID="17" Name="Cy/ Pk" Display="'Cy/ Pk'" Dmx="58~61" WheelPosition="7" Colour="0,255,255" />
      <Function ID="18" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="65~65" WheelPosition="8" Colour="255,150,150" />
      <Function ID="19" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="66~128" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="191~193" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~194" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="191~193" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="190~129" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Gobo 1" Display="'Gobo 1'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 2" Display="'Gobo 2'" Dmx="9~16" />
      <Function ID="3" Name="Gobo 3" Display="'Gobo 3'" Dmx="17~25" />
      <Function ID="4" Name="Gobo 4" Display="'Gobo 4'" Dmx="26~33" />
      <Function ID="5" Name="Gobo 5" Display="'Gobo 5'" Dmx="34~42" />
      <Function ID="6" Name="Gobo 6" Display="'Gobo 6'" Dmx="43~50" />
      <Function ID="7" Name="Gobo 7" Display="'Gobo 7'" Dmx="51~59" />
      <Function ID="8" Name="Gobo 8" Display="'Gobo 8'" Dmx="60~67" />
      <Function ID="9" Name="Gobo 9" Display="'Gobo 9'" Dmx="68~76" />
      <Function ID="10" Name="Gobo 10" Display="'Gobo 10'" Dmx="77~84" />
      <Function ID="11" Name="Gobo 11" Display="'Gobo 11'" Dmx="85~93" />
      <Function ID="12" Name="Gobo 12" Display="'Gobo 12'" Dmx="94~101" />
      <Function ID="13" Name="Gobo 13" Display="'Gobo 13'" Dmx="102~110" />
      <Function ID="14" Name="Gobo 14" Display="'Gobo 14'" Dmx="111~118" />
      <Function ID="15" Name="Gobo 15" Display="'Gobo 15'" Dmx="119~127" />
      <Function ID="16" Name="Gobo 16" Display="'Gobo 16'" Dmx="128~135" />
      <Function ID="17" Name="Gobo 17" Display="'Gobo 17'" Dmx="136~144" />
      <Function ID="18" Name="Gobo 18" Display="'Gobo 18'" Dmx="145~152" />
      <Function ID="19" Name="Gobo 19" Display="'Gobo 19'" Dmx="153~161" />
      <Function ID="20" Name="Gobo 20" Display="'Gobo 20'" Dmx="162~169" />
      <Function ID="21" Name="Gobo 21" Display="'Gobo 21'" Dmx="170~178" />
      <Function ID="22" Name="Gobo 22" Display="'Gobo 22'" Dmx="179~186" />
      <Function ID="23" Name="Gobo 23" Display="'Gobo 23'" Dmx="187~195" />
      <Function ID="24" Name="Gobo 24" Display="'Gobo 24'" Dmx="196~203" />
      <Function ID="25" Name="Gobo 25" Display="'Gobo 25'" Dmx="204~212" />
      <Function ID="26" Name="Gobo 26" Display="'Gobo 26'" Dmx="213~220" />
      <Function ID="27" Name="Gobo 27" Display="'Gobo 27'" Dmx="221~229" />
      <Function ID="28" Name="Gobo 28" Display="'Gobo 28'" Dmx="230~237" />
      <Function ID="29" Name="Gobo 29" Display="'Gobo 29'" Dmx="238~246" />
      <Function ID="30" Name="Full On" Display="'Full On'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Left/Right" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Left" Display="'Left %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Right" Display="'Right %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Up/Down" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Up" Display="'Up %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Down" Display="'Down %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Step_Rot" Name="Step Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0°" Display="'0°'" Dmx="0~0" />
      <Function ID="2" Name="90°" Display="'90°'" Dmx="64~127" />
      <Function ID="3" Name="180°" Display="'180°'" Dmx="128~191" />
      <Function ID="4" Name="270°" Display="'270°'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="X/Y-Rot" Name="X/Y-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Y-Rot" Display="'Y-Rot %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="121~134" />
      <Function ID="4" Name="X-Rot" Display="'X-Rot %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="100~199" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="SGRAYSR1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Motor_1" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Motor_2" ChannelOffset="2" Wheel="20" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Z-Rot" ChannelOffset="7" Wheel="49" />
      <Attribute ID="X/Y-Rot" ChannelOffset="8" Wheel="50" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="51" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SGRAYSR2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Motor_1" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Motor_2" ChannelOffset="2" Wheel="20" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Pan" ChannelOffset="7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="8" Wheel="3" />
      <Attribute ID="Step_Rot" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Z-Rot" ChannelOffset="10" Wheel="49" />
      <Attribute ID="X/Y-Rot" ChannelOffset="11" Wheel="50" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="51" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />

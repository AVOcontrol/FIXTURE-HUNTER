      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="90~99" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="100~109" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="110~119" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="120~129" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="130~139" />

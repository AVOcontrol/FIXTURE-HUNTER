  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5,Shutter:1" Delay="9000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="P/T MSpeed OFF">
      <Set Channel="Control:2" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">
      <Set Channel="Control:3,Shutter:1" Delay="9000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:4,Shutter:1" Delay="9000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Shutdown">
      <Set Channel="Control:6,Shutter:1" Delay="20000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Sound">
      <Set Channel="Control:7,Shutter:1" Delay="9000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Fan Studio">
      <Set Channel="Control:15" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Continuous">
      <Set Channel="Control:16" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="C-Mix_Func" Name="C-Mix Func" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" Highlight="4" Lowlight="4" />
      <Function ID="1" Name="Pure Mix (Full Speed)" Display="'Pure Mix (Full Speed)'" Dmx="0~0" Update="Cyan" />
      <Function ID="2" Name="Cycle  (Full Speed)" Display="'Cycle  (Full Speed)'" Dmx="32~47" Update="Cyan" />
      <Function ID="3" Name="Random (Full Speed)" Display="'Random (Full Speed)'" Dmx="48~63" Update="Cyan" />
      <Function ID="4" Name="Pure Mix Fast (Full Speed)" Display="'Pure Mix Fast (Full Speed)'" Dmx="64~79" Update="Cyan" />
      <Function ID="5" Name="Cycle Fast (Full Speed)" Display="'Cycle Fast (Full Speed)'" Dmx="80~95" Update="Cyan" />
      <Function ID="6" Name="Random Fast (Full Speed)" Display="'Random Fast (Full Speed)'" Dmx="96~111" Update="Cyan" />
      <Function ID="7" Name="Pure Mix (mSpeed)" Display="'Pure Mix (mSpeed)'" Dmx="128~159" Update="Cyan" />
      <Function ID="8" Name="Cycle  (mSpeed)" Display="'Cycle  (mSpeed)'" Dmx="160~175" Update="Cyan" />
      <Function ID="9" Name="Random (mSpeed)" Display="'Random (mSpeed)'" Dmx="176~191" Update="Cyan" />
      <Function ID="10" Name="Pure Mix Fast (mSpeed)" Display="'Pure Mix Fast (mSpeed)'" Dmx="192~207" Update="Cyan" />
      <Function ID="11" Name="Cycle Fast (mSpeed)" Display="'Cycle Fast (mSpeed)'" Dmx="208~223" Update="Cyan" />
      <Function ID="12" Name="Random Fast (mSpeed)" Display="'Random Fast (mSpeed)'" Dmx="224~239" Update="Cyan" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Cyan" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Pure Mix" ID="1" If="'C-Mix_Func'==1||'C-Mix_Func'==4||'C-Mix_Func'==7||'C-Mix_Func'==10" />
      <Condition Name="Cycle/Random" ID="2" If="'C-Mix_Func'==2||'C-Mix_Func'==3||'C-Mix_Func'==5||'C-Mix_Func'==6||'C-Mix_Func'==8||'C-Mix_Func'==9||'C-Mix_Func'==11||'C-Mix_Func'==12" />
      <Else ID="3" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,255" />

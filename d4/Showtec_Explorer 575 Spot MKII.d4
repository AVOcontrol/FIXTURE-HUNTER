      <Function ID="12" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="20~40" WheelPosition="1" Colour="255,0,0" />
      <Function ID="13" Name="Yel - Rs" Display="'Yel - Rs %.f%%',0~100" Dmx="40~60" WheelPosition="2" Colour="255,255,0" />

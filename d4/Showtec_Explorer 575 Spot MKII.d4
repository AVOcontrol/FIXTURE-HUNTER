<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Explorer 575 Spot MKII" ShortName="x575 Sp v2" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>64a7fec4-97eb-4d42-959f-fda9764340d6</Thumbnail>
  <History Date="07-07-06" Author="Ed" Comment="Created from version 1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="25-07-12" Author="Peter Budd" Comment="Edited updated dimmer value" />
  <History Date="07-03-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added physical pan/tilt ranges." />
  <History Date="07-03-18" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised conditionals.  Fixed colour scroll range.  Added function index." />
  <History Date="07-03-18" Author="Nic Morris" Comment="Fixed colour 1 index swatches.  Added highlight/lowlight.  Revised prism with discreet functions." />
  <History Date="07-03-18" Author="Nic Morris" Comment="Removed gobo 1 slot 10 and added scroll.  Renamed Beam to Zoom and revised with discreet functions." />
  <History Date="07-03-18" Author="Nic Morris" Comment="Revised dimmer DMX range.  Recreated palettes.  Fixed macros.  Revised gobos with shake options." />
  <History Date="07-03-18" Author="Nic Morris" Comment="Changed name from Explorer 575 Spot v2 to Explorer 575 Spot MKII" />
  <History Date="07-03-18" Author="Nic Morris" Comment="Renamed existing mode to Advanced and added Basic mode.  Added gobo swatches." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b49bf1d3-d6ed-4f57-8096-3c3e42d3d6ba" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />

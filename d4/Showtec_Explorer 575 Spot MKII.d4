    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="15° (AutoFocus Off)" Display="'15° (AutoFocus Off)'" Dmx="0~0" />
      <Function ID="2" Name="18° (AutoFocus Off)" Display="'18° (AutoFocus Off)'" Dmx="33~65" />
      <Function ID="3" Name="22° (AutoFocus Off)" Display="'22° (AutoFocus Off)'" Dmx="66~98" />
      <Function ID="4" Name="Keep" Display="'Keep'" Dmx="99~128" />
      <Function ID="5" Name="15° (AutoFocus On)" Display="'15° (AutoFocus On)'" Dmx="129~154" />
      <Function ID="6" Name="18° (AutoFocus On)" Display="'18° (AutoFocus On)'" Dmx="155~179" />
      <Function ID="7" Name="22° (AutoFocus On)" Display="'22° (AutoFocus On)'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Dimmer" ID="1" If="'Dimmer_Func'==1" />
      <Condition Name="Control" ID="2,3,4" If="'Dimmer_Func'==2" />
      <Else ID="5" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="129~255" Intensity="0~0" />
      <Function ID="2" Name="Safe" Display="'Safe'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Lamp On/ Reset" Display="'Lamp On/ Reset'" Dmx="30~39" Intensity="0~0" />
      <Function ID="4" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~69" Intensity="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer_Func" Name="Dimmer Func" Description="" Group="I" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
      <Function ID="2" Name="Control" Display="'Control'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
    </Attribute>
  </Control>

  <Macro>
    <Macro Name="Lamp On/ Reset">
      <Set Channel="Dimmer_Func:2,Dimmer:3" Delay="4000" />
      <Set Channel="Dimmer_Func:1,Dimmer:1:100" Delay="1000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Dimmer_Func:2,Dimmer:4" Delay="4000" />
      <Set Channel="Dimmer_Func:1,Dimmer:1:0" Delay="1000" />
    </Macro>
  </Macro>

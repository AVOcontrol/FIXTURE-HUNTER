      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="CyanAdditive" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="YellowAdditive" ChannelOffset="5" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="6" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10" Id="3f70d643-f4cd-4bf7-aff7-d6f4e6304e92">

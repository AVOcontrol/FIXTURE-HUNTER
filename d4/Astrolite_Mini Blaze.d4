        <Attribute ID="Green_Master" ChannelOffset="3" Wheel="8" />
        <Attribute ID="Blue_Master" ChannelOffset="4" Wheel="9" />
        <Attribute ID="Duration" ChannelOffset="5" Wheel="5" />

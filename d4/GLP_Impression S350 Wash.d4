<Fixture Name="Impression S350 Wash" ShortName="ImpS350 Ws" Company="GLP" Version="9">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>cc934cbf-4c18-4ff5-9029-959d428a868e</Thumbnail>
  <History Date="07-02-18" Author="Nic Morris" Comment="Created (charts only - limited range information.  no blade calibration details)" Version="1" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Revised in line with latest charts (date 2018-02-09, SW Main V11)." Version="2" />
  <History Date="16-02-18" Author="Nic Morris" Comment="(added colour names and blade control functions/macros, revised frost + blade module rot ranges, changed blade channel assignment + added effect channels)" Version="3" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Changed name from S350 to Impression S350.  Added product thumbnail." Version="4" />
  <History Date="24-08-18" Author="Nic Morris" Comment="Updated again! Now in line with latest charts (firmware version V24-31-21-22) note charts have dimmer default at 50%.  This is surely wrong." Version="5" />
  <History Date="24-08-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added gobo swatches." Version="6" />
  <History Date="25-10-18" Author="Nic Morris" Comment="Fixed gobo rot ranges.  Exported updated R20.  Revised Atlabase mode ID." Version="7" />
  <History Date="16-04-19" Author="Nic Morris" Comment="Created from GLP Impression S350" Version="8" />
  <History Date="17-02-21" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised colours in line with latest charts (software v50/ documentation rev C)" Version="9" />
  <Manual Filename="" Summary="" />

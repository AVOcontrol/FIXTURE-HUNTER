  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ed879564-8585-4a2f-88ba-ef00560aa52f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Col in Dark" Display="'Col in Dark'" Dmx="250~252" />
      <Function ID="3" Name="All in Dark" Display="'All in Dark'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Fan Speed" Display="'Fan Speed %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Lamp On/ Reset" Display="'Lamp On/ Reset'" Dmx="128~139" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="16~16" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Violet" Display="'Violet'" Dmx="32~32" WheelPosition="2" Colour="180,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~48" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="64~64" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="80~80" WheelPosition="5" Colour="255,240,200" />
      <Function ID="7" Name="6000K" Display="'6000K'" Dmx="96~96" WheelPosition="6" Colour="230,230,255" />
      <Function ID="8" Name="UV Filter" Display="'UV Filter'" Dmx="112~112" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op - Yel" Display="'Op - Yel %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Yel - Vlt" Display="'Yel - Vlt %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="255,255,0" />
      <Function ID="11" Name="Vlt - Grn" Display="'Vlt - Grn %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="180,0,255" />
      <Function ID="12" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Org - CTO" Display="'Org - CTO %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="CTO - CTB" Display="'CTO - CTB %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="255,240,200" />
      <Function ID="15" Name="CTB - UV" Display="'CTB - UV %.f%%',0~100" Dmx="96~127" WheelPosition="6" Colour="230,230,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />

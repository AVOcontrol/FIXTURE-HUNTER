  <Macro>
    <Macro Name="Lamp On/ Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1:100" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1:100" Delay="0" />
    </Macro>

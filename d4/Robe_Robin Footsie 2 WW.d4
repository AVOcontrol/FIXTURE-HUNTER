  <History Date="19-04-23" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (adds WW Master control)" Version="7" />
  <History Date="02-06-23" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (revises blue pos light functions)" Version="8" />
  <History Date="11-10-23" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Updated in line with v1.4 charts in response to manufacturer request." Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1d69a243-690b-460d-a26e-cacc93b92f02" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="Dim Square" Display="'Dim Square'" Dmx="60~64" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="65~69" />
      <Function ID="6" Name="Save Initial DMX Values" Display="'Save Initial DMX Values'" Dmx="130~134" />
      <Function ID="7" Name="Show Initial DMX Values" Display="'Show Initial DMX Values'" Dmx="135~139" />
      <Function ID="8" Name="Reset to Default Values" Display="'Reset to Default Values'" Dmx="140~144" />
      <Function ID="9" Name="Blue Positional Light On" Display="'Blue Positional Light On'" Dmx="145~149" />
      <Function ID="10" Name="Blue Positional Light Off" Display="'Blue Positional Light Off'" Dmx="150~154" />
    </Attribute>
    <Attribute ID="LED_Freq_Sel" Name="LED Freq Sel" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="300Hz" Display="'300Hz'" Dmx="5~9" />
      <Function ID="3" Name="600Hz" Display="'600Hz'" Dmx="10~10" />
      <Function ID="4" Name="1200Hz" Display="'1200Hz'" Dmx="15~19" />
      <Function ID="5" Name="2400Hz" Display="'2400Hz'" Dmx="20~24" />
      <Function ID="6" Name="High" Display="'High'" Dmx="25~29" />
      <Function ID="7" Name="Reserved" Display="'Reserved %.f',30~255" Dmx="30~255" />
    </Attribute>
    <Attribute ID="LED_Freq_Adj" Name="LED Freq Adj" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Selected" Display="'Selected'" Dmx="0~0" />
      <Function ID="2" Name="-" Display="'- %.f',126~1" Dmx="2~127" />
      <Function ID="3" Name="Selected" Display="'Selected'" Dmx="128~128" />
      <Function ID="4" Name="+" Display="'+ %.f',1~126" Dmx="129~254" />
      <Function ID="5" Name="Selected" Display="'Selected'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="WW_Master" Name="WW Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="WW C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Blue_Pos_Light" Name="Blue Pos Light" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="129~150" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

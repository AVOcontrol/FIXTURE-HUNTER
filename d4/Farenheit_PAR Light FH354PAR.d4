      <Function ID="4" Name="7 Col Gradient" Display="'7 Col Gradient'" Dmx="130~189" />
      <Function ID="5" Name="RGB Chase" Display="'RGB Chase'" Dmx="190~249" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
  </Control>

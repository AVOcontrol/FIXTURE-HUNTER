      <Function ID="2" Name="Open - Blue" Display="'Open - Blue %.f%%',0~100" Dmx="24~45" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="46~46" Colour="255,0,0" />
      <Function ID="4" Name="Blue - Green" Display="'Blue - Green %.f%%',0~100" Dmx="47~92" Colour="255,0,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="93~93" Colour="180,0,180" />
      <Function ID="6" Name="Green - Pink" Display="'Green - Pink %.f%%',0~100" Dmx="94~138" Colour="180,0,180" />
      <Function ID="7" Name="Flesh Pink" Display="'Flesh Pink'" Dmx="139~139" Colour="255,128,0" />
      <Function ID="8" Name="Pink - Lav" Display="'Pink - Lav %.f%%',0~100" Dmx="140~185" Colour="255,128,0" />

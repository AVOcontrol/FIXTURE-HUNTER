      <Function ID="6" Name="Rotate Step" Display="'Rotate Step'" Dmx="16~20" Update="Anim_2_Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Anim_2_Rot" />

      <Function ID="1" Name="Index Short" Display="'Index Short'" Dmx="0~0" Update="Anim_1_Rot" />
      <Function ID="2" Name="Index Normal" Display="'Index Normal'" Dmx="6~10" Update="Anim_1_Rot" />
      <Function ID="3" Name="Shake Short" Display="'Shake Short %.f%%',0~100" Dmx="26~56" Update="Anim_1_Rot" />
      <Function ID="4" Name="Shake Normal" Display="'Shake Normal %.f%%',0~100" Dmx="57~87" Update="Anim_1_Rot" />
      <Function ID="5" Name="Rotate Normal" Display="'Rotate Normal'" Dmx="11~15" Update="Anim_1_Rot" />
      <Function ID="6" Name="Rotate Step" Display="'Rotate Step'" Dmx="16~20" Update="Anim_1_Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Anim_1_Rot" />
    </Attribute>
    <Attribute ID="Anim_1" Name="Anim 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Anim_1_Rot" Name="Anim 1 Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Anim_1_Func'&lt;5" />
      <Condition Name="Spin" ID="2,3,4" If="'Anim_1_Func'==5||'Anim_1_Func'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32756" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32781~65535" />
      <Function ID="5" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Anim_2_Func" Name="Anim 2 Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index Short" Display="'Index Short'" Dmx="0~0" Update="Anim_2_Rot" />
      <Function ID="2" Name="Index Normal" Display="'Index Normal'" Dmx="6~10" Update="Anim_2_Rot" />
      <Function ID="3" Name="Shake Short" Display="'Shake Short %.f%%',0~100" Dmx="26~56" Update="Anim_2_Rot" />

      <Function ID="5" Name="Twist Short" Display="'Twist Short %.f%%',0~100" Dmx="151~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Twist Normal" Display="'Twist Normal %.f%%',0~100" Dmx="181~210" GoboSpin="0~0" GoboOrientation="0~0" />

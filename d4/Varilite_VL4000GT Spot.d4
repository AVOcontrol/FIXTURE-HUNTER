      <Condition Name="Spin" ID="2,3,4" If="'Prism'==3||'Prism'==4" />
      <Else ID="5" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32756" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />

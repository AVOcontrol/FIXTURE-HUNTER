      <Function ID="12" Name="Amber - Open" Display="'Amber - Open %.f%%',0~100" Dmx="233~255" Colour="0,0,255" />
      <Function ID="13" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Short" Display="'Fixed Short'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Normal" Display="'Fixed Normal'" Dmx="6~10" GoboSpin="0~0" GoboOrientation="0~0" />

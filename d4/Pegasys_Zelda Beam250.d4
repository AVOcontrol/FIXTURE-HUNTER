      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="100~104" WheelPosition="10" Colour="0,0,255" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="110~114" WheelPosition="11" Colour="255,128,0" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="120~124" WheelPosition="12" Colour="255,240,200" />
      <Function ID="14" Name="CTB" Display="'CTB'" Dmx="130~134" WheelPosition="13" Colour="230,230,255" />

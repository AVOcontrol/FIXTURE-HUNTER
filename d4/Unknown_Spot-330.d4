      <Function ID="28" Name="D Blu - Op" Display="'D Blu - Op'" Dmx="111~121" WheelPosition="13" Colour="0,0,180" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="216~218" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~215" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="216~218" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="219~243" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="244~249" Colour="0,0,0" />
      <Function ID="34" Name="Random" Display="'Random %.f%%',0~100" Dmx="255~250" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

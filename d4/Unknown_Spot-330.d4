      <Function ID="19" Name="Rd - Aq" Display="'Rd - Aq'" Dmx="28~37" WheelPosition="4" Colour="255,0,0" />
      <Function ID="20" Name="Aq - Cy" Display="'Aq - Cy'" Dmx="37~47" WheelPosition="5" Colour="0,255,200" />
      <Function ID="21" Name="Cy - Lav" Display="'Cy - Lav'" Dmx="47~56" WheelPosition="6" Colour="0,255,255" />
      <Function ID="22" Name="Lav - 3200" Display="'Lav - 3200'" Dmx="56~63" WheelPosition="7" Colour="255,128,255" />
      <Function ID="23" Name="3200 - L Yel" Display="'3200 - L Yel'" Dmx="63~74" WheelPosition="8" Colour="255,240,200" />
      <Function ID="24" Name="L Yel - D Grn" Display="'L Yel - D Grn'" Dmx="74~83" WheelPosition="9" Colour="255,255,128" />
      <Function ID="25" Name="D Grn - Yel" Display="'D Grn - Yel'" Dmx="83~93" WheelPosition="10" Colour="0,200,0" />
      <Function ID="26" Name="Yel - Pk" Display="'Yel - Pk'" Dmx="93~102" WheelPosition="11" Colour="255,255,0" />

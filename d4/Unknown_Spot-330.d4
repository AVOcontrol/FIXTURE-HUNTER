      <Function ID="12" Name="Yellow" Display="'Yellow'" Dmx="177~180" WheelPosition="11" Colour="255,255,0" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="181~185" WheelPosition="12" Colour="255,150,150" />
      <Function ID="14" Name="Dark Blue" Display="'Dark Blue'" Dmx="186~189" WheelPosition="13" Colour="0,0,180" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Org - Mag" Display="'Org - Mag'" Dmx="0~10" WheelPosition="1" Colour="255,128,0" />
      <Function ID="17" Name="Mag - L Grn" Display="'Mag - L Grn'" Dmx="10~19" WheelPosition="2" Colour="255,0,255" />

      <Function ID="7" Name="Colour 6 GB" Display="'Colour 6 GB'" Dmx="156~185" />
      <Function ID="8" Name="Colour 7 RGB" Display="'Colour 7 RGB'" Dmx="186~215" />
      <Function ID="9" Name="Auto Jump" Display="'Auto Jump'" Dmx="216~225" />
      <Function ID="10" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="226~235" />
      <Function ID="11" Name="Auto Gradient" Display="'Auto Gradient'" Dmx="236~245" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="246~255" />

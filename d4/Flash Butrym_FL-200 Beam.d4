      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="140~149" Colour="0,0,0" />
      <Function ID="16" Name="Col Mix" Display="'Col Mix %.f%%',0~100" Dmx="150~199" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="200~229" Colour="0,0,0" />

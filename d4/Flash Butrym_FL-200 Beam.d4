  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="50~89" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="90~129" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="130~169" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="170~209" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="210~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="210~219" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="240~249" />
      <Function ID="4" Name="BO on P/T" Display="'BO on P/T'" Dmx="10~19" />
      <Function ID="5" Name="BO on Col" Display="'BO on Col'" Dmx="20~29" />
      <Function ID="6" Name="BO on Gobo" Display="'BO on Gobo'" Dmx="30~39" />
      <Function ID="7" Name="No Function" Display="'No Function'" Dmx="40~49" />
      <Function ID="8" Name="BO on P/T/Col" Display="'BO on P/T/Col'" Dmx="50~59" />
      <Function ID="9" Name="BO on P/T/Gobo" Display="'BO on P/T/Gobo'" Dmx="60~69" />
      <Function ID="10" Name="BO on P/T/Iris" Display="'BO on P/T/Iris'" Dmx="70~79" />
      <Function ID="11" Name="BO on Col/Gobo" Display="'BO on Col/Gobo'" Dmx="80~89" />
      <Function ID="12" Name="BO on P/T/Col/Gobo" Display="'BO on P/T/Col/Gobo'" Dmx="90~99" />
      <Function ID="13" Name="BO on P/T/Gobo" Display="'BO on P/T/Gobo'" Dmx="100~109" />
      <Function ID="14" Name="BO on P/T/Col/Gobo" Display="'BO on P/T/Col/Gobo'" Dmx="110~119" />
      <Function ID="15" Name="No Function" Display="'No Function'" Dmx="120~239" />
      <Function ID="16" Name="Lamp Off" Display="'Lamp Off'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />

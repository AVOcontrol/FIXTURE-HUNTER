      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="72~72" WheelPosition="9" Colour="255,0,255" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="80~80" WheelPosition="10" Colour="0,255,255" />
      <Function ID="12" Name="CTO 260" Display="'CTO 260'" Dmx="88~88" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="CTO 190" Display="'CTO 190'" Dmx="96~96" WheelPosition="12" Colour="255,240,200" />
      <Function ID="14" Name="CTB 8000" Display="'CTB 8000'" Dmx="104~104" WheelPosition="13" Colour="230,230,255" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="112~112" WheelPosition="14" Colour="0,0,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="4~4" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="12~12" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="20~20" WheelPosition="2" Colour="255,128,0" />
      <Function ID="19" Name="Aq/ Grn" Display="'Aq/ Grn'" Dmx="28~28" WheelPosition="3" Colour="0,255,200" />
      <Function ID="20" Name="Grn/ L Grn" Display="'Grn/ L Grn'" Dmx="36~36" WheelPosition="4" Colour="0,255,0" />
      <Function ID="21" Name="L Grn/ Lav" Display="'L Grn/ Lav'" Dmx="44~44" WheelPosition="5" Colour="128,255,0" />
      <Function ID="22" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="52~52" WheelPosition="6" Colour="255,128,255" />
      <Function ID="23" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="60~60" WheelPosition="7" Colour="255,150,150" />
      <Function ID="24" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="68~68" WheelPosition="8" Colour="255,255,0" />
      <Function ID="25" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="76~76" WheelPosition="9" Colour="255,0,255" />
      <Function ID="26" Name="Cy/ 260" Display="'Cy/ 260'" Dmx="84~84" WheelPosition="10" Colour="0,255,255" />
      <Function ID="27" Name="260/ 190" Display="'260/ 190'" Dmx="92~92" WheelPosition="11" Colour="255,240,200" />
      <Function ID="28" Name="190/ CTB" Display="'190/ CTB'" Dmx="100~100" WheelPosition="12" Colour="255,240,200" />
      <Function ID="29" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="108~108" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="116~116" WheelPosition="14" Colour="0,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colur_Effect" Name="Colur Effect" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="192~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="100~105" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="200~205" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6d2eff29-ff29-438c-8548-48f5f1148f1b" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Frost" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo_Effect" ChannelOffset="10" Wheel="15" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colur_Effect" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Prism" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="14" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="15" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />

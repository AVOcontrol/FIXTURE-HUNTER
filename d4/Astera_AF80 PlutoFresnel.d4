  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>a1eef771-834f-45ab-b1bb-e9e9429874e3</Thumbnail>
  <History Date="29-10-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="11-03-17" Author="Nic Morris" Comment="Created from Astera SPOTMAX (AX10)" Version="2" />
  <History Date="15-03-17" Author="Nic Morris" Comment="Added 4 and 16 cell modes in response to customer request." Version="3" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Added product thumbnail" Version="4" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="06-03-18" Author="Nic Morris" Comment="Improved product thumbnail" Version="6" />
  <History Date="19-04-18" Author="Nic Morris" Comment="Changed reserved control to Amber." Version="7" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Renamed existing modes as 'multi-strobe' and added 'no strobe', 'single strobe' and 'SS' modes in line with latest charts (10/10/17)" Version="8" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Note the effect modes seem to have disappeared.  Retained for backwards compatibility or in case this is wrong." Version="9" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Also note charts only have the 'SS' option listed for RGB" Version="10" />
  <History Date="13-05-18" Author="Nic Morris" Comment="'Single Strobe' mode charts have gaps in the offsets.  Very confusing.  Used reserved channels to avoid problems." Version="11" />
  <History Date="13-05-18" Author="Nic Morris" Comment="For 1 pixel modes (no 'Pixel' suffix),'Strobe' is equivalent to 'Single' and 'Multi' versions as there is no difference." Version="12" />
  <History Date="03-11-18" Author="Nic Morris" Comment="Created from Astera AX1 PixelTube" Version="13" />
  <History Date="15-03-19" Author="Nic Morris" Comment="Added Atlabase ID's (currently missing mode 43)" Version="14" />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added missing Atlabase ID to mode 43." Version="15" />
  <History Date="30-05-19" Author="Nic Morris" Comment="Revised CTO display range to Kelvin." Version="16" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Updated in line with May-19 charts.  Far too many modes!" Version="17" />
  <History Date="17-10-19" Author="Nic Morris" Comment="Revised CCT display range." Version="18" />
  <History Date="19-10-19" Author="Nic Morris" Comment="Added Atlabase ID's to new modes." Version="19" />
  <History Date="10-09-20" Author="Nic Morris" Comment="Created from Astera FP1 Titan Tube" Version="20" />
  <History Date="12-09-20" Author="Nic Morris" Comment="Added missing Atlabase ID's to modes 15,16 and 137." Version="24" />
  <History Date="19-01-24" Author="Nic Morris" Comment="Created from Astera FP5 NYX Bulb" Version="25" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bcddcbe2-e986-44d4-9002-cbc57af9e8f9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="6~4" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Col Static" Display="'1 Col Static'" Dmx="0~0" />

    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Strobe 1" Display="'Strobe 1'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
      <Function ID="2" Name="Strobe 2" Display="'Strobe 2'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
    </Attribute>

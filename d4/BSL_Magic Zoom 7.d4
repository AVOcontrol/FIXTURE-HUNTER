    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Control" Display="'Control'" Dmx="16~31" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="32~255" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Spd" Name="Patt Spd" Description="" Group="G">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Condition Name="Control" ID="1,2" If="'Pattern'==2" />
      <Condition Name="Effect" ID="3" If="'Pattern'==3" />
      <Else ID="4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~250" Dmx="3~252" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Byte_1" Name="Patt Byte 1" Description="" Group="G">

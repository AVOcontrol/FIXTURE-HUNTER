      <Function ID="16" Name="White 3" Display="'White 3'" Dmx="75~79" Update="Auto_Spd" />
      <Function ID="17" Name="Program 2" Display="'Program 2'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="18" Name="Program 3" Display="'Program 3'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="19" Name="Program 4" Display="'Program 4'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="20" Name="Program 5" Display="'Program 5'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="21" Name="Program 6" Display="'Program 6'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="22" Name="Program 7" Display="'Program 7'" Dmx="130~139" Update="Auto_Spd" />
      <Function ID="23" Name="Program 8" Display="'Program 8'" Dmx="140~149" Update="Auto_Spd" />

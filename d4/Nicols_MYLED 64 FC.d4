      <Function ID="28" Name="Program 13" Display="'Program 13'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="29" Name="Program 14" Display="'Program 14'" Dmx="200~209" Update="Auto_Spd" />
      <Function ID="30" Name="Program 15" Display="'Program 15'" Dmx="210~219" Update="Auto_Spd" />
      <Function ID="31" Name="Program 16" Display="'Program 16'" Dmx="220~229" Update="Auto_Spd" />
      <Function ID="32" Name="Program 17" Display="'Program 17'" Dmx="230~239" Update="Auto_Spd" />
      <Function ID="33" Name="Program 18" Display="'Program 18'" Dmx="240~249" Update="Auto_Spd" />
      <Function ID="34" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Auto'==34" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 2 DMX" Channels="2" Id="b017ed46-34ec-48df-b46b-8c7effeac4a1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="SVRFP128" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8f778798-4ac5-43e4-83dc-51d43237b7b0" />
    <Include>

      <Function ID="14" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="60~187" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="255,255,255" />

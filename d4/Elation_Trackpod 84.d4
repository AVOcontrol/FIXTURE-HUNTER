      <Function ID="13" Name="Chase 13" Display="'Chase 13'" Dmx="192~207" />
      <Function ID="14" Name="Chase 14" Display="'Chase 14'" Dmx="208~223" />
      <Function ID="15" Name="Chase 15" Display="'Chase 15'" Dmx="224~239" />
      <Function ID="16" Name="Chase 16" Display="'Chase 16'" Dmx="240~255" />

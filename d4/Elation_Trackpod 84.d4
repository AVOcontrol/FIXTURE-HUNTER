  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="30-11-11" Author="John Rogers" Comment="Created from existing Pixel Track Pro d4 file." />
  <History Date="23-03-12" Author="Peter Budd" Comment="Created 7Ch Mode" />
  <History Date="26-03-12" Author="Peter Budd" Comment="Created from Showtec Pixel Track Pro" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Dimmer" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

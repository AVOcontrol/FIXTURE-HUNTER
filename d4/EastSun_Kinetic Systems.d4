  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="60fc589b-740f-45e9-a4db-cbfb0993620e" />
  <Control>
    <Attribute ID="Lift" Name="Lift" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Lift_Speed" Name="Lift Speed" Description="" Group="P">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~44" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="45~64" />
      <Function ID="5" Name="Open Pls" Display="'Open Pls %.f%%',0~100" Dmx="66~106" />
      <Function ID="6" Name="Rnd Pl Pls" Display="'Rnd Pl Pls %.f%%',0~100" Dmx="107~189" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~230" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="231~251" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="LED_Function" Name="LED Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static Red" Display="'Static Red'" Dmx="5~9" />
      <Function ID="3" Name="Static Amber" Display="'Static Amber'" Dmx="10~14" />
      <Function ID="4" Name="Static Yellow" Display="'Static Yellow'" Dmx="15~19" />
      <Function ID="5" Name="Static Green" Display="'Static Green'" Dmx="20~24" />
      <Function ID="6" Name="Static Cyan" Display="'Static Cyan'" Dmx="25~29" />
      <Function ID="7" Name="Static Blue" Display="'Static Blue'" Dmx="30~34" />
      <Function ID="8" Name="Static Magenta" Display="'Static Magenta'" Dmx="35~39" />
      <Function ID="9" Name="Static White" Display="'Static White'" Dmx="40~44" />
      <Function ID="10" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="50~94" />
      <Function ID="11" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="100~149" />
      <Function ID="12" Name="Colour Mixing" Display="'Colour Mixing %.f%%',0~100" Dmx="155~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~240" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="246~250" />
    </Attribute>
    <Attribute ID="LED_Function1" Name="LED Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colourful Change" Display="'Colourful Change %.f%%',0~100" Dmx="5~39" />
      <Function ID="3" Name="Colourful Effect" Display="'Colourful Effect %.1f%%',0.0~100.0" Dmx="40~255" />
    </Attribute>
    <Attribute ID="Function_Speed" Name="Function Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe (1)" Display="'Strobe (1) %.1f%%',0.0~100.0" Dmx="10~90" />
      <Function ID="3" Name="Strobe (2)" Display="'Strobe (2) %.1f%%',0.0~100.0" Dmx="91~170" />
      <Function ID="4" Name="Strobe (3)" Display="'Strobe (3) %.1f%%',0.0~100.0" Dmx="171~250" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="15-11-23" Author="Nic Morris" Comment="Created from Unknown 760 Nano Wash Moving Head IP65 (RGBW) (charts are a mess.  assumed identical.  note some modes reference lime rather than white components but it is not consistent and the specs only have RGBW)" Version="4" />
  <History Date="17-11-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="18-09-24" Author="Nic Morris" Comment="Created from PM Lights Nano Wash BX65" Version="6" />
  <History Date="25-09-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="22-04-25" Author="Nic Morris" Comment="Created from PM Lights MEGA BX65 (effectively identical. pixel layout and colour macros missing - assumed the same for now)" Version="14" />
  <History Date="25-06-25" Author="Nic Morris" Comment="Created from Volux Phantom (effectively identical)" Version="16" />
  <History Date="27-06-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="17" />
  <History Date="28-07-25" Author="Nic Morris" Comment="Created from AB LIGHTS MAXIMUS" Version="20" />
  <History Date="31-07-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="21" />
  <History Date="02-10-25" Author="Nic Morris" Comment="Created from E-Lite STORM WASH 1200 (identical)" Version="22" />
  <History Date="03-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="23" />
  <History Date="14-11-25" Author="Nic Morris" Comment="Created from Miner Light Mega Wash 19Q 60 IP (effectively identical.  documentation is a mess.  conflicting tilt ranges.  no pixel layout.  assumed the same for now.  16bit pan mapping in 251 and 321 channel modes is strange and looks wrong...)" Version="24" />

      <Function ID="16" Name="Rd/ T Yel" Display="'Rd/ T Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="T Yel/ Yel" Display="'T Yel/ Yel'" Dmx="25~29" WheelPosition="2" Colour="240,220,0" />

      <Function ID="21" Name="Pk/ Org" Display="'Pk/ Org'" Dmx="65~69" WheelPosition="6" Colour="255,175,200" />
      <Function ID="22" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="75~79" WheelPosition="7" Colour="255,150,0" />
      <Function ID="23" Name="Blu/ S Blu" Display="'Blu/ S Blu'" Dmx="85~89" WheelPosition="8" Colour="0,0,255" />
      <Function ID="24" Name="S Blu/ D Pk" Display="'S Blu/ D Pk'" Dmx="95~99" WheelPosition="9" Colour="50,150,255" />
      <Function ID="25" Name="D Pk/ Gldn" Display="'D Pk/ Gldn'" Dmx="105~109" WheelPosition="10" Colour="220,140,150" />

      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="56~63" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Op/ 1" Display="'Op/ 1'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="1/ 2" Display="'1/ 2'" Dmx="72~79" WheelPosition="1" Colour="0,0,0" />

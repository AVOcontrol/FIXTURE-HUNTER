  <Thumbnail>e1cb630a-afca-451d-8cd8-2211240a031f</Thumbnail>
  <History Date="10-01-20" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="08-12-22" Author="Nic Morris" Comment="Created from Imrelax IM-RL8H500MW (identical except reset function range)" Version="2" />
  <History Date="09-12-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="30-01-24" Author="Nic Morris" Comment="Corrected 6 channel mapping (2nd channel should be tilt speed)" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5d9f031e-39dc-4134-9248-e4b516b96b65" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="8~15" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~27" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="28~47" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="48~67" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="68~87" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="88~107" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="108~127" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="128~147" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="148~167" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="168~187" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="188~207" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="208~227" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="228~247" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="CT" Name="CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="3" Name="Warm White-2700K" Display="'Warm White-2700K %.f%%',0~100" Dmx="7~46" Colour="0,0,0" />
      <Function ID="4" Name="2700K (Bulb White)" Display="'2700K (Bulb White)'" Dmx="47~47" Colour="0,0,0" />
      <Function ID="5" Name="2700-3200K" Display="'2700-3200K %.fK',2700~3200" Dmx="48~87" Colour="0,0,0" />
      <Function ID="6" Name="3200K (Halogen White)" Display="'3200K (Halogen White)'" Dmx="88~88" Colour="0,0,0" />
      <Function ID="7" Name="3200-4000K" Display="'3200-4000K %.fK',3200~4000" Dmx="89~128" Colour="0,0,0" />
      <Function ID="8" Name="4000K (Neutral White)" Display="'4000K (Neutral White)'" Dmx="129~129" Colour="0,0,0" />
      <Function ID="9" Name="4000-5600K" Display="'4000-5600K %.fK',4000~5600" Dmx="130~169" Colour="0,0,0" />

    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Change/Fade" />
      <Function ID="2" Name="CT Preset" Display="'CT Preset'" Dmx="52~102" Update="Change/Fade" />
      <Function ID="3" Name="Col Change Mode" Display="'Col Change Mode'" Dmx="103~153" Update="Change/Fade" />
      <Function ID="4" Name="Col Fade Mode" Display="'Col Fade Mode'" Dmx="154~255" Update="Change/Fade" />
    </Attribute>
    <Attribute ID="Change/Fade" Name="Change/Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Col Change Mode" ID="2,3,4,5,6,7" If="'Macro'==3" />
      <Condition Name="Col Fade Mode" ID="8,9,10,11,12,13" If="'Macro'==4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Col Change 1" Display="'Col Change 1'" Dmx="0~0" />
      <Function ID="3" Name="Col Change 2" Display="'Col Change 2'" Dmx="43~84" />

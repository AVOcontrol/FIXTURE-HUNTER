      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="56~61" WheelPosition="10" Colour="0,0,0" />
      <Function ID="12" Name="Op/ 1" Display="'Op/ 1'" Dmx="62~67" WheelPosition="0" Colour="255,255,255" />
      <Function ID="13" Name="1/ 2" Display="'1/ 2'" Dmx="68~73" WheelPosition="1" Colour="0,0,0" />
